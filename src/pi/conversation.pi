import "english.pi"

skill load_facts(mem) -> Any {
  let st = new_state()
  if mem != null {
    let text = read_file(mem)
    if text != null {
      for line in split(text, "\n") {
        let r = handle(st, line)
        let st = r[1]
      }
    }
  }
  return st
}

skill converse(mem) -> Any {
  return converse_with(mem,handle,load_facts(mem))
}

skill converse_with(mem,respond,st) -> Any {
  let going = true
  while going {
    let m = mark()
    let line = input()
    if line == null {
      let going = false
    } else {
      let r = respond(st, line)
      if r[0] != "" { do print(r[0]) }
      let r = release(m, r)
      let st = r[1]
      if mem != null and r[2] {
        if write_file(mem, join(st["said"], "\n")) == null { return "Could not save facts to " ++ mem }
      }
    }
  }
  return "Goodbye. I know " ++ str(len(st["facts"])) ++ " facts."
}
