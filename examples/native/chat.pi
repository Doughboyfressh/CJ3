# Native Pi dialogue with persistent facts and searchable notes.
import "conversation.pi"
import "notes.pi"

skill main() -> Any {
  # the console speaks UTF-8 (em dashes, emoji, the inline-eval brackets)
  do rt_console_utf8()
  # the memory without the brain: chat --remember NOTE / chat --recall QUERY
  if arg(1) == "--remember" or arg(1) == "--recall" {
    let words = []
    let i = 2
    while arg(i) != null {
      let words = append(words, arg(i))
      let i = i + 1
    }
    if arg(1) == "--remember" {
      if mem_add(join(words, " ")) == null { return "could not save note to " ++ MEMFILE() }
      return "saved (" ++ str(len(mem_all())) ++ " notes)"
    }
    let found = mem_find(join(words, " "), 5)
    if len(found) == 0 { return "no notes about that" }
    return join(found, "\n")
  }
  if arg(1) != null { return "Usage: chat [--remember NOTE | --recall QUERY]" }
  return converse("out/chat_facts.txt")
}
