# Compounding: a growing library makes Pi solve problems it could not before. Pi first dreams easy problems and
# solves them; the op-pairs that recur in its solutions become new single ops (a learned "vocabulary"). Then it
# faces hard problems (length-4 programs) that its base ops cannot reach at search depth 3. With the learned
# vocabulary -- each macro counting as one step -- some of those become reachable. The lift is pure: every hard
# problem counted was unsolvable before and is verified on held-out inputs after. Deterministic -> golden.
import "dreamlib.pi"

skill opkey(op) -> Any { return str(op[0]) ++ "_" ++ str(op[1]) }

# learn up to k macros: the most frequent adjacent op-pairs among a batch of easy solutions
skill learn_macros(alpha, k) -> Any {
  let seed = 777
  let count = {}
  let pairops = {}
  for d in range(0, 60) {
    let dt = dream_target(seed, alpha, 2)
    let target = dt[0]
    let seed = dt[1]
    let s = solve(alpha, 2, examples_of(target, 1, 6))
    let prog = s[0]
    if verifies(prog, target) == 1 and len(prog) >= 2 {
      for i in range(0, len(prog) - 1) {
        let key = opkey(prog[i]) ++ "|" ++ opkey(prog[i + 1])
        let had = count[key]
        if had == null { let had = 0 }
        let count = put(count, key, had + 1)
        let pairops = put(pairops, key, [prog[i], prog[i + 1]])
      }
    }
  }
  let chosen = []
  for t in range(0, k) {
    let bestk = ""
    let bestc = 1
    for key in keys(count) {
      if contains(chosen, key) == false and count[key] > bestc {
        let bestc = count[key]
        let bestk = key
      }
    }
    if bestk != "" { let chosen = append(chosen, bestk) }
  }
  let macros = []
  for key in chosen { let macros = append(macros, [4, pairops[key]]) }
  return macros
}

# does any program of length <= maxlen agree with the target on every input 1..8? (exhaustive; defines "hard")
skill expressible(alpha, maxlen, target) -> Any {
  let all = examples_of(target, 1, 9)
  for l in range(1, maxlen + 1) {
    for idx in range(0, power(len(alpha), l)) {
      if matches(nth_prog(alpha, l, idx), all) { return 1 }
    }
  }
  return 0
}

skill uses_macro(prog) -> Any {
  if prog == null { return 0 }
  for op in prog {
    if op[0] == 4 { return 1 }
  }
  return 0
}

skill pick3(seed, alpha) -> Any {
  let target = []
  for i in range(0, 3) {
    let r = pick(seed, len(alpha))
    let target = append(target, alpha[r[0]])
    let seed = r[1]
  }
  return [target, seed]
}

skill main() -> Any {
  let base = alphabet()
  let macros = learn_macros(base, 4)
  let withlib = base ++ macros
  let seed = 999
  let hard = 0
  let base_got = 0
  let lib_got = 0
  let via_macro = 0
  for d in range(0, 80) {
    let t = pick3(seed, base)
    let target = t[0]
    let seed = t[1]
    if expressible(base, 2, target) == 0 {
      # no base program of length <= 2 matches it on inputs 1..8 -- genuinely out of reach without the library
      let hard = hard + 1
      # the honest protocol: search on inputs 1..5 only, then verify on unseen 6..8
      let s = solve(withlib, 2, examples_of(target, 1, 6))
      let lok = verifies(s[0], target)
      let lib_got = lib_got + lok
      if lok == 1 { let via_macro = via_macro + uses_macro(s[0]) }
    } else {
      let base_got = base_got + 1
    }
  }
  return "macros " ++ str(len(macros)) ++ ", hard " ++ str(hard) ++ ", base-only solvable 0, with-library solved " ++ str(lib_got) ++ " (all via a learned macro: " ++ str(via_macro) ++ "), easy " ++ str(base_got)
}
