# Pi's vision understanding: from pixels to a scene (what is on the screen, where, inside what).
#   regions   -- connected areas of one colour class (64 classes: 4 levels per channel), on flat arrays (a whole
#                screen, 2M pixels -- the ARC object layer stops at 4096 cells)
#   kinds     -- panel (a big rectangle: a window), bar (long and thin: a title or tool bar), button (a small
#                rectangle), glyph (a tiny mark: part of a letter), shape (anything else); the background is the
#                largest region spanning the picture edge to edge
#   text      -- glyphs in a row, close together, become a text line
#   layout    -- every element is placed in the smallest panel that holds it; a bar right on top of a panel, edge to
#                edge, is its title bar
# A rectangle is judged by its edges: at least 3 of its 4 sides at least 80% its own colour (a title bar may take the
# top edge of a window; holes such as text and buttons inside do not matter).
# Everything per region lives in flat arrays changed in place: a real screen has tens of thousands of regions, and a
# list grown by copying is quadratic (it ran out of the 4 GB heap).
import "senses.pi"

# 8 levels per channel (512 classes): 4 levels put a light grey button and a light grey window in one class
skill qcol(c) -> Any { return (c // 65536 // 32) * 64 + ((c // 256) % 256 // 32) * 8 + (c % 256) // 32 }

# -> [count, arr of 7 per region: class, size, x0, y0, x1, y1, a pixel's colour, label arr (region per pixel)]
skill regions(w, h, pix) -> Any {
  let n = w * h
  let q = arr(n)
  for i in range(0, n) { do aset(q, i, qcol(aget(pix, i))) }
  let lab = arr(n)
  let queue = arr(n)
  let maxr = 300000
  let rs = arr(7 * maxr)
  let k = 0
  let start = 0
  while start < n and k < maxr {
    if aget(lab, start) == 0 {
      let c = aget(q, start)
      let k = k + 1
      do aset(lab, start, k)
      do aset(queue, 0, start)
      let qh = 0
      let qt = 1
      let x0 = start % w
      let x1 = x0
      let y0 = start // w
      let y1 = y0
      while qh < qt {
        let p = aget(queue, qh)
        let qh = qh + 1
        let px = p % w
        let py = p // w
        if px < x0 { let x0 = px }
        if px > x1 { let x1 = px }
        if py < y0 { let y0 = py }
        if py > y1 { let y1 = py }
        if px > 0 {
          if aget(lab, p - 1) == 0 and aget(q, p - 1) == c {
            do aset(lab, p - 1, k)
            do aset(queue, qt, p - 1)
            let qt = qt + 1
          }
        }
        if px < w - 1 {
          if aget(lab, p + 1) == 0 and aget(q, p + 1) == c {
            do aset(lab, p + 1, k)
            do aset(queue, qt, p + 1)
            let qt = qt + 1
          }
        }
        if py > 0 {
          if aget(lab, p - w) == 0 and aget(q, p - w) == c {
            do aset(lab, p - w, k)
            do aset(queue, qt, p - w)
            let qt = qt + 1
          }
        }
        if py < h - 1 {
          if aget(lab, p + w) == 0 and aget(q, p + w) == c {
            do aset(lab, p + w, k)
            do aset(queue, qt, p + w)
            let qt = qt + 1
          }
        }
      }
      let b = 7 * (k - 1)
      do aset(rs, b, c)
      do aset(rs, b + 1, qt)
      do aset(rs, b + 2, x0)
      do aset(rs, b + 3, y0)
      do aset(rs, b + 4, x1)
      do aset(rs, b + 5, y1)
      do aset(rs, b + 6, aget(pix, start))
    }
    let start = start + 1
  }
  return [k, rs, lab]
}

# how much of one side of a box belongs to region k (percent)
skill side_own(lab, w, k, xa, ya, xb, yb) -> Any {
  let own = 0
  let tot = 0
  for y in range(ya, yb + 1) {
    for x in range(xa, xb + 1) {
      let tot = tot + 1
      if aget(lab, y * w + x) == k { let own = own + 1 }
    }
  }
  return own * 100 // max(1, tot)
}

skill is_rect(lab, w, k, x0, y0, x1, y1) -> Any {
  let sides = 0
  if side_own(lab, w, k, x0, y0, x1, y0) >= 80 { let sides = sides + 1 }
  if side_own(lab, w, k, x0, y1, x1, y1) >= 80 { let sides = sides + 1 }
  if side_own(lab, w, k, x0, y0, x0, y1) >= 80 { let sides = sides + 1 }
  if side_own(lab, w, k, x1, y0, x1, y1) >= 80 { let sides = sides + 1 }
  return sides >= 3
}

# kind codes: 0 background, 1 glyph, 2 panel, 3 bar, 4 button, 5 shape
skill kind_name(c) -> Any {
  if c == 1 { return "glyph" }
  if c == 2 { return "panel" }
  if c == 3 { return "bar" }
  if c == 4 { return "button" }
  if c == 5 { return "shape" }
  return "background"
}

# -> [count, region arr, kind arr]
skill classify(w, h, pix) -> Any {
  let r = regions(w, h, pix)
  let k = r[0]
  let rs = r[1]
  let lab = r[2]
  if arg(1) == "memtrace" { do print("regions: " ++ str(k) ++ ", heap " ++ str(memused() // 1000000) ++ " MB") }
  let big = 0 - 1
  for i in range(0, k) {
    let b = 7 * i
    if aget(rs, b + 2) == 0 and aget(rs, b + 3) == 0 and aget(rs, b + 4) == w - 1 and aget(rs, b + 5) == h - 1 {
      if big < 0 { let big = i } else {
        if aget(rs, b + 1) > aget(rs, 7 * big + 1) { let big = i }
      }
    }
  }
  if big < 0 {
    let big = 0
    for i in range(0, k) {
      if aget(rs, 7 * i + 1) > aget(rs, 7 * big + 1) { let big = i }
    }
  }
  let total = w * h
  let kinds = arr(k + 1)
  for i in range(0, k) {
    if i != big {
      let b = 7 * i
      let size = aget(rs, b + 1)
      let x0 = aget(rs, b + 2)
      let y0 = aget(rs, b + 3)
      let x1 = aget(rs, b + 4)
      let y1 = aget(rs, b + 5)
      let bw = x1 - x0 + 1
      let bh = y1 - y0 + 1
      let kind = 5
      if bh <= 9 and bw <= 9 and size <= 45 { let kind = 1 } else {
        if size >= 12 and is_rect(lab, w, i + 1, x0, y0, x1, y1) {
          # a long thin strip is a bar however big it is (a title bar 400x26 passed the window test first)
          if bw >= 8 * bh and bh <= 30 { let kind = 3 } else {
            if bw * bh >= total // 50 and bh >= 24 { let kind = 2 } else {
              if bh >= 5 and bh <= 40 and bw >= 8 { let kind = 4 }
            }
          }
        }
      }
      do aset(kinds, i, kind)
    }
  }
  return [k, rs, kinds]
}

skill iabs(v) -> Any {
  if v < 0 { return 0 - v }
  return v
}

# glyph regions side by side on one row -> text lines [x0, y0, x1, y1, marks] (3 marks at least). The glyphs are
# visited by left edge (counting sort); a line whose right end is far behind is closed for good, so each glyph only
# looks at the lines still open.
# two-number min and max that allocate nothing (min and max take any number of arguments, so every call builds a
# list -- per pair of text lines on a real screen that is billions of lists)
skill imin(a, b) -> Any {
  if a < b { return a }
  return b
}

skill imax(a, b) -> Any {
  if a > b { return a }
  return b
}

skill text_lines(w, k, rs, kinds) -> Any {
  let ng = 0
  for i in range(0, k) {
    if aget(kinds, i) == 1 { let ng = ng + 1 }
  }
  let cnt = arr(w + 1)
  for i in range(0, k) {
    if aget(kinds, i) == 1 { do aset(cnt, aget(rs, 7 * i + 2), aget(cnt, aget(rs, 7 * i + 2)) + 1) }
  }
  let pos = arr(w + 1)
  let acc = 0
  for x in range(0, w) {
    do aset(pos, x, acc)
    let acc = acc + aget(cnt, x)
  }
  let order = arr(ng + 1)
  for i in range(0, k) {
    if aget(kinds, i) == 1 {
      let x = aget(rs, 7 * i + 2)
      do aset(order, aget(pos, x), i)
      do aset(pos, x, aget(pos, x) + 1)
    }
  }
  # lines: 5 fields each; open: indices of lines still open
  let maxl = ng + 1
  let ln = arr(5 * maxl)
  let nl = 0
  let open = arr(maxl)
  let no = 0
  for t in range(0, ng) {
    let i = aget(order, t)
    let b = 7 * i
    let gx0 = aget(rs, b + 2)
    let gy0 = aget(rs, b + 3)
    let gx1 = aget(rs, b + 4)
    let gy1 = aget(rs, b + 5)
    let cy = (gy0 + gy1) // 2
    let placed = 0 - 1
    let keep = 0
    # (a while, not range(): range builds a whole list, once per glyph -- 100k glyphs ran out of the heap)
    let u = 0
    while u < no {
      let li = aget(open, u)
      let u = u + 1
      let lb = 5 * li
      if gx0 - aget(ln, lb + 2) > 8 {
        # this line is behind for good: closed (not kept open)
        let keep = keep
      } else {
        do aset(open, keep, li)
        let keep = keep + 1
        if placed < 0 {
          # one line: the glyph's rows overlap the line's by at least half the shorter (capitals and small letters
          # have different centres but share rows)
          let ov = imin(aget(ln, lb + 3), gy1) - imax(aget(ln, lb + 1), gy0) + 1
          if ov * 2 >= imin(gy1 - gy0 + 1, aget(ln, lb + 3) - aget(ln, lb + 1) + 1) {
            let placed = li
            do aset(ln, lb + 1, imin(aget(ln, lb + 1), gy0))
            do aset(ln, lb + 2, imax(aget(ln, lb + 2), gx1))
            do aset(ln, lb + 3, imax(aget(ln, lb + 3), gy1))
            do aset(ln, lb + 4, aget(ln, lb + 4) + 1)
          }
        }
      }
    }
    let no = keep
    if placed < 0 {
      let lb = 5 * nl
      do aset(ln, lb, gx0)
      do aset(ln, lb + 1, gy0)
      do aset(ln, lb + 2, gx1)
      do aset(ln, lb + 3, gy1)
      do aset(ln, lb + 4, 1)
      do aset(open, no, nl)
      let no = no + 1
      let nl = nl + 1
    }
  }
  # second pass: lines that share rows and touch end to end are one line (a letter's fragments, visited left to right,
  # can start two lines side by side) -- merged until nothing changes
  let alive = arr(nl + 1)
  for li in range(0, nl) { do aset(alive, li, 1) }
  let changed = true
  while changed {
    let changed = false
    for a in range(0, nl) {
      if aget(alive, a) == 1 {
        let b = a + 1
        while b < nl {
          let bcur = b
          let b = b + 1
          if aget(alive, bcur) == 1 {
            let ab = 5 * a
            let bb = 5 * bcur
            let ov = imin(aget(ln, ab + 3), aget(ln, bb + 3)) - imax(aget(ln, ab + 1), aget(ln, bb + 1)) + 1
            let ha = aget(ln, ab + 3) - aget(ln, ab + 1) + 1
            let hb = aget(ln, bb + 3) - aget(ln, bb + 1) + 1
            let gap = imax(aget(ln, ab), aget(ln, bb)) - imin(aget(ln, ab + 2), aget(ln, bb + 2))
            if ov * 2 >= imin(ha, hb) and gap <= 8 {
              do aset(ln, ab, imin(aget(ln, ab), aget(ln, bb)))
              do aset(ln, ab + 1, imin(aget(ln, ab + 1), aget(ln, bb + 1)))
              do aset(ln, ab + 2, imax(aget(ln, ab + 2), aget(ln, bb + 2)))
              do aset(ln, ab + 3, imax(aget(ln, ab + 3), aget(ln, bb + 3)))
              do aset(ln, ab + 4, aget(ln, ab + 4) + aget(ln, bb + 4))
              do aset(alive, bcur, 0)
              let changed = true
            }
          }
        }
      }
    }
  }
  let g = [[], []]
  for li in range(0, nl) {
    let lb = 5 * li
    if aget(alive, li) == 1 and aget(ln, lb + 4) >= 3 { let g = v_push(g, [aget(ln, lb), aget(ln, lb + 1), aget(ln, lb + 2), aget(ln, lb + 3), aget(ln, lb + 4)]) }
  }
  return v_items(g)
}

skill inside(a, b) -> Any { return a[1] >= b[1] and a[2] >= b[2] and a[3] <= b[3] and a[4] <= b[4] }

skill hexcol(c) -> Any {
  let d = "0123456789abcdef"
  let s = "#"
  for sh in [1048576, 65536, 4096, 256, 16, 1] { let s = s ++ slice(d, (c // sh) % 16, (c // sh) % 16 + 1) }
  return s
}

skill box_text(e, scale) -> Any { return str(e[1] * scale) ++ "," ++ str(e[2] * scale) ++ " size " ++ str((e[3] - e[1] + 1) * scale) ++ "x" ++ str((e[4] - e[2] + 1) * scale) }

# -> [description, panels, bars, buttons, text lines, glyph marks, shapes, boxes to draw [x0, y0, x1, y1, colour]]
# a list grown in chunks of 64 (appending to one long list copies it every time: quadratic on a busy screen)
skill v_push(g, x) -> Any {
  let cur = append(g[1], x)
  if len(cur) >= 64 { return [append(g[0], cur), []] }
  return [g[0], cur]
}

skill v_items(g) -> Any {
  let out = []
  for c in g[0] { let out = out ++ c }
  return out ++ g[1]
}

# -> [description, panels, bars, buttons, text lines, glyph marks, shapes, boxes to draw, lines, bars+buttons, panels]
# (the description names at most 400 things; the counts and lists hold everything)
skill understand(w, h, pix, scale) -> Any {
  let c = classify(w, h, pix)
  let k = c[0]
  let rs = c[1]
  let kinds = c[2]
  if arg(1) == "memtrace" { do print("classified: " ++ str(k) ++ " regions, heap " ++ str(memused() // 1000000) ++ " MB") }
  let lines = text_lines(w, k, rs, kinds)
  if arg(1) == "memtrace" { do print("text lines: " ++ str(len(lines)) ++ ", heap " ++ str(memused() // 1000000) ++ " MB") }
  let gp = [[], []]
  let go = [[], []]
  let ng = 0
  let ns = 0
  for i in range(0, k) {
    let kd = aget(kinds, i)
    if kd == 1 { let ng = ng + 1 }
    if kd == 5 { let ns = ns + 1 }
    if kd >= 2 and kd <= 4 {
      let b = 7 * i
      let e = [kind_name(kd), aget(rs, b + 2), aget(rs, b + 3), aget(rs, b + 4), aget(rs, b + 5), aget(rs, b + 6), aget(rs, b + 1)]
      if kd == 2 { let gp = v_push(gp, e) } else { let go = v_push(go, e) }
    }
  }
  let panels = v_items(gp)
  let others = v_items(go)
  let nb = 0
  let nbt = 0
  for o in others {
    if o[0] == "bar" { let nb = nb + 1 } else { let nbt = nbt + 1 }
  }
  let gt = [[], []]
  let gt = v_push(gt, "scene: " ++ str(len(panels)) ++ " panels, " ++ str(nb) ++ " bars, " ++ str(nbt) ++ " buttons, " ++ str(len(lines)) ++ " text lines (" ++ str(ng) ++ " glyph marks), " ++ str(ns) ++ " other shapes")
  let said = 1
  let gb = [[], []]
  let pn = 0
  for p in panels {
    let pn = pn + 1
    if said < 400 {
      let gt = v_push(gt, "panel " ++ str(pn) ++ " at " ++ box_text(p, scale) ++ " " ++ hexcol(p[5]))
      let said = said + 1
    }
    let gb = v_push(gb, [p[1], p[2], p[3], p[4], 16711680])
  }
  for o in others {
    # the owner as numbers (a text per element and panel pair ran out of the heap on a busy screen)
    let owner = 0
    let title = false
    let best = 0
    let j = 0
    for p in panels {
      let j = j + 1
      # a bar sitting right on top of a panel, edge to edge, is that window's title bar
      if o[0] == "bar" and iabs(o[1] - p[1]) <= 2 and iabs(o[3] - p[3]) <= 2 and p[2] - o[4] >= 0 and p[2] - o[4] <= 2 {
        let owner = j
        let title = true
        let best = 1
      }
      if inside(o, p) {
        let area = (p[3] - p[1]) * (p[4] - p[2])
        if best == 0 or area < best {
          let best = area
          let owner = j
          let title = false
        }
      }
    }
    if said < 400 {
      let on = "the desktop"
      if owner > 0 { let on = "panel " ++ str(owner) }
      if title { let on = on ++ " (its title bar)" }
      let gt = v_push(gt, "  " ++ o[0] ++ " at " ++ box_text(o, scale) ++ " " ++ hexcol(o[5]) ++ " in " ++ on)
      let said = said + 1
    }
    let col = 65280
    if o[0] == "bar" { let col = 16753920 }
    let gb = v_push(gb, [o[1], o[2], o[3], o[4], col])
  }
  for l in lines {
    if said < 400 {
      let gt = v_push(gt, "  text line at " ++ str(l[0] * scale) ++ "," ++ str(l[1] * scale) ++ " width " ++ str((l[2] - l[0] + 1) * scale) ++ " (" ++ str(l[4]) ++ " marks)")
      let said = said + 1
    }
    let gb = v_push(gb, [l[0], l[1], l[2], l[3], 255])
  }
  let txt = join(v_items(gt), NL()) ++ NL()
  return [txt, len(panels), nb, nbt, len(lines), ng, ns, v_items(gb), lines, others, panels]
}

skill NL() -> Any { return "\n" }

# draw box outlines onto a copy of the picture (what Pi understood, made visible)
skill annotate(w, h, pix, boxes) -> Any {
  let a = arr(w * h)
  for i in range(0, w * h) { do aset(a, i, aget(pix, i)) }
  for b in boxes {
    for x in range(b[0], b[2] + 1) {
      do aset(a, b[1] * w + x, b[4])
      do aset(a, b[3] * w + x, b[4])
    }
    for y in range(b[1], b[3] + 1) {
      do aset(a, y * w + b[0], b[4])
      do aset(a, y * w + b[2], b[4])
    }
  }
  return a
}

# ---- a synthetic desktop with a known answer: 1 window, 1 title bar, 3 buttons, 8 text lines -----------------------
skill fill(p, w, x0, y0, x1, y1, c) -> Any {
  for y in range(y0, y1 + 1) {
    for x in range(x0, x1 + 1) { do aset(p, y * w + x, c) }
  }
  return p
}

skill pow2(k) -> Any {
  let v = 1
  for i in range(0, k) { let v = v * 2 }
  return v
}

# a row of pseudo-letters (3x5 marks, 2 apart; a wider gap between words), from a seed -> the next seed
skill glyph_row(p, w, x, y, n, c, seed) -> Any {
  let s = seed
  let cx = x
  for i in range(0, n) {
    let s = (s * 1103515245 + 12345) % 2147483648
    let bits = s // 65536 % 32768
    if bits == 0 { let bits = 21845 }
    for k in range(0, 15) {
      if (bits // pow2(k)) % 2 == 1 { do aset(p, (y + k // 3) * w + cx + k % 3, c) }
    }
    let cx = cx + 5
    if i % 5 == 4 { let cx = cx + 4 }
  }
  return s
}

skill synth_scene() -> Any {
  let w = 320
  let h = 200
  let p = arr(w * h)
  do fill(p, w, 0, 0, w - 1, h - 1, 2780019)
  do fill(p, w, 30, 20, 289, 179, 15263976)
  do fill(p, w, 30, 20, 289, 33, 2109536)
  let s = glyph_row(p, w, 36, 25, 8, 16777215, 7)
  for i in range(0, 4) { let s = glyph_row(p, w, 45, 48 + 14 * i, 20, 1052688, s) }
  for i in range(0, 3) {
    do fill(p, w, 45 + 80 * i, 145, 104 + 80 * i, 162, 4881360)
    let s = glyph_row(p, w, 55 + 80 * i, 151, 4, 16777215, s)
  }
  return [w, h, p]
}
