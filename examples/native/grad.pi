skill g_ptx() -> Any {
  return G_V() ++ g_k_mm() ++ g_k_atb() ++ g_k_abt() ++ g_k_addbias() ++ g_k_biasgrad() ++ g_k_act() ++ g_k_actb() ++ g_k_mse() ++ g_k_adam() ++ g_k_vrfwd() ++ g_k_vrbwd() ++ g_k_posenc() ++ g_k_addnoise() ++ g_k_vrw()
}

# ---- float32 <-> Pi reals (Pi reals are doubles) --------------------------------------------------------------------
skill g_pow2(k) -> Any {
  let r = 1.0
  let n = if k < 0 { 0 - k } else { k }
  for i in range(0, n) { r = r * 2.0 }
  if k < 0 { return 1.0 / r }
  return r
}
skill g_f32bits(x) -> Any {
  if x == 0.0 { return 0 }
  let s = 0
  if x < 0.0 {
    s = 2147483648
    x = 0.0 - x
  }
  let e = 0
  while x >= 2.0 {
    x = x / 2.0
    e += 1
  }
  while x < 1.0 {
    x = x * 2.0
    e += 0 - 1
  }
  let m = int((x - 1.0) * 8388608.0 + 0.5)
  if m >= 8388608 {
    m = 0
    e += 1
  }
  if e < 0 - 126 { return s }
  if e > 127 { return s + 2139095040 }
  return s + (e + 127) * 8388608 + m
}
skill g_bits_real(b) -> Any {
  let s = if b >= 2147483648 { 0.0 - 1.0 } else { 1.0 }
  let r = b % 2147483648
  let e = r // 8388608
  let m = r % 8388608
  if e == 0 { return s * float(m) * g_pow2(0 - 149) }
  if e == 255 { return s * 1.0e30 }
  return s * (1.0 + float(m) / 8388608.0) * g_pow2(e - 127)
}

skill rt_g_putbits(host, it, bits) -> Any {
  do rt_poke32(rt_untag(host) + 4 * rt_untag(it), rt_untag(bits))
  return rt_tag(0)
}
skill rt_g_getbits(host, it) -> Any { return rt_tag(rt_peek32(rt_untag(host) + 4 * rt_untag(it))) }

# ---- the engine ----
skill g_open() -> Any {
  if rt_gpu_open() != 1 { fail("the GPU could not be opened") }
  let mod = rt_sh_module(g_ptx(), "out\\grad_log.txt")
  if mod < 0 { fail("the driver refused the training kernels (" ++ str(mod) ++ "): " ++ read_file("out\\grad_log.txt")) }
  let fns = {}
  for nm in ["mm", "mm_atb", "mm_abt", "addbias", "biasgrad", "act", "actb", "mseg", "adam", "vrfwd", "vrbwd", "posenc", "addnoise", "vrw"] {
    let f = rt_gpu_fn(mod, nm)
    if f < 0 { fail("kernel " ++ nm ++ " missing") }
    fns = put(fns, nm, f)
  }
  return {"fns": fns, "tape": rt_sh_box([]), "params": rt_sh_box([]), "graph": rt_sh_box([])}
}

skill g_bs() -> Any { return 256 }
skill g_run(G, name, n, ps) -> Any {
  let r = rt_gpu_launch(G["fns"][name], (n + g_bs() - 1) // g_bs(), g_bs(), ps)
  if r != 0 { fail("kernel " ++ name ++ " failed: " ++ str(r)) }
  return 0
}

# a tensor: [data on GPU, grad on GPU, rows, cols, wants-grad flag]
skill g_tensor(rows, cols) -> Any {
  let n = rows * cols
  let data = rt_gpu_alloc(4 * n)
  let grad = rt_gpu_alloc(4 * n)
  rt_gpu_zero(data, 4 * n)
  rt_gpu_zero(grad, 4 * n)
  return [data, grad, rows, cols, arr(1)]
}
skill g_n(t) -> Any { return t[2] * t[3] }
skill g_wants(t) -> Any { return aget(t[4], 0) == 1 }
skill g_param(G, rows, cols) -> Any {
  let t = g_tensor(rows, cols)
  aset(t[4], 0, 1)
  rt_sh_set(G["params"], append(rt_sh_get(G["params"]), t))
  return t
}

skill g_set(t, xs) -> Any {
  let n = g_n(t)
  let host = rt_host_alloc(4 * n)
  for i in range(0, n) { rt_g_putbits(host, i, g_f32bits(xs[i])) }
  rt_host_to_gpu(t[0], host, 4 * n)
  rt_host_free(host)
  return t
}
skill g_get(t, which) -> Any {
  let n = g_n(t)
  let host = rt_host_alloc(4 * n)
  rt_gpu_to_host(host, if which == 1 { t[1] } else { t[0] }, 4 * n)
  let out = []
  for i in range(0, n) { out = append(out, g_bits_real(rt_g_getbits(host, i))) }
  rt_host_free(host)
  return out
}

skill g_randn_list(st, n, scale) -> Any {
  let out = []
  for i in range(0, n // 2 + 1) {
    aset(st, 0, (aget(st, 0) * 1103515245 + 12345) % 2147483648)
    let u1 = (float(aget(st, 0)) + 1.0) / 2147483649.0
    aset(st, 0, (aget(st, 0) * 1103515245 + 12345) % 2147483648)
    let u2 = float(aget(st, 0)) / 2147483648.0
    let r = sqrt(0.0 - 2.0 * log(u1)) * scale
    out = append(out, r * cos(6.2831853 * u2))
    out = append(out, r * sin(6.2831853 * u2))
  }
  return slice(out, 0, n)
}
skill g_randn(t, st, scale) -> Any { return g_set(t, g_randn_list(st, g_n(t), scale)) }

# uniform in [-scale, scale], straight into the tensor's host buffer (SIREN wants uniform init)
skill g_uniform(t, st, scale) -> Any {
  let n = g_n(t)
  let host = rt_host_alloc(4 * n)
  for i in range(0, n) {
    aset(st, 0, (aget(st, 0) * 1103515245 + 12345) % 2147483648)
    let u = float(aget(st, 0)) / 2147483648.0 * 2.0 - 1.0
    rt_g_putbits(host, i, g_f32bits(u * scale))
  }
  rt_host_to_gpu(t[0], host, 4 * n)
  rt_host_free(host)
  return t
}

# ---- forward ops; each records on the tape how to push gradient back ----
skill g_push(G, entry) -> Any { return rt_sh_set(G["tape"], append(rt_sh_get(G["tape"]), entry)) }

skill g_matmul(G, x, w) -> Any {
  let M = x[2]
  let K = x[3]
  let N = w[3]
  let out = g_tensor(M, N)
  aset(out[4], 0, 1)
  rt_sh_set(G["graph"], append(rt_sh_get(G["graph"]), out))
  g_run(G, "mm", M * N, [x[0], w[0], out[0], M, K, N])
  g_push(G, ["matmul", x, w, out, M, K, N])
  return out
}

# out = x . w + b, then activation ("" none, "relu", "sin"); a = sin frequency
skill g_dense(G, x, w, b, act, a) -> Any {
  let z = g_matmul(G, x, w)
  g_run(G, "addbias", g_n(z), [z[0], b[0], z[2], z[3]])
  g_push(G, ["addbias", z, b])
  if act == "" { return z }
  let mode = if act == "relu" { 0 } else { 1 }
  let y = g_tensor(z[2], z[3])
  aset(y[4], 0, 1)
  rt_sh_set(G["graph"], append(rt_sh_get(G["graph"]), y))
  g_run(G, "act", g_n(z), [z[0], y[0], g_n(z), mode, g_f32bits(a)])
  g_push(G, ["act", z, y, mode, a])
  return y
}

skill g_mse(G, pred, tgt) -> Any {
  let n = g_n(pred)
  let lossdev = rt_gpu_alloc(4)
  rt_gpu_zero(lossdev, 4)
  g_run(G, "mseg", n, [pred[0], tgt[0], pred[1], lossdev, n])
  let host = rt_host_alloc(4)
  rt_gpu_to_host(host, lossdev, 4)
  let loss = g_bits_real(rt_g_getbits(host, 0))
  rt_host_free(host)
  rt_gpu_free(lossdev)
  return loss
}

# raw[(Nr*M) x 4] (density logit + 3 colour logits per sample) -> pixel colours C[Nr x 3] by volume rendering
skill g_volrender(G, raw, M, deltabuf, bg) -> Any {
  let Nr = raw[2] // M
  let out = g_tensor(Nr, 3)
  aset(out[4], 0, 1)
  rt_sh_set(G["graph"], append(rt_sh_get(G["graph"]), out))
  let tscr = rt_gpu_alloc(4 * Nr * M)
  let bs = 256
  let r = rt_gpu_launch(G["fns"]["vrfwd"], (Nr + bs - 1) // bs, bs, [raw[0], out[0], tscr, Nr, M, deltabuf, g_f32bits(bg)])
  if r != 0 { fail("vrfwd failed: " ++ str(r)) }
  g_push(G, ["volrender", raw, out, M, deltabuf, bg, tscr, Nr])
  return out
}

# a GPU buffer of n copies of delta (for uniform sampling)
skill g_const_delta(n, delta) -> Any {
  let buf = rt_gpu_alloc(4 * n)
  let host = rt_host_alloc(4 * n)
  for i in range(0, n) { rt_g_putbits(host, i, g_f32bits(delta)) }
  rt_host_to_gpu(buf, host, 4 * n)
  rt_host_free(host)
  return buf
}

# per-sample volume-rendering weights of raw[(Nr*M) x 4] -> a host buffer of Nr*M floats (caller frees). For
# importance sampling: where the weight is high, a surface is.
skill g_vweights(G, raw, M, deltabuf) -> Any {
  let Nr = raw[2] // M
  let wdev = rt_gpu_alloc(4 * Nr * M)
  let bs = 256
  let r = rt_gpu_launch(G["fns"]["vrw"], (Nr + bs - 1) // bs, bs, [raw[0], wdev, deltabuf, Nr, M])
  if r != 0 { fail("vrw failed: " ++ str(r)) }
  let host = rt_host_alloc(4 * Nr * M)
  rt_gpu_to_host(host, wdev, 4 * Nr * M)
  rt_gpu_free(wdev)
  return host
}

# 3D points[n x 3] -> Fourier features[n x (3 + 6L)] = [p, sin(pi 2^k p), cos(pi 2^k p)]. An input (no gradient).
skill g_posenc(G, pts, L, alpha) -> Any {
  let n = pts[2]
  let F = 3 + 6 * L
  let feat = g_tensor(n, F)
  rt_sh_set(G["graph"], append(rt_sh_get(G["graph"]), feat))
  let bs = 256
  let r = rt_gpu_launch(G["fns"]["posenc"], (n + bs - 1) // bs, bs, [pts[0], feat[0], n, L, g_f32bits(alpha)])
  if r != 0 { fail("posenc failed: " ++ str(r)) }
  return feat
}

# add Gaussian noise to the density channel (column 0 of a (Nr*M) x 4 raw tensor), in place. Training only --
# it makes thin persistent fog unreliable so the field commits to opaque surfaces or empty space.
skill g_addnoise(G, raw, scale, seed) -> Any {
  let n = raw[2]
  let bs = 256
  let r = rt_gpu_launch(G["fns"]["addnoise"], (n + bs - 1) // bs, bs, [raw[0], n, g_f32bits(scale), seed])
  if r != 0 { fail("addnoise failed: " ++ str(r)) }
  return raw
}

# walk the tape in reverse. A feedforward net is a tree, so each tensor's grad is written once (no accumulation).
skill g_backward(G) -> Any {
  let tape = rt_sh_get(G["tape"])
  let i = len(tape) - 1
  while i >= 0 {
    let e = tape[i]
    let k = e[0]
    if k == "act" {
      let z = e[1]
      let y = e[2]
      g_run(G, "actb", g_n(z), [z[0], y[1], z[1], g_n(z), e[3], g_f32bits(e[4])])
    } else if k == "addbias" {
      let z = e[1]
      let b = e[2]
      if g_wants(b) { g_run(G, "biasgrad", b[3], [z[1], b[1], z[2], z[3]]) }
    } else if k == "volrender" {
      let raw = e[1]
      let out = e[2]
      let bs = 256
      let Nr = e[7]
      let r = rt_gpu_launch(G["fns"]["vrbwd"], (Nr + bs - 1) // bs, bs, [raw[0], e[6], out[1], raw[1], Nr, e[3], e[4], g_f32bits(e[5])])
      if r != 0 { fail("vrbwd failed: " ++ str(r)) }
      rt_gpu_free(e[6])
    } else if k == "matmul" {
      let x = e[1]
      let w = e[2]
      let out = e[3]
      if g_wants(w) { g_run(G, "mm_atb", e[5] * e[6], [x[0], out[1], w[1], e[4], e[5], e[6]]) }
      if g_wants(x) { g_run(G, "mm_abt", e[4] * e[5], [out[1], w[0], x[1], e[4], e[5], e[6]]) }
    }
    i = i - 1
  }
  return 0
}

# ---- Adam ----
skill g_opt(G, lr) -> Any {
  let st = []
  for p in rt_sh_get(G["params"]) {
    let n = g_n(p)
    let m = rt_gpu_alloc(4 * n)
    let v = rt_gpu_alloc(4 * n)
    rt_gpu_zero(m, 4 * n)
    rt_gpu_zero(v, 4 * n)
    st = append(st, [m, v])
  }
  return {"st": st, "t": arr(1), "lr": lr}
}
skill g_zero_grad(G) -> Any {
  for p in rt_sh_get(G["params"]) { rt_gpu_zero(p[1], 4 * g_n(p)) }
  # free the previous forward pass's intermediate tensors (never a param, x, or target)
  for t in rt_sh_get(G["graph"]) {
    rt_gpu_free(t[0])
    rt_gpu_free(t[1])
  }
  rt_sh_set(G["graph"], [])
  rt_sh_set(G["tape"], [])
  return 0
}
skill g_powf(base, k) -> Any {
  let r = 1.0
  for i in range(0, k) { r = r * base }
  return r
}
skill g_step(G, opt) -> Any {
  aset(opt["t"], 0, aget(opt["t"], 0) + 1)
  let t = aget(opt["t"], 0)
  let mc = 1.0 - g_powf(0.9, t)
  let vc = 1.0 - g_powf(0.999, t)
  let ps = rt_sh_get(G["params"])
  let i = 0
  for p in ps {
    let s = opt["st"][i]
    let n = g_n(p)
    g_run(G, "adam", n, [p[0], p[1], s[0], s[1], n, g_f32bits(opt["lr"]), g_f32bits(0.9), g_f32bits(0.999), g_f32bits(0.00000001), g_f32bits(mc), g_f32bits(vc)])
    i += 1
  }
  return 0
}
