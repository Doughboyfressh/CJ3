# flash: Qwen3.8 Flash Next (qwen4exp, 177B, 512 experts) run by Pi on its own GPU kernels (flashgpu.pi).
# The dense weights (~5 GB) live on the GPU; the experts (59.5 GB) are read from the GGUF into a VRAM cache of
# slots the first time a token routes to them; the token embedding and the 28.8 GB n-gram table stay on disk (a
# token reads one row and 16 rows). Follows llama.cpp b11011 src/models/qwen4exp.cpp; checked against a numpy
# reference layer by layer. Contexts up to ~2048 tokens: there the sparse attention keeps every cell (dense).
import "flashgpu.pi"

skill FL_DIR() -> Any { return "C:\\Users\\Dough\\.cache\\huggingface\\hub\\models--unsloth--Qwen3.8-Flash-Next-GGUF\\snapshots\\38bb39ee97821de2c9009abb7e93950eec396e66\\UD-IQ4_XS\\" }
skill FL_SHARDS() -> Any { return [FL_DIR() ++ "Qwen3.8-Flash-Next-UD-IQ4_XS-00002-of-00003.gguf", FL_DIR() ++ "Qwen3.8-Flash-Next-UD-IQ4_XS-00003-of-00003.gguf"] }
skill FL_TMAX() -> Any { return 64 }
skill FL_MAXPOS() -> Any { return 16384 }
// a verify pass checks up to FL_TS() tokens at once (the last real one and up to FL_TS() - 1 drafted after it)
skill FL_TS() -> Any { return 4 }
# the expert cache: pool A for the 43 layers whose experts are 2.33 MB (IQ3_S, IQ3_S, IQ4_NL), pool B for the five
# larger ones (layers 2, 4, 30, 46, 47: up to 3.48 MB)
skill FL_NA() -> Any { return 8800 }
skill FL_SA() -> Any { return 2329600 }
skill FL_NB() -> Any { return 900 }
skill FL_SB() -> Any { return 3481600 }
skill FL_HB() -> Any { return 67108864 }
# the PLE hash constants (qwen4exp.ple.* in the GGUF's metadata)
skill FL_MULT() -> Any { return [23703573157769, 20109073645365, 8052911324071] }
skill FL_OFFS() -> Any { return [0, 20000003, 40000026, 60000059, 80000106, 100000165, 120000228, 140000297, 160000374, 180000455, 200000548, 220000655, 240000802, 260000955, 280001114, 300001275] }
skill FL_VOCS() -> Any { return [20000003, 20000023, 20000033, 20000047, 20000059, 20000063, 20000069, 20000077, 20000081, 20000093, 20000107, 20000147, 20000153, 20000159, 20000161, 20000171] }
skill FL_EOS() -> Any { return 248044 }

skill fl_bytes(t) -> Any {
  let rows = 1
  for d in slice(t[3], 1, len(t[3])) { rows = rows * d }
  return rows * fg_rowbytes(t[2], t[3][0])
}

# the model: tensors (name -> [path, file offset, type, dims]), the dense ones on the GPU, kernels, buffers, the cache
skill fl_open() -> Any {
  let r = rt_gpu_open()
  if r != 1 { return "gpu open failed " ++ str(r) }
  let fs = fg_kernels()
  if typeof(fs) == "text" { return fs }
  let tm = {}
  let fh = {}
  let fho = {}
  // the shards mapped too: a token's embedding row and n-gram rows are read straight from memory, no file opened
  let fm = {}
  for p in FL_SHARDS() {
    let m = open_model(p)
    for t in m[0] { tm[t[0]] = [p, m[1] + t[3], t[2], t[1]] }
    fh[p] = rt_fopen_r(p)
    fm[p] = rt_fmap(p)
    // (out\flash_seqread.flag: without the random-access hint, for comparing)
    fho[p] = if read_file("out\\flash_seqread.flag") != null { rt_fopen_ov(p) } else { rt_fopen_ovr(p) }
    if fh[p] == null { return "cannot open " ++ p }
  }
  // one page-locked buffer for every read from the shards
  let hb = rt_host_alloc(FL_HB())
  if hb < 0 { return "pinned host buffer failed" }
  let w = {}
  let up = 0
  for nm in keys(tm) {
    let t = tm[nm]
    if not contains(nm, "_exps") and not contains(nm, "token_embd") {
      let n = fl_bytes(t)
      if n <= 0 { return "no row size for " ++ nm ++ " (type " ++ str(t[2]) ++ ")" }
      let d = rt_gpu_alloc(n)
      if d < 0 { return "gpu alloc failed for " ++ nm }
      let got = rt_gpu_fread(d, fh[t[0]], t[1], n, hb, FL_HB())
      if got != n { return "short read of " ++ nm }
      w[nm] = d
      up += n
    }
  }
  let T = FL_TMAX()
  let P = FL_MAXPOS()
  let sizes = [["RES", T * 10240], ["XN", T * 10240], ["LO", T * 320], ["G", T * 10240], ["CUR", T * 2560], ["INJ", T * 16], ["QF", T * 12288], ["K", T * 512], ["V", T * 512], ["Q", T * 6144], ["O", T * 6144], ["MIX", T * 10240], ["Z", T * 6144], ["BA", T * 48], ["AL", T * 48], ["CV", T * 10240], ["FIN", T * 6144], ["OUT", T * 2560], ["LG", T * 512], ["E", T * 10], ["W", T * 10], ["H1", T * 12800], ["H2", T * 6400], ["D", T * 25600], ["SHG", T * 1280], ["SHU", T * 640], ["SHD", T * 2560], ["SG", T], ["MO", T * 2560], ["ROPE", T * 64], ["LOGITS", 248320 * FL_TS()], ["SC", T * 24 * P], ["KC", 12 * P * 256], ["VC", 12 * P * 256], ["HIST", 48 * 3 * 10240], ["EMB", T * 2560], ["PK", T * 10240], ["PV", T * 2560], ["PQ", T * 10240], ["PG", T * 10240], ["PX", T * 10240], ["PH", 9 * 10240], ["TAB", 3 * T * 10], ["RT", P * 64], ["IK", 12 * P * 128], ["QPK", 12 * (P // 4) * 128], ["IQ", T * 512], ["IQN", T * 512], ["SB", T * (P // 4)], ["SEL", T * (P // 4)], ["RAW", T * 344], ["PRAW", T * 180]]
  let ws = {}
  for sz in sizes {
    let p = rt_gpu_alloc(8 * sz[1])
    if p < 0 { return "gpu alloc failed for " ++ sz[0] }
    ws[sz[0]] = p
  }
  // the router's choice (and the head's best token) in mapped host memory: read after the sync with no copy call
  let em = rt_host_mapped(8 * T * 10)
  if em == null { return "mapped host buffer failed" }
  ws["E"] = em[1]
  // the position for the recorded passes: written by the host in mapped memory (POSH), copied by posget to POSD
  let ph = rt_host_mapped(8)
  ws["POSH"] = ph[1]
  ws["POSD"] = rt_gpu_alloc(8)
  ws["IKT"] = rt_gpu_alloc(8 * 128)
  // the slot tables go up asynchronously from page-locked memory, one region a layer
  let tabh = rt_host_alloc(48 * 3 * T * 10 * 8)
  // experiment (out\flash_pregate.flag): layer L + 1's router run on layer L's MoE input, to measure how well the
  // next layer's experts can be known a layer early -> [E2 host, E2 device, LG2, W2, stats, prediction]
  let pg = null
  if read_file("out\\flash_pregate.flag") != null {
    let e2 = rt_host_mapped(8 * T * 10)
    pg = [e2[0], e2[1], rt_gpu_alloc(8 * T * 512), rt_gpu_alloc(8 * T * 10), arr(6), arr(10)]
  }
  if tabh < 0 { return "pinned table buffer failed" }
  // the rope angles of every position, once: RT[p][i] = [cos, sin] of p * 1e7^(-2i/64), i < 32
  let rt = []
  for pos in range(0, P) {
    for i in range(0, 32) {
      let th = (pos * 1.0) * exp(0.0 - (2.0 * i / 64.0) * log(10000000.0))
      rt ++= [cos(th), sin(th)]
    }
  }
  rt_gpu_put(ws["RT"], rt)
  // the delta-net states: 48 layers x 48 heads x 128 x 128 float32
  ws["S"] = rt_gpu_alloc(48 * 48 * 16384 * 4)
  // a verify pass's checkpoints: the recurrent states after each of its first FL_TS() - 1 tokens (S, the conv
  // histories), so a draft rejected after token t costs one copy back, not a second pass
  ws["SCK"] = rt_gpu_alloc((FL_TS() - 1) * 48 * 48 * 16384 * 4)
  ws["HCK"] = rt_gpu_alloc((FL_TS() - 1) * 8 * 48 * 3 * 10240)
  ws["PCK"] = rt_gpu_alloc((FL_TS() - 1) * 8 * 9 * 10240)
  if ws["SCK"] < 0 or ws["HCK"] < 0 or ws["PCK"] < 0 { return "gpu alloc failed for the verify checkpoints" }
  // the weights by layer (lt[L]["attn_q.weight"]) and the rest (gt): no name is built or searched per pass. A dense
  // weight is [gpu address, type, row bytes, n, rows]; an expert tensor or a host one keeps [path, offset, type, dims]
  let lt = []
  for L in range(0, 48) { lt ++= [{}] }
  let gt = {}
  for nm in keys(tm) {
    let t = tm[nm]
    let e = t
    if w[nm] != null { e = [w[nm], t[2], fg_rowbytes(t[2], t[3][0]), t[3][0], if len(t[3]) > 1 { t[3][1] } else { 1 }] }
    let ps = split(nm, ".")
    if ps[0] == "blk" {
      let L = int(ps[1])
      lt[L] = put(lt[L], join(slice(ps, 2, len(ps)), "."), e)
    } else {
      gt[nm] = e
    }
  }
  // matrices that read the same input, side by side once (originals freed): the shared expert's gate and up
  // (shgu, 1280 rows) and the router with the shared expert's gate scalar (rtg, 513 rows) -- one launch each at T = 1
  for L in range(0, 48) {
    let g = lt[L]["ffn_gate_shexp.weight"]
    let u = lt[L]["ffn_up_shexp.weight"]
    if g[1] == u[1] and g[2] == u[2] and g[4] == u[4] {
      let f = rt_gpu_alloc(g[2] * (g[4] + u[4]))
      if f >= 0 {
        rt_gpu_copy(f, g[0], g[2] * g[4])
        rt_gpu_copy(f + g[2] * g[4], u[0], u[2] * u[4])
        rt_gpu_free(g[0])
        rt_gpu_free(u[0])
        lt[L] = put(put(put(lt[L], "ffn_gate_shexp.weight", [f, g[1], g[2], g[3], g[4]]), "ffn_up_shexp.weight", [f + g[2] * g[4], u[1], u[2], u[3], u[4]]), "shgu", [f, g[1], g[2], g[3], g[4] + u[4]])
      }
    }
    let r = lt[L]["ffn_gate_inp.weight"]
    let q = lt[L]["ffn_gate_inp_shexp.weight"]
    if r[1] == q[1] and r[2] == q[2] {
      let f = rt_gpu_alloc(r[2] * (r[4] + q[4]))
      if f >= 0 {
        rt_gpu_copy(f, r[0], r[2] * r[4])
        rt_gpu_copy(f + r[2] * r[4], q[0], q[2] * q[4])
        rt_gpu_free(r[0])
        rt_gpu_free(q[0])
        lt[L] = put(put(put(lt[L], "ffn_gate_inp.weight", [f, r[1], r[2], r[3], r[4]]), "ffn_gate_inp_shexp.weight", [f + r[2] * r[4], q[1], q[2], q[3], q[4]]), "rtg", [f, r[1], r[2], r[3], r[4] + q[4]])
      }
    }
  }
  let pb = rt_gpu_alloc(FL_NB() * FL_SB())
  // pool A takes the VRAM that is left (less a reserve for the graphs and the last small buffers)
  let na = (rt_gpu_meminfo()[0] - 400 * 1048576) // FL_SA()
  if na > 16000 { na = 16000 }
  if na < 2000 { return "too little VRAM for the expert cache: " ++ str(na) ++ " slots" }
  let pa = rt_gpu_alloc(na * FL_SA())
  if pa < 0 or pb < 0 { return "gpu alloc failed for the expert cache" }
  let slot_of = arr(48 * 512)
  for i in range(0, 48 * 512) { aset(slot_of, i, 0 - 1) }
  // the same index for the GPU (slotmap), in mapped memory: int32 a key, written only when a miss moves an expert
  let som = rt_host_mapped(48 * 512 * 4)
  if som == null { return "mapped slot index failed" }
  for i in range(0, 48 * 512) { rt_host_put32(som[0] + 4 * i, 0 - 1) }
  let owner = arr(na + FL_NB())
  for i in range(0, na + FL_NB()) { aset(owner, i, 0 - 1) }
  // [hand in A, misses, hits, hand in B, layer-call counter]
  let ctr = arr(5)
  let ref = arr(na + FL_NB())
  let stamp = arr(na + FL_NB())
  let st = rt_gpu_stream()
  if st < 0 { return "gpu stream failed " ++ str(st) }
  // one event a layer, recorded in the graphs right after its router: the host waits for that, not for the GPU
  let evs = []
  for L in range(0, 48) { evs ++= [rt_gpu_event()] }
  let fl = {"t": tm, "w": w, "fs": fs, "ws": ws, "pa": pa, "pb": pb, "slot_of": slot_of, "owner": owner, "ctr": ctr, "ref": ref, "stamp": stamp, "dense": up, "fh": fh, "fho": fho, "fm": fm, "hb": hb, "prof": arr(12), "lt": lt, "gt": gt, "verify": read_file("out\\flash_verify.flag") != null, "st": st, "na": na, "evs": evs, "eh": em[0], "som": som, "posh": ph[0], "dp": arr(1), "tabh": tabh, "pg": pg, "lx": fl_lx(lt), "spec": arr(1), "elog": if read_file("out\\flash_elog.flag") != null { arr(20000001) } else { null }, "kp": if read_file("out\\flash_kprof.flag") != null { arr(2 * 4093) } else { null }}
  fl = put(fl, "bk", [slot_of, owner, ctr, ref, stamp, fh, hb, som[0], fl["elog"], fl["verify"], em[0], fl["lx"], fl["prof"], arr(1), na])
  // the decode pass compiled once into graphs (out\flash_nograph.flag: every launch live, for comparison)
  let u0 = rt_usec()
  let g = fl_capture(fl)
  fl = put(fl, "g", g)
  fl = put(fl, "gus", rt_usec() - u0)
  fl_reset(fl)
  return fl
}

// after a verify pass that kept only its tokens 0 .. t (t < T - 1): the recurrent states as they were after token t
skill fl_rollback(fl, t) -> Any {
  let ws = fl["ws"]
  rt_gpu_copy(ws["S"], ws["SCK"] + t * 48 * 48 * 16384 * 4, 48 * 48 * 16384 * 4)
  rt_gpu_copy(ws["HIST"], ws["HCK"] + t * 8 * 48 * 3 * 10240, 8 * 48 * 3 * 10240)
  rt_gpu_copy(ws["PH"], ws["PCK"] + t * 8 * 9 * 10240, 8 * 9 * 10240)
  return t
}

// a new sequence: states and histories to zero
skill fl_reset(fl) -> Any {
  let ws = fl["ws"]
  rt_gpu_zero(ws["S"], 48 * 48 * 16384 * 4)
  rt_gpu_zero(ws["HIST"], 8 * 48 * 3 * 10240)
  rt_gpu_zero(ws["PH"], 8 * 9 * 10240)
  return 0
}

skill fl_f16(lo, hi) -> Any {
  let h = lo + 256 * hi
  let s = if h >= 32768 { 0.0 - 1.0 } else { 1.0 }
  let e = (h // 1024) % 32
  let m = h % 1024
  if e == 0 { return s * m * (2.0 ^ (0 - 24)) }
  return s * (1.0 + m / 1024.0) * (2.0 ^ (e - 15))
}

// token tok's embedding row (Q8_0 [2560]) -> 2560 reals
skill fl_embed(fl, tok) -> Any {
  let t = fl["gt"]["token_embd.weight"]
  let b = read_bytes(t[0], t[1] + tok * 2720, 2720)
  let out = []
  for k in range(0, 80) {
    let d = fl_f16(aget(b, 34 * k), aget(b, 34 * k + 1))
    for j in range(0, 32) {
      let q = aget(b, 34 * k + 2 + j)
      if q >= 128 { q = q - 256 }
      out ++= [d * q]
    }
  }
  return out
}

skill fl_kv() -> Any { return [0 - 127, 0 - 104, 0 - 83, 0 - 65, 0 - 49, 0 - 35, 0 - 22, 0 - 10, 1, 13, 25, 38, 53, 69, 89, 113] }

// row r of the n-gram table (IQ4_NL [160]) -> 160 reals
skill fl_plerow(fl, r) -> Any {
  let t = fl["gt"]["per_layer_token_embd.weight"]
  let b = read_bytes(t[0], t[1] + r * 90, 90)
  let kv = fl_kv()
  let out = []
  for k in range(0, 5) {
    let d = fl_f16(aget(b, 18 * k), aget(b, 18 * k + 1))
    let lo = []
    let hi = []
    for j in range(0, 16) {
      let q = aget(b, 18 * k + 2 + j)
      lo ++= [d * kv[q % 16]]
      hi ++= [d * kv[q // 16]]
    }
    out = out ++ lo ++ hi
  }
  return out
}

skill fl_xor(a, b) -> Any {
  let r = 0
  let p = 1
  let x = a
  let y = b
  while x > 0 or y > 0 {
    if x % 2 != y % 2 { r += p }
    x = x // 2
    y = y // 2
    p = p * 2
  }
  return r
}

// the 16 n-gram rows of token i of toks (the window before the sequence start, or after an EOS, reads as EOS)
skill fl_plerows(toks, i) -> Any {
  let ctx = [toks[i]]
  let cut = false
  for s in [1, 2] {
    let t = if i - s >= 0 { toks[i - s] } else { 0 - 1 }
    if t < 0 or t == FL_EOS() { cut = true }
    ctx ++= [if cut { FL_EOS() } else { t }]
  }
  let mult = FL_MULT()
  let rows = []
  for n in [2, 3] {
    let mixed = ctx[0] * mult[0]
    for j in range(1, n) { mixed = fl_xor(mixed, ctx[j] * mult[j]) }
    for g in range(0, 8) {
      let h = (n - 2) * 8 + g
      rows ++= [mixed % FL_VOCS()[h] + FL_OFFS()[h]]
    }
  }
  return rows
}

// a weight from a table: [gpu address, type, row bytes, n, rows]
// every launch goes on the engine's own stream (a blocking one: host copies on the default stream stay in order
// with it), so any run of launches can be recorded as a graph
skill fl_mvt(fl, e, x, y, nv) -> Any {
  if fl["kp"] == null { return fg_mvw(fl["fs"], e[0], e[1], e[2], e[3], e[4], x, y, nv, fl["st"]) }
  let u0 = fl_kp0(fl)
  let r = fg_mvw(fl["fs"], e[0], e[1], e[2], e[3], e[4], x, y, nv, fl["st"])
  fl_kp1(fl, "mv type " ++ str(e[1]) ++ " " ++ str(e[3]) ++ " -> " ++ str(e[4]) ++ " x" ++ str(nv), u0)
  return r
}

// kernel profile (out\flash_kprof.flag; launches live, no graphs): each launch waited for and timed, by label. A
// label's slot is a hash; its name is written to out\kp_<slot>.txt the first time
skill fl_kp0(fl) -> Any {
  if fl["kp"] == null { return 0 }
  rt_gpu_sync()
  return rt_usec()
}

skill fl_kp1(fl, label, u0) -> Any {
  let kp = fl["kp"]
  if kp == null { return 0 }
  rt_gpu_sync()
  let dt = rt_usec() - u0
  let h = 0
  for c in chars(label) { h = (h * 131 + ord(c)) % 4093 }
  if aget(kp, 2 * h + 1) == 0 { write_file("out\\kp_" ++ str(h) ++ ".txt", label) }
  aset(kp, 2 * h, aget(kp, 2 * h) + dt)
  aset(kp, 2 * h + 1, aget(kp, 2 * h + 1) + 1)
  return 0
}

// the profile so far, per pass, largest first -> lines
skill fl_kp_report(fl, passes) -> Any {
  let kp = fl["kp"]
  let rows = []
  let total = 0
  for h in range(0, 4093) {
    if aget(kp, 2 * h + 1) > 0 {
      rows ++= [[aget(kp, 2 * h), aget(kp, 2 * h + 1), read_file("out\\kp_" ++ str(h) ++ ".txt")]]
      total += aget(kp, 2 * h)
    }
  }
  let out = ["kernel time per pass (us, each launch waited for): total " ++ str(total // passes)]
  let left = rows
  while len(left) > 0 {
    let b = 0
    for i in range(1, len(left)) {
      if left[i][0] > left[b][0] { b = i }
    }
    let r = left[b]
    out ++= [format("{:>8}", str(r[0] // passes)) ++ "  " ++ format("{:>5}", str(r[1] // passes)) ++ "x  " ++ r[2]]
    left = slice(left, 0, b) ++ slice(left, b + 1, len(left))
  }
  return out
}

skill fl_kp_zero(fl) -> Any {
  let kp = fl["kp"]
  if kp == null { return 0 }
  for i in range(0, 2 * 4093) { aset(kp, i, 0) }
  return 0
}

skill fl_mv(fl, name, x, y, nv) -> Any {
  let t = fl["t"][name]
  let n = t[3][0]
  let rows = if len(t[3]) > 1 { t[3][1] } else { 1 }
  return fg_mv(fl["fs"], fl["w"][name], t[2], fg_rowbytes(t[2], n), n, rows, x, y, nv, fl["st"])
}

skill fl_go(fl, k, g, b, ps) -> Any {
  if fl["kp"] == null { return ge_go(fl["fs"], k, g, b, ps, fl["st"]) }
  let u0 = fl_kp0(fl)
  let r = ge_go(fl["fs"], k, g, b, ps, fl["st"])
  fl_kp1(fl, k, u0)
  return r
}

// the hyper-connection mix of RES with the weights at prefix p -> CUR (and INJ when inject)
skill fl_hcmix(fl, LT, p, T, inject) -> Any {
  let ws = fl["ws"]
  let w = fl["w"]
  // the inject's 4 x 10240 dot products ride in the norm (each stream's block adds its part; hccomb sums them):
  // as a matvec of its own they were 4 rows for a whole GPU, ~30 us of waiting, twice a layer
  if inject {
    fl_go(fl, "hcnormi", T * 4, 256, [ws["RES"], LT[p ++ "norm.weight"][0], ws["XN"], LT[p ++ "inject.weight"][0], ws["INJ"], 2560, 4])
  } else {
    fl_go(fl, "hcnorm", T * 4, 256, [ws["RES"], LT[p ++ "norm.weight"][0], ws["XN"], 2560, 4])
  }
  fl_mvt(fl, LT[p ++ "down.weight"], ws["XN"], ws["LO"], T)
  fl_go(fl, "act", (T * 320 + 255) // 256, 256, [ws["LO"], 0, ws["LO"], T * 320, 1])
  fl_mvt(fl, LT[p ++ "up.weight"], ws["LO"], ws["G"], T)
  fl_go(fl, "hcmix", (T * 2560 + 255) // 256, 256, [ws["XN"], ws["G"], ws["CUR"], T * 2560])
  return 0
}

skill fl_rope(fl, pos0, T) -> Any {
  let r = []
  for t in range(0, T) {
    let pos = (pos0 + t) * 1.0
    for i in range(0, 32) {
      let th = pos * exp(0.0 - (2.0 * i / 64.0) * log(10000000.0))
      r ++= [cos(th), sin(th)]
    }
  }
  return rt_gpu_put(fl["ws"]["ROPE"], r)
}

// the experts the router chose for this layer, into cache slots -> the three slot tables (gate, up, down rows)
// each layer's expert tensors and their per-expert byte counts, once: [gate, up, down, bg, bu, bd]
skill fl_lx(lt) -> Any {
  let out = []
  for L in range(0, 48) {
    let LT = lt[L]
    let tg = LT["ffn_gate_exps.weight"]
    let tu = LT["ffn_up_exps.weight"]
    let td = LT["ffn_down_exps.weight"]
    out ++= [[tg, tu, td, fl_bytes(tg) // 512, fl_bytes(tu) // 512, fl_bytes(td) // 512]]
  }
  return out
}

// the profile's clock: only when profiling is on (bk[13]; flashchat bench), else 0 -- 300 reads a token cost time
skill fl_us(on) -> Any {
  if aget(on, 0) == 1 { return rt_usec() }
  return 0
}

skill fl_experts(fl, L, T) -> Any {
  // every handle from one list (fl["bk"]): a map lookup walks ~45 keys, and this runs 48 times a token
  let bk = fl["bk"]
  let ub0 = fl_us(bk[13])
  let es = rt_host_get(bk[10], T * 10)
  let ub1 = fl_us(bk[13])
  let lx = bk[11][L]
  let tg = lx[0]
  let tu = lx[1]
  let td = lx[2]
  let bg = lx[3]
  let bu = lx[4]
  let bd = lx[5]
  let so = bk[0]
  let ow = bk[1]
  let ctr = bk[2]
  let big = bg + bu + bd > FL_SA()
  // CLOCK: a hit sets the slot's referenced bit; the hand skips (and clears) referenced slots, and never takes a
  // slot this layer is using -- a plain ring once evicted an expert a moment after this same layer had hit it,
  // so two of the layer's experts ran with one expert's weights
  let ref = bk[3]
  let stamp = bk[4]
  let somh = bk[7]
  let verify = bk[9]
  let cur = aget(ctr, 4) + 1
  aset(ctr, 4, cur)
  let tab = []
  let pend = []
  let pend_bytes = 0
  // out\flash_elog.flag: every lookup's key logged (fl["elog"]: count, then keys), for replaying cache policies
  let elog = bk[8]
  for k in range(0, T * 10) {
    let e = int(es[k])
    let key = L * 512 + e
    if elog != null and aget(elog, 0) < 20000000 {
      aset(elog, aget(elog, 0) + 1, key)
      aset(elog, 0, aget(elog, 0) + 1)
    }
    let s = aget(so, key)
    if s >= 0 {
      aset(ref, s, 1)
      aset(stamp, s, cur)
    }
    if s < 0 {
      let base0 = if big { bk[14] } else { 0 }
      let n0 = if big { FL_NB() } else { bk[14] }
      let hi = if big { 3 } else { 0 }
      let found = false
      let tries = 0
      while not found {
        let c = base0 + aget(ctr, hi)
        aset(ctr, hi, (aget(ctr, hi) + 1) % n0)
        tries += 1
        if aget(stamp, c) != cur {
          if aget(ref, c) == 1 and tries < 2 * n0 {
            aset(ref, c, 0)
          } else {
            s = c
            found = true
          }
        }
        if tries > 3 * n0 { return "the expert cache is too small for one layer's experts" }
      }
      aset(stamp, s, cur)
      aset(ref, s, 0)
      let old = aget(ow, s)
      if old >= 0 {
        aset(so, old, 0 - 1)
        rt_host_put32(somh + 4 * old, 0 - 1)
      }
      aset(ow, s, key)
      aset(so, key, s)
      rt_host_put32(somh + 4 * key, s)
      let base = fl_slot(fl, s)
      // the three parts are queued; the queue is read all at once (overlapped) when the pinned buffer is full
      if pend_bytes + bg + bu + bd > FL_HB() {
        fl_flush(fl, pend)
        pend = []
        pend_bytes = 0
      }
      // each part in pieces of at most FL_PIECE() bytes: more reads in flight, which an NVMe drive serves faster
      pend = pend ++ fl_pieces(tg[0], tg[1] + e * bg, bg, pend_bytes, base) ++ fl_pieces(tu[0], tu[1] + e * bu, bu, pend_bytes + bg, base + bg) ++ fl_pieces(td[0], td[1] + e * bd, bd, pend_bytes + bg + bu, base + bg + bu)
      pend_bytes += bg + bu + bd
      aset(ctr, 1, aget(ctr, 1) + 1)
    } else {
      aset(ctr, 2, aget(ctr, 2) + 1)
    }
    // debug: the slot must hold this expert now (its first 4 KB of the gate part against the file)
    if verify {
      let parts = [[0, tg, bg], [bg, tu, bu], [bg + bu, td, bd]]
      for pt in parts {
        // layer 39 is checked through (every 4 KB), the others at their two ends
        let ats = [0, pt[2] - 4096]
        if L == 39 { ats = map(range(0, pt[2] // 4096), fn(i) => i * 4096) ++ [pt[2] - 4096] }
        for at in ats {
          let mm = mark()
          rt_gpu_sync()
          rt_gpu_dump(fl_slot(fl, s) + pt[0] + at, 4096, "out\\slotchk.bin")
          let g = read_bytes("out\\slotchk.bin", 0, 4096)
          let f = read_bytes(pt[1][0], pt[1][1] + e * pt[2] + at, 4096)
          let same = true
          for i in range(0, 4096) {
            if aget(g, i) != aget(f, i) { same = false }
          }
          release(mm, 0)
          if not same { print("STALE: layer " ++ str(L) ++ " expert " ++ str(e) ++ " slot " ++ str(s) ++ " part at " ++ str(pt[0]) ++ " +" ++ str(at) ++ " owner " ++ str(aget(ow, s)) ++ " key " ++ str(key)) }
        }
      }
    }
  }
  if len(pend) > 0 { fl_flush(fl, pend) }
  aset(bk[12], 2, aget(bk[12], 2) + fl_flushed(fl))
  // (the slot table itself is made on the GPU by slotmap, from E and the mapped index)
  let ub2 = fl_us(bk[13])
  let pr = bk[12]
  aset(pr, 8, aget(pr, 8) + ub1 - ub0)
  aset(pr, 9, aget(pr, 9) + ub2 - ub1)
  aset(pr, 10, aget(pr, 10) + fl_us(bk[13]) - ub2)
  return [tg, tu, td]
}

// a check of the cache: for every step-th slot in use, its three parts on the GPU against the file -> [checked, bad]
skill fl_check(fl, step) -> Any {
  let ow = fl["owner"]
  let checked = 0
  let bad = []
  let s = 0
  while s < fl["na"] + FL_NB() {
    let key = aget(ow, s)
    if key >= 0 {
      let L = key // 512
      let e = key % 512
      let P = "blk." ++ str(L) ++ "."
      let off = 0
      for kind in ["ffn_gate_exps", "ffn_up_exps", "ffn_down_exps"] {
        let t = fl["t"][P ++ kind ++ ".weight"]
        let b = fl_bytes(t) // 512
        let n = min(b, 65536)
        let mm = mark()
        rt_gpu_sync()
        rt_gpu_dump(fl_slot(fl, s) + off, n, "out\\slotchk.bin")
        let g = read_bytes("out\\slotchk.bin", 0, n)
        let f = read_bytes(t[0], t[1] + e * b, n)
        let same = true
        let i = 0
        while i < n and same {
          if aget(g, i) != aget(f, i) { same = false }
          i += 1
        }
        release(mm, 0)
        if not same { bad ++= [[s, L, e, kind]] }
        off += b
      }
      checked += 1
    }
    s += step
  }
  return [checked, bad]
}

skill FL_PIECE() -> Any { return 4194304 }

// one read [path, offset, bytes, buffer offset, gpu destination] as pieces of at most FL_PIECE() bytes
skill fl_pieces(path, off, n, bo, dst) -> Any {
  let out = []
  let k = 0
  let pc = FL_PIECE()
  while k < n {
    let m = min(pc, n - k)
    out ++= [[path, off + k, m, bo + k, dst + k]]
    k += m
  }
  return out
}

// the queued expert reads [path, file offset, bytes, buffer offset, gpu destination], each shard's at once
skill fl_flushed(fl) -> Any {
  let v = aget(fl["prof"], 5)
  aset(fl["prof"], 5, 0)
  return v
}

skill fl_flush(fl, pend) -> Any {
  let u0 = rt_usec()
  for p in FL_SHARDS() {
    let reqs = []
    for q in pend {
      if q[0] == p { reqs ++= [[q[1], q[2], q[3], q[4]]] }
    }
    if len(reqs) > 0 { rt_read_batch(fl["fho"][p], reqs, fl["hb"]) }
  }
  aset(fl["prof"], 5, aget(fl["prof"], 5) + rt_usec() - u0)
  return 0
}

skill fl_slot(fl, s) -> Any {
  if s < fl["na"] { return fl["pa"] + s * FL_SA() }
  return fl["pb"] + (s - fl["na"]) * FL_SB()
}

// QSA for attention layer number ai (blk prefix P): the raw indexer keys of these T tokens into IK, the blocks they
// complete pooled into PK; when some query sees more than 512 complete blocks (past ~2048 tokens), its 512 best
// blocks are chosen -> the selection SEL (else 0: every visible cell counts, which is exact up to there)
// fl_qsa for one token at the position in POSD (recorded once): the key into IK through IKT, the pool when a block
// completes, and the sparse selection, which does nothing while attention is still dense
skill fl_qsa_d(fl, LT, ai) -> Any {
  let ws = fl["ws"]
  let MP = FL_MAXPOS()
  let pd = ws["POSD"]
  let ik = ws["IK"] + ai * MP * 128 * 8
  let pk = ws["QPK"] + ai * (MP // 4) * 128 * 8
  fl_mvt(fl, LT["indexer.k_proj.weight"], ws["CUR"], ws["IKT"], 1)
  fl_go(fl, "ikput_d", 1, 128, [ws["IKT"], ik, pd])
  fl_go(fl, "qsapool_d", 1, 128, [ik, LT["indexer.k_norm.weight"][0], ws["RT"], pk, pd, 0])
  fl_mvt(fl, LT["indexer.q_proj.weight"], ws["CUR"], ws["IQ"], 1)
  fl_go(fl, "qsaq_d", 4, 128, [ws["IQ"], LT["indexer.q_norm.weight"][0], ws["RT"], ws["IQN"], pd, 0])
  fl_go(fl, "qsascore_d", (MP // 4 + 255) // 256, 256, [ws["IQN"], pk, ws["SB"], pd, 0, 0, 1])
  fl_go(fl, "qsasel_d", 1, 256, [ws["SB"], ws["SEL"], pd, 0, 512])
  return 0
}

skill fl_qsa(fl, LT, ai, pos0, T) -> Any {
  let ws = fl["ws"]
  let w = fl["w"]
  let MP = FL_MAXPOS()
  let ik = ws["IK"] + ai * MP * 128 * 8
  let pk = ws["QPK"] + ai * (MP // 4) * 128 * 8
  fl_mvt(fl, LT["indexer.k_proj.weight"], ws["CUR"], ik + pos0 * 128 * 8, T)
  let b0 = pos0 // 4
  let b1 = (pos0 + T) // 4
  if b1 > b0 { fl_go(fl, "qsapool", b1 - b0, 128, [ik, LT["indexer.k_norm.weight"][0], ws["RT"], pk, b0]) }
  if ai == 0 and read_file("out\\flash_qsadump.flag") != null {
    let mm = mark()
    rt_gpu_sync()
    rt_gpu_dump(ik, 8 * (pos0 + T) * 128, "out\\qsa_IK" ++ str(pos0) ++ ".bin")
    rt_gpu_dump(pk, 8 * b1 * 128, "out\\qsa_PK" ++ str(pos0) ++ ".bin")
    release(mm, 0)
  }
  if b1 <= 512 { return 0 }
  fl_mvt(fl, LT["indexer.q_proj.weight"], ws["CUR"], ws["IQ"], T)
  fl_go(fl, "qsaq", T * 4, 128, [ws["IQ"], LT["indexer.q_norm.weight"][0], ws["RT"], ws["IQN"], pos0])
  fl_go(fl, "qsascore", (T * b1 + 255) // 256, 256, [ws["IQN"], pk, ws["SB"], b1, pos0, T])
  fl_go(fl, "qsasel", T, 256, [ws["SB"], ws["SEL"], b1, 512])
  // debug (out\flash_qsadump.flag): the first attention layer's indexer state of this call, for a numpy check
  if ai == 0 and read_file("out\\flash_qsadump.flag") != null {
    let mm = mark()
    rt_gpu_sync()
    rt_gpu_dump(ik, 8 * (pos0 + T) * 128, "out\\qsa_IK.bin")
    rt_gpu_dump(ws["IQ"], 8 * T * 512, "out\\qsa_IQ.bin")
    rt_gpu_dump(ws["SB"], 8 * T * b1, "out\\qsa_SB.bin")
    rt_gpu_dump(ws["SEL"], 8 * T * b1, "out\\qsa_SEL.bin")
    rt_gpu_dump(pk, 8 * b1 * 128, "out\\qsa_PK.bin")
    rt_gpu_dump(ws["IQN"], 8 * T * 512, "out\\qsa_IQN.bin")
    write_file("out\\qsa_meta.txt", str(pos0) ++ " " ++ str(T) ++ " " ++ str(b1))
    release(mm, 0)
  }
  return ws["SEL"]
}

skill fl_gg(g, st) -> Any {
  let rc = rt_gpu_graph_go(g, st)
  if rc != 0 { do fail("graph launch failed " ++ str(rc)) }
  return rc
}

// the router's choice is read on the host: wait for the GPU, then put the layer's experts in the cache and the table
// (recorded passes) the host waits only until layer L's router has run; the shared expert goes on meanwhile
skill fl_route_host_ev(fl, L) -> Any {
  let pr = fl["bk"][12]
  let pon = fl["bk"][13]
  let u0 = fl_us(pon)
  let rcw = rt_gpu_event_wait(fl["evs"][L])
  if rcw != 0 { do fail("event wait failed " ++ str(rcw) ++ " at layer " ++ str(L)) }
  let u1 = fl_us(pon)
  fl_experts(fl, L, 1)
  aset(pr, 0, aget(pr, 0) + u1 - u0)
  aset(pr, 1, aget(pr, 1) + fl_us(pon) - u1)
  return 0
}

skill fl_route_host(fl, L, T) -> Any {
  let pr = fl["prof"]
  let u0 = rt_usec()
  rt_gpu_sync()
  let u1 = rt_usec()
  let pg = fl["pg"]
  if pg != null and T == 1 {
    // this layer's real choice against the guess made a layer early: [layers, overlap, misses, misses guessed]
    let st = pg[4]
    let es = rt_host_get(fl["eh"], 10)
    let pred = pg[5]
    for k in range(0, 10) {
      let e = int(es[k])
      let guessed = false
      if L > 0 {
        for j in range(0, 10) {
          if aget(pred, j) == e { guessed = true }
        }
      }
      if L > 0 and guessed { aset(st, 1, aget(st, 1) + 1) }
      if L > 0 and aget(fl["slot_of"], L * 512 + e) < 0 {
        aset(st, 2, aget(st, 2) + 1)
        if guessed { aset(st, 3, aget(st, 3) + 1) }
      }
    }
    if L > 0 { aset(st, 0, aget(st, 0) + 1) }
    let g = rt_host_get(pg[0], 10)
    for j in range(0, 10) { aset(pred, j, int(g[j])) }
  }
  fl_experts(fl, L, T)
  aset(pr, 0, aget(pr, 0) + u1 - u0)
  aset(pr, 1, aget(pr, 1) + rt_usec() - u1)
  return 0
}

// segment B of layer L: the chosen experts (through the slot table), the shared expert, their sum, the combine.
// Nothing in it depends on the position, so at T = 1 it is one recorded graph.
// layer L's shared expert (CUR -> SHD): it does not need the router's choice, so in the recorded passes it runs
// right after the router, while the host reads that choice
skill fl_shexp(fl, L, T) -> Any {
  let ws = fl["ws"]
  let LT = fl["lt"][L]
  if T == 1 and LT["shgu"] != null {
    fl_mvt(fl, LT["shgu"], ws["CUR"], ws["SHG"], 1)
    fl_go(fl, "act", 3, 256, [ws["SHG"], ws["SHG"] + 8 * 640, ws["SHG"], 640, 2])
  } else {
    fl_mvt(fl, LT["ffn_gate_shexp.weight"], ws["CUR"], ws["SHG"], T)
    fl_mvt(fl, LT["ffn_up_shexp.weight"], ws["CUR"], ws["SHU"], T)
    fl_go(fl, "act", (T * 640 + 255) // 256, 256, [ws["SHG"], ws["SHU"], ws["SHG"], T * 640, 2])
  }
  fl_mvt(fl, LT["ffn_down_shexp.weight"], ws["SHG"], ws["SHD"], T)
  return 0
}

skill fl_segB(fl, L, T) -> Any { return fl_segBx(fl, L, T, true) }

skill fl_segBx(fl, L, T, shx) -> Any {
  let ws = fl["ws"]
  let LT = fl["lt"][L]
  let fs = fl["fs"]
  let st = fl["st"]
  let tg = LT["ffn_gate_exps.weight"][2]
  let tu = LT["ffn_up_exps.weight"][2]
  let td = LT["ffn_down_exps.weight"][2]
  let n = T * 10
  let tab = ws["TAB"]
  let lx = fl["lx"][L]
  fl_go(fl, "slotmap", 1, (n + 31) // 32 * 32, [ws["E"], fl["som"][1], tab, fl["pa"], fl["pb"], L, n, fl["na"], FL_SA(), FL_SB(), lx[3], lx[4]])
  let u0 = fl_kp0(fl)
  if tg == tu {
    // gate and up in one launch: 2 n slots (TAB's first two thirds), gate rows then up rows into H1
    fg_mvx2(fs, tab, tg, fg_rowbytes(tg, 2560), 2560, 640, 2 * n, n, ws["CUR"], 10, ws["H1"], st)
    fl_kp1(fl, "experts gate+up type " ++ str(tg), u0)
    fl_go(fl, "act", (n * 640 + 255) // 256, 256, [ws["H1"], ws["H1"] + 8 * n * 640, ws["H1"], n * 640, 2])
  } else {
    fg_mvx(fs, tab, tg, fg_rowbytes(tg, 2560), 2560, 640, n, ws["CUR"], 10, ws["H1"], st)
    fl_kp1(fl, "experts gate type " ++ str(tg), u0)
    u0 = fl_kp0(fl)
    fg_mvx(fs, tab + 8 * n, tu, fg_rowbytes(tu, 2560), 2560, 640, n, ws["CUR"], 10, ws["H2"], st)
    fl_kp1(fl, "experts up type " ++ str(tu), u0)
    fl_go(fl, "act", (n * 640 + 255) // 256, 256, [ws["H1"], ws["H2"], ws["H1"], n * 640, 2])
  }
  u0 = fl_kp0(fl)
  fg_mvx(fs, tab + 16 * n, td, fg_rowbytes(td, 640), 640, 2560, n, ws["H1"], 1, ws["D"], st)
  fl_kp1(fl, "experts down type " ++ str(td), u0)
  if shx { fl_shexp(fl, L, T) }
  // (at T = 1 the gate scalar came with the router: LG[512])
  let sg = ws["SG"]
  if T == 1 and LT["rtg"] != null { sg = ws["LG"] + 8 * 512 } else { fl_mvt(fl, LT["ffn_gate_inp_shexp.weight"], ws["CUR"], ws["SG"], T) }
  fl_go(fl, "moesum", (T * 2560 + 255) // 256, 256, [ws["D"], ws["W"], ws["SHD"], sg, ws["MO"], T * 2560])
  fl_go(fl, "hccomb", (T * 10240 + 255) // 256, 256, [ws["RES"], ws["MO"], ws["INJ"], T * 10240])
  return 0
}

// segment A of layer L: (layer 1: the n-gram kernels) the mix before the token mixer, the attention or delta-net
// block, the combine, the mix before the MoE, the router. A delta-net layer's segment has no position in it either.
skill fl_segA(fl, L, T, pos0, ai, dump) -> Any {
  let ws = fl["ws"]
  let LT = fl["lt"][L]
  if L == 0 { fl_go(fl, "embq8", T, 256, [ws["RAW"], ws["RES"]]) }
  if L == 1 {
    fl_go(fl, "pleiq4", T * 16, 160, [ws["PRAW"], ws["EMB"]])
    fl_ple_k(fl, T)
  }
  fl_hcmix(fl, LT, "hc_attn_", T, true)
  if (L + 1) % 4 == 0 {
    // (the caches hold float32: 512 a position)
    let kc = ws["KC"] + ai * FL_MAXPOS() * 512 * 4
    let vc = ws["VC"] + ai * FL_MAXPOS() * 512 * 4
    fl_mvt(fl, LT["attn_q.weight"], ws["CUR"], ws["QF"], T)
    fl_mvt(fl, LT["attn_k.weight"], ws["CUR"], ws["K"], T)
    fl_mvt(fl, LT["attn_v.weight"], ws["CUR"], ws["V"], T)
    if aget(fl["dp"], 0) == 1 {
      // recorded for replay at any position (T = 1): the position comes from the GPU word POSD
      let pd = ws["POSD"]
      fl_go(fl, "qkrope_d", 26, 256, [ws["QF"], ws["K"], ws["V"], LT["attn_q_norm.weight"][0], LT["attn_k_norm.weight"][0], ws["Q"], kc, vc, ws["RT"], pd, 0])
      fl_qsa_d(fl, LT, ai)
      fl_go(fl, "attn_d", 24, 256, [ws["Q"], kc, vc, ws["QF"], ws["O"], ws["SC"], ws["SEL"], pd, 0, FL_MAXPOS(), 0])
    } else {
      fl_go(fl, "qkrope", T * 26, 256, [ws["QF"], ws["K"], ws["V"], LT["attn_q_norm.weight"][0], LT["attn_k_norm.weight"][0], ws["Q"], kc, vc, ws["RT"] + pos0 * 64 * 8, pos0])
      let sel = fl_qsa(fl, LT, ai, pos0, T)
      fl_go(fl, "attn", T * 24, 256, [ws["Q"], kc, vc, ws["QF"], ws["O"], ws["SC"], sel, pos0, FL_MAXPOS(), (pos0 + T) // 4])
    }
    fl_mvt(fl, LT["attn_output.weight"], ws["O"], ws["OUT"], T)
  } else {
    fl_mvt(fl, LT["attn_qkv.weight"], ws["CUR"], ws["MIX"], T)
    fl_mvt(fl, LT["attn_gate.weight"], ws["CUR"], ws["Z"], T)
    fl_mvt(fl, LT["ssm_beta.weight"], ws["CUR"], ws["BA"], T)
    fl_mvt(fl, LT["ssm_alpha.weight"], ws["CUR"], ws["AL"], T)
    let ck = aget(fl["spec"], 0) == 1
    fl_go(fl, "dnconv", 40, 256, [ws["MIX"], ws["HIST"] + L * 3 * 10240 * 8, LT["ssm_conv1d.weight"][0], ws["CV"], if ck { ws["HCK"] + L * 3 * 10240 * 8 } else { 0 }, T, 10240])
    fl_go(fl, "dnstep", 48, 128, [ws["CV"], ws["BA"], ws["AL"], LT["ssm_dt.bias"][0], LT["ssm_a"][0], ws["S"] + L * 48 * 16384 * 4, ws["O"], if ck { ws["SCK"] + L * 48 * 16384 * 4 } else { 0 }, T])
    fl_go(fl, "dngnorm", T * 48, 128, [ws["O"], ws["Z"], LT["ssm_norm.weight"][0], ws["FIN"]])
    fl_mvt(fl, LT["ssm_out.weight"], ws["FIN"], ws["OUT"], T)
  }
  if dump {
    let mmd = mark()
    rt_gpu_sync()
    rt_gpu_dump(ws["OUT"], 8 * T * 2560, "out\\flash_O" ++ str(L) ++ ".bin")
    release(mmd, 0)
  }
  fl_go(fl, "hccomb", (T * 10240 + 255) // 256, 256, [ws["RES"], ws["OUT"], ws["INJ"], T * 10240])
  fl_hcmix(fl, LT, "hc_ffn_", T, true)
  if T == 1 and LT["rtg"] != null { fl_mvt(fl, LT["rtg"], ws["CUR"], ws["LG"], 1) } else { fl_mvt(fl, LT["ffn_gate_inp.weight"], ws["CUR"], ws["LG"], T) }
  fl_go(fl, "route", T, 32, [ws["LG"], ws["E"], ws["W"]])
  let pg = fl["pg"]
  if pg != null and L < 47 {
    fl_mvt(fl, fl["lt"][L + 1]["ffn_gate_inp.weight"], ws["CUR"], pg[2], T)
    fl_go(fl, "route", T, 32, [pg[2], pg[1], pg[3]])
  }
  return 0
}

// Pi compiles the decode pass: every segment without a position in it (A of the 36 delta-net layers, B of all 48)
// is recorded once as a CUDA graph at T = 1 and replayed with one call -> [graphs A, graphs B], or null if a
// capture fails
// capture is recording, not running: nothing is computed here. Graph 0 is layer 0's segment A; graph 1 + L is layer
// L's segment B, then layer L + 1's segment A when that is a delta-net layer, or the head after layer 47 -> [graph 0,
// [graphs 1 + L]], or null (a failed capture, or out\flash_nograph.flag)
skill fl_capture(fl) -> Any {
  if read_file("out\\flash_nograph.flag") != null or fl["kp"] != null { return null }
  let st = fl["st"]
  rt_gpu_sync()
  aset(fl["dp"], 0, 1)
  if rt_gpu_capture(st) != 0 { return null }
  fl_go(fl, "posget", 1, 32, [fl["ws"]["POSH"], fl["ws"]["POSD"]])
  fl_segA(fl, 0, 1, 0, 0, false)
  let evs = fl["evs"]
  let rce = rt_gpu_event_record(evs[0], st)
  if rce != 0 { do fail("event record failed " ++ str(rce)) }
  fl_shexp(fl, 0, 1)
  let g0 = rt_gpu_capture_end(st)
  if g0 < 0 { return null }
  let gb = []
  for L in range(0, 48) {
    if rt_gpu_capture(st) != 0 { return null }
    fl_segBx(fl, L, 1, false)
    if L == 47 {
      fl_head(fl, 1)
    } else {
      fl_segA(fl, L + 1, 1, 0, (L + 1) // 4, false)
      rt_gpu_event_record(evs[L + 1], st)
      fl_shexp(fl, L + 1, 1)
    }
    let g = rt_gpu_capture_end(st)
    if g < 0 { return null }
    gb ++= [g]
  }
  aset(fl["dp"], 0, 0)
  return [g0, gb]
}

// after the last layer: the output mix, the logits of the last position, and the best of them into E[0], E[1]
skill fl_head(fl, T) -> Any {
  let ws = fl["ws"]
  fl_hcmix(fl, fl["gt"], "output_hc_", T, false)
  let t = fl["gt"]["output.weight"]
  let u0 = fl_kp0(fl)
  // a verify pass wants every position's best token (row t of LOGITS -> E[2t], E[2t + 1]); otherwise the last one
  let nv = if aget(fl["spec"], 0) == 1 { T } else { 1 }
  fg_mvw(fl["fs"], t[0], t[1], t[2], 2560, 248320, ws["CUR"] + (T - nv) * 2560 * 8, ws["LOGITS"], nv, fl["st"])
  fl_kp1(fl, "output head", u0)
  fl_go(fl, "amax", nv, 1024, [ws["LOGITS"], ws["E"], 248320])
  return 0
}

// layer 1's n-gram embeddings (PLE): the table rows are read on the host and put in EMB before the pass starts ...
skill fl_ple_host(fl, toks, i0, T) -> Any {
  let emb = []
  for i in range(i0, i0 + T) {
    for r in fl_plerows(toks, i) { emb = emb ++ fl_plerow(fl, r) }
  }
  return rt_gpu_put(fl["ws"]["EMB"], emb)
}

// ... and the kernels that add them to RES run in layer 1's segment A
skill fl_ple_k(fl, T) -> Any {
  let ws = fl["ws"]
  let LT1 = fl["lt"][1]
  fl_mvt(fl, LT1["ple_key.weight"], ws["EMB"], ws["PK"], T)
  fl_mvt(fl, LT1["ple_value.weight"], ws["EMB"], ws["PV"], T)
  fl_go(fl, "hcnorm", T * 4, 256, [ws["PK"], LT1["ple_norm_key.weight"][0], ws["PK"], 2560, 4])
  fl_go(fl, "hcnorm", T * 4, 256, [ws["RES"], LT1["ple_norm_query.weight"][0], ws["PQ"], 2560, 4])
  fl_go(fl, "plegate", T * 4, 256, [ws["PK"], ws["PQ"], ws["PV"], ws["PG"]])
  fl_go(fl, "hcnorm", T * 4, 256, [ws["PG"], LT1["ple_norm_conv.weight"][0], ws["PX"], 2560, 4])
  fl_go(fl, "pleconv", 40, 256, [ws["PX"], ws["PH"], LT1["ple_conv1d.weight"][0], ws["RES"], ws["PG"], if aget(fl["spec"], 0) == 1 { ws["PCK"] } else { 0 }, T])
  return 0
}

// T tokens (toks[i0 .. i0 + T]) at positions pos0 ..: every layer; dump: write RES after each layer to
// out\flash_L<i>.bin -> the top 5 [logit, token] of the last position
skill fl_forward(fl, toks, i0, pos0, T, dump) -> Any { return fl_forward_k(fl, toks, i0, pos0, T, dump, 5) }

// ... with the k best of the last position (k = 1: chosen on the GPU, two numbers come back)
skill fl_forward_k(fl, toks, i0, pos0, T, dump, k) -> Any {
  // Pi frees nothing by itself: this pass's host lists (the embeddings, the n-gram rows, the tables) go at the end
  let mmf = mark()
  let u0 = rt_usec()
  let r = fl_pass(fl, toks, i0, pos0, T, dump, k)
  aset(fl["prof"], 3, aget(fl["prof"], 3) + rt_usec() - u0)
  aset(fl["prof"], 4, aget(fl["prof"], 4) + 1)
  return release(mmf, r)
}

skill fl_pass(fl, toks, i0, pos0, T, dump, k) -> Any {
  let uh0 = rt_usec()
  let ws = fl["ws"]
  let w = fl["w"]
  // the raw rows only (embedding Q8_0, n-gram IQ4_NL), gathered from the mapped shards in one copy each; the GPU
  // dequantizes them in layer 0's and layer 1's segments
  let te = fl["gt"]["token_embd.weight"]
  let tp = fl["gt"]["per_layer_token_embd.weight"]
  let eo = []
  let po = []
  for i in range(i0, i0 + T) {
    eo ++= [te[1] + toks[i] * 2720]
    for r in fl_plerows(toks, i) { po ++= [tp[1] + r * 90] }
  }
  rt_gather_put(ws["RAW"], fl["fm"][te[0]][0], eo, 2720)
  rt_gather_put(ws["PRAW"], fl["fm"][tp[0]][0], po, 90)
  aset(fl["prof"], 6, aget(fl["prof"], 6) + rt_usec() - uh0)
  // one token, no dumps: the recorded graphs, one call per layer (the 12 attention layers' first halves run live,
  // their launches carry the position). The host's only other work is the router's choice, once per layer.
  let st = fl["st"]
  // k == 0: a verify pass (checkpoints on, every position's best token)
  aset(fl["spec"], 0, if k == 0 { 1 } else { 0 })
  let g = if T == 1 and not dump and k != 0 { fl["g"] } else { null }
  if g != null {
    rt_host_put32(fl["posh"], pos0)
    fl_gg(g[0], st)
  } else {
    fl_segA(fl, 0, T, pos0, 0, dump)
  }
  for L in range(0, 48) {
    if g != null { fl_route_host_ev(fl, L) } else { fl_route_host(fl, L, T) }
    if g != null {
      fl_gg(g[1][L], st)
    } else {
      fl_segB(fl, L, T)
      if dump {
        let mmd = mark()
        rt_gpu_sync()
        rt_gpu_dump(ws["MO"], 8 * T * 2560, "out\\flash_M" ++ str(L) ++ ".bin")
        rt_gpu_dump(ws["E"], 8 * T * 10, "out\\flash_E" ++ str(L) ++ ".bin")
        rt_gpu_dump(ws["W"], 8 * T * 10, "out\\flash_W" ++ str(L) ++ ".bin")
        rt_gpu_dump(ws["H2"], 8 * T * 6400, "out\\flash_U" ++ str(L) ++ ".bin")
        rt_gpu_dump(ws["H1"], 8 * T * 6400, "out\\flash_H" ++ str(L) ++ ".bin")
        rt_gpu_dump(ws["D"], 8 * T * 25600, "out\\flash_D" ++ str(L) ++ ".bin")
        rt_gpu_dump(ws["CUR"], 8 * T * 2560, "out\\flash_C" ++ str(L) ++ ".bin")
        rt_gpu_dump(ws["TAB"], 8 * 3 * T * 10, "out\\flash_T" ++ str(L) ++ ".bin")
        rt_gpu_dump(ws["RES"], 8 * T * 10240, "out\\flash_L" ++ str(L) ++ ".bin")
        release(mmd, 0)
      }
      if L < 47 { fl_segA(fl, L + 1, T, pos0, (L + 1) // 4, dump) } else { fl_head(fl, T) }
    }
  }
  if k == 1 {
    rt_gpu_sync()
    let r = rt_host_get(fl["eh"], 2)
    return [[r[0], int(r[1])]]
  }
  if k == 0 {
    rt_gpu_sync()
    aset(fl["spec"], 0, 0)
    let r = rt_host_get(fl["eh"], 2 * T)
    let ys = []
    for t in range(0, T) { ys ++= [int(r[2 * t + 1])] }
    return ys
  }
  rt_gpu_sync()
  let lg = rt_gpu_get(ws["LOGITS"], 248320)
  return fl_top(lg, k)
}

// the k largest values of xs, largest first, as [value, index] (the first index on ties)
skill fl_top(xs, k) -> Any {
  let best = []
  for i in range(0, len(xs)) {
    let v = xs[i]
    if len(best) < k or v > best[len(best) - 1][0] {
      let j = len(best)
      while j > 0 and v > best[j - 1][0] { j -= 1 }
      best = slice(best, 0, j) ++ [[v, i]] ++ slice(best, j, len(best))
      if len(best) > k { best = slice(best, 0, k) }
    }
  }
  return best
}
