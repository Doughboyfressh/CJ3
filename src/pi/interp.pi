# Pi evaluating Pi, in process. A small tree-walking interpreter over expression trees (the shape a program
# search builds and runs millions of times). Every evaluation carries a fuel budget, so a generated program that
# loops forever simply runs out and fails instead of hanging -- which is what makes it safe to run code Pi wrote
# itself. This is the keystone the dreaming / compression / self-improvement loops stand on.
#
# An expression is a list whose head says its form:
#   ["q", v]                 a literal value v
#   ["v", name]              a variable
#   ["if", c, a, b]          if c is truthy then a else b
#   ["lam", [params], body]  a function value (captures the names around it)
#   ["app", f, [args]]       apply a function value
#   ["call", name, [args]]   call a named definition (defs), which may call itself -- recursion
#   ["let", name, e, body]   bind name to e within body
#   ["op", name, [args]]     a built-in: + - * // % neg , < <= > >= == != , and or not ,
#                            cons head tail empty nil len nth ++ list , min max
# defs is a map name -> ["lam", params, body]. A result is [ok, value, fuel]: ok 0 means out of fuel, an error,
# or an unbound name. A function value is ["fn", params, body, env].

skill ev_truthy(v) -> Any {
  if typeof(v) == "null" { return false }
  if typeof(v) == "int" or typeof(v) == "real" { return v != 0 }
  if typeof(v) == "text" or typeof(v) == "list" or typeof(v) == "map" { return len(v) != 0 }
  return true
}

# evaluate every expression in es; -> [ok, [values], fuel]
skill ev_all(es, env, defs, fuel) -> Any {
  let out = []
  for e in es {
    let r = ev(e, env, defs, fuel)
    if r[0] == 0 { return [0, out, r[2]] }
    let out = append(out, r[1])
    let fuel = r[2]
  }
  return [1, out, fuel]
}

skill ev_op(name, a, fuel) -> Any {
  if name == "+" { return [1, a[0] + a[1], fuel] }
  if name == "-" { return [1, a[0] - a[1], fuel] }
  if name == "*" { return [1, a[0] * a[1], fuel] }
  if name == "//" {
    if a[1] == 0 { return [0, 0, fuel] }
    # the smallest integer divided by -1 is a hardware fault: dividing by -1 is just negation
    if a[1] == 0 - 1 { return [1, 0 - a[0], fuel] }
    return [1, a[0] // a[1], fuel]
  }
  if name == "%" {
    if a[1] == 0 { return [0, 0, fuel] }
    if a[1] == 0 - 1 { return [1, 0, fuel] }
    return [1, a[0] % a[1], fuel]
  }
  if name == "neg" { return [1, 0 - a[0], fuel] }
  if name == "<" { return [1, a[0] < a[1], fuel] }
  if name == "<=" { return [1, a[0] <= a[1], fuel] }
  if name == ">" { return [1, a[0] > a[1], fuel] }
  if name == ">=" { return [1, a[0] >= a[1], fuel] }
  if name == "==" { return [1, a[0] == a[1], fuel] }
  if name == "!=" { return [1, a[0] != a[1], fuel] }
  if name == "and" { return [1, ev_truthy(a[0]) and ev_truthy(a[1]), fuel] }
  if name == "or" { return [1, ev_truthy(a[0]) or ev_truthy(a[1]), fuel] }
  if name == "not" { return [1, ev_truthy(a[0]) == false, fuel] }
  if name == "nil" { return [1, [], fuel] }
  if name == "cons" { return [1, [a[0]] ++ a[1], fuel] }
  if name == "head" {
    if len(a[0]) == 0 { return [0, 0, fuel] }
    return [1, a[0][0], fuel]
  }
  if name == "tail" {
    if len(a[0]) == 0 { return [0, 0, fuel] }
    return [1, slice(a[0], 1, len(a[0])), fuel]
  }
  if name == "empty" { return [1, len(a[0]) == 0, fuel] }
  if name == "len" { return [1, len(a[0]), fuel] }
  if name == "nth" {
    if a[1] < 0 or a[1] >= len(a[0]) { return [0, 0, fuel] }
    return [1, a[0][a[1]], fuel]
  }
  if name == "++" { return [1, a[0] ++ a[1], fuel] }
  if name == "list" { return [1, a, fuel] }
  if name == "min" {
    if a[0] <= a[1] { return [1, a[0], fuel] }
    return [1, a[1], fuel]
  }
  if name == "max" {
    if a[0] >= a[1] { return [1, a[0], fuel] }
    return [1, a[1], fuel]
  }
  return [0, 0, fuel]
}

skill ev(e, env, defs, fuel) -> Any {
  if fuel <= 0 { return [0, 0, 0] }
  let fuel = fuel - 1
  let h = e[0]
  if h == "q" { return [1, e[1], fuel] }
  if h == "v" {
    let x = env[e[1]]
    if x == null { return [0, 0, fuel] }
    return [1, x, fuel]
  }
  if h == "if" {
    let c = ev(e[1], env, defs, fuel)
    if c[0] == 0 { return c }
    if ev_truthy(c[1]) { return ev(e[2], env, defs, c[2]) }
    return ev(e[3], env, defs, c[2])
  }
  if h == "lam" { return [1, ["fn", e[1], e[2], env], fuel] }
  if h == "let" {
    let r = ev(e[2], env, defs, fuel)
    if r[0] == 0 { return r }
    return ev(e[3], put(env, e[1], r[1]), defs, r[2])
  }
  if h == "op" {
    let r = ev_all(e[2], env, defs, fuel)
    if r[0] == 0 { return [0, 0, r[2]] }
    return ev_op(e[1], r[1], r[2])
  }
  if h == "app" {
    let f = ev(e[1], env, defs, fuel)
    if f[0] == 0 { return f }
    let r = ev_all(e[2], env, defs, f[2])
    if r[0] == 0 { return [0, 0, r[2]] }
    return ev_apply(f[1], r[1], defs, r[2])
  }
  if h == "call" {
    let d = defs[e[1]]
    if d == null { return [0, 0, fuel] }
    let r = ev_all(e[2], env, defs, fuel)
    if r[0] == 0 { return [0, 0, r[2]] }
    return ev_apply(["fn", d[1], d[2], {}], r[1], defs, r[2])
  }
  return [0, 0, fuel]
}

# apply a function value to already-evaluated arguments
skill ev_apply(fv, args, defs, fuel) -> Any {
  if typeof(fv) != "list" { return [0, 0, fuel] }
  if fv[0] != "fn" { return [0, 0, fuel] }
  let params = fv[1]
  if len(params) != len(args) { return [0, 0, fuel] }
  let env = fv[3]
  for i in range(0, len(params)) { let env = put(env, params[i], args[i]) }
  return ev(fv[2], env, defs, fuel)
}

# run a named definition on arguments (the usual entry); -> [ok, value]
skill run_def(defs, name, args, fuel) -> Any {
  let d = defs[name]
  if d == null { return [0, 0] }
  let r = ev_apply(["fn", d[1], d[2], {}], args, defs, fuel)
  return [r[0], r[1]]
}

# evaluate a closed expression (no free variables) with a budget; -> [ok, value]
skill ev_closed(e, defs, fuel) -> Any {
  let r = ev(e, {}, defs, fuel)
  return [r[0], r[1]]
}
