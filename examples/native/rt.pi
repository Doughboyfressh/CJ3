# rt -- Pi's native runtime, written in Pi itself. pic compiles it into every program.
#
# Functions named rt_* are compiled in the raw dialect: values are plain machine integers, conditions test for
# non-zero, and the primitives reach the machine -- peek(a) / poke(a, v) (8 bytes), peekb / pokeb (1 byte),
# gaddr(k) (the address of global slot k, 0 .. 31) and wcall("Name", ...) (a call into kernel32). On Linux the same
# wcall goes to a skill of this file instead (see "Linux" at the end), built on lsys(number, ...) (a system call),
# ostarget() (1 when compiled for Linux) and faddr("rt_name") (a skill's address).
#
# The values every other function sees: an integer n is 2n + 1 (so the low bit is 1); null is 0; anything else
# is the address of an object [kind, length, payload]: kind 1 text (bytes), 2 list (values), 3 map (key and
# value pairs, in order). Objects are never changed after they are made, so they are shared freely.
# Globals: 0 the next free byte of the heap, 1 the standard output handle, 2 a scratch word, 3 the heap's start,
# 4 the standard input handle, 5 a one-byte input buffer, 6 the end of the committed heap, 7 the end of the reserve.
#
# The heap: 24 GB of address space is RESERVED at the start (it costs nothing), and memory is COMMITTED 256 MB at a
# time as the heap grows -- Windows charges only for what Pi uses (the old heap committed one fixed 4 GB block).

skill rt_init() -> Any {
  let reserve = 25769803776
  let heap = wcall("VirtualAlloc", 0, reserve, 8192, 4)
  if heap == 0 { do wcall("ExitProcess", 3) }
  if wcall("VirtualAlloc", heap, 268435456, 4096, 4) == 0 { do wcall("ExitProcess", 3) }
  do poke(gaddr(0), heap)
  do poke(gaddr(3), heap)
  do poke(gaddr(6), heap + 268435456)
  do poke(gaddr(7), heap + reserve)
  do poke(gaddr(1), wcall("GetStdHandle", 0 - 11))
  return 0
}

skill rt_oom() -> Any {
  do poke(gaddr(0), peek(gaddr(3)))
  do wcall("WriteFile", peek(gaddr(1)), rt_cstr("out of memory (24 GB heap)"), 26, gaddr(2), 0)
  do wcall("ExitProcess", 4)
  return 0
}

skill rt_alloc(n) -> Any {
  let p = peek(gaddr(0))
  let q = p + (n + 7) // 8 * 8
  if q > peek(gaddr(6)) {
    # commit more, in 256 MB steps; past the reserve, or if Windows will not commit, a clean failure
    let top = peek(gaddr(6))
    let nt = top
    while nt < q { let nt = nt + 268435456 }
    if nt > peek(gaddr(7)) { do rt_oom() }
    if wcall("VirtualAlloc", top, nt - top, 4096, 4) == 0 { do rt_oom() }
    do poke(gaddr(6), nt)
  }
  do poke(gaddr(0), q)
  return p
}

skill rt_obj(kind, n, bytes) -> Any {
  let p = rt_alloc(16 + bytes)
  do poke(p, kind)
  do poke(p + 8, n)
  return p
}

skill rt_text_new(n) -> Any { return rt_obj(1, n, n) }
skill rt_list_new(n) -> Any { return rt_obj(2, n, 8 * n) }
skill rt_map_new(n) -> Any { return rt_obj(3, n, 16 * n) }
skill rt_tag(n) -> Any { return 2 * n + 1 }
skill rt_untag(v) -> Any { return (v - 1) // 2 }

# 0 null, 1 text, 2 list, 3 map, 4 integer (booleans are the integers 1 and 0), 5 function, 6 real, 7 set, 8 array,
# 9 big integer (a whole number past 2^62: see "whole numbers of any size"). The kind is
# the low byte of an object's first word (a function keeps its capture count in the bytes above it).
skill rt_kind(v) -> Any {
  if v == 0 { return 0 }
  if v % 2 == 1 { return 4 }
  return peek(v) % 256
}

skill rt_truthy(v) -> Any {
  let k = rt_kind(v)
  if k == 0 { return 0 }
  if k == 4 { return v != 1 }
  return peek(v + 8) != 0
}

skill rt_len(v) -> Any {
  let k = rt_kind(v)
  if k == 1 or k == 2 or k == 3 or k == 8 { return rt_tag(peek(v + 8)) }
  return 1
}

# [a, b, c] and {"k": v}: the values were pushed in order; addr is the stack pointer after the last push
skill rt_list_pack(addr, nt) -> Any {
  let n = rt_untag(nt)
  let l = rt_list_new(n)
  for i in range(0, n) { do poke(l + 16 + 8 * i, peek(addr + 8 * (n - 1 - i))) }
  return l
}

skill rt_map_pack(addr, nt) -> Any {
  let n = rt_untag(nt)
  let m = rt_map_alloc(n, 0)
  for i in range(0, 2 * n) { do poke(m + 16 + 8 * i, peek(addr + 8 * (2 * n - 1 - i))) }
  do rt_mi_build(m)
  return m
}

# ---- maps with a hash index ----------------------------------------------------------------------------------------
# A map of 8 or more pairs, or one made to grow in place, carries an index after its pairs: cap slots of 8 bytes (the
# pair's number + 1; 0 empty; cap a power of two, at least twice the room for pairs). The first word keeps, above the
# kind byte, cap (bits 8..47; 0: no index, the linear walk) and whether the map grows in place (bit 48: then it has
# room for rt_owncap(n) pairs, the index after that room). The index is inside the map's own allocation, so freeing a
# region or copying the map out of one carries it along; equal maps stay equal (== reads the pairs only). Keys equal
# by == hash alike: numbers by their value as a real (1 and 1.0), text by its bytes, anything else by kind and length.
skill rt_mi_cap(m) -> Any { return (peek(m) // 256) % 1099511627776 }
skill rt_mi_own(m) -> Any { return (peek(m) // 281474976710656) % 2 }
skill rt_mi_room(m) -> Any {
  if rt_mi_own(m) == 1 { return rt_owncap(peek(m + 8)) }
  return peek(m + 8)
}
skill rt_mi_base(m) -> Any { return m + 16 + 16 * rt_mi_room(m) }

# a map with room for n pairs (own: rt_owncap(n) of them) and its index's space; the pairs not yet written
skill rt_map_alloc(n, own) -> Any {
  let room = n
  if own == 1 { let room = rt_owncap(n) }
  let cap = 0
  if own == 1 or n >= 8 {
    let cap = 16
    while cap < 2 * room { let cap = 2 * cap }
  }
  let m = rt_alloc(16 + 16 * room + 8 * cap)
  do poke(m, 3 + 256 * cap + 281474976710656 * own)
  do poke(m + 8, n)
  return m
}

# bytes a map occupies: its pairs' room and its index
skill rt_map_bytes(m) -> Any { return 16 + 16 * rt_mi_room(m) + 8 * rt_mi_cap(m) }

skill rt_hash(k) -> Any {
  if k == 0 { return 0 }
  let kd = rt_kind(k)
  if kd == 4 or kd == 6 or kd == 9 {
    let b = rt_realbits(k)
    # 0.0 and -0.0 are equal
    if b * 2 == 0 { return 0 }
    return b * 1181783497276652981 + 7
  }
  if kd == 1 {
    let n = peek(k + 8)
    let h = 5381
    for i in range(0, n) { let h = h * 1099511628211 + peekb(k + 16 + i) }
    return h
  }
  return kd * 1000003 + peek(k + 8)
}

skill rt_mi_slot(h, cap) -> Any {
  let s = (h // 65536) % cap
  if s < 0 { return s + cap }
  return s
}

# pair i (its hash h) into the index (base, cap): the first empty slot from its own
skill rt_mi_add(base, cap, h, i) -> Any {
  let s = rt_mi_slot(h, cap)
  while peek(base + 8 * s) != 0 { let s = (s + 1) % cap }
  do poke(base + 8 * s, i + 1)
  return 0
}

# the index of m made from its pairs (nothing when it has none)
skill rt_mi_build(m) -> Any {
  let cap = rt_mi_cap(m)
  if cap == 0 { return 0 }
  let base = rt_mi_base(m)
  for s in range(0, cap) { do poke(base + 8 * s, 0) }
  let n = peek(m + 8)
  for i in range(0, n) { do rt_mi_add(base, cap, rt_hash(peek(m + 16 + 16 * i)), i) }
  return 0
}

# equality as Pi's ==: integers by value, text by content, lists and maps element by element
skill rt_eqr(a, b) -> Any {
  # numbers compare by value across int and real (1 == 1.0), as the interpreter's == does
  let na = rt_kind(a)
  let nb = rt_kind(b)
  if (na == 4 or na == 6 or na == 9) and (nb == 4 or nb == 6 or nb == 9) {
    if na == 4 and nb == 4 {
      if a == b { return 1 }
      return 0
    }
    # integers of any size: small and big never hold the same value, two bigs compare limb by limb
    if (na == 4 or na == 9) and (nb == 4 or nb == 9) {
      if na != nb { return 0 }
      if rt_bcmp(a, b) == 0 { return 1 }
      return 0
    }
    let x = rt_realbits(a)
    let y = rt_realbits(b)
    if flt(x, y) { return 0 }
    if flt(y, x) { return 0 }
    return 1
  }
  if a == b { return 1 }
  let ka = rt_kind(a)
  if ka != rt_kind(b) { return 0 }
  if ka == 0 or ka == 4 or ka == 5 { return 0 }
  let n = peek(a + 8)
  if n != peek(b + 8) { return 0 }
  if ka == 1 {
    for i in range(0, n) {
      if peekb(a + 16 + i) != peekb(b + 16 + i) { return 0 }
    }
    return 1
  }
  let words = n
  if ka == 3 { let words = 2 * n }
  for i in range(0, words) {
    if rt_eqr(peek(a + 16 + 8 * i), peek(b + 16 + 8 * i)) == 0 { return 0 }
  }
  return 1
}

skill rt_eq(a, b) -> Any { return 2 * rt_eqr(a, b) + 1 }

skill rt_map_find(m, key) -> Any {
  let n = peek(m + 8)
  let cap = rt_mi_cap(m)
  if cap > 0 {
    let base = rt_mi_base(m)
    let s = rt_mi_slot(rt_hash(key), cap)
    while s >= 0 {
      let v = peek(base + 8 * s)
      if v == 0 { return 0 - 1 }
      if rt_eqr(peek(m + 16 + 16 * (v - 1)), key) { return v - 1 }
      let s = (s + 1) % cap
    }
  }
  for i in range(0, n) {
    if rt_eqr(peek(m + 16 + 16 * i), key) { return i }
  }
  return 0 - 1
}

# x[k]: a map's value, a list's item or a text's character; null when there is none (negative k from the end)
skill rt_index(v, k) -> Any {
  let kind = rt_kind(v)
  if kind == 3 {
    let i = rt_map_find(v, k)
    if i < 0 { return 0 }
    return peek(v + 24 + 16 * i)
  }
  if kind != 1 and kind != 2 { return 0 }
  # a whole real (928.0, from / or floor) indexes like its integer; a fractional one is an error, not a silent null
  if rt_kind(k) == 6 {
    let fb = peek(k + 8)
    let fi = f2i(fb)
    if flt(i2f(fi), fb) or flt(fb, i2f(fi)) { do rt_fail(rt_concat("a list or text index must be a whole number, got ", rt_str(k))) }
    let k = rt_tag(fi)
  }
  if rt_kind(k) != 4 { return 0 }
  let n = peek(v + 8)
  let i = rt_untag(k)
  if i < 0 { let i = i + n }
  if i < 0 or i >= n { return 0 }
  if kind == 2 { return peek(v + 16 + 8 * i) }
  let s = rt_text_new(1)
  do pokeb(s + 16, peekb(v + 16 + i))
  return s
}

# xs[i] = v in a program is let xs = rt_setat(xs, i, v): a new list with element i replaced (negative i counts from
# the end); m[k] = v on a map is put(m, k, v)
skill rt_setat(v, k, x) -> Any {
  let kind = rt_kind(v)
  if kind == 3 { return rt_put(v, k, x) }
  if kind != 2 { do rt_fail("xs[i] = v: xs must be a list or a map") }
  if rt_kind(k) != 4 { do rt_fail("xs[i] = v: the index must be an integer") }
  let n = peek(v + 8)
  let i = rt_untag(k)
  if i < 0 { let i = i + n }
  if i < 0 or i >= n { do rt_fail("xs[i] = v: index out of range") }
  let r = rt_list_new(n)
  for j in range(0, n) { do poke(r + 16 + 8 * j, peek(v + 16 + 8 * j)) }
  do poke(r + 16 + 8 * i, x)
  return r
}

# put(map, key, value): a new map, the key's value replaced in place or the pair added at the end
skill rt_put(m, key, val) -> Any {
  let n = peek(m + 8)
  let i = rt_map_find(m, key)
  let size = n
  if i < 0 { let size = n + 1 }
  let r = rt_map_alloc(size, 0)
  for j in range(0, 2 * n) { do poke(r + 16 + 8 * j, peek(m + 16 + 8 * j)) }
  if i < 0 {
    do poke(r + 16 + 16 * n, key)
    do poke(r + 24 + 16 * n, val)
  } else {
    do poke(r + 24 + 16 * i, val)
  }
  # the index: the old one's slots when it has the same size (the pairs keep their numbers), plus the new key
  let cap = rt_mi_cap(r)
  if cap > 0 {
    if rt_mi_cap(m) == cap {
      let ob = rt_mi_base(m)
      let nb = rt_mi_base(r)
      for s in range(0, cap) { do poke(nb + 8 * s, peek(ob + 8 * s)) }
      if i < 0 { do rt_mi_add(nb, cap, rt_hash(key), n) }
    } else {
      do rt_mi_build(r)
    }
  }
  return r
}

# let m = put(m, k, v) where the compiler proved nothing else sees m (own_names in pic.pi): the map changes in place
# while it has room (rt_owncap pairs), and is copied into twice the room when it has not
skill rt_put_own(m, key, val) -> Any {
  if rt_kind(m) != 3 { return rt_put(m, key, val) }
  let n = peek(m + 8)
  let i = rt_map_find(m, key)
  if rt_mi_own(m) == 1 {
    if i >= 0 {
      do poke(m + 24 + 16 * i, val)
      return m
    }
    if n + 1 <= rt_owncap(n) {
      do poke(m + 16 + 16 * n, key)
      do poke(m + 24 + 16 * n, val)
      do poke(m + 8, n + 1)
      do rt_mi_add(rt_mi_base(m), rt_mi_cap(m), rt_hash(key), n)
      return m
    }
  }
  let size = n
  if i < 0 { let size = n + 1 }
  let r = rt_map_alloc(size, 1)
  for j in range(0, 2 * n) { do poke(r + 16 + 8 * j, peek(m + 16 + 8 * j)) }
  if i < 0 {
    do poke(r + 16 + 16 * n, key)
    do poke(r + 24 + 16 * n, val)
  } else {
    do poke(r + 24 + 16 * i, val)
  }
  do rt_mi_build(r)
  return r
}

# let x = rt_setat(x, k, v) (x[k] = v) when nothing else sees x: a map grows in place, a list's item is written
skill rt_setat_own(v, k, x) -> Any {
  let kind = rt_kind(v)
  if kind == 3 { return rt_put_own(v, k, x) }
  if kind == 2 and rt_kind(k) == 4 {
    let n = peek(v + 8)
    let i = rt_untag(k)
    if i < 0 { let i = i + n }
    if i >= 0 and i < n {
      do poke(v + 16 + 8 * i, x)
      return v
    }
  }
  return rt_setat(v, k, x)
}

skill rt_append(l, x) -> Any {
  let n = peek(l + 8)
  let r = rt_list_new(n + 1)
  for i in range(0, n) { do poke(r + 16 + 8 * i, peek(l + 16 + 8 * i)) }
  do poke(r + 16 + 8 * n, x)
  return r
}

# a ++ b: lists joined, anything else joined as text
skill rt_concat(a, b) -> Any {
  if rt_kind(a) == 2 and rt_kind(b) == 2 {
    let na = peek(a + 8)
    let nb = peek(b + 8)
    let r = rt_list_new(na + nb)
    for i in range(0, na) { do poke(r + 16 + 8 * i, peek(a + 16 + 8 * i)) }
    for i in range(0, nb) { do poke(r + 16 + 8 * (na + i), peek(b + 16 + 8 * i)) }
    return r
  }
  let sa = rt_str(a)
  let sb = rt_str(b)
  let na = peek(sa + 8)
  let nb = peek(sb + 8)
  let r = rt_text_new(na + nb)
  for i in range(0, na) { do pokeb(r + 16 + i, peekb(sa + 16 + i)) }
  for i in range(0, nb) { do pokeb(r + 16 + na + i, peekb(sb + 16 + i)) }
  return r
}

# ---- lists that grow in place. When the compiler proves a local list is seen only through its own variable (see
# own_names in pic.pi), `let x = append(x, v)` and `let x = x ++ ys` come here: the list is allocated with room to
# spare -- 8 slots, then doubling -- so growing it is a write, not a copy of everything before. The room a list of
# length n has is rt_owncap(n), so no extra word is kept: every list these make was allocated at that size.
skill rt_owncap(n) -> Any {
  if n <= 8 { return 8 }
  let c = 16
  while c < n { let c = 2 * c }
  return c
}

skill rt_own_copy(l) -> Any {
  let n = peek(l + 8)
  let r = rt_obj(2, n, 8 * rt_owncap(n))
  for i in range(0, n) { do poke(r + 16 + 8 * i, peek(l + 16 + 8 * i)) }
  return r
}

skill rt_append_own(l, x) -> Any {
  if rt_kind(l) != 2 { return rt_own_copy(rt_append(l, x)) }
  let n = peek(l + 8)
  if n > 0 and n < rt_owncap(n) {
    do poke(l + 16 + 8 * n, x)
    do poke(l + 8, n + 1)
    return l
  }
  let r = rt_obj(2, n + 1, 8 * rt_owncap(n + 1))
  for i in range(0, n) { do poke(r + 16 + 8 * i, peek(l + 16 + 8 * i)) }
  do poke(r + 16 + 8 * n, x)
  return r
}

skill rt_concat_own(a, b) -> Any {
  if rt_kind(a) != 2 or rt_kind(b) != 2 {
    let r = rt_concat(a, b)
    if rt_kind(r) == 2 { return rt_own_copy(r) }
    return r
  }
  let na = peek(a + 8)
  let nb = peek(b + 8)
  let n = na + nb
  if na > 0 and n <= rt_owncap(na) {
    for i in range(0, nb) { do poke(a + 16 + 8 * (na + i), peek(b + 16 + 8 * i)) }
    do poke(a + 8, n)
    return a
  }
  let r = rt_obj(2, n, 8 * rt_owncap(n))
  for i in range(0, na) { do poke(r + 16 + 8 * i, peek(a + 16 + 8 * i)) }
  for i in range(0, nb) { do poke(r + 16 + 8 * (na + i), peek(b + 16 + 8 * i)) }
  return r
}

skill rt_itoa(n) -> Any {
  let neg = 0
  let m = n
  if n < 0 {
    let neg = 1
    let m = 0 - n
  }
  let digits = 1
  let x = m
  while x >= 10 {
    let x = x // 10
    let digits = digits + 1
  }
  let ln = digits + neg
  let s = rt_text_new(ln)
  let i = ln - 1
  let x = m
  while i >= neg {
    do pokeb(s + 16 + i, 48 + x % 10)
    let x = x // 10
    let i = i - 1
  }
  if neg { do pokeb(s + 16, 45) }
  return s
}

skill rt_str(v) -> Any {
  let k = rt_kind(v)
  if k == 1 { return v }
  if k == 4 { return rt_itoa(rt_untag(v)) }
  if k == 9 { return rt_btoa(v) }
  if k == 0 { return "null" }
  if k == 5 { return "<fn>" }
  if k == 6 { return rt_ftoa(peek(v + 8)) }
  return rt_repr(v)
}

# map, filter and reduce, written in Pi: higher-order words that used to live in Rust, now the language's own.
# f is a function value (a closure); each is called through the compiler's closure-call.
# Results grow in chunks of 256, joined once at the end (appending item by item copied the whole list each time).
skill map(xs, fn_given) -> Any {
  let chunks = []
  let cur = []
  for x in xs {
    let cur = append(cur, fn_given(x))
    if len(cur) == 256 {
      let chunks = append(chunks, cur)
      let cur = []
    }
  }
  let out = []
  for c in chunks { let out = out ++ c }
  return out ++ cur
}

skill filter(xs, fn_given) -> Any {
  let chunks = []
  let cur = []
  for x in xs {
    if fn_given(x) {
      let cur = append(cur, x)
      if len(cur) == 256 {
        let chunks = append(chunks, cur)
        let cur = []
      }
    }
  }
  let out = []
  for c in chunks { let out = out ++ c }
  return out ++ cur
}

# apply(f, args): call a function value with the items of a list as its arguments
skill apply(fn_given, args) -> Any {
  let n = len(args)
  if n == 0 { return fn_given() }
  if n == 1 { return fn_given(args[0]) }
  if n == 2 { return fn_given(args[0], args[1]) }
  if n == 3 { return fn_given(args[0], args[1], args[2]) }
  if n == 4 { return fn_given(args[0], args[1], args[2], args[3]) }
  if n == 5 { return fn_given(args[0], args[1], args[2], args[3], args[4]) }
  if n == 6 { return fn_given(args[0], args[1], args[2], args[3], args[4], args[5]) }
  do fail("apply: more than 6 arguments")
  return null
}

skill reduce(xs, fn_given, start) -> Any {
  let acc = start
  for x in xs { let acc = fn_given(acc, x) }
  return acc
}

skill rt_num(s) -> Any {
  let k = rt_kind(s)
  if k == 4 { return s }
  if k != 1 { return 0 }
  let n = peek(s + 8)
  let i = 0
  let neg = 0
  if n > 0 and peekb(s + 16) == 45 {
    let neg = 1
    let i = 1
  }
  if i >= n { return 0 }
  # more than 18 digits: a big integer (every character checked first)
  if n - i > 18 {
    for j in range(i, n) {
      let c = peekb(s + 16 + j)
      if c < 48 or c > 57 { return 0 }
    }
    return rt_batoi(s, i, n, neg)
  }
  let v = 0
  while i < n {
    let c = peekb(s + 16 + i)
    if c < 48 or c > 57 { return 0 }
    let v = v * 10 + (c - 48)
    let i = i + 1
  }
  if neg { let v = 0 - v }
  return rt_tag(v)
}

skill rt_contains(h, x) -> Any {
  let k = rt_kind(h)
  if k == 2 {
    for i in range(0, peek(h + 8)) {
      if rt_eqr(peek(h + 16 + 8 * i), x) { return 3 }
    }
    return 1
  }
  # a map: whether the key is there (as "c in seen" is in Python) -- it used to give null, so a seen-set built from a
  # map never saw anything (the steering run's sum came out as 1 + ... + 10000)
  if k == 3 {
    if rt_map_find(h, x) >= 0 { return 3 }
    return 1
  }
  # text in text ignores case, as Pi's contains does; anything else (a number) gives null
  if k == 1 and rt_kind(x) == 1 {
    let n = peek(h + 8)
    let m = peek(x + 8)
    for i in range(0, n - m + 1) {
      let same = 1
      let j = 0
      while same and j < m {
        if rt_lower(peekb(h + 16 + i + j)) != rt_lower(peekb(x + 16 + j)) { let same = 0 }
        let j = j + 1
      }
      if same { return 3 }
    }
    return 1
  }
  return 0
}

skill rt_lower(b) -> Any {
  if b >= 65 and b <= 90 { return b + 32 }
  return b
}

skill rt_chars(s) -> Any {
  let n = peek(s + 8)
  let l = rt_list_new(n)
  for i in range(0, n) {
    let c = rt_text_new(1)
    do pokeb(c + 16, peekb(s + 16 + i))
    do poke(l + 16 + 8 * i, c)
  }
  return l
}

skill rt_ord(s) -> Any { return rt_tag(peekb(s + 16)) }

skill rt_slice(v, at, bt) -> Any {
  let n = peek(v + 8)
  let a = rt_untag(at)
  let b = rt_untag(bt)
  # slice(v, a): to the end
  if bt == 0 { let b = n }
  if a < 0 { let a = a + n }
  if b < 0 { let b = b + n }
  if a < 0 { let a = 0 }
  if b > n { let b = n }
  if b < a { let b = a }
  if rt_kind(v) == 2 {
    let r = rt_list_new(b - a)
    for i in range(a, b) { do poke(r + 16 + 8 * (i - a), peek(v + 16 + 8 * i)) }
    return r
  }
  let r = rt_text_new(b - a)
  for i in range(a, b) { do pokeb(r + 16 + i - a, peekb(v + 16 + i)) }
  return r
}

# a value as text: text inside lists and maps is quoted
skill rt_repr(v) -> Any {
  let k = rt_kind(v)
  if k == 1 { return rt_concat(rt_concat("\"", v), "\"") }
  if k != 2 and k != 3 { return rt_str(v) }
  let n = peek(v + 8)
  let out = "["
  if k == 3 { let out = "{" }
  for i in range(0, n) {
    if i > 0 { let out = rt_concat(out, ", ") }
    if k == 2 {
      let out = rt_concat(out, rt_repr(peek(v + 16 + 8 * i)))
    } else {
      let out = rt_concat(rt_concat(rt_concat(out, rt_repr(peek(v + 16 + 16 * i))), ": "), rt_repr(peek(v + 24 + 16 * i)))
    }
  }
  if k == 3 { return rt_concat(out, "}") }
  return rt_concat(out, "]")
}

skill rt_out(s) -> Any {
  do wcall("WriteFile", peek(gaddr(1)), s + 16, peek(s + 8), gaddr(2), 0)
  return 0
}

# print(x): text as it is, anything else as Pi writes it, then a newline
skill rt_print(v) -> Any {
  do rt_out(rt_concat(rt_str(v), "\n"))
  return v
}

skill rt_fail(msg) -> Any {
  do rt_out(rt_concat(rt_concat("PiRuntimeError: ", rt_str(msg)), "\n"))
  do wcall("ExitProcess", 1)
  return 0
}

skill rt_exit(v) -> Any {
  let code = 0
  if rt_kind(v) == 4 { let code = rt_untag(v) }
  do wcall("ExitProcess", code)
  return 0
}

# a text as a C string (its bytes and a 0)
skill rt_cstr(s) -> Any {
  let n = peek(s + 8)
  let p = rt_alloc(n + 1)
  for i in range(0, n) { do pokeb(p + i, peekb(s + 16 + i)) }
  do pokeb(p + n, 0)
  return p
}

skill rt_read_file(path) -> Any {
  let h = wcall("CreateFileA", rt_cstr(path), 2147483648, 3, 0, 3, 128, 0)
  if h == 0 - 1 { return 0 }
  let size = wcall("GetFileSize", h, 0) % 4294967296
  let s = rt_text_new(size)
  do wcall("ReadFile", h, s + 16, size, gaddr(2), 0)
  do wcall("CloseHandle", h)
  return s
}

# write_file(path, text or a list of byte values)
skill rt_write_file(path, data) -> Any {
  let n = peek(data + 8)
  let buf = data + 16
  if rt_kind(data) == 2 {
    let buf = rt_alloc(n)
    for i in range(0, n) { do pokeb(buf + i, rt_untag(peek(data + 16 + 8 * i)) % 256) }
  }
  let h = wcall("CreateFileA", rt_cstr(path), 1073741824, 0, 0, 2, 128, 0)
  if h == 0 - 1 { return 0 }
  do wcall("WriteFile", h, buf, n, gaddr(2), 0)
  do wcall("CloseHandle", h)
  return 3
}

# arg(k): the k-th word of the command line (0 is the program), quotes respected; null past the end
skill rt_arg(kt) -> Any {
  let want = rt_untag(kt)
  let p = wcall("GetCommandLineA")
  let idx = 0
  while 1 {
    while peekb(p) == 32 { let p = p + 1 }
    if peekb(p) == 0 { return 0 }
    let quoted = 0
    if peekb(p) == 34 {
      let quoted = 1
      let p = p + 1
    }
    let start = p
    if quoted {
      while peekb(p) != 0 and peekb(p) != 34 { let p = p + 1 }
    } else {
      while peekb(p) != 0 and peekb(p) != 32 { let p = p + 1 }
    }
    if idx == want {
      let s = rt_text_new(p - start)
      for i in range(0, p - start) { do pokeb(s + 16 + i, peekb(start + i)) }
      return s
    }
    if quoted and peekb(p) == 34 { let p = p + 1 }
    let idx = idx + 1
  }
  return 0
}

# -- words moved out of Rust into Pi: keys values has get lower upper trim split join reverse sum abs sort min max
# Each matches the interpreter's word (checked by examples/native/words.pi): text is bytes, numbers are integers.

skill rt_kv(m, which) -> Any {
  if rt_kind(m) != 3 { return 0 }
  let n = peek(m + 8)
  let l = rt_list_new(n)
  for i in range(0, n) { do poke(l + 16 + 8 * i, peek(m + 16 + 16 * i + 8 * which)) }
  return l
}
skill rt_keys(m) -> Any { return rt_kv(m, 0) }
skill rt_values(m) -> Any { return rt_kv(m, 1) }

# has(x): x is not null
skill rt_has(v) -> Any {
  if v == 0 { return 1 }
  return 3
}

# get(map, key) or get(list, i): like x[k], but text gives null; get(m, k, d): d where that is null
skill rt_get(v, k, d) -> Any {
  if rt_kind(v) == 1 { return d }
  let r = rt_index(v, k)
  if r == 0 { return d }
  return r
}

# a text's bytes a..b (machine indices) as a new text
skill rt_sub(s, a, b) -> Any {
  let r = rt_text_new(b - a)
  for i in range(a, b) { do pokeb(r + 16 + i - a, peekb(s + 16 + i)) }
  return r
}

skill rt_case(s, up) -> Any {
  if rt_kind(s) != 1 { return 0 }
  let n = peek(s + 8)
  let r = rt_text_new(n)
  for i in range(0, n) {
    let b = peekb(s + 16 + i)
    if up {
      if b >= 97 and b <= 122 { let b = b - 32 }
    } else {
      if b >= 65 and b <= 90 { let b = b + 32 }
    }
    do pokeb(r + 16 + i, b)
  }
  return r
}
skill rt_lowers(s) -> Any { return rt_case(s, 0) }
skill rt_uppers(s) -> Any { return rt_case(s, 1) }

skill rt_isspace(b) -> Any { return b == 32 or (b >= 9 and b <= 13) }

skill rt_trim(s) -> Any {
  if rt_kind(s) != 1 { return 0 }
  let n = peek(s + 8)
  let a = 0
  while a < n and rt_isspace(peekb(s + 16 + a)) { let a = a + 1 }
  let b = n
  while b > a and rt_isspace(peekb(s + 15 + b)) { let b = b - 1 }
  return rt_sub(s, a, b)
}

# x occurs in s at byte i
skill rt_at(s, i, x) -> Any {
  for j in range(0, peek(x + 8)) {
    if peekb(s + 16 + i + j) != peekb(x + 16 + j) { return 0 }
  }
  return 1
}

# split(s, sep): pieces between each sep; with no sep (or ""), the runs of non-space
# two passes -- count the pieces, then allocate the list once and fill it (appending piece by piece copied the
# whole list each time: quadratic, and out of memory on a 5 MB text of 70,000 lines)
skill rt_split(s, sep) -> Any {
  if rt_kind(s) != 1 { return 0 }
  let n = peek(s + 8)
  if rt_kind(sep) == 1 and peek(sep + 8) > 0 {
    let m = peek(sep + 8)
    let count = 1
    let i = 0
    while i + m <= n {
      if rt_at(s, i, sep) {
        let count = count + 1
        let i = i + m
      } else {
        let i = i + 1
      }
    }
    let out = rt_list_new(count)
    let k = 0
    let start = 0
    let i = 0
    while i + m <= n {
      if rt_at(s, i, sep) {
        do poke(out + 16 + 8 * k, rt_sub(s, start, i))
        let k = k + 1
        let i = i + m
        let start = i
      } else {
        let i = i + 1
      }
    }
    do poke(out + 16 + 8 * k, rt_sub(s, start, n))
    return out
  }
  let count = 0
  let i = 0
  while i < n {
    while i < n and rt_isspace(peekb(s + 16 + i)) { let i = i + 1 }
    let start = i
    while i < n and rt_isspace(peekb(s + 16 + i)) == 0 { let i = i + 1 }
    if i > start { let count = count + 1 }
  }
  let out = rt_list_new(count)
  let k = 0
  let i = 0
  while i < n {
    while i < n and rt_isspace(peekb(s + 16 + i)) { let i = i + 1 }
    let start = i
    while i < n and rt_isspace(peekb(s + 16 + i)) == 0 { let i = i + 1 }
    if i > start {
      do poke(out + 16 + 8 * k, rt_sub(s, start, i))
      let k = k + 1
    }
  }
  return out
}

# join(xs, sep): each item as text, sep between (no sep: nothing between)
# two passes too: every item as text, the total length, then one text filled once (concatenating was quadratic)
skill rt_join(xs, sep) -> Any {
  if rt_kind(xs) != 2 { return 0 }
  let n = peek(xs + 8)
  let parts = rt_list_new(n)
  let total = 0
  let sl = 0
  if rt_kind(sep) == 1 { let sl = peek(sep + 8) }
  for i in range(0, n) {
    let t = rt_str(peek(xs + 16 + 8 * i))
    do poke(parts + 16 + 8 * i, t)
    let total = total + peek(t + 8)
    if i > 0 { let total = total + sl }
  }
  let out = rt_text_new(total)
  let pos = 0
  for i in range(0, n) {
    if i > 0 {
      for j in range(0, sl) { do pokeb(out + 16 + pos + j, peekb(sep + 16 + j)) }
      let pos = pos + sl
    }
    let t = peek(parts + 16 + 8 * i)
    let tl = peek(t + 8)
    for j in range(0, tl) { do pokeb(out + 16 + pos + j, peekb(t + 16 + j)) }
    let pos = pos + tl
  }
  return out
}

skill rt_reverse(v) -> Any {
  let k = rt_kind(v)
  let n = peek(v + 8)
  if k == 2 {
    let r = rt_list_new(n)
    for i in range(0, n) { do poke(r + 16 + 8 * i, peek(v + 8 + 8 * (n - i))) }
    return r
  }
  if k == 1 {
    let r = rt_text_new(n)
    for i in range(0, n) { do pokeb(r + 16 + i, peekb(v + 15 + n - i)) }
    return r
  }
  return 0
}

# sum(xs): the numbers in it added up (other items skipped)
skill rt_sum(xs) -> Any {
  if rt_kind(xs) != 2 { return 0 }
  # exact at any size, reals included (it used to wrap past 2^62 and skip reals): small sums stay on the machine
  # path while they are far from overflowing
  let t = 1
  let hi = 2305843009213693952
  for i in range(0, peek(xs + 8)) {
    let x = peek(xs + 16 + 8 * i)
    let k = rt_kind(x)
    if k == 4 and rt_kind(t) == 4 and t < hi and t > 0 - hi and x < hi and x > 0 - hi {
      let t = t + x - 1
    } else {
      if k == 4 or k == 6 or k == 9 { let t = rt_add(t, x) }
    }
  }
  return t
}

skill rt_abs(v) -> Any {
  if rt_kind(v) == 6 {
    let b = peek(v + 8)
    if flt(b, i2f(0)) { return rt_mkreal(fmul(b, i2f(0 - 1))) }
    return v
  }
  if rt_kind(v) == 9 {
    if peek(v + 16) == 1 { return rt_bneg(v) }
    return v
  }
  if rt_kind(v) != 4 { return 0 }
  # -2^62 has no small opposite: it becomes big
  let lo = 1 - 2 * 4611686018427387903 - 2
  if v == lo { return rt_bneg(v) }
  if v < 0 { return 2 - v }
  return v
}

# min(a, b, ...) / max(...): the first extreme among the numbers given, null if none (pic packs the
# arguments into a list); tagged integers order the same as their values
skill rt_extreme(xs, wantmax) -> Any {
  let best = 0
  let found = 0
  for i in range(0, peek(xs + 8)) {
    let x = peek(xs + 16 + 8 * i)
    # any number, by value (it used to skip reals and compare only small integers)
    let k = rt_kind(x)
    if k == 4 or k == 6 or k == 9 {
      if found == 0 {
        let best = x
        let found = 1
      } else {
        let c = rt_untag(rt_cmp(x, best))
        if wantmax {
          if c > 0 { let best = x }
        } else {
          if c < 0 { let best = x }
        }
      }
    }
  }
  return best
}
# format(t, a, b, ...): each "{}" in t takes the next value as text (none left: nothing); pic packs the
# arguments into one list, the template first
skill rt_format(args) -> Any {
  let t = peek(args + 16)
  if rt_kind(t) != 1 { return 0 }
  let n = peek(t + 8)
  let next = 1
  let out = ""
  let start = 0
  let i = 0
  while i + 1 < n {
    # a placeholder: {} or {:spec} (up to 16 bytes, no { inside) -- {:.2f} gives 2 decimals, any other spec ({:?},
    # {:d}) is plain {}; the specs used to come out raw. Anything else in braces ("{ }") stays text.
    let j = 0 - 1
    if peekb(t + 16 + i) == 123 {
      if peekb(t + 17 + i) == 125 { let j = i + 1 }
      if peekb(t + 17 + i) == 58 {
        let k = i + 1
        while k < n and k < i + 18 and peekb(t + 16 + k) != 125 and peekb(t + 16 + k) != 123 { let k = k + 1 }
        if k < n and peekb(t + 16 + k) == 125 { let j = k }
      }
    }
    if j >= 0 {
      let out = rt_concat(out, rt_sub(t, start, i))
      if next < peek(args + 8) {
        let v = peek(args + 16 + 8 * next)
        let nd = rt_fmtprec(t, i + 1, j)
        let bs = rt_fmtbase(t, i + 1, j)
        if bs > 0 and rt_kind(v) == 4 {
          let out = rt_concat(out, rt_fmtpad(rt_itob(rt_untag(v), bs), t, i + 1, j))
        } else {
          if nd >= 0 and (rt_kind(v) == 6 or rt_kind(v) == 4) {
            let out = rt_concat(out, rt_fmtfix(v, nd))
          } else {
            let out = rt_concat(out, rt_str(v))
          }
        }
      }
      let next = next + 1
      let i = j + 1
      let start = i
    } else {
      let i = i + 1
    }
  }
  return rt_concat(out, rt_sub(t, start, n))
}

# a format spec (bytes a .. b of t, a the ":") ending in b, o or x -> that base (2, 8, 16), else 0
skill rt_fmtbase(t, a, b) -> Any {
  if b - a < 2 or peekb(t + 16 + a) != 58 { return 0 }
  let c = peekb(t + 16 + b - 1)
  if c == 98 { return 2 }
  if c == 111 { return 8 }
  if c == 120 or c == 88 { return 16 }
  return 0
}

# an integer in base 2, 8 or 16 (lower-case digits, "-" first if negative)
skill rt_itob(n, base) -> Any {
  if n == 0 { return "0" }
  let neg = 0
  if n < 0 { let neg = 1 }
  let m = n
  if neg { let m = 0 - n }
  let ds = "0123456789abcdef"
  let rev = []
  while m > 0 {
    let rev = rt_append(rev, peekb(ds + 16 + m % base))
    let m = m // base
  }
  let k = peek(rev + 8)
  let r = rt_text_new(k + neg)
  if neg { do pokeb(r + 16, 45) }
  for i in range(0, k) { do pokeb(r + 16 + neg + i, peek(rev + 16 + 8 * (k - 1 - i))) }
  return r
}

# a width in a spec ({:8b}, {:08b}: the digits after ":") pads s on the left, with 0s if the width starts with 0
skill rt_fmtpad(s, t, a, b) -> Any {
  let k = a + 1
  let zero = 0
  if k < b and peekb(t + 16 + k) == 48 { let zero = 1 }
  let w = 0
  while k < b and peekb(t + 16 + k) >= 48 and peekb(t + 16 + k) <= 57 {
    let w = w * 10 + peekb(t + 16 + k) - 48
    let k = k + 1
  }
  let fill = " "
  if zero { let fill = "0" }
  let s = s
  while peek(s + 8) < w { let s = rt_concat(fill, s) }
  return s
}

# the precision in a format spec (bytes a .. b of t): ".N" then "f" -> N, else -1
skill rt_fmtprec(t, a, b) -> Any {
  let k = a
  while k < b {
    if peekb(t + 16 + k) == 46 {
      let d = 0
      let m = k + 1
      let any = 0
      while m < b and peekb(t + 16 + m) >= 48 and peekb(t + 16 + m) <= 57 {
        let d = d * 10 + peekb(t + 16 + m) - 48
        let m = m + 1
        let any = 1
      }
      if any and m < b and peekb(t + 16 + m) == 102 { return d }
      return 0 - 1
    }
    let k = k + 1
  }
  return 0 - 1
}

# a number with exactly nd decimals (rounded half up), as text; past ~9e15 scaled, plain text
skill rt_fmtfix(v, nd) -> Any {
  let x = rt_realbits(v)
  let neg = flt(x, i2f(0))
  if neg { let x = fmul(x, i2f(0 - 1)) }
  let nd = nd
  if nd > 15 { let nd = 15 }
  let sc = 1
  for q in range(0, nd) { let sc = sc * 10 }
  let y = fadd(fmul(x, i2f(sc)), fdiv(i2f(1), i2f(2)))
  if flt(y, fmul(i2f(1000000000), i2f(9000000))) == 0 { return rt_str(v) }
  let mm = f2i(rt_floor(y))
  let ip = mm // sc
  let fp = mm % sc
  let s = rt_itoa(ip)
  if nd > 0 {
    let ds = rt_itoa(fp)
    let z = ""
    for q in range(0, nd - peek(ds + 8)) { let z = rt_concat(z, "0") }
    let s = rt_concat(rt_concat(s, "."), rt_concat(z, ds))
  }
  if neg and mm != 0 { return rt_concat("-", s) }
  return s
}

# range(n) or range(a, b): the integers a, a+1, ..., b-1 (pic packs the arguments into one list)
skill rt_range(args) -> Any {
  let a = 0
  let b = rt_untag(peek(args + 16))
  if peek(args + 8) >= 2 {
    let a = b
    let b = rt_untag(peek(args + 24))
  }
  # range(a, b, step): every step-th from a, stopping before b (a negative step counts down)
  let st = 1
  if peek(args + 8) >= 3 { let st = rt_untag(peek(args + 32)) }
  if st == 0 { do rt_fail("range: the step must not be 0") }
  let n = 0
  if st > 0 and b > a { let n = (b - a + st - 1) // st }
  if st < 0 and a > b { let n = (a - b - st - 1) // (0 - st) }
  let l = rt_list_new(n)
  for i in range(0, n) { do poke(l + 16 + 8 * i, rt_tag(a + i * st)) }
  return l
}

skill rt_min(xs) -> Any { return rt_extreme(xs, 0) }
skill rt_max(xs) -> Any { return rt_extreme(xs, 1) }

# sort's order: two numbers by value, anything else by its text, byte by byte
skill rt_textlt(x, y) -> Any {
  let n = peek(x + 8)
  let m = peek(y + 8)
  let i = 0
  while i < n and i < m {
    let a = peekb(x + 16 + i)
    let b = peekb(y + 16 + i)
    if a != b { return a < b }
    let i = i + 1
  }
  return n < m
}
skill rt_less(a, b) -> Any {
  let ka = rt_kind(a)
  let kb = rt_kind(b)
  if ka == 4 and kb == 4 { return a < b }
  # numbers by value at any size (reals used to sort by their text: 10.0 before 9.5)
  if (ka == 4 or ka == 6 or ka == 9) and (kb == 4 or kb == 6 or kb == 9) { return rt_untag(rt_cmp(a, b)) < 0 }
  return rt_textlt(rt_str(a), rt_str(b))
}

# sort(xs): a stable bottom-up merge sort (equal items keep their order, as the interpreter's sort does)
skill rt_sort(xs) -> Any {
  if rt_kind(xs) != 2 { return 0 }
  let n = peek(xs + 8)
  let a = rt_list_new(n)
  let b = rt_list_new(n)
  for i in range(0, n) { do poke(a + 16 + 8 * i, peek(xs + 16 + 8 * i)) }
  let w = 1
  while w < n {
    let lo = 0
    while lo < n {
      let mid = lo + w
      if mid > n { let mid = n }
      let hi = lo + 2 * w
      if hi > n { let hi = n }
      let i = lo
      let j = mid
      let k = lo
      while k < hi {
        let left = 0
        if i < mid {
          if j >= hi {
            let left = 1
          } else {
            if rt_less(peek(a + 16 + 8 * j), peek(a + 16 + 8 * i)) == 0 { let left = 1 }
          }
        }
        if left {
          do poke(b + 16 + 8 * k, peek(a + 16 + 8 * i))
          let i = i + 1
        } else {
          do poke(b + 16 + 8 * k, peek(a + 16 + 8 * j))
          let j = j + 1
        }
        let k = k + 1
      }
      let lo = hi
    }
    let t = a
    let a = b
    let b = t
    let w = 2 * w
  }
  return a
}

# -- real numbers -----------------------------------------------------------------------------------------
# A real is a boxed IEEE double: [kind=6, 8-byte double bits]. Integers stay immediate (2n+1); a value is a real
# only when division or a non-integer literal made it, so integer code never allocates. The float operations
# themselves are primitives pic emits (i2f f2i fadd fsub fmul fdiv flt): they work on the 64-bit double pattern.

skill rt_mkreal(bits) -> Any {
  let p = rt_alloc(16)
  do poke(p, 6)
  do poke(p + 8, bits)
  return p
}

# the double-bit pattern of any number: a real's stored bits, or an integer converted
skill rt_realbits(v) -> Any {
  if rt_kind(v) == 6 { return peek(v + 8) }
  if rt_kind(v) == 9 { return rt_btof(v) }
  return i2f(rt_untag(v))
}

# floor(x) as double bits: truncate toward zero, then step down one if x was negative and not whole
skill rt_floor(x) -> Any {
  let t = f2i(x)
  let ft = i2f(t)
  if flt(x, ft) { return i2f(t - 1) }
  return ft
}

# the slow paths of + - * // % and unary -: reached when a real is involved, when an operand is a big integer, or
# when the inline small-integer path overflowed (it never wraps: the exact answer comes from here)
skill rt_add(a, b) -> Any {
  if rt_isint(a) and rt_isint(b) { return rt_badd(a, b) }
  return rt_mkreal(fadd(rt_realbits(a), rt_realbits(b)))
}
skill rt_subn(a, b) -> Any {
  if rt_isint(a) and rt_isint(b) { return rt_badd(a, rt_bneg(b)) }
  return rt_mkreal(fsub(rt_realbits(a), rt_realbits(b)))
}
skill rt_mul(a, b) -> Any {
  if rt_isint(a) and rt_isint(b) { return rt_bmul(a, b) }
  # [0] * n and "ab" * n (either way round): repeated, as most languages' programs write it
  let ka = rt_kind(a)
  let kb = rt_kind(b)
  if (ka == 1 or ka == 2) and kb == 4 { return rt_repeat(a, rt_untag(b)) }
  if (kb == 1 or kb == 2) and ka == 4 { return rt_repeat(b, rt_untag(a)) }
  return rt_mkreal(fmul(rt_realbits(a), rt_realbits(b)))
}
# a list or text n times over (n < 0: none); list items are shared, which is safe -- xs[i] = v makes a new list
skill rt_repeat(v, n) -> Any {
  let n = n
  if n < 0 { let n = 0 }
  let m = peek(v + 8)
  if rt_kind(v) == 1 {
    let r = rt_text_new(m * n)
    for k in range(0, n) {
      for i in range(0, m) { do pokeb(r + 16 + k * m + i, peekb(v + 16 + i)) }
    }
    return r
  }
  let r = rt_list_new(m * n)
  for k in range(0, n) {
    for i in range(0, m) { do poke(r + 16 + 8 * (k * m + i), peek(v + 16 + 8 * i)) }
  }
  return r
}
skill rt_neg(a) -> Any {
  if rt_isint(a) { return rt_bneg(a) }
  return rt_mkreal(fmul(rt_realbits(a), i2f(0 - 1)))
}
# / is always real, as the interpreter's division is (6 / 2 is 3.0)
skill rt_div(a, b) -> Any { return rt_mkreal(fdiv(rt_realbits(a), rt_realbits(b))) }
skill rt_idiv(a, b) -> Any {
  if rt_isint(a) and rt_isint(b) { return rt_bdivmod(a, b, 0) }
  return rt_mkreal(rt_floor(fdiv(rt_realbits(a), rt_realbits(b))))
}
skill rt_mod(a, b) -> Any {
  if rt_isint(a) and rt_isint(b) { return rt_bdivmod(a, b, 1) }
  let x = rt_realbits(a)
  let y = rt_realbits(b)
  return rt_mkreal(fsub(x, fmul(y, rt_floor(fdiv(x, y)))))
}

# compare two numbers by value, giving the tagged integer -1, 0 or 1 (integers exactly, at any size)
skill rt_cmp(a, b) -> Any {
  if rt_kind(a) == 4 and rt_kind(b) == 4 {
    if a < b { return rt_tag(0 - 1) }
    if b < a { return rt_tag(1) }
    return rt_tag(0)
  }
  if rt_isint(a) and rt_isint(b) { return rt_tag(rt_bcmp(a, b)) }
  let x = rt_realbits(a)
  let y = rt_realbits(b)
  if flt(x, y) { return rt_tag(0 - 1) }
  if flt(y, x) { return rt_tag(1) }
  return rt_tag(0)
}

# ==== whole numbers of any size ===================================================================================
# A small integer is a tagged machine word (|v| <= 2^62). Past that, + - * // % ^ (and num of a long text) give a
# big: kind 9, [9][n][sign 0 or 1][limb 0][limb 1]..., n = 1 + the limb count, limbs in base 10^9, least
# significant first, raw machine words (no pointers, so regions copy it as bytes). Every result passes rt_bnorm, so
# a value that fits is always small: small and big never hold the same number, and the inline paths stay exact.
skill rt_isint(v) -> Any {
  let k = rt_kind(v)
  return k == 4 or k == 9
}

skill rt_bnew(s, nl) -> Any {
  let p = rt_alloc(24 + 8 * nl)
  do poke(p, 9)
  do poke(p + 8, nl + 1)
  do poke(p + 16, s)
  for i in range(0, nl) { do poke(p + 24 + 8 * i, 0) }
  return p
}

# the limb count without leading zero limbs
skill rt_blen(p) -> Any {
  let nl = peek(p + 8) - 1
  while nl > 0 and peek(p + 16 + 8 * nl) == 0 { let nl = nl - 1 }
  return nl
}

# any integer as a big (a small one spread over three limbs: 2^62 < 10^27)
skill rt_tobig(v) -> Any {
  if rt_kind(v) == 9 { return v }
  let x = rt_untag(v)
  let s = 0
  let m = x
  if x < 0 {
    let s = 1
    let m = 0 - x
  }
  let p = rt_bnew(s, 3)
  do poke(p + 24, m % 1000000000)
  do poke(p + 32, (m // 1000000000) % 1000000000)
  do poke(p + 40, m // 1000000000000000000)
  return p
}

# a result tidied: leading zero limbs dropped, given back small when it fits (-2^62 .. 2^62 - 1)
skill rt_bnorm(p) -> Any {
  let nl = rt_blen(p)
  if nl == 0 { return 1 }
  let s = peek(p + 16)
  if nl <= 3 {
    let top = 0
    if nl == 3 { let top = peek(p + 40) }
    if top < 5 {
      let m = top * 1000000000000000000 + peek(p + 24)
      if nl >= 2 { let m = m + peek(p + 32) * 1000000000 }
      let lim = 4611686018427387903
      if s == 0 and m <= lim { return 2 * m + 1 }
      if s == 1 and m <= lim + 1 { return 1 - 2 * m }
    }
  }
  if nl == peek(p + 8) - 1 { return p }
  let r = rt_bnew(s, nl)
  for i in range(0, nl) { do poke(r + 24 + 8 * i, peek(p + 24 + 8 * i)) }
  return r
}

# |a| against |b| (bigs) -> -1, 0, 1
skill rt_bmcmp(a, b) -> Any {
  let la = rt_blen(a)
  let lb = rt_blen(b)
  if la < lb { return 0 - 1 }
  if la > lb { return 1 }
  let i = la - 1
  while i >= 0 {
    let x = peek(a + 24 + 8 * i)
    let y = peek(b + 24 + 8 * i)
    if x < y { return 0 - 1 }
    if x > y { return 1 }
    let i = i - 1
  }
  return 0
}

# |a| + |b| with sign s
skill rt_bmadd(a, b, s) -> Any {
  let la = rt_blen(a)
  let lb = rt_blen(b)
  let nl = la
  if lb > nl { let nl = lb }
  let r = rt_bnew(s, nl + 1)
  let c = 0
  for i in range(0, nl) {
    let x = c
    if i < la { let x = x + peek(a + 24 + 8 * i) }
    if i < lb { let x = x + peek(b + 24 + 8 * i) }
    let c = 0
    if x >= 1000000000 {
      let x = x - 1000000000
      let c = 1
    }
    do poke(r + 24 + 8 * i, x)
  }
  do poke(r + 24 + 8 * nl, c)
  return r
}

# |a| - |b| (|a| >= |b|) with sign s
skill rt_bmsub(a, b, s) -> Any {
  let la = rt_blen(a)
  let lb = rt_blen(b)
  let r = rt_bnew(s, la)
  let c = 0
  for i in range(0, la) {
    let x = peek(a + 24 + 8 * i) - c
    if i < lb { let x = x - peek(b + 24 + 8 * i) }
    let c = 0
    if x < 0 {
      let x = x + 1000000000
      let c = 1
    }
    do poke(r + 24 + 8 * i, x)
  }
  return r
}

skill rt_badd(a, b) -> Any {
  let x = rt_tobig(a)
  let y = rt_tobig(b)
  let sx = peek(x + 16)
  let sy = peek(y + 16)
  if sx == sy { return rt_bnorm(rt_bmadd(x, y, sx)) }
  let c = rt_bmcmp(x, y)
  if c == 0 { return 1 }
  if c > 0 { return rt_bnorm(rt_bmsub(x, y, sx)) }
  return rt_bnorm(rt_bmsub(y, x, sy))
}

skill rt_bneg(a) -> Any {
  let x = rt_tobig(a)
  let nl = rt_blen(x)
  let r = rt_bnew(1 - peek(x + 16), nl)
  for i in range(0, nl) { do poke(r + 24 + 8 * i, peek(x + 24 + 8 * i)) }
  return rt_bnorm(r)
}

skill rt_bmul(a, b) -> Any {
  # both small and under 2^31: the machine product is exact
  if rt_kind(a) == 4 and rt_kind(b) == 4 {
    let x = rt_untag(a)
    let y = rt_untag(b)
    if x < 2147483648 and x > 0 - 2147483648 and y < 2147483648 and y > 0 - 2147483648 { return 2 * (x * y) + 1 }
  }
  let x = rt_tobig(a)
  let y = rt_tobig(b)
  let la = rt_blen(x)
  let lb = rt_blen(y)
  if la == 0 or lb == 0 { return 1 }
  let s = 0
  if peek(x + 16) != peek(y + 16) { let s = 1 }
  let r = rt_bnew(s, la + lb)
  for i in range(0, la) {
    let ai = peek(x + 24 + 8 * i)
    let c = 0
    for j in range(0, lb) {
      let t = peek(r + 24 + 8 * (i + j)) + ai * peek(y + 24 + 8 * j) + c
      do poke(r + 24 + 8 * (i + j), t % 1000000000)
      let c = t // 1000000000
    }
    let k = i + lb
    while c > 0 {
      let t = peek(r + 24 + 8 * k) + c
      do poke(r + 24 + 8 * k, t % 1000000000)
      let c = t // 1000000000
      let k = k + 1
    }
  }
  return rt_bnorm(r)
}

# out = |b| x d (0 <= d < 10^9); out has room for b's limbs + 1
skill rt_bmulsmall(b, d, out) -> Any {
  let lb = rt_blen(b)
  let c = 0
  for j in range(0, lb) {
    let t = peek(b + 24 + 8 * j) * d + c
    do poke(out + 24 + 8 * j, t % 1000000000)
    let c = t // 1000000000
  }
  do poke(out + 24 + 8 * lb, c)
  for j in range(lb + 1, peek(out + 8) - 1) { do poke(out + 24 + 8 * j, 0) }
  return out
}

# r = r - t in place (|r| >= |t|; t no longer than r)
skill rt_bmsubin(r, t) -> Any {
  let nr = peek(r + 8) - 1
  let nt = rt_blen(t)
  let c = 0
  for i in range(0, nr) {
    let x = peek(r + 24 + 8 * i) - c
    if i < nt { let x = x - peek(t + 24 + 8 * i) }
    let c = 0
    if x < 0 {
      let x = x + 1000000000
      let c = 1
    }
    do poke(r + 24 + 8 * i, x)
  }
  return r
}

# the top three limbs of p as a real (the value / 10^(9 (len - 3)))
skill rt_btop3(p, nl) -> Any {
  let x = i2f(0)
  for k in range(1, 4) {
    let i = nl - k
    let x = fmul(x, i2f(1000000000))
    if i >= 0 { let x = fadd(x, i2f(peek(p + 24 + 8 * i))) }
  }
  return x
}

# |a| divmod |b| (b not zero): the quotient's limbs go into q (zeroed, room for a's limbs); the remainder is returned
# (a big, sign 0). One limb of a at a time: the remainder r gains it at the bottom, the next quotient limb is
# estimated from the leading limbs as reals (off by at most a little), then corrected exactly.
skill rt_bmdivmod(a, b, q) -> Any {
  let la = rt_blen(a)
  let lb = rt_blen(b)
  if lb == 1 {
    let d = peek(b + 24)
    let rem = 0
    let i = la - 1
    while i >= 0 {
      let cur = rem * 1000000000 + peek(a + 24 + 8 * i)
      do poke(q + 24 + 8 * i, cur // d)
      let rem = cur % d
      let i = i - 1
    }
    let rr = rt_bnew(0, 1)
    do poke(rr + 24, rem)
    return rr
  }
  let r = rt_bnew(0, lb + 1)
  let t = rt_bnew(0, lb + 1)
  let fb = rt_btop3(b, lb)
  let i = la - 1
  while i >= 0 {
    let k = lb
    while k > 0 {
      do poke(r + 24 + 8 * k, peek(r + 16 + 8 * k))
      let k = k - 1
    }
    do poke(r + 24, peek(a + 24 + 8 * i))
    let qd = 0
    if rt_bmcmp(r, b) >= 0 {
      let lr = rt_blen(r)
      let est = fdiv(rt_btop3(r, lr), fb)
      if lr > lb { let est = fmul(est, i2f(1000000000)) }
      let qd = f2i(est)
      if qd > 999999999 { let qd = 999999999 }
      if qd < 0 { let qd = 0 }
      do rt_bmulsmall(b, qd, t)
      while rt_bmcmp(t, r) > 0 {
        let qd = qd - 1
        do rt_bmulsmall(b, qd, t)
      }
      do rt_bmsubin(r, t)
      while rt_bmcmp(r, b) >= 0 {
        do rt_bmsubin(r, b)
        let qd = qd + 1
      }
    }
    do poke(q + 24 + 8 * i, qd)
    let i = i - 1
  }
  return r
}

# a // b (want 0) or a % b (want 1) for integers, floored as Pi's // and %: the remainder takes the divisor's sign
skill rt_bdivmod(a, b, want) -> Any {
  let x = rt_tobig(a)
  let y = rt_tobig(b)
  if rt_blen(y) == 0 { do rt_fail("integer division by zero") }
  let q = rt_bnew(0, rt_blen(x) + 1)
  let r = rt_bmdivmod(x, y, q)
  let sx = peek(x + 16)
  let sy = peek(y + 16)
  let exact = rt_blen(r) == 0
  if sx == sy {
    if want == 0 { return rt_bnorm(q) }
    do poke(r + 16, sy)
    return rt_bnorm(r)
  }
  if want == 0 {
    let qq = q
    if exact == 0 { let qq = rt_bmadd(q, rt_tobig(3), 0) }
    do poke(qq + 16, 1)
    return rt_bnorm(qq)
  }
  if exact { return 1 }
  return rt_bnorm(rt_bmsub(y, r, sy))
}

# a against b for integers -> -1, 0, 1 (raw)
skill rt_bcmp(a, b) -> Any {
  let x = rt_tobig(a)
  let y = rt_tobig(b)
  let sx = peek(x + 16)
  let sy = peek(y + 16)
  if sx != sy {
    if sx == 1 { return 0 - 1 }
    return 1
  }
  let c = rt_bmcmp(x, y)
  if sx == 1 { return 0 - c }
  return c
}

# a big as double bits (rounded; past ~1.8e308 it is infinite)
skill rt_btof(p) -> Any {
  let nl = rt_blen(p)
  let x = i2f(0)
  let i = nl - 1
  while i >= 0 {
    let x = fadd(fmul(x, i2f(1000000000)), i2f(peek(p + 24 + 8 * i)))
    let i = i - 1
  }
  if peek(p + 16) == 1 { let x = fmul(x, i2f(0 - 1)) }
  return x
}

# a big in decimal
skill rt_btoa(p) -> Any {
  let nl = rt_blen(p)
  let s = peek(p + 16)
  let top = rt_itoa(peek(p + 16 + 8 * nl))
  let tl = peek(top + 8)
  let out = rt_text_new(s + tl + 9 * (nl - 1))
  let k = 0
  if s == 1 {
    do pokeb(out + 16, 45)
    let k = 1
  }
  for i in range(0, tl) { do pokeb(out + 16 + k + i, peekb(top + 16 + i)) }
  let k = k + tl
  let i = nl - 2
  while i >= 0 {
    let x = peek(p + 24 + 8 * i)
    let j = 8
    while j >= 0 {
      do pokeb(out + 16 + k + j, 48 + x % 10)
      let x = x // 10
      let j = j - 1
    }
    let k = k + 9
    let i = i - 1
  }
  return out
}

# the digits s[i0 .. n) (checked by the caller) as an integer, negative if neg
skill rt_batoi(s, i0, n, neg) -> Any {
  let nd = n - i0
  let nl = (nd + 8) // 9
  let p = rt_bnew(neg, nl)
  for j in range(0, nl) {
    let e = n - 9 * j
    let b = e - 9
    if b < i0 { let b = i0 }
    let x = 0
    for k in range(b, e) { let x = x * 10 + (peekb(s + 16 + k) - 48) }
    do poke(p + 24 + 8 * j, x)
  }
  return rt_bnorm(p)
}

# a ^ e for an integer a and a raw e >= 0, exactly (squaring)
skill rt_bpow(a, e) -> Any {
  let r = 3
  let p = a
  let e = e
  while e > 0 {
    if e % 2 == 1 { let r = rt_bmul(r, p) }
    let e = e // 2
    if e > 0 { let p = rt_bmul(p, p) }
  }
  return r
}

# a real from a literal: mantissa m times ten to the e (both tagged integers pic worked out)
skill rt_reallit(m, e) -> Any {
  let mi = rt_untag(m)
  let k = rt_untag(e)
  # 9007199254740993.0 comes as 90071992547409930 e-1: drop the zeros first, so the value is rounded once
  while k < 0 and mi != 0 and mi % 10 == 0 {
    let mi = mi // 10
    let k = k + 1
  }
  let x = i2f(mi)
  # one multiply or divide by 10^|k| (exact up to 10^22), so the result is rounded once -- stepping by 10 rounded
  # at every step and left literals like 0.1 + 0.2 or 17-digit values an ulp off
  let kk = k
  if kk < 0 { let kk = 0 - kk }
  let p = i2f(1)
  while kk > 0 {
    let p = fmul(p, i2f(10))
    let kk = kk - 1
  }
  if k > 0 { return rt_mkreal(fmul(x, p)) }
  if k < 0 { return rt_mkreal(fdiv(x, p)) }
  return rt_mkreal(x)
}

# a decimal number's text ("2.5", "-1e3", " 0.125") -> the real, or null if it is not one
skill rt_parse_real(s) -> Any {
  let n = peek(s + 8)
  let i = 0
  while i < n and peekb(s + 16 + i) == 32 { let i = i + 1 }
  let neg = 0
  if i < n and peekb(s + 16 + i) == 45 {
    let neg = 1
    let i = i + 1
  } else {
    if i < n and peekb(s + 16 + i) == 43 { let i = i + 1 }
  }
  let m = 0
  let e = 0
  let nd = 0
  let any = 0
  while i < n and peekb(s + 16 + i) >= 48 and peekb(s + 16 + i) <= 57 {
    if nd < 18 {
      let m = m * 10 + peekb(s + 16 + i) - 48
      if m > 0 { let nd = nd + 1 }
    } else {
      let e = e + 1
    }
    let any = 1
    let i = i + 1
  }
  if i < n and peekb(s + 16 + i) == 46 {
    let i = i + 1
    while i < n and peekb(s + 16 + i) >= 48 and peekb(s + 16 + i) <= 57 {
      if nd < 18 {
        let m = m * 10 + peekb(s + 16 + i) - 48
        if m > 0 { let nd = nd + 1 }
        let e = e - 1
      }
      let any = 1
      let i = i + 1
    }
  }
  if any == 0 { return 0 }
  if i < n and (peekb(s + 16 + i) == 101 or peekb(s + 16 + i) == 69) {
    let i = i + 1
    let es = 1
    if i < n and peekb(s + 16 + i) == 45 {
      let es = 0 - 1
      let i = i + 1
    } else {
      if i < n and peekb(s + 16 + i) == 43 { let i = i + 1 }
    }
    let x = 0
    while i < n and peekb(s + 16 + i) >= 48 and peekb(s + 16 + i) <= 57 {
      if x < 100000 { let x = x * 10 + peekb(s + 16 + i) - 48 }
      let i = i + 1
    }
    let e = e + es * x
  }
  if neg { let m = 0 - m }
  return rt_reallit(rt_tag(m), rt_tag(e))
}

# a real as text: a whole value prints like an integer (as the interpreter's str does); otherwise up to six
# fractional digits, trailing zeros trimmed
skill rt_ftoa(bits) -> Any {
  let neg = flt(bits, i2f(0))
  let x = bits
  if neg { let x = fmul(bits, i2f(0 - 1)) }
  # 10^16 and past: d.dddddde+N (the whole part no longer fits the machine word, and was printed wrapped)
  let lim = fmul(i2f(100000000), i2f(100000000))
  if flt(x, lim) == 0 {
    if flt(fsub(x, x), i2f(1)) == 0 {
      if flt(i2f(0), x) == 0 { return "nan" }
      if neg { return "-inf" }
      return "inf"
    }
    let e = 0
    let ten = i2f(10)
    while flt(x, ten) == 0 {
      let x = fdiv(x, ten)
      let e = e + 1
    }
    let out = rt_concat(rt_concat(rt_ftoa(x), "e+"), rt_itoa(e))
    if neg { return rt_concat("-", out) }
    return out
  }
  let ip = f2i(x)
  let frac = fsub(x, i2f(ip))
  # round the fraction to six decimal places as one integer 0..1000000 (a carry rolls into the whole part)
  let half = fdiv(i2f(1), i2f(2))
  let fr = f2i(fadd(fmul(frac, i2f(1000000)), half))
  if fr >= 1000000 {
    let ip = ip + 1
    let fr = 0
  }
  let out = rt_itoa(ip)
  if fr > 0 {
    let ds = rt_itoa(fr)
    let pad = 6 - peek(ds + 8)
    let z = ""
    for i in range(0, pad) { let z = z ++ "0" }
    let ds = rt_concat(z, ds)
    let m = peek(ds + 8)
    while m > 1 and peekb(ds + 15 + m) == 48 { let m = m - 1 }
    let out = rt_concat(rt_concat(out, "."), rt_sub(ds, 0, m))
  }
  if neg { return rt_concat("-", out) }
  return out
}

# -- math words on reals ----------------------------------------------------------------------------------
# sqrt floor ceil round abs and ^ match the interpreter exactly (sqrt is sqrtsd, round is ties-to-even).
# Transcendental words (exp log sin cos) come later; they cannot be bit-identical to the interpreter's libm.

skill rt_sqrt(v) -> Any {
  let b = rt_realbits(v)
  if flt(b, i2f(0)) { return 0 }                 # sqrt of a negative is null, as the interpreter's is
  return rt_mkreal(fsqrt(b))
}

# int(x): a whole number -- a real cut toward zero (3.9 -> 3, -3.9 -> -3), text read as a number, integers as they are
skill rt_int(v) -> Any {
  let k = rt_kind(v)
  if k == 1 {
    let r = rt_num(v)
    if r == 0 { let r = rt_parse_real(v) }
    if r == 0 { return 0 }
    return rt_int(r)
  }
  if k != 6 { return v }
  let x = rt_realbits(v)
  let neg = 0
  if flt(x, i2f(0)) {
    let neg = 1
    let x = fmul(x, i2f(0 - 1))
  }
  # below 2^61: the machine cut; past it every real is whole -- halve it (exactly) below 2^61, then multiply back
  let top = fmul(i2f(1073741824), i2f(2147483648))
  let e = 0
  while flt(x, top) == 0 {
    let x = fdiv(x, i2f(2))
    let e = e + 1
    if e > 1100 { do rt_fail("int: not a finite number") }
  }
  let r = rt_tag(f2i(x))
  if e > 0 { let r = rt_bmul(r, rt_bpow(rt_tag(2), e)) }
  if neg { return rt_neg(r) }
  return r
}

# float(x): the same number as a real (text read first)
skill rt_float(v) -> Any {
  if rt_kind(v) == 1 {
    let r = rt_parse_real(v)
    if r == 0 { return 0 }
    return r
  }
  if v == 0 { return 0 }
  return rt_mkreal(rt_realbits(v))
}

skill rt_floorw(v) -> Any {
  if rt_kind(v) == 9 { return v }                # a big integer is already whole (a real would lose its digits)
  return rt_mkreal(rt_floor(rt_realbits(v)))
}

skill rt_ceil(v) -> Any {
  if rt_kind(v) == 9 { return v }
  let b = rt_realbits(v)
  return rt_mkreal(fmul(rt_floor(fmul(b, i2f(0 - 1))), i2f(0 - 1)))   # ceil(x) = -floor(-x)
}

# round(): half to even (banker's rounding), as the interpreter's round does
skill rt_round(v) -> Any {
  if rt_kind(v) == 9 { return v }
  let x = rt_realbits(v)
  let fl = rt_floor(x)
  let frac = fsub(x, fl)
  let half = fdiv(i2f(1), i2f(2))
  let nlo = f2i(fl)
  if flt(frac, half) { return rt_mkreal(fl) }
  if flt(half, frac) { return rt_mkreal(i2f(nlo + 1)) }
  if nlo % 2 == 0 { return rt_mkreal(fl) }
  return rt_mkreal(i2f(nlo + 1))
}

# a ^ b for an integer exponent: exact repeated squaring, giving a real as the interpreter's ^ does
skill rt_pow(a, b) -> Any {
  if rt_kind(b) != 4 {
    # a real exponent: a whole one (2.0) goes the exact way below; otherwise exp(b log a) for a > 0, 0 for a = 0
    let eb = rt_realbits(b)
    let wb = rt_floor(eb)
    let whole = flt(wb, eb) == 0 and flt(eb, wb) == 0
    if whole and flt(eb, i2f(1000000)) and flt(i2f(0 - 1000000), eb) { return rt_pow(rt_mkreal(rt_realbits(a)), rt_tag(f2i(wb))) }
    let x = rt_realbits(a)
    if flt(x, i2f(0)) { do rt_fail("pow: a negative number to a fractional power has no real value") }
    if flt(i2f(0), x) == 0 { return rt_mkreal(i2f(0)) }
    return rt_mkreal(rt_exp(fmul(eb, rt_log(x))))
  }
  # an integer to a whole power: exact, at any size (2 ^ 1000 used to go through reals and wrap)
  if rt_isint(a) and rt_untag(b) >= 0 { return rt_bpow(a, rt_untag(b)) }
  let base = rt_realbits(a)
  let e = rt_untag(b)
  let neg = 0
  if e < 0 {
    let neg = 1
    let e = 0 - e
  }
  let r = i2f(1)
  let p = base
  while e > 0 {
    if e % 2 == 1 { let r = fmul(r, p) }
    let p = fmul(p, p)
    let e = e // 2
  }
  if neg { let r = fdiv(i2f(1), r) }
  return rt_mkreal(r)
}

# -- transcendental words as Pi series ---------------------------------------------------------------------
# exp log log10 log2 sin cos tan atan, computed from series over the float primitives. They are Pi's own
# approximations (about 1e-12 on the tested ranges), NOT bit-identical to the interpreter's libm, so programs
# that must match should compare them by tolerance. pi and ln2 are derived from fast-converging series, not
# hardcoded. Everything here works on double bit patterns; the *w wrappers take and return tagged values.

# ln 2 from 2*atanh(1/3): t = 1/3 converges fast, so no constant is needed to bootstrap it
skill rt_ln2() -> Any {
  let t = fdiv(i2f(1), i2f(3))
  let t2 = fmul(t, t)
  let term = t
  let sum = t
  let k = 3
  while k < 44 {
    let term = fmul(term, t2)
    let sum = fadd(sum, fdiv(term, i2f(k)))
    let k = k + 2
  }
  return fmul(i2f(2), sum)
}

# atan(x) for a small |x| by its alternating series
skill rt_atans(x) -> Any {
  let x2 = fmul(x, x)
  let term = x
  let sum = x
  let k = 3
  let add = 0
  while k < 80 {
    let term = fmul(term, x2)
    let piece = fdiv(term, i2f(k))
    if add { let sum = fadd(sum, piece) } else { let sum = fsub(sum, piece) }
    let add = 1 - add
    let k = k + 2
  }
  return sum
}

# pi from Machin's formula 16*atan(1/5) - 4*atan(1/239)
skill rt_pi() -> Any {
  let a = rt_atans(fdiv(i2f(1), i2f(5)))
  let b = rt_atans(fdiv(i2f(1), i2f(239)))
  return fsub(fmul(i2f(16), a), fmul(i2f(4), b))
}

skill rt_exp(x) -> Any {
  let ln2 = rt_ln2()
  let kf = rt_floor(fadd(fdiv(x, ln2), fdiv(i2f(1), i2f(2))))
  let r = fsub(x, fmul(kf, ln2))
  let term = i2f(1)
  let sum = i2f(1)
  let nn = 1
  while nn < 20 {
    let term = fdiv(fmul(term, r), i2f(nn))
    let sum = fadd(sum, term)
    let nn = nn + 1
  }
  let k = f2i(kf)
  let p = sum
  while k > 0 {
    let p = fmul(p, i2f(2))
    let k = k - 1
  }
  while k < 0 {
    let p = fdiv(p, i2f(2))
    let k = k + 1
  }
  return p
}

# natural log: reduce x to m near 1 by powers of two, then log(m) = 2*atanh((m-1)/(m+1))
skill rt_log(x) -> Any {
  let ln2 = rt_ln2()
  let e = 0
  let m = x
  let hi = fdiv(i2f(4), i2f(3))
  let lo = fdiv(i2f(2), i2f(3))
  while flt(hi, m) {
    let m = fdiv(m, i2f(2))
    let e = e + 1
  }
  while flt(m, lo) {
    let m = fmul(m, i2f(2))
    let e = e - 1
  }
  let t = fdiv(fsub(m, i2f(1)), fadd(m, i2f(1)))
  let t2 = fmul(t, t)
  let term = t
  let sum = t
  let k = 3
  while k < 44 {
    let term = fmul(term, t2)
    let sum = fadd(sum, fdiv(term, i2f(k)))
    let k = k + 2
  }
  return fadd(fmul(i2f(e), ln2), fmul(i2f(2), sum))
}

# reduce an angle to [-pi, pi]
skill rt_reduce(x) -> Any {
  let tp = fmul(i2f(2), rt_pi())
  let q = rt_floor(fadd(fdiv(x, tp), fdiv(i2f(1), i2f(2))))
  return fsub(x, fmul(q, tp))
}

skill rt_sin(x) -> Any {
  let r = rt_reduce(x)
  let r2 = fmul(r, r)
  let term = r
  let sum = r
  let nn = 1
  while nn < 16 {
    let d = i2f(2 * nn * (2 * nn + 1))
    let term = fdiv(fmul(fmul(term, r2), i2f(0 - 1)), d)
    let sum = fadd(sum, term)
    let nn = nn + 1
  }
  return sum
}

skill rt_cos(x) -> Any {
  let r = rt_reduce(x)
  let r2 = fmul(r, r)
  let term = i2f(1)
  let sum = i2f(1)
  let nn = 1
  while nn < 16 {
    let d = i2f((2 * nn - 1) * (2 * nn))
    let term = fdiv(fmul(fmul(term, r2), i2f(0 - 1)), d)
    let sum = fadd(sum, term)
    let nn = nn + 1
  }
  return sum
}

# atan over the whole line: fold |x|>1 to 1/|x| (pi/2 - atan(1/x)), then if the argument is still not small,
# shift by pi/4 (atan(r) = pi/4 + atan((r-1)/(r+1))) so the series argument stays well under 1
skill rt_atan(x) -> Any {
  let neg = flt(x, i2f(0))
  let a = x
  if neg { let a = fmul(x, i2f(0 - 1)) }
  let big = flt(i2f(1), a)
  let r = a
  if big { let r = fdiv(i2f(1), a) }
  let shift = flt(fdiv(i2f(42), i2f(100)), r)
  let s = r
  if shift { let s = fdiv(fsub(r, i2f(1)), fadd(r, i2f(1))) }
  let v = rt_atans(s)
  if shift { let v = fadd(fdiv(rt_pi(), i2f(4)), v) }
  if big { let v = fsub(fdiv(rt_pi(), i2f(2)), v) }
  if neg { let v = fmul(v, i2f(0 - 1)) }
  return v
}

skill rt_expw(v) -> Any { return rt_mkreal(rt_exp(rt_realbits(v))) }
skill rt_logw(v) -> Any {
  let b = rt_realbits(v)
  if flt(i2f(0), b) == 0 { return 0 }
  return rt_mkreal(rt_log(b))
}
skill rt_log10w(v) -> Any {
  let b = rt_realbits(v)
  if flt(i2f(0), b) == 0 { return 0 }
  return rt_mkreal(fdiv(rt_log(b), rt_log(i2f(10))))
}
skill rt_log2w(v) -> Any {
  let b = rt_realbits(v)
  if flt(i2f(0), b) == 0 { return 0 }
  return rt_mkreal(fdiv(rt_log(b), rt_ln2()))
}
skill rt_sinw(v) -> Any { return rt_mkreal(rt_sin(rt_realbits(v))) }
skill rt_cosw(v) -> Any { return rt_mkreal(rt_cos(rt_realbits(v))) }
skill rt_tanw(v) -> Any {
  let b = rt_realbits(v)
  return rt_mkreal(fdiv(rt_sin(b), rt_cos(b)))
}
skill rt_atanw(v) -> Any { return rt_mkreal(rt_atan(rt_realbits(v))) }

# -- region memory -----------------------------------------------------------------------------------------
# There is no garbage collector; regions give memory back. `let m = mark()` remembers the allocation point;
# `release(m, keep)` frees everything allocated since, except `keep`, which is deep-copied (only the parts made
# after the mark), relocated down to the mark and returned. Values are never mutated, so nothing older can point
# into the region; any OTHER value made since the mark must not be used after the release.

skill rt_memused() -> Any { return rt_tag(peek(gaddr(0)) - peek(gaddr(3))) }
skill rt_mark() -> Any { return rt_tag(peek(gaddr(0))) }

# copy the parts of v that live in [lo, hi) to fresh memory above the heap top
skill rt_rcopy(v, lo, hi) -> Any {
  if v == 0 { return 0 }
  if v % 2 == 1 { return v }
  if v < lo or v >= hi { return v }
  let w = peek(v)
  let k = w % 256
  if k == 1 {
    let n = peek(v + 8)
    let r = rt_text_new(n)
    for i in range(0, n) { do pokeb(r + 16 + i, peekb(v + 16 + i)) }
    return r
  }
  if k == 3 {
    let n = peek(v + 8)
    let r = rt_map_alloc(n, 0)
    for i in range(0, 2 * n) { do poke(r + 16 + 8 * i, rt_rcopy(peek(v + 16 + 8 * i), lo, hi)) }
    do rt_mi_build(r)
    return r
  }
  if k == 2 {
    let n = peek(v + 8)
    let r = rt_obj(k, n, 8 * n)
    for i in range(0, n) { do poke(r + 16 + 8 * i, rt_rcopy(peek(v + 16 + 8 * i), lo, hi)) }
    return r
  }
  if k == 5 {
    let nc = w // 256
    let r = rt_alloc(16 + 8 * nc)
    do poke(r, w)
    do poke(r + 8, peek(v + 8))
    for i in range(0, nc) { do poke(r + 16 + 8 * i, rt_rcopy(peek(v + 16 + 8 * i), lo, hi)) }
    return r
  }
  if k == 7 or k == 8 or k == 9 {
    let ns = peek(v + 8)
    let r = rt_alloc(16 + 8 * ns)
    for i in range(0, 2 + ns) { do poke(r + 8 * i, peek(v + 8 * i)) }
    return r
  }
  let r = rt_alloc(16)
  do poke(r, w)
  do poke(r + 8, peek(v + 8))
  return r
}

# bytes an object occupies on the heap (allocations are rounded up to 8)
skill rt_objsize(p) -> Any {
  let w = peek(p)
  let k = w % 256
  if k == 1 { return (16 + peek(p + 8) + 7) // 8 * 8 }
  if k == 2 { return 16 + 8 * peek(p + 8) }
  if k == 3 { return rt_map_bytes(p) }
  if k == 5 { return 16 + 8 * (w // 256) }
  if k == 7 or k == 8 or k == 9 { return 16 + 8 * peek(p + 8) }
  return 16
}

# how many value-holding words follow an object's 16-byte header
skill rt_fields(p) -> Any {
  let w = peek(p)
  let k = w % 256
  if k == 2 { return peek(p + 8) }
  if k == 3 { return 2 * peek(p + 8) }
  if k == 5 { return w // 256 }
  return 0
}

skill rt_release(mt, keep) -> Any {
  let m = rt_untag(mt)
  let top = peek(gaddr(0))
  let c = rt_rcopy(keep, m, top)
  let fin = peek(gaddr(0))
  let delta = top - m
  # relocate pointers that point inside the copied block [top, fin)
  let p = top
  while p < fin {
    let nf = rt_fields(p)
    for i in range(0, nf) {
      let a = p + 16 + 8 * i
      let x = peek(a)
      if x % 2 == 0 and x >= top and x < fin { do poke(a, x - delta) }
    }
    let p = p + rt_objsize(p)
  }
  # move the block down to the mark and free everything above it
  let size = fin - top
  for i in range(0, size // 8) { do poke(m + 8 * i, peek(top + 8 * i)) }
  do poke(gaddr(0), m + size)
  if c % 2 == 0 and c >= top and c < fin { return c - delta }
  return c
}

# typeof(x): what kind of value x is, as text -- "null" "text" "list" "map" "int" "fn" "real"
skill rt_typeof(v) -> Any {
  let k = rt_kind(v)
  if k == 0 { return "null" }
  if k == 1 { return "text" }
  if k == 2 { return "list" }
  if k == 3 { return "map" }
  if k == 4 { return "int" }
  if k == 5 { return "fn" }
  if k == 7 { return "set" }
  if k == 8 { return "array" }
  if k == 9 { return "int" }
  return "real"
}

# -- hash sets of integers ------------------------------------------------------------------------------------
# A set object [7, slots, slot...] with open addressing. It holds integers only (never pointers), so it is safe
# alongside region memory. hset(n) makes one with n slots (keep it well under full); hset_add(s, k) adds the
# integer k and says whether it was new. This is the one mutable value in Pi: the set changes in place.
skill rt_hset(nt) -> Any {
  let n = rt_untag(nt)
  let p = rt_alloc(16 + 8 * n)
  do poke(p, 7)
  do poke(p + 8, n)
  for i in range(0, n) { do poke(p + 16 + 8 * i, 0) }
  return p
}

skill rt_hset_add(h, kt) -> Any {
  let n = peek(h + 8)
  let i = rt_untag(kt) % n
  let probes = 0
  while probes < n {
    let s = peek(h + 16 + 8 * i)
    if s == 0 {
      do poke(h + 16 + 8 * i, kt)
      return 3
    }
    if s == kt { return 1 }
    let i = i + 1
    if i == n { let i = 0 }
    let probes = probes + 1
  }
  return 1
}

# is the integer k in the set?
skill rt_hset_has(h, kt) -> Any {
  let n = peek(h + 8)
  let i = rt_untag(kt) % n
  let probes = 0
  while probes < n {
    let s = peek(h + 16 + 8 * i)
    if s == 0 { return 1 }
    if s == kt { return 3 }
    let i = i + 1
    if i == n { let i = 0 }
    let probes = probes + 1
  }
  return 1
}

# input(): the next line from standard input (without its line ending), or null at the end of input.
# Globals 4 and 5: the standard input handle, and a one-byte read buffer.
skill rt_input() -> Any {
  if peek(gaddr(4)) == 0 { do poke(gaddr(4), wcall("GetStdHandle", 0 - 10)) }
  let h = peek(gaddr(4))
  # a line of any length: the buffer doubles when full (it used to stop at 4,096 bytes and drop the rest)
  let cap = 4096
  let buf = rt_text_new(cap)
  let n = 0
  let got = 0
  let going = 1
  while going {
    do poke(gaddr(2), 0)
    let ok = wcall("ReadFile", h, gaddr(5), 1, gaddr(2), 0)
    if ok == 0 or peek(gaddr(2)) == 0 {
      let going = 0
    } else {
      let got = 1
      let b = peekb(gaddr(5))
      if b == 10 {
        let going = 0
      } else {
        if b != 13 {
          if n == cap {
            let nb = rt_text_new(2 * cap)
            for k in range(0, n) { do pokeb(nb + 16 + k, peekb(buf + 16 + k)) }
            let buf = nb
            let cap = 2 * cap
          }
          do pokeb(buf + 16 + n, b)
          let n = n + 1
        }
      }
    }
  }
  if got == 0 { return 0 }
  return rt_sub(buf, 0, n)
}

# ---- networking: Windows sockets, reached at run time (LoadLibraryA + GetProcAddress, called with wcallp) ----
skill rt_u32(v) -> Any { return (v % 4294967296 + 4294967296) % 4294967296 }

skill rt_wsproc(name) -> Any {
  let m = wcall("LoadLibraryA", rt_cstr("ws2_32.dll"))
  return wcall("GetProcAddress", m, rt_cstr(name))
}

# tcp(ip, port, data): connect to ip:port (dotted text), send all of data, read until the other side closes;
# -> the reply as text, or null if the connection fails
skill rt_tcp(ip, portt, data) -> Any {
  let port = rt_untag(portt)
  let wsa = rt_alloc(512)
  do wcallp(rt_wsproc("WSAStartup"), 514, wsa)
  let s = wcallp(rt_wsproc("socket"), 2, 1, 6)
  if s == 0 - 1 { return 0 }
  let sa = rt_alloc(16)
  for i in range(0, 16) { do pokeb(sa + i, 0) }
  do pokeb(sa, 2)
  do pokeb(sa + 2, port // 256)
  do pokeb(sa + 3, port % 256)
  let n = peek(ip + 8)
  let part = 0
  let k = 4
  for i in range(0, n) {
    let c = peekb(ip + 16 + i)
    if c == 46 {
      do pokeb(sa + k, part)
      let k = k + 1
      let part = 0
    } else {
      let part = part * 10 + c - 48
    }
  }
  do pokeb(sa + k, part)
  if rt_u32(wcallp(rt_wsproc("connect"), s, sa, 16)) != 0 {
    do wcallp(rt_wsproc("closesocket"), s)
    return 0
  }
  let len = peek(data + 8)
  let sent = 0
  let fsend = rt_wsproc("send")
  while sent < len {
    let r = rt_u32(wcallp(fsend, s, data + 16 + sent, len - sent, 0))
    if r == 0 or r >= 2147483648 {
      do wcallp(rt_wsproc("closesocket"), s)
      return 0
    }
    let sent = sent + r
  }
  let cap = 65536
  let buf = rt_alloc(cap)
  let got = 0
  let frecv = rt_wsproc("recv")
  let going = 1
  while going == 1 {
    if cap - got < 16384 {
      let nb = rt_alloc(cap * 2)
      for i in range(0, got // 8 + 1) { do poke(nb + 8 * i, peek(buf + 8 * i)) }
      let buf = nb
      let cap = cap * 2
    }
    let r = rt_u32(wcallp(frecv, s, buf + got, cap - got, 0))
    if r == 0 or r >= 2147483648 { let going = 0 } else { let got = got + r }
  }
  do wcallp(rt_wsproc("closesocket"), s)
  let t = rt_text_new(got)
  for i in range(0, got) { do pokeb(t + 16 + i, peekb(buf + i)) }
  return t
}

# ---- a web server's sockets (sitelib.pi's serve_http): listening is on 127.0.0.1 ONLY, never the network ----------
# rt_listen(port): a socket listening on 127.0.0.1:port -> the socket, or null (the port is taken)
skill rt_listen(portt) -> Any {
  let port = rt_untag(portt)
  let wsa = rt_alloc(512)
  do wcallp(rt_wsproc("WSAStartup"), 514, wsa)
  let s = wcallp(rt_wsproc("socket"), 2, 1, 6)
  if s == 0 - 1 { return 0 }
  let sa = rt_alloc(16)
  for i in range(0, 16) { do pokeb(sa + i, 0) }
  do pokeb(sa, 2)
  do pokeb(sa + 2, port // 256)
  do pokeb(sa + 3, port % 256)
  do pokeb(sa + 4, 127)
  do pokeb(sa + 7, 1)
  if rt_u32(wcallp(rt_wsproc("bind"), s, sa, 16)) != 0 {
    do wcallp(rt_wsproc("closesocket"), s)
    return 0
  }
  if rt_u32(wcallp(rt_wsproc("listen"), s, 16)) != 0 {
    do wcallp(rt_wsproc("closesocket"), s)
    return 0
  }
  return rt_tag(s)
}

# rt_accept(socket): wait for the next connection -> its socket, or null
skill rt_accept(st) -> Any {
  let c = wcallp(rt_wsproc("accept"), rt_untag(st), 0, 0)
  if c == 0 - 1 { return 0 }
  return rt_tag(c)
}

# rt_recv_some(socket): the bytes that have arrived (waiting for some), as text; "" once the other side closed
skill rt_recv_some(ct) -> Any {
  let cap = 65536
  let buf = rt_alloc(cap)
  let r = rt_u32(wcallp(rt_wsproc("recv"), rt_untag(ct), buf, cap, 0))
  if r >= 2147483648 { let r = 0 }
  let t = rt_text_new(r)
  for i in range(0, r) { do pokeb(t + 16 + i, peekb(buf + i)) }
  return t
}

# rt_send_all(socket, text): send every byte -> 1, or 0 if the connection broke
skill rt_send_all(ct, data) -> Any {
  let len = peek(data + 8)
  let sent = 0
  let fsend = rt_wsproc("send")
  while sent < len {
    let r = rt_u32(wcallp(fsend, rt_untag(ct), data + 16 + sent, len - sent, 0))
    if r == 0 or r >= 2147483648 { return rt_tag(0) }
    let sent = sent + r
  }
  return rt_tag(1)
}

skill rt_closesock(ct) -> Any {
  do wcallp(rt_wsproc("closesocket"), rt_untag(ct))
  return 0
}

# chr(n): the character with code n as UTF-8 text (chr(65) is "A", chr(233) is "é" -- two bytes, chr(9786) "☺")
skill rt_chr(nt) -> Any {
  let n = rt_untag(nt)
  if n < 0 or n > 1114111 { do rt_fail("chr: not a character code") }
  if n < 128 {
    let t = rt_text_new(1)
    do pokeb(t + 16, n)
    return t
  }
  if n < 2048 {
    let t = rt_text_new(2)
    do pokeb(t + 16, 192 + n // 64)
    do pokeb(t + 17, 128 + n % 64)
    return t
  }
  if n < 65536 {
    let t = rt_text_new(3)
    do pokeb(t + 16, 224 + n // 4096)
    do pokeb(t + 17, 128 + n // 64 % 64)
    do pokeb(t + 18, 128 + n % 64)
    return t
  }
  let t = rt_text_new(4)
  do pokeb(t + 16, 240 + n // 262144)
  do pokeb(t + 17, 128 + n // 4096 % 64)
  do pokeb(t + 18, 128 + n // 64 % 64)
  do pokeb(t + 19, 128 + n % 64)
  return t
}

# ---- Pi's senses and hands: Windows system DLLs reached at run time (no import entries, no outside libraries) ----
skill rt_proc(dll, name) -> Any {
  let m = wcall("LoadLibraryA", rt_cstr(dll))
  if m == 0 { return 0 }
  return wcall("GetProcAddress", m, rt_cstr(name))
}

skill rt_zero(p, n) -> Any {
  for i in range(0, n) { do pokeb(p + i, 0) }
  return p
}

skill rt_poke32(p, v) -> Any {
  let u = (v % 4294967296 + 4294967296) % 4294967296
  do pokeb(p, u % 256)
  do pokeb(p + 1, (u // 256) % 256)
  do pokeb(p + 2, (u // 65536) % 256)
  do pokeb(p + 3, (u // 16777216) % 256)
  return p
}

skill rt_peek32(p) -> Any { return peekb(p) + 256 * peekb(p + 1) + 65536 * peekb(p + 2) + 16777216 * peekb(p + 3) }

# spawn(command line): start another program (a Pi agent) with no window -> its process handle, or null
skill rt_spawn(cmd) -> Any {
  let si = rt_zero(rt_alloc(104), 104)
  do rt_poke32(si, 104)
  let pi = rt_zero(rt_alloc(24), 24)
  let ok = wcallp(rt_proc("kernel32.dll", "CreateProcessA"), 0, rt_cstr(cmd), 0, 0, 0, 134217728, 0, 0, si, pi)
  if rt_u32(ok) == 0 { return 0 }
  do wcallp(rt_proc("kernel32.dll", "CloseHandle"), peek(pi + 8))
  return rt_tag(peek(pi))
}

# spawn_out(cmd, path): run cmd with no window, its stdout and stderr going to the file path (created fresh); -> the
# process handle (for wait / rt_kill), or null. Called by name (rt_spawn_out) -- the brain's hands use it.
skill rt_spawn_out(cmd, path) -> Any {
  let sa = rt_zero(rt_alloc(24), 24)
  do rt_poke32(sa, 24)
  do rt_poke32(sa + 16, 1)
  let fh = wcall("CreateFileA", rt_cstr(path), 1073741824, 3, sa, 2, 128, 0)
  if fh == 0 - 1 { return 0 }
  let si = rt_zero(rt_alloc(104), 104)
  do rt_poke32(si, 104)
  do rt_poke32(si + 60, 256)
  do poke(si + 88, fh)
  do poke(si + 96, fh)
  let pi = rt_zero(rt_alloc(24), 24)
  let ok = wcallp(rt_proc("kernel32.dll", "CreateProcessA"), 0, rt_cstr(cmd), 0, 0, 1, 134217728, 0, 0, si, pi)
  do wcall("CloseHandle", fh)
  if rt_u32(ok) == 0 { return 0 }
  do wcallp(rt_proc("kernel32.dll", "CloseHandle"), peek(pi + 8))
  return rt_tag(peek(pi))
}

# kill(handle): end a process (one that wait timed out on) and close its handle
skill rt_kill(ht) -> Any {
  let h = rt_untag(ht)
  do wcallp(rt_proc("kernel32.dll", "TerminateProcess"), h, 1)
  do wcallp(rt_proc("kernel32.dll", "WaitForSingleObject"), h, 2000)
  do wcallp(rt_proc("kernel32.dll", "CloseHandle"), h)
  return rt_tag(0)
}

# wait(handle, ms): -> the agent's exit code once it has finished, or null if it is still running after ms
skill rt_wait(ht, mst) -> Any {
  let h = rt_untag(ht)
  let r = rt_u32(wcallp(rt_proc("kernel32.dll", "WaitForSingleObject"), h, rt_untag(mst)))
  if r != 0 { return 0 }
  let code = rt_zero(rt_alloc(8), 8)
  do wcallp(rt_proc("kernel32.dll", "GetExitCodeProcess"), h, code)
  do wcallp(rt_proc("kernel32.dll", "CloseHandle"), h)
  return rt_tag(rt_peek32(code))
}

# ---- Linux, where there is no desktop and no WinHTTP. The software is the screen: 64 by 64, white until a
# click paints a pixel. render draws its own bitmap. http:// goes out through the same sockets as tcp.
# https is not this. The machine is Softwell, not this screen.

skill rt_sw_desk() -> Any {
  let p = peek(gaddr(19))
  if p != 0 { return p }
  let p = rt_lx_map(64 + 64 * 64 * 4)
  do poke(gaddr(19), p)
  do poke(p + 48, 64)
  do poke(p + 56, 64)
  for i in range(0, 64 * 64 // 2) { do poke(p + 64 + 8 * i, 0 - 1) }
  return p
}

skill rt_sw_screen(stept) -> Any {
  let d = rt_sw_desk()
  let sw = peek(d + 48)
  let sh = peek(d + 56)
  let step = rt_untag(stept)
  if step < 1 { let step = 1 }
  let w = sw // step
  let h = sh // step
  let a = rt_arr(rt_tag(w * h))
  for y in range(0, h) {
    for x in range(0, w) {
      let p = d + 64 + 4 * ((y * step) * sw + x * step)
      do poke(a + 16 + 8 * (y * w + x), rt_tag(peekb(p + 2) * 65536 + peekb(p + 1) * 256 + peekb(p)))
    }
  }
  let out = rt_list_new(0)
  let out = rt_append(out, rt_tag(w))
  let out = rt_append(out, rt_tag(h))
  return rt_append(out, a)
}

skill rt_sw_render(txt, sizet, face) -> Any {
  let n = peek(txt + 8)
  let scale = rt_untag(sizet) // 8
  if scale < 1 { let scale = 1 }
  let gw = 6 * scale
  let gh = 8 * scale
  let w = 8 + n * gw
  let h = 8 + gh
  let a = rt_arr(rt_tag(w * h))
  for i in range(0, w * h) { do poke(a + 16 + 8 * i, rt_tag(16777215)) }
  for i in range(0, n) {
    let c = peekb(txt + 16 + i)
    for ry in range(0, 7) {
      for rx in range(0, 5) {
        let on = 0
        if c != 32 {
          if rx == 0 or rx == 4 or ry == c % 7 { let on = 1 }
        }
        if on == 1 {
          for sy in range(0, scale) {
            for sx in range(0, scale) {
              let x = 4 + i * gw + rx * scale + sx
              let y = 4 + ry * scale + sy
              do poke(a + 16 + 8 * (y * w + x), rt_tag(0))
            }
          }
        }
      }
    }
  }
  let out = rt_list_new(0)
  let out = rt_append(out, rt_tag(w))
  let out = rt_append(out, rt_tag(h))
  return rt_append(out, a)
}

skill rt_sw_mouse(xt, yt, bt) -> Any {
  let d = rt_sw_desk()
  let x = rt_untag(xt)
  let y = rt_untag(yt)
  do poke(d + 8, x)
  do poke(d + 16, y)
  do poke(d + 24, rt_untag(bt))
  if x >= 0 and x < peek(d + 48) and y >= 0 and y < peek(d + 56) {
    let p = d + 64 + 4 * (y * peek(d + 48) + x)
    do pokeb(p, 0)
    do pokeb(p + 1, 0)
    do pokeb(p + 2, 0)
  }
  return 3
}

skill rt_sw_key(vt) -> Any {
  do poke(rt_sw_desk() + 32, rt_untag(vt))
  return 3
}

skill rt_sw_fgwin() -> Any {
  let d = rt_sw_desk()
  let out = rt_list_new(0)
  let out = rt_append(out, rt_tag(0))
  let out = rt_append(out, rt_tag(0))
  let out = rt_append(out, rt_tag(peek(d + 48)))
  return rt_append(out, rt_tag(peek(d + 56)))
}

skill rt_sw_focus(cls) -> Any {
  let n = peek(cls + 8)
  if n != 2 { return 0 }
  if peekb(cls + 16) != 80 or peekb(cls + 17) != 105 { return 0 }
  do poke(rt_sw_desk() + 40, 1)
  return 3
}

skill rt_sw_play(path) -> Any {
  let h = wcall("CreateFileA", rt_cstr(path), 2147483648, 3, 0, 3, 128, 0)
  if h == 0 - 1 { return 0 }
  let b = rt_alloc(12)
  do poke(gaddr(2), 0)
  do wcall("ReadFile", h, b, 12, gaddr(2), 0)
  do wcall("CloseHandle", h)
  if peek(gaddr(2)) < 12 { return 0 }
  if peekb(b) != 82 or peekb(b + 1) != 73 or peekb(b + 2) != 70 or peekb(b + 3) != 70 { return 0 }
  if peekb(b + 8) != 87 or peekb(b + 9) != 65 or peekb(b + 10) != 86 or peekb(b + 11) != 69 { return 0 }
  return 3
}

skill rt_sw_hostip(url, hs, hostn, sa) -> Any {
  let dotted = 1
  for i in range(0, hostn) {
    let c = peekb(url + 16 + hs + i)
    if c != 46 and (c < 48 or c > 57) { let dotted = 0 }
  }
  if dotted == 0 { return 0 }
  let part = 0
  let k = 4
  for i in range(0, hostn) {
    let c = peekb(url + 16 + hs + i)
    if c == 46 {
      do pokeb(sa + k, part)
      let k = k + 1
      let part = 0
    } else {
      let part = part * 10 + c - 48
    }
  }
  do pokeb(sa + k, part)
  return 1
}

skill rt_sw_http(url) -> Any {
  let n = peek(url + 8)
  if n < 8 { return 0 }
  if peekb(url + 16 + 4) == 115 { return 0 }
  if peekb(url + 16) != 104 { return 0 }
  let at = 7
  let hs = 7
  while at < n and peekb(url + 16 + at) != 47 and peekb(url + 16 + at) != 58 { let at = at + 1 }
  let hostn = at - hs
  if hostn < 1 { return 0 }
  let port = 80
  if at < n and peekb(url + 16 + at) == 58 {
    let at = at + 1
    let port = 0
    while at < n and peekb(url + 16 + at) != 47 {
      let port = port * 10 + peekb(url + 16 + at) - 48
      let at = at + 1
    }
  }
  let sa = rt_alloc(16)
  for i in range(0, 16) { do pokeb(sa + i, 0) }
  do pokeb(sa, 2)
  do pokeb(sa + 2, port // 256)
  do pokeb(sa + 3, port % 256)
  if rt_sw_hostip(url, hs, hostn, sa) == 0 { return 0 }
  let s = rt_lx_socket(2, 1, 6)
  if s == 0 - 1 { return 0 }
  if rt_lx_connect(s, sa, 16) != 0 {
    do rt_lx_closesocket(s)
    return 0
  }
  let pathn = n - at
  if pathn < 1 {
    let pathn = 1
    let at = n
  }
  let reqn = 4 + pathn + 18 + hostn + 23
  let req = rt_alloc(reqn)
  do pokeb(req, 71)
  do pokeb(req + 1, 69)
  do pokeb(req + 2, 84)
  do pokeb(req + 3, 32)
  if pathn == 1 and at == n { do pokeb(req + 4, 47) } else {
    for i in range(0, pathn) { do pokeb(req + 4 + i, peekb(url + 16 + at + i)) }
  }
  let p = 4 + pathn
  let tail = " HTTP/1.0\r\nHost: "
  for i in range(0, 18) { do pokeb(req + p + i, peekb(tail + 16 + i)) }
  let p = p + 18
  for i in range(0, hostn) { do pokeb(req + p + i, peekb(url + 16 + hs + i)) }
  let p = p + hostn
  let end = "\r\nConnection: close\r\n\r\n"
  for i in range(0, 23) { do pokeb(req + p + i, peekb(end + 16 + i)) }
  let sent = 0
  while sent < reqn {
    let r = rt_lx_send(s, req + sent, reqn - sent, 0)
    if r == 0 - 1 {
      do rt_lx_closesocket(s)
      return 0
    }
    let sent = sent + r
  }
  let cap = 65536
  let buf = rt_alloc(cap)
  let got = 0
  let going = 1
  while going == 1 {
    if cap - got < 4096 {
      let nb = rt_alloc(cap * 2)
      for i in range(0, got) { do pokeb(nb + i, peekb(buf + i)) }
      let buf = nb
      let cap = cap * 2
    }
    let r = rt_lx_recv(s, buf + got, cap - got, 0)
    if r == 0 or r == 0 - 1 { let going = 0 } else { let got = got + r }
  }
  do rt_lx_closesocket(s)
  let cut = 0
  let i = 0
  while i + 3 < got and cut == 0 {
    if peekb(buf + i) == 13 and peekb(buf + i + 1) == 10 and peekb(buf + i + 2) == 13 and peekb(buf + i + 3) == 10 {
      let cut = i + 4
    }
    let i = i + 1
  }
  let t = rt_text_new(got - cut)
  for i in range(0, got - cut) { do pokeb(t + 16 + i, peekb(buf + cut + i)) }
  return t
}

# screen(step): what is on the screen now, every step-th pixel -> [width, height, arr of 0xRRGGBB]
skill rt_screen(stept) -> Any {
  if ostarget() != 0 { return rt_sw_screen(stept) }
  let step = rt_untag(stept)
  if step < 1 { let step = 1 }
  # real pixels: without this a scaled display (125%, 150%) hands Pi a resized, blurred copy of the screen
  do wcallp(rt_proc("user32.dll", "SetProcessDPIAware"))
  let sw = rt_u32(wcallp(rt_proc("user32.dll", "GetSystemMetrics"), 0))
  let sh = rt_u32(wcallp(rt_proc("user32.dll", "GetSystemMetrics"), 1))
  let hdc = wcallp(rt_proc("user32.dll", "GetDC"), 0)
  let mdc = wcallp(rt_proc("gdi32.dll", "CreateCompatibleDC"), hdc)
  let bmp = wcallp(rt_proc("gdi32.dll", "CreateCompatibleBitmap"), hdc, sw, sh)
  let old = wcallp(rt_proc("gdi32.dll", "SelectObject"), mdc, bmp)
  do wcallp(rt_proc("gdi32.dll", "BitBlt"), mdc, 0, 0, sw, sh, hdc, 0, 0, 13369376)
  let bi = rt_zero(rt_alloc(48), 48)
  do rt_poke32(bi, 40)
  do rt_poke32(bi + 4, sw)
  do rt_poke32(bi + 8, 0 - sh)
  do pokeb(bi + 12, 1)
  do pokeb(bi + 14, 32)
  let buf = rt_alloc(sw * sh * 4)
  do wcallp(rt_proc("gdi32.dll", "GetDIBits"), mdc, bmp, 0, sh, buf, bi, 0)
  do wcallp(rt_proc("gdi32.dll", "SelectObject"), mdc, old)
  do wcallp(rt_proc("gdi32.dll", "DeleteObject"), bmp)
  do wcallp(rt_proc("gdi32.dll", "DeleteDC"), mdc)
  do wcallp(rt_proc("user32.dll", "ReleaseDC"), 0, hdc)
  let w = sw // step
  let h = sh // step
  let a = rt_arr(rt_tag(w * h))
  for y in range(0, h) {
    for x in range(0, w) {
      let p = buf + 4 * ((y * step) * sw + x * step)
      do poke(a + 16 + 8 * (y * w + x), rt_tag(peekb(p + 2) * 65536 + peekb(p + 1) * 256 + peekb(p)))
    }
  }
  let out = rt_list_new(0)
  let out = rt_append(out, rt_tag(w))
  let out = rt_append(out, rt_tag(h))
  return rt_append(out, a)
}

# render(text, size, font): black text on white, drawn by Windows' own font engine (GDI, smoothed like the screen)
# -> [width, height, arr of 0xRRGGBB]; the text sits 4 pixels in from the top left. Pi's teacher for reading.
skill rt_render(txt, sizet, face) -> Any {
  if ostarget() != 0 { return rt_sw_render(txt, sizet, face) }
  let size = rt_untag(sizet)
  let n = peek(txt + 8)
  let s = rt_cstr(txt)
  # a font name ending in "@ct" draws with ClearType (coloured edges, as the screen does); otherwise greyscale smoothing
  let quality = 4
  let fl = peek(face + 8)
  let fname = rt_cstr(face)
  if fl > 3 {
    if peekb(face + 16 + fl - 3) == 64 and peekb(face + 16 + fl - 2) == 99 and peekb(face + 16 + fl - 1) == 116 {
      let quality = 5
      do pokeb(fname + fl - 3, 0)
    }
  }
  let hdc = wcallp(rt_proc("user32.dll", "GetDC"), 0)
  let mdc = wcallp(rt_proc("gdi32.dll", "CreateCompatibleDC"), hdc)
  let font = wcallp(rt_proc("gdi32.dll", "CreateFontA"), 0 - size, 0, 0, 0, 400, 0, 0, 0, 0, 0, 0, quality, 0, fname)
  let oldf = wcallp(rt_proc("gdi32.dll", "SelectObject"), mdc, font)
  let sz = rt_zero(rt_alloc(16), 16)
  do wcallp(rt_proc("gdi32.dll", "GetTextExtentPoint32A"), mdc, s, n, sz)
  let w = rt_peek32(sz) + 8
  let h = rt_peek32(sz + 4) + 8
  let bmp = wcallp(rt_proc("gdi32.dll", "CreateCompatibleBitmap"), hdc, w, h)
  let oldb = wcallp(rt_proc("gdi32.dll", "SelectObject"), mdc, bmp)
  do wcallp(rt_proc("gdi32.dll", "PatBlt"), mdc, 0, 0, w, h, 16711778)
  do wcallp(rt_proc("gdi32.dll", "SetBkMode"), mdc, 1)
  do wcallp(rt_proc("gdi32.dll", "SetTextColor"), mdc, 0)
  do wcallp(rt_proc("gdi32.dll", "TextOutA"), mdc, 4, 4, s, n)
  let bi = rt_zero(rt_alloc(48), 48)
  do rt_poke32(bi, 40)
  do rt_poke32(bi + 4, w)
  do rt_poke32(bi + 8, 0 - h)
  do pokeb(bi + 12, 1)
  do pokeb(bi + 14, 32)
  let buf = rt_alloc(w * h * 4)
  do wcallp(rt_proc("gdi32.dll", "GetDIBits"), mdc, bmp, 0, h, buf, bi, 0)
  do wcallp(rt_proc("gdi32.dll", "SelectObject"), mdc, oldb)
  do wcallp(rt_proc("gdi32.dll", "SelectObject"), mdc, oldf)
  do wcallp(rt_proc("gdi32.dll", "DeleteObject"), bmp)
  do wcallp(rt_proc("gdi32.dll", "DeleteObject"), font)
  do wcallp(rt_proc("gdi32.dll", "DeleteDC"), mdc)
  do wcallp(rt_proc("user32.dll", "ReleaseDC"), 0, hdc)
  let a = rt_arr(rt_tag(w * h))
  for i in range(0, w * h) {
    let p = buf + 4 * i
    do poke(a + 16 + 8 * i, rt_tag(peekb(p + 2) * 65536 + peekb(p + 1) * 256 + peekb(p)))
  }
  let out = rt_list_new(0)
  let out = rt_append(out, rt_tag(w))
  let out = rt_append(out, rt_tag(h))
  return rt_append(out, a)
}

# a Pi text as a NUL-ended UTF-16 string (bytes taken as code points) for the wide Windows calls
skill rt_wstr(s, f, n) -> Any {
  let p = rt_zero(rt_alloc(2 * n + 2), 2 * n + 2)
  for i in range(0, n) { do pokeb(p + 2 * i, peekb(s + 16 + f + i)) }
  return p
}

# http(url): GET an http:// or https:// page (WinHTTP does the TLS) -> the body as text, or null
skill rt_http(url) -> Any {
  if ostarget() != 0 { return rt_sw_http(url) }
  let n = peek(url + 8)
  let secure = 0
  let at = 0
  if n > 8 {
    if peekb(url + 16 + 4) == 115 and peekb(url + 16 + 5) == 58 {
      let secure = 1
      let at = 8
    }
  }
  if secure == 0 { let at = 7 }
  let hs = at
  while at < n and peekb(url + 16 + at) != 47 and peekb(url + 16 + at) != 58 { let at = at + 1 }
  let hostn = at - hs
  let port = 80
  if secure == 1 { let port = 443 }
  if at < n and peekb(url + 16 + at) == 58 {
    let at = at + 1
    let port = 0
    while at < n and peekb(url + 16 + at) != 47 {
      let port = port * 10 + peekb(url + 16 + at) - 48
      let at = at + 1
    }
  }
  let path = rt_wstr(url, at, n - at)
  if at >= n { let path = rt_wstr("/", 0, 1) }
  let ses = wcallp(rt_proc("winhttp.dll", "WinHttpOpen"), rt_wstr("Pi/1", 0, 4), 0, 0, 0, 0)
  if ses == 0 { return 0 }
  let con = wcallp(rt_proc("winhttp.dll", "WinHttpConnect"), ses, rt_wstr(url, hs, hostn), port, 0)
  let flags = 0
  if secure == 1 { let flags = 8388608 }
  let req = wcallp(rt_proc("winhttp.dll", "WinHttpOpenRequest"), con, rt_wstr("GET", 0, 3), path, 0, 0, 0, flags)
  let ok = 0
  if req != 0 { let ok = rt_u32(wcallp(rt_proc("winhttp.dll", "WinHttpSendRequest"), req, 0, 0, 0, 0, 0, 0)) }
  if ok != 0 { let ok = rt_u32(wcallp(rt_proc("winhttp.dll", "WinHttpReceiveResponse"), req, 0)) }
  let t = 0
  if ok != 0 {
    let cap = 65536
    let buf = rt_alloc(cap)
    let got = 0
    let avail = rt_alloc(8)
    let rd = rt_alloc(8)
    let going = 1
    while going == 1 {
      do rt_zero(avail, 8)
      do wcallp(rt_proc("winhttp.dll", "WinHttpQueryDataAvailable"), req, avail)
      let k = rt_peek32(avail)
      if k == 0 { let going = 0 } else {
        if got + k > cap {
          let nc = cap * 2
          while got + k > nc { let nc = nc * 2 }
          let nb = rt_alloc(nc)
          for i in range(0, got) { do pokeb(nb + i, peekb(buf + i)) }
          let buf = nb
          let cap = nc
        }
        do rt_zero(rd, 8)
        do wcallp(rt_proc("winhttp.dll", "WinHttpReadData"), req, buf + got, k, rd)
        let r = rt_peek32(rd)
        if r == 0 { let going = 0 }
        let got = got + r
      }
    }
    let t = rt_text_new(got)
    for i in range(0, got) { do pokeb(t + 16 + i, peekb(buf + i)) }
  }
  if req != 0 { do wcallp(rt_proc("winhttp.dll", "WinHttpCloseHandle"), req) }
  if con != 0 { do wcallp(rt_proc("winhttp.dll", "WinHttpCloseHandle"), con) }
  do wcallp(rt_proc("winhttp.dll", "WinHttpCloseHandle"), ses)
  return t
}

# ---- a host file and a wall clock. Not the machine. Softwell is the RAM, the SSD, the CPU, and the GPU. --------
# fmap(path): the whole file mapped into memory (the operating system pages it in from the SSD as it is touched)
# -> [address, size] as integers, or null; fbyte(m, i): its i-th byte. Huge files without reading them in.
skill rt_fmap(path) -> Any {
  let h = wcall("CreateFileA", rt_cstr(path), 2147483648, 3, 0, 3, 128, 0)
  if h == 0 - 1 { return 0 }
  let szp = rt_zero(rt_alloc(8), 8)
  do wcallp(rt_proc("kernel32.dll", "GetFileSizeEx"), h, szp)
  let size = peek(szp)
  if size == 0 { return 0 }
  let mp = wcallp(rt_proc("kernel32.dll", "CreateFileMappingA"), h, 0, 2, 0, 0, 0)
  if mp == 0 { return 0 }
  let base = wcallp(rt_proc("kernel32.dll", "MapViewOfFile"), mp, 4, 0, 0, 0)
  if base == 0 { return 0 }
  let out = rt_list_new(0)
  let out = rt_append(out, rt_tag(base))
  return rt_append(out, rt_tag(size))
}

skill rt_fbyte(m, it) -> Any {
  let base = rt_untag(peek(m + 16))
  let size = rt_untag(peek(m + 24))
  let i = rt_untag(it)
  if i < 0 or i >= size { return 0 }
  return rt_tag(peekb(base + i))
}

# ticks(): milliseconds since the machine started (for measuring)
skill rt_ticks() -> Any { return rt_tag(wcallp(rt_proc("kernel32.dll", "GetTickCount64"))) }

# microseconds from the performance counter (ticks() moves in ~15 ms steps, too coarse to time a kernel)
skill rt_usec() -> Any {
  let c = rt_zero(rt_alloc(8), 8)
  let f = rt_zero(rt_alloc(8), 8)
  do wcallp(rt_proc("kernel32.dll", "QueryPerformanceCounter"), c)
  do wcallp(rt_proc("kernel32.dll", "QueryPerformanceFrequency"), f)
  let fr = peek(f)
  return rt_tag(peek(c) // fr * 1000000 + peek(c) % fr * 1000000 // fr)
}

# the integer product below is the chip. There is no driver and no PTX launch.








# gpu_mm(A, B, n): C = A x B for n x n matrices of integers (arr, row by row). The same 32-bit product
# the mm kernel computes. There is no driver.
skill rt_sw_mm(a, b, nt) -> Any {
  let n = rt_untag(nt)
  let cells = n * n
  let c = rt_arr(rt_tag(cells))
  for i in range(0, n) {
    for j in range(0, n) {
      let acc = 0
      for k in range(0, n) {
        let av = rt_untag(peek(a + 16 + 8 * (i * n + k)))
        let bv = rt_untag(peek(b + 16 + 8 * (k * n + j)))
        let acc = acc + av * bv
      }
      let acc = acc % 4294967296
      if acc < 0 { let acc = acc + 4294967296 }
      if acc >= 2147483648 { let acc = acc - 4294967296 }
      do poke(c + 16 + 8 * (i * n + j), rt_tag(acc))
    }
  }
  return c
}

skill rt_gpu_mm(a, b, nt) -> Any {
  return rt_sw_mm(a, b, nt)
}

# seqk, with no driver. One program per id, base B, length L. A program that matches terms 2..7 on every
# sequence keeps the smaller id. // and % are floor, and a zero divisor is not a match. The result is one
# id per sequence, or -1.
skill rt_sw_seq(tg, st, lt, bt, nt, mt) -> Any {
  let S = rt_untag(st)
  let L = rt_untag(lt)
  let B = rt_untag(bt)
  let N = rt_untag(nt)
  let off = rt_untag(mt)
  let c = rt_arr(rt_tag(S))
  for s in range(0, S) { do poke(c + 16 + 8 * s, rt_tag(0 - 1)) }
  if L < 1 or B < 2 or N < 1 { return c }
  let toks = rt_alloc(8 * L)
  let stk = rt_alloc(64)
  let p = 0
  while p < N {
    let id = off + p
    let sp = 0
    let ok = 1
    let i = 0
    while i < L {
      let tok = id % B
      let id = id // B
      do poke(toks + 8 * i, tok)
      if tok < 6 {
        if sp >= 8 { let ok = 0 }
        let sp = sp + 1
      } else {
        if sp < 2 { let ok = 0 } else { let sp = sp - 1 }
      }
      let i = i + 1
    }
    if sp != 1 { let ok = 0 }
    if ok == 1 {
      for s in range(0, S) {
        let have = rt_untag(peek(c + 16 + 8 * s))
        let n = 2
        let match = 1
        while n <= 7 and match == 1 {
          let term = rt_untag(peek(tg + 16 + 8 * (s * 12 + n)))
          let a1 = rt_untag(peek(tg + 16 + 8 * (s * 12 + n - 1)))
          let a2 = rt_untag(peek(tg + 16 + 8 * (s * 12 + n - 2)))
          let sp = 0
          let bad = 0
          let i = 0
          while i < L and bad == 0 {
            let tok = peek(toks + 8 * i)
            if tok < 6 {
              let v = n
              if tok == 1 { let v = a1 }
              if tok == 2 { let v = a2 }
              if tok == 3 { let v = 1 }
              if tok == 4 { let v = 2 }
              if tok == 5 { let v = 3 }
              do poke(stk + 8 * sp, v)
              let sp = sp + 1
            } else {
              let sp = sp - 1
              let b = peek(stk + 8 * sp)
              let a = peek(stk + 8 * (sp - 1))
              let v = a + b
              if tok == 7 { let v = a - b }
              if tok == 8 { let v = a * b }
              if tok >= 9 {
                if b == 0 { let bad = 1 } else {
                  let v = a // b
                  if tok == 10 { let v = a % b }
                }
              }
              do poke(stk + 8 * (sp - 1), v)
            }
            let i = i + 1
          }
          if bad == 1 or peek(stk) != term { let match = 0 }
          let n = n + 1
        }
        if match == 1 {
          if have < 0 or off + p < have { do poke(c + 16 + 8 * s, rt_tag(off + p)) }
        }
      }
    }
    let p = p + 1
  }
  return c
}

# gpu_seq(ptx, targets, S, L, B, N, M): run a Pi-written kernel "seqk" over N candidate programs (one GPU thread
# each) against S target sequences of 12 terms (targets = S*12 integers, sent as 64-bit). The kernel writes a match
# count, then (program, sequence) pairs. -> [count, p0, s0, p1, s1, ...] (at most M pairs), or a negative code.
skill rt_gpu_seq(ptx, tg, st, lt, bt, nt, mt) -> Any {
  return rt_sw_seq(tg, st, lt, bt, nt, mt)
}

# ---- Softwell, the only machine (called by name). An address in the 64 KB is the GPU memory. A file is read
# by the host and copied in. Reals cross as doubles (their bits). No device, no driver, no second context.
# A launch of a kernel this chip does not run returns -400. An allocation past the end of RAM returns -700.
skill rt_sw_copy(d, s, n) -> Any {
  let i = 0
  while i + 8 <= n {
    do poke(d + i, peek(s + i))
    let i = i + 8
  }
  while i < n {
    do pokeb(d + i, peekb(s + i))
    let i = i + 1
  }
  return 0
}

skill rt_sw_zero(d, n) -> Any {
  let i = 0
  while i + 8 <= n {
    do poke(d + i, 0)
    let i = i + 8
  }
  while i < n {
    do pokeb(d + i, 0)
    let i = i + 1
  }
  return 0
}

skill rt_sw_entry(ptx, name) -> Any {
  let n = peek(ptx + 8)
  let m = peek(name + 8)
  let i = 0
  while i + 7 + m <= n {
    if peekb(ptx + 16 + i) == 46 and peekb(ptx + 17 + i) == 101 and peekb(ptx + 18 + i) == 110 and peekb(ptx + 19 + i) == 116 and peekb(ptx + 20 + i) == 114 and peekb(ptx + 21 + i) == 121 and peekb(ptx + 22 + i) == 32 {
      let ok = 1
      let j = 0
      while j < m and ok == 1 {
        if peekb(ptx + 23 + i + j) != peekb(name + 16 + j) { let ok = 0 }
        let j = j + 1
      }
      if ok == 1 {
        let c = peekb(ptx + 23 + i + m)
        if c == 32 or c == 40 { return 1 }
      }
    }
    let i = i + 1
  }
  return 0
}

skill rt_gpu_open() -> Any {
  return rt_tag(1)
}

skill rt_sw_ram() -> Any {
  if peek(gaddr(22)) == 0 { do poke(gaddr(22), wcall("VirtualAlloc", 0, 65536, 12288, 4)) }
  return peek(gaddr(22))
}

skill rt_sw_host(p) -> Any { return rt_tag(p) }

skill rt_sw_prog() -> Any { return rt_tag(rt_sw_ram()) }

# Copy n bytes of program text into RAM. 4 bytes a cycle. Returns the first free address.
# The program is replaced. An allocation already made is no longer in the count.
skill rt_sw_page(src, nt) -> Any {
  let n = rt_untag(nt)
  if n < 0 or n > 8388608 { return rt_tag(0 - 800) }
  let heap = 0
  if n > 0 { let heap = ((n + 7) // 8) * 8 }
  if heap > 65536 { return rt_tag(0 - 700) }
  let base = rt_sw_ram()
  if base == 0 { return rt_tag(0 - 700) }
  let s = rt_untag(src)
  let i = 0
  while i < n {
    do pokeb(base + i, peekb(s + i))
    let i = i + 1
  }
  do poke(gaddr(21), heap)
  let cyc = 0
  if n > 0 { let cyc = (n + 3) // 4 }
  do poke(gaddr(24), cyc)
  let pages = 0
  if n > 0 { let pages = (n + 4095) // 4096 }
  do poke(gaddr(26), pages)
  return rt_tag(base + heap)
}

skill rt_sw_retire(nt) -> Any {
  let n = rt_untag(nt)
  if n < 0 { let n = 0 }
  do poke(gaddr(25), peek(gaddr(25)) + n)
  return rt_tag(peek(gaddr(25)))
}

# The page-in, the statements retired, and the bus. One bus cycle moves 32 bytes.
skill rt_sw_clock() -> Any { return rt_tag(peek(gaddr(24)) + peek(gaddr(25)) + peek(gaddr(27))) }

# GPU wait so far. The page-in and the CPU are not in this register.
skill rt_sw_gpu() -> Any { return rt_tag(peek(gaddr(27))) }

# ceil(n / 32). For every n > 0, this B and the page-in P = ceil(n / 4) satisfy B ≤ P ≤ 8B.
skill rt_sw_bus(nt) -> Any {
  let n = rt_untag(nt)
  if n < 1 { return rt_tag(0) }
  return rt_tag((n + 31) // 32)
}

skill rt_sw_bound(nt) -> Any {
  let n = rt_untag(nt)
  if n < 1 { return rt_tag(0) }
  let p = (n + 3) // 4
  let b = (n + 31) // 32
  if b <= p and p <= 8 * b { return rt_tag(1) }
  return rt_tag(0)
}

skill rt_sw_note(n) -> Any {
  do poke(gaddr(28), n)
  return 0
}

skill rt_sw_finish(r) -> Any {
  if r == 1 {
    let n = peek(gaddr(28))
    if n > 0 { do poke(gaddr(27), peek(gaddr(27)) + (n + 31) // 32) }
  }
  do poke(gaddr(28), 0)
  return r
}

# 4 KB beside RAM. A shared row lives here, not in the 64 KB.
skill rt_sw_tmem() -> Any {
  if peek(gaddr(29)) == 0 { do poke(gaddr(29), wcall("VirtualAlloc", 0, 4096, 12288, 4)) }
  return rt_tag(peek(gaddr(29)))
}

skill rt_gpu_alloc(nt) -> Any {
  let n = rt_untag(nt)
  if n < 1 { let n = 1 }
  let used = peek(gaddr(21))
  if used + n > 65536 { return rt_tag(0 - 700) }
  let base = rt_sw_ram()
  if base == 0 { return rt_tag(0 - 700) }
  do poke(gaddr(21), used + n)
  return rt_tag(base + used)
}


# 8 MB of SSD. The chip holds one 4 KB page of it, not a second RAM. A miss copies that page at
# 4 bytes a cycle, which is 1,024. The bus still counts only the bytes the instruction uses.
skill rt_sw_ssd() -> Any {
  if peek(gaddr(30)) == 0 { do poke(gaddr(30), wcall("VirtualAlloc", 0, 8388608, 12288, 4)) }
  return peek(gaddr(30))
}

skill rt_sw_pg() -> Any { return rt_tag(peek(gaddr(24))) }

skill rt_sw_ssd_alloc(nt) -> Any {
  let n = rt_untag(nt)
  if n < 1 { let n = 1 }
  let n = ((n + 4095) // 4096) * 4096
  let used = peek(gaddr(31))
  let used = ((used + 4095) // 4096) * 4096
  if used + n > 8388608 { return rt_tag(0 - 800) }
  do poke(gaddr(31), used + n)
  return rt_tag(used)
}

skill rt_sw_page_at(off) -> Any {
  if off < 0 or off >= 8388608 { return 0 }
  let page = off // 4096
  let win = peek(gaddr(23))
  if win == 0 {
    let win = wcall("VirtualAlloc", 0, 4096, 12288, 4)
    do poke(gaddr(23), win)
  }
  if peek(gaddr(20)) != page + 1 {
    let src = rt_sw_ssd() + page * 4096
    let i = 0
    while i < 4096 {
      do pokeb(win + i, peekb(src + i))
      let i = i + 1
    }
    do poke(gaddr(20), page + 1)
    do poke(gaddr(24), peek(gaddr(24)) + 1024)
  }
  return win + (off % 4096)
}

skill rt_sw_ssd_ld(base, off) -> Any {
  let p = rt_sw_page_at(base + off)
  if p == 0 { return i2f(0) }
  return peek(p)
}

skill rt_sw_ssd_st(base, off, v) -> Any {
  let o = base + off
  let p = rt_sw_page_at(o)
  if p == 0 { return 0 }
  do poke(p, v)
  do poke(rt_sw_ssd() + o, v)
  return 0
}

skill rt_sw_ssd_ld32(base, off) -> Any {
  let p = rt_sw_page_at(base + off)
  if p == 0 { return 0 }
  return rt_peek32(p)
}

skill rt_sw_ssd_st32(base, off, bits) -> Any {
  let o = base + off
  let p = rt_sw_page_at(o)
  if p == 0 { return 0 }
  let u = rt_sw_f32_of(bits)
  do rt_poke32(p, u)
  do rt_poke32(rt_sw_ssd() + o, u)
  return 0
}

skill rt_sw_ssd_put(bt, ot, v) -> Any {
  do rt_sw_ssd_st(rt_untag(bt), rt_untag(ot), rt_realbits(v))
  return rt_tag(0)
}

skill rt_sw_ssd_putf(bt, ot, v) -> Any {
  do rt_sw_ssd_st32(rt_untag(bt), rt_untag(ot), rt_realbits(v))
  return rt_tag(0)
}

skill rt_sw_ssd_real(bt, ot) -> Any {
  return rt_mkreal(rt_sw_ssd_ld(rt_untag(bt), rt_untag(ot)))
}

# the bump goes back to the start of the 64 KB. The previous addresses are no longer RAM.
skill rt_sw_rewind() -> Any {
  do poke(gaddr(21), 0)
  return rt_tag(0)
}

# GPU memory back (a snapshot, a thought) -> 0 when it worked
skill rt_gpu_free(dt) -> Any {
  return rt_tag(0)
}

# bytes [off, off+n) of a file -> GPU memory at d, through one 64 MB host buffer
skill rt_gpu_file(dt, path, offt, nt) -> Any {
  let d = rt_untag(dt)
  let off = rt_untag(offt)
  let n = rt_untag(nt)
  let h = wcall("CreateFileA", rt_cstr(path), 2147483648, 3, 0, 3, 128, 0)
  if h == 0 - 1 { return rt_tag(0 - 1) }
  if rt_u32(wcall("SetFilePointerEx", h, off, 0, 0)) == 0 {
    do wcall("CloseHandle", h)
    return rt_tag(0 - 2)
  }
  let chunk = 67108864
  # (a small copy takes a small buffer: these were 64 MB a call, and 64 MB copies of a 2 KB vector add up)
  if n + 8 < chunk { let chunk = n + 8 }
  let buf = rt_alloc(chunk)
  let done = 0
  while done < n {
    let want = n - done
    if want > chunk { let want = chunk }
    do poke(gaddr(2), 0)
    do wcall("ReadFile", h, buf, want, gaddr(2), 0)
    let got = peek(gaddr(2)) % 4294967296
    if got == 0 { let done = n } else {
      do rt_sw_copy(d + done, buf, got)
      let done = done + got
    }
  }
  do wcall("CloseHandle", h)
  return rt_tag(done)
}

# a file kept open for reading (others may read and write it too) -> its handle, or null
skill rt_fopen_r(path) -> Any {
  let h = wcall("CreateFileA", rt_cstr(path), 2147483648, 3, 0, 3, 128, 0)
  if h == 0 - 1 { return 0 }
  return rt_tag(h)
}

# a file opened for overlapped reads (many at once, rt_read_batch) -> its handle, or null
skill rt_fopen_ov(path) -> Any {
  let h = wcall("CreateFileA", rt_cstr(path), 2147483648, 3, 0, 3, 1073741824, 0)
  if h == 0 - 1 { return 0 }
  return rt_tag(h)
}

# the same with FILE_FLAG_RANDOM_ACCESS: Windows then reads no further ahead than asked (an expert's neighbour in the
# file is rarely the next one needed) and keeps less of what nobody asked for in its file cache
skill rt_fopen_ovr(path) -> Any {
  let h = wcall("CreateFileA", rt_cstr(path), 2147483648, 3, 0, 3, 1342177280, 0)
  if h == 0 - 1 { return 0 }
  return rt_tag(h)
}

# requests [file offset, bytes, buffer offset, gpu destination] read from the overlapped file h all at once into the
# pinned buffer hb (an NVMe drive serves many reads in flight far faster than one at a time), each copied to the
# GPU as it arrives -> the bytes moved
skill rt_read_batch(ht, reqt, hbt) -> Any {
  let h = rt_untag(ht)
  let hb = rt_untag(hbt)
  let nreq = peek(reqt + 8)
  let ovs = rt_zero(rt_alloc(32 * nreq + 8), 32 * nreq + 8)
  let fev = rt_proc("kernel32.dll", "CreateEventA")
  let fres = rt_proc("kernel32.dll", "GetOverlappedResult")
  let fclose = rt_proc("kernel32.dll", "CloseHandle")
  let fread = rt_proc("kernel32.dll", "ReadFile")
  for i in range(0, nreq) {
    let rq = peek(reqt + 16 + 8 * i)
    let off = rt_untag(peek(rq + 16))
    let ov = ovs + 32 * i
    do rt_poke32(ov + 16, off % 4294967296)
    do rt_poke32(ov + 20, off // 4294967296)
    do poke(ov + 24, wcallp(fev, 0, 1, 0, 0))
    do wcallp(fread, h, hb + rt_untag(peek(rq + 32)), rt_untag(peek(rq + 24)), 0, ov)
  }
  let total = 0
  let cnt = rt_alloc(8)
  for i in range(0, nreq) {
    let rq = peek(reqt + 16 + 8 * i)
    let ov = ovs + 32 * i
    do poke(cnt, 0)
    do wcallp(fres, h, ov, cnt, 1)
    let got = peek(cnt) % 4294967296
    do rt_sw_copy(rt_untag(peek(rq + 40)), hb + rt_untag(peek(rq + 32)), got)
    do wcallp(fclose, peek(ov + 24))
    let total = total + got
  }
  return rt_tag(total)
}

# n bytes of page-locked host memory (fast copies to the GPU) -> its address, or -1
skill rt_host_alloc(nt) -> Any {
  let n = rt_untag(nt)
  if n < 1 { let n = 1 }
  let p = wcall("VirtualAlloc", 0, n, 12288, 4)
  if p == 0 { return rt_tag(0 - 1) }
  return rt_tag(p)
}

# a page-locked host buffer of n bytes that GPU kernels can address too -> [host address, device address], or null.
# What a kernel writes there the host reads after a sync with no copy call (a small copy costs ~20 us of driver).
skill rt_host_mapped(nt) -> Any {
  let h = rt_host_alloc(nt)
  if h < 0 { return 0 }
  let out = rt_list_new(0)
  let out = rt_append(out, h)
  return rt_append(out, h)
}

# a 32-bit integer into host memory at h (a mapped word a kernel will read)
skill rt_host_put32(ht, vt) -> Any {
  do rt_poke32(rt_untag(ht), rt_untag(vt))
  return vt
}

# n doubles at host address h (a mapped buffer, read after a sync) -> a list of reals
skill rt_host_get(ht, nt) -> Any {
  let h = rt_untag(ht)
  let n = rt_untag(nt)
  let l = rt_list_new(n)
  for i in range(0, n) { do poke(l + 16 + 8 * i, rt_mkreal(peek(h + 8 * i))) }
  return l
}

# integers xs as raw 8-byte words through the page-locked host buffer h to GPU memory at d, queued on stream st
# (the host does not wait; h must not be reused until the stream has passed this copy)
skill rt_gpu_put_u64_async(dt, xs, ht, st) -> Any {
  let n = peek(xs + 8)
  let d = rt_untag(dt)
  for i in range(0, n) { do poke(d + 8 * i, rt_untag(peek(xs + 16 + 8 * i))) }
  return rt_tag(n)
}

# host <-> GPU copies of n bytes, a page-locked buffer's free, and a host buffer to / from a file (the brain keeps its
# state snapshots in host memory: the VRAM they took is the experts' cache)
skill rt_gpu_to_host(ht, dt, nt) -> Any {
  do rt_sw_copy(rt_untag(ht), rt_untag(dt), rt_untag(nt))
  return rt_tag(0)
}
skill rt_host_to_gpu(dt, ht, nt) -> Any {
  do rt_sw_copy(rt_untag(dt), rt_untag(ht), rt_untag(nt))
  return rt_tag(0)
}
skill rt_host_free(ht) -> Any {
  return rt_tag(0)
}

skill rt_host_dump(ht, nt, path) -> Any {
  let h = wcall("CreateFileA", rt_cstr(path), 1073741824, 0, 0, 2, 128, 0)
  if h == 0 - 1 { return rt_tag(0) }
  let p = rt_untag(ht)
  let n = rt_untag(nt)
  let done = 0
  while done < n {
    let want = n - done
    if want > 1073741824 { let want = 1073741824 }
    do poke(gaddr(2), 0)
    do wcall("WriteFile", h, p + done, want, gaddr(2), 0)
    let got = peek(gaddr(2)) % 4294967296
    if got == 0 { let done = n + 1 } else { let done = done + got }
  }
  do wcall("CloseHandle", h)
  return rt_tag(done)
}

# n bytes of the file into host memory at h -> the bytes read
skill rt_host_load(ht, path, nt) -> Any {
  let h = wcall("CreateFileA", rt_cstr(path), 2147483648, 3, 0, 3, 128, 0)
  if h == 0 - 1 { return rt_tag(0) }
  let p = rt_untag(ht)
  let n = rt_untag(nt)
  let done = 0
  let stop = 0
  while done < n and stop == 0 {
    let want = n - done
    if want > 1073741824 { let want = 1073741824 }
    do poke(gaddr(2), 0)
    do wcall("ReadFile", h, p + done, want, gaddr(2), 0)
    let got = peek(gaddr(2)) % 4294967296
    if got == 0 { let stop = 1 } else { let done = done + got }
  }
  do wcall("CloseHandle", h)
  return rt_tag(done)
}

# n bytes at off of the open file h -> GPU memory at d, through the host buffer hb (cap bytes) -> the bytes moved
skill rt_gpu_fread(dt, ht, offt, nt, hbt, capt) -> Any {
  let d = rt_untag(dt)
  let h = rt_untag(ht)
  let n = rt_untag(nt)
  let hb = rt_untag(hbt)
  let cap = rt_untag(capt)
  if rt_u32(wcall("SetFilePointerEx", h, rt_untag(offt), 0, 0)) == 0 { return rt_tag(0 - 2) }
  let done = 0
  while done < n {
    let want = n - done
    if want > cap { let want = cap }
    do poke(gaddr(2), 0)
    do wcall("ReadFile", h, hb, want, gaddr(2), 0)
    let got = peek(gaddr(2)) % 4294967296
    if got == 0 { return rt_tag(done) }
    do rt_sw_copy(d + done, hb, got)
    let done = done + got
  }
  return rt_tag(done)
}

# n bytes of GPU memory from s to d (on the GPU, no host copy)
skill rt_gpu_copy(dt, st, nt) -> Any {
  if rt_untag(nt) <= 0 { return rt_tag(0) }
  do rt_sw_copy(rt_untag(dt), rt_untag(st), rt_untag(nt))
  return rt_tag(0)
}

# n bytes of GPU memory at d set to zero
skill rt_gpu_zero(dt, nt) -> Any {
  do rt_sw_zero(rt_untag(dt), rt_untag(nt))
  return rt_tag(0)
}

# n bytes of GPU memory at d -> a file (raw), through one 64 MB host buffer; -> the bytes written
skill rt_gpu_dump(dt, nt, path) -> Any {
  let d = rt_untag(dt)
  let n = rt_untag(nt)
  let h = wcall("CreateFileA", rt_cstr(path), 1073741824, 0, 0, 2, 128, 0)
  if h == 0 - 1 { return rt_tag(0 - 1) }
  let chunk = 67108864
  # (a small copy takes a small buffer: these were 64 MB a call, and 64 MB copies of a 2 KB vector add up)
  if n + 8 < chunk { let chunk = n + 8 }
  let buf = rt_alloc(chunk)
  let done = 0
  while done < n {
    let want = n - done
    if want > chunk { let want = chunk }
    do rt_sw_copy(buf, d + done, want)
    do poke(gaddr(2), 0)
    do wcall("WriteFile", h, buf, want, gaddr(2), 0)
    let done = done + want
  }
  do wcall("CloseHandle", h)
  return rt_tag(done)
}

# a list of numbers -> doubles in GPU memory at d
skill rt_gpu_put(dt, xs) -> Any {
  let n = peek(xs + 8)
  for i in range(0, n) { do poke(rt_untag(dt) + 8 * i, rt_realbits(peek(xs + 16 + 8 * i))) }
  return rt_tag(n)
}

# a list of integers -> raw 8-byte words in GPU memory at d (addresses, indices: not converted to doubles)
skill rt_gpu_put_u64(dt, xs) -> Any {
  let n = peek(xs + 8)
  for i in range(0, n) { do poke(rt_untag(dt) + 8 * i, rt_untag(peek(xs + 16 + 8 * i))) }
  return rt_tag(n)
}

# move(src, dst): a file renamed / moved (replacing dst) -> true when it worked. Pi deletes nothing: what it no
# longer wants is moved aside.
skill rt_move(st, dt) -> Any {
  let r = wcallp(rt_proc("kernel32.dll", "MoveFileExA"), rt_cstr(st), rt_cstr(dt), 1)
  if rt_u32(r) == 0 { return rt_tag(0) }
  return rt_tag(1)
}

# gather_put(d, base, offs, nb): the nb bytes at base + each offset of offs (a mapped file: no file is opened), side by
# side in one host buffer, copied to the GPU at d in one go -> the bytes copied
skill rt_gather_put(dt, bt, offs, nbt) -> Any {
  let d = rt_untag(dt)
  let base = rt_untag(bt)
  let nb = rt_untag(nbt)
  let n = peek(offs + 8)
  let hb = rt_alloc(n * nb + 8)
  for i in range(0, n) {
    let src = base + rt_untag(peek(offs + 16 + 8 * i))
    let dst = hb + i * nb
    for j in range(0, nb) { do pokeb(dst + j, peekb(src + j)) }
  }
  do rt_sw_copy(d, hb, n * nb)
  return rt_tag(n * nb)
}

# n doubles from GPU memory at d -> a list of reals
skill rt_gpu_get(dt, nt) -> Any {
  let n = rt_untag(nt)
  let l = rt_list_new(n)
  for i in range(0, n) { do poke(l + 16 + 8 * i, rt_mkreal(peek(rt_untag(dt) + 8 * i))) }
  return l
}

skill rt_gpu_module(ptx) -> Any {
  let p = rt_alloc(8)
  do poke(p, ptx)
  return rt_tag(p)
}

skill rt_gpu_fn(mt, name) -> Any {
  let ptx = peek(rt_untag(mt))
  if rt_sw_entry(ptx, name) == 0 { return rt_tag(0 - 400) }
  let f = rt_alloc(16)
  do poke(f, ptx)
  do poke(f + 8, name)
  return rt_tag(f)
}

skill rt_sw_text_is(t, s) -> Any {
  let n = peek(t + 8)
  if n != peek(s + 8) { return 0 }
  let i = 0
  while i < n {
    if peekb(t + 16 + i) != peekb(s + 16 + i) { return 0 }
    let i = i + 1
  }
  return 1
}

# a double's bits, rounded to f32 the way fma.rn.f32 rounds. Every f32 value is an exact double, so a
# product of two of them added in double and rounded once is that f32 fma.
skill rt_sw_f32_of(dbits) -> Any {
  let sign = shr(dbits, 63)
  let exp = band(shr(dbits, 52), 2047)
  let man = band(dbits, 4503599627370495)
  if exp == 2047 {
    if man == 0 { return bor(shl(sign, 31), 2139095040) }
    return bor(shl(sign, 31), 2143289344)
  }
  if exp == 0 { return shl(sign, 31) }
  let fexp = exp - 1023 + 127
  if fexp >= 255 { return bor(shl(sign, 31), 2139095040) }
  if fexp <= 0 { return shl(sign, 31) }
  let top = shr(man, 29)
  let roundb = band(shr(man, 28), 1)
  let sticky = band(man, 268435455)
  if roundb == 1 {
    if sticky != 0 { let top = top + 1 } else {
      if band(top, 1) == 1 { let top = top + 1 }
    }
  }
  if top >= 8388608 {
    let top = 0
    let fexp = fexp + 1
    if fexp >= 255 { return bor(shl(sign, 31), 2139095040) }
  }
  return bor(shl(sign, 31), bor(shl(fexp, 23), top))
}

skill rt_sw_f64_of(u) -> Any {
  let u = band(u, 4294967295)
  let sign = shr(u, 31)
  let exp = band(shr(u, 23), 255)
  let man = band(u, 8388607)
  if exp == 255 { return bor(shl(sign, 63), bor(shl(2047, 52), shl(man, 29))) }
  if exp == 0 {
    if man == 0 { return shl(sign, 63) }
    let s = 0
    while man < 8388608 {
      let man = shl(man, 1)
      let s = s + 1
    }
    let man = band(man, 8388607)
    return bor(shl(sign, 63), bor(shl(897 - s, 52), shl(man, 29)))
  }
  return bor(shl(sign, 63), bor(shl(exp - 127 + 1023, 52), shl(man, 29)))
}

skill rt_sw_fma32(a, b, c) -> Any {
  return rt_sw_f64_of(rt_sw_f32_of(fadd(fmul(a, b), c)))
}

skill rt_sw_f32tag(real) -> Any { return rt_tag(rt_sw_f32_of(rt_realbits(real))) }

skill rt_sw_stf(pt, it, real) -> Any {
  do rt_poke32(rt_untag(pt) + 4 * rt_untag(it), rt_sw_f32_of(rt_realbits(real)))
  return rt_tag(0)
}

skill rt_sw_ldf(pt, it) -> Any {
  return rt_mkreal(rt_sw_f64_of(rt_peek32(rt_untag(pt) + 4 * rt_untag(it))))
}

# pi_conv: sample start+t is the f32 dot of the impulse with the dry samples at that point and before it.
# Left and right are separate. A thread past n writes nothing.
skill rt_sw_conv(gx, bx, ps) -> Any {
  let dry = rt_untag(peek(ps + 16))
  let irp = rt_untag(peek(ps + 24))
  let out = rt_untag(peek(ps + 32))
  let m = rt_untag(peek(ps + 40))
  let start = rt_untag(peek(ps + 48))
  let n = rt_untag(peek(ps + 56))
  let bs = rt_untag(bx)
  do rt_sw_note(16 * n + 16 * m)
  let blocks = rt_untag(gx)
  let t = 0
  let lim = blocks * bs
  while t < lim {
    if t < n {
      let idx = start + t
      let count = m
      if idx + 1 < count { let count = idx + 1 }
      let accL = rt_sw_f64_of(0)
      let accR = rt_sw_f64_of(0)
      let i = 0
      while i < count {
        let irL = rt_sw_f64_of(rt_peek32(irp + 8 * i))
        let irR = rt_sw_f64_of(rt_peek32(irp + 8 * i + 4))
        let dL = rt_sw_f64_of(rt_peek32(dry + 8 * (idx - i)))
        let dR = rt_sw_f64_of(rt_peek32(dry + 8 * (idx - i) + 4))
        let accL = rt_sw_fma32(irL, dL, accL)
        let accR = rt_sw_fma32(irR, dR, accR)
        let i = i + 1
      }
      do rt_poke32(out + 8 * idx, rt_sw_f32_of(accL))
      do rt_poke32(out + 8 * idx + 4, rt_sw_f32_of(accR))
    }
    let t = t + 1
  }
  return rt_tag(0)
}

skill rt_sw_mul32(a, b) -> Any { return rt_sw_f64_of(rt_sw_f32_of(fmul(a, b))) }

skill rt_sw_add32(a, b) -> Any { return rt_sw_f64_of(rt_sw_f32_of(fadd(a, b))) }

skill rt_sw_div32(a, b) -> Any { return rt_sw_f64_of(rt_sw_f32_of(fdiv(a, b))) }

skill rt_sw_sqrt32(a) -> Any { return rt_sw_f64_of(rt_sw_f32_of(fsqrt(a))) }

# nearest integer, ties to even, from a double's bits
skill rt_sw_rni(dbits) -> Any {
  let t = f2i(dbits)
  let whole = i2f(t)
  let ad = dbits
  let aw = whole
  if flt(dbits, i2f(0)) {
    let ad = fsub(i2f(0), dbits)
    let aw = fsub(i2f(0), whole)
  }
  let diff = fsub(ad, aw)
  let half = fdiv(i2f(1), i2f(2))
  let away = 0
  if flt(half, diff) { let away = 1 }
  if flt(diff, half) == 0 and flt(half, diff) == 0 {
    if band(t, 1) == 1 { let away = 1 }
  }
  if away == 0 { return t }
  if flt(dbits, i2f(0)) { return t - 1 }
  return t + 1
}

skill rt_sw_byte(pt, it) -> Any { return rt_tag(peekb(rt_untag(pt) + rt_untag(it))) }

# pi_mix: dry and wet scaled, then x / (1 + x^4)^(1/4), then the 24-bit sample.
skill rt_sw_mix(gx, bx, ps) -> Any {
  let dry = rt_untag(peek(ps + 16))
  let wet = rt_untag(peek(ps + 24))
  let pcm = rt_untag(peek(ps + 32))
  let start = rt_untag(peek(ps + 40))
  let n = rt_untag(peek(ps + 48))
  let dryg = rt_untag(peek(ps + 56))
  do rt_sw_note(22 * n)
  let wetg = rt_untag(peek(ps + 64))
  let pbs = rt_untag(peek(ps + 72))
  let blocks = rt_untag(gx)
  let tx = rt_untag(bx)
  let scale = rt_sw_f64_of(1258291198)
  let unit = rt_sw_f64_of(1065353216)
  let g0 = rt_sw_mul32(rt_sw_f64_of(rt_sw_f32_of(i2f(dryg))), rt_sw_f64_of(897988541))
  let g1 = rt_sw_mul32(rt_sw_f64_of(rt_sw_f32_of(i2f(wetg))), rt_sw_f64_of(897988541))
  let b = 0
  while b < blocks {
    let th = 0
    while th < tx {
      let t = b * pbs + th
      if t < n {
        let idx = start + t
        let dL = rt_sw_f64_of(rt_peek32(dry + 8 * idx))
        let dR = rt_sw_f64_of(rt_peek32(dry + 8 * idx + 4))
        let wL = rt_sw_f64_of(rt_peek32(wet + 8 * idx))
        let wR = rt_sw_f64_of(rt_peek32(wet + 8 * idx + 4))
        let L = rt_sw_fma32(wL, g1, rt_sw_mul32(dL, g0))
        let R = rt_sw_fma32(wR, g1, rt_sw_mul32(dR, g0))
        let aL = band(L, 9223372036854775807)
        let pL = rt_sw_mul32(aL, aL)
        let pL = rt_sw_mul32(pL, pL)
        let pL = rt_sw_add32(pL, unit)
        let pL = rt_sw_sqrt32(pL)
        let pL = rt_sw_sqrt32(pL)
        let L = rt_sw_mul32(rt_sw_div32(L, pL), scale)
        let aR = band(R, 9223372036854775807)
        let pR = rt_sw_mul32(aR, aR)
        let pR = rt_sw_mul32(pR, pR)
        let pR = rt_sw_add32(pR, unit)
        let pR = rt_sw_sqrt32(pR)
        let pR = rt_sw_sqrt32(pR)
        let R = rt_sw_mul32(rt_sw_div32(R, pR), scale)
        let iL = rt_sw_rni(L)
        let iR = rt_sw_rni(R)
        let p = pcm + 6 * idx
        do pokeb(p, band(iL, 255))
        do pokeb(p + 1, band(shr(iL, 8), 255))
        do pokeb(p + 2, band(shr(iL, 16), 255))
        do pokeb(p + 3, band(iR, 255))
        do pokeb(p + 4, band(shr(iR, 8), 255))
        do pokeb(p + 5, band(shr(iR, 16), 255))
      }
      let th = th + 1
    }
    let b = b + 1
  }
  return rt_tag(0)
}

skill rt_sw_u32(pt) -> Any { return rt_tag(rt_peek32(rt_untag(pt))) }

# pi_peak: the louder of the two channels, times 100000, truncated. The word at ppk keeps the greatest.
skill rt_sw_peak(gx, bx, ps) -> Any {
  let buf = rt_untag(peek(ps + 16))
  let pk = rt_untag(peek(ps + 24))
  let n = rt_untag(peek(ps + 32))
  let pbs = rt_untag(peek(ps + 40))
  do rt_sw_note(8 * n + 4)
  let blocks = rt_untag(gx)
  let tx = rt_untag(bx)
  let scale = rt_sw_f64_of(1203982336)
  let best = rt_peek32(pk)
  let b = 0
  while b < blocks {
    let th = 0
    while th < tx {
      let t = b * pbs + th
      if t < n {
        let L = band(rt_sw_f64_of(rt_peek32(buf + 8 * t)), 9223372036854775807)
        let R = band(rt_sw_f64_of(rt_peek32(buf + 8 * t + 4)), 9223372036854775807)
        let m = L
        if flt(m, R) { let m = R }
        let u = f2i(rt_sw_mul32(m, scale))
        if u < 0 { let u = 0 }
        if best < u { let best = u }
      }
      let th = th + 1
    }
    let b = b + 1
  }
  do rt_poke32(pk, best)
  return rt_tag(0)
}

skill rt_sw_stb(pt, it, vt) -> Any {
  do pokeb(rt_untag(pt) + rt_untag(it), rt_untag(vt))
  return rt_tag(0)
}

# pi_nv12: one RGB byte triple becomes a limited-range BT.709 Y. Even pixels also write the block's U and V.
skill rt_sw_nv12(gx, bx, ps) -> Any {
  let rgb = rt_untag(peek(ps + 16))
  let nv = rt_untag(peek(ps + 24))
  let w = rt_untag(peek(ps + 32))
  let h = rt_untag(peek(ps + 40))
  let pitch = rt_untag(peek(ps + 48))
  let pbs = rt_untag(peek(ps + 56))
  do rt_sw_note(3 * w * h + pitch * h + pitch * ((h + 1) // 2))
  let blocks = rt_untag(gx)
  let tx = rt_untag(bx)
  let yr = rt_sw_f64_of(1046066128)
  let yg = rt_sw_f64_of(1060575065)
  let yb = rt_sw_f64_of(1033100696)
  let ys = rt_sw_f64_of(1062984668)
  let yo = rt_sw_f64_of(1099169792)
  let q = rt_sw_f64_of(1048576000)
  let ur = rt_sw_f64_of(3186275176)
  let ug = rt_sw_f64_of(3200602918)
  let ub = rt_sw_f64_of(1056964608)
  let us = rt_sw_f64_of(1063313633)
  let uo = rt_sw_f64_of(1124106240)
  let vr = rt_sw_f64_of(1056964608)
  let vg = rt_sw_f64_of(3202911463)
  let vb = rt_sw_f64_of(3174806690)
  let b = 0
  while b < blocks {
    let th = 0
    while th < tx {
      let t = b * pbs + th
      if t < w * h {
        let x = t % w
        let y = t // w
        let p = rgb + 3 * t
        let r = peekb(p)
        let g = peekb(p + 1)
        let bl = peekb(p + 2)
        let f = rt_sw_mul32(rt_sw_f64_of(rt_sw_f32_of(i2f(r))), yr)
        let f = rt_sw_fma32(rt_sw_f64_of(rt_sw_f32_of(i2f(g))), yg, f)
        let f = rt_sw_fma32(rt_sw_f64_of(rt_sw_f32_of(i2f(bl))), yb, f)
        let f = rt_sw_add32(rt_sw_mul32(f, ys), yo)
        let Y = f2i(f)
        if Y < 0 { let Y = 0 }
        if Y > 235 { let Y = 235 }
        do pokeb(nv + y * pitch + x, Y)
        if band(x, 1) == 0 and band(y, 1) == 0 {
          let p1 = p + 3
          let row = w * 3
          let p2 = p + row
          let p3 = p2 + 3
          let rs = r + peekb(p1) + peekb(p2) + peekb(p3)
          let gs = g + peekb(p1 + 1) + peekb(p2 + 1) + peekb(p3 + 1)
          let bs = bl + peekb(p1 + 2) + peekb(p2 + 2) + peekb(p3 + 2)
          let r4 = rt_sw_mul32(rt_sw_f64_of(rt_sw_f32_of(i2f(rs))), q)
          let g4 = rt_sw_mul32(rt_sw_f64_of(rt_sw_f32_of(i2f(gs))), q)
          let b4 = rt_sw_mul32(rt_sw_f64_of(rt_sw_f32_of(i2f(bs))), q)
          let U = rt_sw_mul32(r4, ur)
          let U = rt_sw_fma32(g4, ug, U)
          let U = rt_sw_fma32(b4, ub, U)
          let U = rt_sw_add32(rt_sw_mul32(U, us), uo)
          let V = rt_sw_mul32(r4, vr)
          let V = rt_sw_fma32(g4, vg, V)
          let V = rt_sw_fma32(b4, vb, V)
          let V = rt_sw_add32(rt_sw_mul32(V, us), uo)
          let Ui = f2i(U)
          let Vi = f2i(V)
          if Ui < 0 { let Ui = 0 }
          if Vi < 0 { let Vi = 0 }
          if Ui > 240 { let Ui = 240 }
          if Vi > 240 { let Vi = 240 }
          let c = nv + h * pitch + (y // 2) * pitch + x
          do pokeb(c, Ui)
          do pokeb(c + 1, Vi)
        }
      }
      let th = th + 1
    }
    let b = b + 1
  }
  return rt_tag(0)
}

skill rt_sw_arg(ps, i) -> Any { return rt_untag(peek(ps + 16 + 8 * i)) }

skill rt_sw_ld32(p) -> Any { return rt_sw_f64_of(rt_peek32(p)) }

skill rt_sw_st32(p, bits) -> Any {
  do rt_poke32(p, rt_sw_f32_of(bits))
  return 0
}

# n float32 ones at a raw or tagged address. The harness's own 1.0 is a tagged real, and this is not.
skill rt_sw_onef(pt, nt) -> Any {
  let p = rt_untag(pt)
  let n = rt_untag(nt)
  let i = 0
  while i < n {
    do rt_sw_st32(p + 4 * i, i2f(1))
    let i = i + 1
  }
  return rt_tag(0)
}

# C[M,N] = A[M,K] . B[K,N]
skill rt_sw_gemm(gx, bx, ps) -> Any {
  let A = rt_sw_arg(ps, 0)
  let B = rt_sw_arg(ps, 1)
  let C = rt_sw_arg(ps, 2)
  let M = rt_sw_arg(ps, 3)
  let K = rt_sw_arg(ps, 4)
  let N = rt_sw_arg(ps, 5)
  do rt_sw_note(4 * (M * K + K * N + M * N))
  let lim = rt_untag(gx) * rt_untag(bx)
  let count = M * N
  let t = 0
  while t < lim {
    if t < count {
      let row = t // N
      let col = t % N
      let acc = rt_sw_f64_of(0)
      let k = 0
      while k < K {
        let acc = rt_sw_fma32(rt_sw_ld32(A + 4 * (row * K + k)), rt_sw_ld32(B + 4 * (k * N + col)), acc)
        let k = k + 1
      }
      do rt_sw_st32(C + 4 * t, acc)
    }
    let t = t + 1
  }
  return rt_tag(0)
}

# C[K,N] = A[M,K]^T . B[M,N]
skill rt_sw_atb(gx, bx, ps) -> Any {
  let A = rt_sw_arg(ps, 0)
  let B = rt_sw_arg(ps, 1)
  let C = rt_sw_arg(ps, 2)
  let M = rt_sw_arg(ps, 3)
  let K = rt_sw_arg(ps, 4)
  let N = rt_sw_arg(ps, 5)
  do rt_sw_note(4 * (M * K + M * N + K * N))
  let lim = rt_untag(gx) * rt_untag(bx)
  let count = K * N
  let t = 0
  while t < lim {
    if t < count {
      let row = t // N
      let col = t % N
      let acc = rt_sw_f64_of(0)
      let m = 0
      while m < M {
        let acc = rt_sw_fma32(rt_sw_ld32(A + 4 * (m * K + row)), rt_sw_ld32(B + 4 * (m * N + col)), acc)
        let m = m + 1
      }
      do rt_sw_st32(C + 4 * t, acc)
    }
    let t = t + 1
  }
  return rt_tag(0)
}

# C[M,K] = A[M,N] . B[K,N]^T
skill rt_sw_abt(gx, bx, ps) -> Any {
  let A = rt_sw_arg(ps, 0)
  let B = rt_sw_arg(ps, 1)
  let C = rt_sw_arg(ps, 2)
  let M = rt_sw_arg(ps, 3)
  let K = rt_sw_arg(ps, 4)
  let N = rt_sw_arg(ps, 5)
  do rt_sw_note(4 * (M * N + K * N + M * K))
  let lim = rt_untag(gx) * rt_untag(bx)
  let count = M * K
  let t = 0
  while t < lim {
    if t < count {
      let row = t // K
      let col = t % K
      let acc = rt_sw_f64_of(0)
      let n = 0
      while n < N {
        let acc = rt_sw_fma32(rt_sw_ld32(A + 4 * (row * N + n)), rt_sw_ld32(B + 4 * (col * N + n)), acc)
        let n = n + 1
      }
      do rt_sw_st32(C + 4 * t, acc)
    }
    let t = t + 1
  }
  return rt_tag(0)
}

skill rt_sw_addbias(gx, bx, ps) -> Any {
  let Z = rt_sw_arg(ps, 0)
  let B = rt_sw_arg(ps, 1)
  let M = rt_sw_arg(ps, 2)
  let N = rt_sw_arg(ps, 3)
  do rt_sw_note(4 * (M * N + N))
  let lim = rt_untag(gx) * rt_untag(bx)
  let count = M * N
  let t = 0
  while t < lim {
    if t < count {
      let col = t % N
      do rt_sw_st32(Z + 4 * t, rt_sw_add32(rt_sw_ld32(Z + 4 * t), rt_sw_ld32(B + 4 * col)))
    }
    let t = t + 1
  }
  return rt_tag(0)
}

skill rt_sw_biasgrad(gx, bx, ps) -> Any {
  let Z = rt_sw_arg(ps, 0)
  let B = rt_sw_arg(ps, 1)
  let M = rt_sw_arg(ps, 2)
  let N = rt_sw_arg(ps, 3)
  do rt_sw_note(4 * (M * N + N))
  let lim = rt_untag(gx) * rt_untag(bx)
  let t = 0
  while t < lim {
    if t < N {
      let acc = rt_sw_f64_of(0)
      let r = 0
      while r < M {
        let acc = rt_sw_add32(acc, rt_sw_ld32(Z + 4 * (r * N + t)))
        let r = r + 1
      }
      do rt_sw_st32(B + 4 * t, acc)
    }
    let t = t + 1
  }
  return rt_tag(0)
}

skill rt_sw_exp2tag(real) -> Any { return rt_tag(rt_sw_f32_of(rt_sw_exp2(rt_realbits(real)))) }

skill rt_sw_log2tag(real) -> Any { return rt_tag(rt_sw_f32_of(rt_sw_log2(rt_realbits(real)))) }

skill rt_sw_neg32(a) -> Any { return rt_sw_f64_of(bxor(rt_sw_f32_of(a), shl(1, 31))) }

skill rt_sw_scale2(bits, n) -> Any {
  if bits == 0 { return shl(shr(bits, 63), 63) }
  let sign = shr(bits, 63)
  let exp = band(shr(bits, 52), 2047)
  let man = band(bits, 4503599627370495)
  if exp == 2047 { return bits }
  if exp == 0 { return shl(sign, 63) }
  let exp = exp + n
  if exp >= 2047 { return bor(shl(sign, 63), shl(2047, 52)) }
  if exp <= 0 { return shl(sign, 63) }
  return bor(shl(sign, 63), bor(shl(exp, 52), man))
}

# 2^x, rounded back to f32. The GPU instruction is an approximation; this is the rounded value.
skill rt_sw_exp2(x) -> Any {
  let x = rt_sw_f64_of(rt_sw_f32_of(x))
  let n = rt_sw_rni(x)
  let f = fsub(x, i2f(n))
  let y = fmul(f, 4604418534313441775)
  let sum = i2f(1)
  let term = i2f(1)
  let i = 1
  while i < 16 {
    let term = fdiv(fmul(term, y), i2f(i))
    let sum = fadd(sum, term)
    let i = i + 1
  }
  return rt_sw_f64_of(rt_sw_f32_of(rt_sw_scale2(sum, n)))
}

skill rt_sw_log2(x) -> Any {
  let exp = band(shr(x, 52), 2047)
  let man = band(x, 4503599627370495)
  if exp == 0 or exp == 2047 { return rt_sw_f64_of(4286578688) }
  let e = exp - 1023
  let m = bor(shl(1023, 52), man)
  let one = i2f(1)
  let z = fdiv(fsub(m, one), fadd(m, one))
  let z2 = fmul(z, z)
  let sum = z
  let term = z
  let i = 1
  while i < 14 {
    let term = fmul(term, z2)
    let sum = fadd(sum, fdiv(term, i2f(2 * i + 1)))
    let i = i + 1
  }
  let ln = fmul(sum, i2f(2))
  return rt_sw_f64_of(rt_sw_f32_of(fadd(i2f(e), fdiv(ln, 4604418534313441775))))
}

skill rt_sw_sin(x) -> Any {
  let x = rt_sw_f64_of(rt_sw_f32_of(x))
  let x2 = fmul(x, x)
  let term = x
  let sum = x
  let i = 1
  while i < 12 {
    let term = fsub(i2f(0), fdiv(fmul(term, x2), i2f((2 * i) * (2 * i + 1))))
    let sum = fadd(sum, term)
    let i = i + 1
  }
  return rt_sw_f64_of(rt_sw_f32_of(sum))
}

skill rt_sw_cos(x) -> Any {
  let x = rt_sw_f64_of(rt_sw_f32_of(x))
  let x2 = fmul(x, x)
  let term = i2f(1)
  let sum = i2f(1)
  let i = 1
  while i < 12 {
    let term = fsub(i2f(0), fdiv(fmul(term, x2), i2f((2 * i - 1) * (2 * i))))
    let sum = fadd(sum, term)
    let i = i + 1
  }
  return rt_sw_f64_of(rt_sw_f32_of(sum))
}

skill rt_sw_rcp32(a) -> Any { return rt_sw_f64_of(rt_sw_f32_of(fdiv(i2f(1), a))) }

skill rt_sw_relu32(a) -> Any {
  if flt(rt_sw_f64_of(0), a) { return a }
  return rt_sw_f64_of(0)
}

# the kernel's own range reduction, then the rounded sine
skill rt_sw_fsin(x) -> Any {
  let n = rt_sw_f64_of(rt_sw_f32_of(i2f(rt_sw_rni(rt_sw_mul32(x, rt_sw_f64_of(1042479491))))))
  let x = rt_sw_add32(x, rt_sw_neg32(rt_sw_mul32(n, rt_sw_f64_of(1086918619))))
  return rt_sw_sin(x)
}

skill rt_sw_fcos(x) -> Any {
  let n = rt_sw_f64_of(rt_sw_f32_of(i2f(rt_sw_rni(rt_sw_mul32(x, rt_sw_f64_of(1042479491))))))
  let x = rt_sw_add32(x, rt_sw_neg32(rt_sw_mul32(n, rt_sw_f64_of(1086918619))))
  return rt_sw_cos(x)
}

skill rt_sw_sig(c) -> Any {
  let e = rt_sw_exp2(rt_sw_mul32(rt_sw_neg32(c), rt_sw_f64_of(1069066811)))
  return rt_sw_rcp32(rt_sw_add32(e, rt_sw_f64_of(1065353216)))
}

skill rt_sw_expm(dens, delta) -> Any {
  let a = rt_sw_mul32(rt_sw_relu32(dens), delta)
  return rt_sw_exp2(rt_sw_mul32(rt_sw_neg32(a), rt_sw_f64_of(1069066811)))
}

# relu only. sin.approx is the GPU's approximation; here the sine is the rounded value.
skill rt_sw_act(gx, bx, ps) -> Any {
  let X = rt_sw_arg(ps, 0)
  let Y = rt_sw_arg(ps, 1)
  let n = rt_sw_arg(ps, 2)
  do rt_sw_note(8 * n)
  let mode = rt_sw_arg(ps, 3)
  let a = rt_sw_f64_of(rt_sw_arg(ps, 4))
  let lim = rt_untag(gx) * rt_untag(bx)
  let z = rt_sw_f64_of(0)
  let t = 0
  while t < lim {
    if t < n {
      let x = rt_sw_ld32(X + 4 * t)
      if mode == 0 {
        if flt(z, x) == 0 { let x = z }
      } else { let x = rt_sw_fsin(rt_sw_mul32(x, a)) }
      do rt_sw_st32(Y + 4 * t, x)
    }
    let t = t + 1
  }
  return rt_tag(0)
}

skill rt_sw_actb(gx, bx, ps) -> Any {
  let X = rt_sw_arg(ps, 0)
  let DY = rt_sw_arg(ps, 1)
  let DX = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  do rt_sw_note(12 * n)
  let mode = rt_sw_arg(ps, 4)
  let a = rt_sw_f64_of(rt_sw_arg(ps, 5))
  let lim = rt_untag(gx) * rt_untag(bx)
  let z = rt_sw_f64_of(0)
  let t = 0
  while t < lim {
    if t < n {
      let g = z
      if mode == 0 {
        if flt(z, rt_sw_ld32(X + 4 * t)) { let g = rt_sw_ld32(DY + 4 * t) }
      } else {
        let y = rt_sw_fcos(rt_sw_mul32(rt_sw_ld32(X + 4 * t), a))
        let g = rt_sw_mul32(rt_sw_mul32(y, a), rt_sw_ld32(DY + 4 * t))
      }
      do rt_sw_st32(DX + 4 * t, g)
    }
    let t = t + 1
  }
  return rt_tag(0)
}

# squared error, added in thread order. The GPU's atomic add does not promise an order.
skill rt_sw_mseg(gx, bx, ps) -> Any {
  let P = rt_sw_arg(ps, 0)
  let T = rt_sw_arg(ps, 1)
  let D = rt_sw_arg(ps, 2)
  let L = rt_sw_arg(ps, 3)
  let n = rt_sw_arg(ps, 4)
  do rt_sw_note(12 * n + 4)
  let lim = rt_untag(gx) * rt_untag(bx)
  let nf = rt_sw_f64_of(rt_sw_f32_of(i2f(n)))
  let two = rt_sw_f64_of(rt_sw_f32_of(i2f(2)))
  let t = 0
  while t < lim {
    if t < n {
      let e = rt_sw_add32(rt_sw_ld32(P + 4 * t), rt_sw_f64_of(bxor(rt_sw_f32_of(rt_sw_ld32(T + 4 * t)), shl(1, 31))))
      let sq = rt_sw_mul32(e, e)
      let loss = rt_sw_add32(rt_sw_ld32(L), rt_sw_div32(sq, nf))
      do rt_sw_st32(L, loss)
      do rt_sw_st32(D + 4 * t, rt_sw_div32(rt_sw_mul32(two, e), nf))
    }
    let t = t + 1
  }
  return rt_tag(0)
}

skill rt_sw_adam(gx, bx, ps) -> Any {
  let P = rt_sw_arg(ps, 0)
  let G = rt_sw_arg(ps, 1)
  let M = rt_sw_arg(ps, 2)
  let V = rt_sw_arg(ps, 3)
  let n = rt_sw_arg(ps, 4)
  do rt_sw_note(16 * n)
  let lr = rt_sw_f64_of(rt_sw_arg(ps, 5))
  let b1 = rt_sw_f64_of(rt_sw_arg(ps, 6))
  let b2 = rt_sw_f64_of(rt_sw_arg(ps, 7))
  let eps = rt_sw_f64_of(rt_sw_arg(ps, 8))
  let mc = rt_sw_f64_of(rt_sw_arg(ps, 9))
  let vc = rt_sw_f64_of(rt_sw_arg(ps, 10))
  let one = rt_sw_f64_of(1065353216)
  let lim = rt_untag(gx) * rt_untag(bx)
  let t = 0
  while t < lim {
    if t < n {
      let p = rt_sw_ld32(P + 4 * t)
      let g = rt_sw_ld32(G + 4 * t)
      let m = rt_sw_fma32(g, rt_sw_add32(one, rt_sw_f64_of(bxor(rt_sw_f32_of(b1), shl(1, 31)))), rt_sw_mul32(rt_sw_ld32(M + 4 * t), b1))
      let g2 = rt_sw_mul32(g, g)
      let v = rt_sw_fma32(g2, rt_sw_add32(one, rt_sw_f64_of(bxor(rt_sw_f32_of(b2), shl(1, 31)))), rt_sw_mul32(rt_sw_ld32(V + 4 * t), b2))
      do rt_sw_st32(M + 4 * t, m)
      do rt_sw_st32(V + 4 * t, v)
      let den = rt_sw_add32(rt_sw_sqrt32(rt_sw_div32(v, vc)), eps)
      let step = rt_sw_mul32(rt_sw_div32(rt_sw_div32(m, mc), den), lr)
      do rt_sw_st32(P + 4 * t, rt_sw_add32(p, rt_sw_f64_of(bxor(rt_sw_f32_of(step), shl(1, 31)))))
    }
    let t = t + 1
  }
  return rt_tag(0)
}

skill rt_sw_vrfwd(gx, bx, ps) -> Any {
  let raw = rt_sw_arg(ps, 0)
  let out = rt_sw_arg(ps, 1)
  let tr = rt_sw_arg(ps, 2)
  let nr = rt_sw_arg(ps, 3)
  let m = rt_sw_arg(ps, 4)
  do rt_sw_note(20 * nr * m + 16 * nr)
  let delta = rt_sw_arg(ps, 5)
  let bg = rt_sw_f64_of(rt_sw_arg(ps, 6))
  let one = rt_sw_f64_of(1065353216)
  let lim = rt_untag(gx) * rt_untag(bx)
  let ray = 0
  while ray < lim {
    if ray < nr {
      let d = rt_sw_ld32(delta + 4 * ray)
      let T = one
      let r = rt_sw_f64_of(0)
      let g = rt_sw_f64_of(0)
      let b = rt_sw_f64_of(0)
      let s = 0
      while s < m {
        let p = raw + 16 * (ray * m + s)
        let e = rt_sw_expm(rt_sw_ld32(p), d)
        let alpha = rt_sw_add32(one, rt_sw_neg32(e))
        let c0 = rt_sw_sig(rt_sw_ld32(p + 4))
        let c1 = rt_sw_sig(rt_sw_ld32(p + 8))
        let c2 = rt_sw_sig(rt_sw_ld32(p + 12))
        let w = rt_sw_mul32(T, alpha)
        let r = rt_sw_fma32(w, c0, r)
        let g = rt_sw_fma32(w, c1, g)
        let b = rt_sw_fma32(w, c2, b)
        do rt_sw_st32(tr + 4 * (ray * m + s), T)
        let T = rt_sw_add32(T, rt_sw_neg32(w))
        let s = s + 1
      }
      let r = rt_sw_fma32(T, bg, r)
      let g = rt_sw_fma32(T, bg, g)
      let b = rt_sw_fma32(T, bg, b)
      do rt_sw_st32(out + 12 * ray, r)
      do rt_sw_st32(out + 12 * ray + 4, g)
      do rt_sw_st32(out + 12 * ray + 8, b)
    }
    let ray = ray + 1
  }
  return rt_tag(0)
}

skill rt_sw_vrw(gx, bx, ps) -> Any {
  let raw = rt_sw_arg(ps, 0)
  let wts = rt_sw_arg(ps, 1)
  let delta = rt_sw_arg(ps, 2)
  let nr = rt_sw_arg(ps, 3)
  let m = rt_sw_arg(ps, 4)
  do rt_sw_note(20 * nr * m + 4 * nr)
  let one = rt_sw_f64_of(1065353216)
  let lim = rt_untag(gx) * rt_untag(bx)
  let ray = 0
  while ray < lim {
    if ray < nr {
      let d = rt_sw_ld32(delta + 4 * ray)
      let T = one
      let s = 0
      while s < m {
        let e = rt_sw_expm(rt_sw_ld32(raw + 16 * (ray * m + s)), d)
        let w = rt_sw_mul32(T, rt_sw_add32(one, rt_sw_neg32(e)))
        do rt_sw_st32(wts + 4 * (ray * m + s), w)
        let T = rt_sw_add32(T, rt_sw_neg32(w))
        let s = s + 1
      }
    }
    let ray = ray + 1
  }
  return rt_tag(0)
}

skill rt_sw_vrbwd(gx, bx, ps) -> Any {
  let raw = rt_sw_arg(ps, 0)
  let tr = rt_sw_arg(ps, 1)
  let dc = rt_sw_arg(ps, 2)
  let draw = rt_sw_arg(ps, 3)
  let nr = rt_sw_arg(ps, 4)
  let m = rt_sw_arg(ps, 5)
  do rt_sw_note(36 * nr * m + 16 * nr)
  let delta = rt_sw_arg(ps, 6)
  let bg = rt_sw_f64_of(rt_sw_arg(ps, 7))
  let one = rt_sw_f64_of(1065353216)
  let z = rt_sw_f64_of(0)
  let lim = rt_untag(gx) * rt_untag(bx)
  let ray = 0
  while ray < lim {
    if ray < nr {
      let dlt = rt_sw_ld32(delta + 4 * ray)
      let c0 = rt_sw_ld32(dc + 12 * ray)
      let c1 = rt_sw_ld32(dc + 12 * ray + 4)
      let c2 = rt_sw_ld32(dc + 12 * ray + 8)
      let sum = rt_sw_add32(rt_sw_add32(c0, c1), c2)
      let last = ray * m + m - 1
      let eL = rt_sw_expm(rt_sw_ld32(raw + 16 * last), dlt)
      let TL = rt_sw_ld32(tr + 4 * last)
      let tail = rt_sw_mul32(rt_sw_mul32(rt_sw_mul32(dlt, rt_sw_mul32(TL, eL)), bg), sum)
      let a0 = z
      let a1 = z
      let a2 = z
      let s = m - 1
      while s >= 0 {
        let idx = ray * m + s
        let p = raw + 16 * idx
        let dens = rt_sw_ld32(p)
        let gate = z
        if flt(z, dens) { let gate = one }
        let e = rt_sw_expm(dens, dlt)
        let alpha = rt_sw_add32(one, rt_sw_neg32(e))
        let T = rt_sw_ld32(tr + 4 * idx)
        let w = rt_sw_mul32(T, alpha)
        let rest = rt_sw_add32(T, rt_sw_neg32(w))
        let s0 = rt_sw_sig(rt_sw_ld32(p + 4))
        let s1 = rt_sw_sig(rt_sw_ld32(p + 8))
        let s2 = rt_sw_sig(rt_sw_ld32(p + 12))
        let dot = rt_sw_fma32(c2, s2, rt_sw_fma32(c1, s1, rt_sw_mul32(c0, s0)))
        let acc = rt_sw_fma32(c2, a2, rt_sw_fma32(c1, a1, rt_sw_mul32(c0, a0)))
        let g = rt_sw_add32(rt_sw_mul32(rt_sw_add32(rt_sw_mul32(rest, dot), rt_sw_neg32(acc)), dlt), rt_sw_neg32(tail))
        do rt_sw_st32(draw + 16 * idx, rt_sw_mul32(g, gate))
        let q0 = rt_sw_mul32(s0, rt_sw_add32(one, rt_sw_neg32(s0)))
        let q1 = rt_sw_mul32(s1, rt_sw_add32(one, rt_sw_neg32(s1)))
        let q2 = rt_sw_mul32(s2, rt_sw_add32(one, rt_sw_neg32(s2)))
        do rt_sw_st32(draw + 16 * idx + 4, rt_sw_mul32(rt_sw_mul32(w, c0), q0))
        do rt_sw_st32(draw + 16 * idx + 8, rt_sw_mul32(rt_sw_mul32(w, c1), q1))
        do rt_sw_st32(draw + 16 * idx + 12, rt_sw_mul32(rt_sw_mul32(w, c2), q2))
        let a0 = rt_sw_fma32(w, s0, a0)
        let a1 = rt_sw_fma32(w, s1, a1)
        let a2 = rt_sw_fma32(w, s2, a2)
        if s == 0 { let s = 0 - 1 } else { let s = s - 1 }
      }
    }
    let ray = ray + 1
  }
  return rt_tag(0)
}

skill rt_sw_posenc(gx, bx, ps) -> Any {
  let pts = rt_sw_arg(ps, 0)
  let feat = rt_sw_arg(ps, 1)
  let n = rt_sw_arg(ps, 2)
  let L = rt_sw_arg(ps, 3)
  do rt_sw_note(12 * n + 4 * n * (L * 6 + 3))
  let alpha = rt_sw_f64_of(rt_sw_arg(ps, 4))
  let one = rt_sw_f64_of(1065353216)
  let z = rt_sw_f64_of(0)
  let pi = rt_sw_f64_of(1078530011)
  let lim = rt_untag(gx) * rt_untag(bx)
  let t = 0
  while t < lim {
    if t < n {
      let stride = L * 6 + 3
      let o = feat + 4 * (t * stride)
      let x = rt_sw_ld32(pts + 12 * t)
      let y = rt_sw_ld32(pts + 12 * t + 4)
      let zz = rt_sw_ld32(pts + 12 * t + 8)
      do rt_sw_st32(o, x)
      do rt_sw_st32(o + 4, y)
      do rt_sw_st32(o + 8, zz)
      let o = o + 12
      let freq = pi
      let lv = 0
      while lv < L {
        let w = rt_sw_add32(alpha, rt_sw_neg32(rt_sw_f64_of(rt_sw_f32_of(i2f(lv)))))
        if flt(w, z) { let w = z }
        if flt(one, w) { let w = one }
        do rt_sw_st32(o, rt_sw_mul32(rt_sw_fsin(rt_sw_mul32(freq, x)), w))
        do rt_sw_st32(o + 4, rt_sw_mul32(rt_sw_fcos(rt_sw_mul32(freq, x)), w))
        do rt_sw_st32(o + 8, rt_sw_mul32(rt_sw_fsin(rt_sw_mul32(freq, y)), w))
        do rt_sw_st32(o + 12, rt_sw_mul32(rt_sw_fcos(rt_sw_mul32(freq, y)), w))
        do rt_sw_st32(o + 16, rt_sw_mul32(rt_sw_fsin(rt_sw_mul32(freq, zz)), w))
        do rt_sw_st32(o + 20, rt_sw_mul32(rt_sw_fcos(rt_sw_mul32(freq, zz)), w))
        let o = o + 24
        let freq = rt_sw_mul32(freq, rt_sw_f64_of(1073741824))
        let lv = lv + 1
      }
    }
    let t = t + 1
  }
  return rt_tag(0)
}

skill rt_sw_u32m(a, b) -> Any { return band(a * b, 4294967295) }

skill rt_sw_u32a(a, b) -> Any { return band(a + b, 4294967295) }

skill rt_sw_addnoise(gx, bx, ps) -> Any {
  let raw = rt_sw_arg(ps, 0)
  let n = rt_sw_arg(ps, 1)
  do rt_sw_note(16 * n)
  let scale = rt_sw_f64_of(rt_sw_arg(ps, 2))
  let seed = rt_sw_arg(ps, 3)
  let lim = rt_untag(gx) * rt_untag(bx)
  let tiny = rt_sw_f64_of(872415232)
  let neg = rt_sw_f64_of(3216077336)
  let twopi = rt_sw_f64_of(1086918619)
  let t = 0
  while t < lim {
    if t < n {
      let u = rt_sw_u32a(rt_sw_u32m(rt_sw_u32a(t, seed), 747796405), 2891336453)
      let s = bxor(rt_sw_u32m(u, u), u)
      let f1 = rt_sw_add32(rt_sw_f64_of(bor(shr(s, 9), 1065353216)), rt_sw_neg32(rt_sw_f64_of(1065353216)))
      if flt(f1, tiny) { let f1 = tiny }
      let u2 = rt_sw_u32a(rt_sw_u32m(s, 747796405), 2891336453)
      let s2 = bxor(rt_sw_u32m(u2, u2), u2)
      let f2 = rt_sw_add32(rt_sw_f64_of(bor(shr(s2, 9), 1065353216)), rt_sw_neg32(rt_sw_f64_of(1065353216)))
      let mag = rt_sw_sqrt32(rt_sw_mul32(rt_sw_log2(f1), neg))
      let noise = rt_sw_mul32(rt_sw_mul32(mag, rt_sw_cos(rt_sw_mul32(f2, twopi))), scale)
      let p = raw + 16 * t
      do rt_sw_st32(p, rt_sw_add32(rt_sw_ld32(p), noise))
    }
    let t = t + 1
  }
  return rt_tag(0)
}

# This chip's reduction. The sum of n floats is one word in TMEM, not a second buffer.
skill rt_sw_tred(gx, bx, ps) -> Any {
  let buf = rt_sw_arg(ps, 0)
  let n = rt_sw_arg(ps, 1)
  do rt_sw_note(4 * n + 4)
  let base = rt_untag(rt_sw_tmem())
  let acc = rt_sw_f64_of(0)
  let lim = rt_untag(gx) * rt_untag(bx)
  let t = 0
  while t < lim {
    if t < n { let acc = rt_sw_add32(acc, rt_sw_ld32(buf + 4 * t)) }
    let t = t + 1
  }
  do rt_sw_st32(base, acc)
  return rt_tag(0)
}

# y[row] = dot(A[row], x). x is one shared row in the 4 KB, or it is not.
# A row of at most 1024 floats is copied into TMEM once, and every row reads it there.
# A longer row does not fit, so it is not kept, and every row reads it from the bus.
skill rt_sw_srow(gx, bx, ps) -> Any {
  let A = rt_sw_arg(ps, 0)
  let X = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let M = rt_sw_arg(ps, 3)
  let K = rt_sw_arg(ps, 4)
  let fits = 0
  if K > 0 and K <= 1024 { let fits = 1 }
  let bytes = 0
  if M > 0 {
    if fits == 1 { let bytes = 4 * (M * K + K + M) }
    if fits == 0 { let bytes = 4 * (2 * M * K + M) }
  }
  do rt_sw_note(bytes)
  let base = rt_untag(rt_sw_tmem())
  if fits == 1 {
    let k = 0
    while k < K {
      do rt_sw_st32(base + 4 * k, rt_sw_ld32(X + 4 * k))
      let k = k + 1
    }
  }
  let lim = rt_untag(gx) * rt_untag(bx)
  let t = 0
  while t < lim {
    if t < M {
      let acc = rt_sw_f64_of(0)
      let k = 0
      while k < K {
        let xv = rt_sw_f64_of(0)
        if fits == 1 { let xv = rt_sw_ld32(base + 4 * k) }
        if fits == 0 { let xv = rt_sw_ld32(X + 4 * k) }
        let acc = rt_sw_fma32(rt_sw_ld32(A + 4 * (t * K + k)), xv, acc)
        let k = k + 1
      }
      do rt_sw_st32(Y + 4 * t, acc)
    }
    let t = t + 1
  }
  return rt_tag(0)
}

# mvf32: k float rows times nv double vectors. A vector that fits is one shared row in TMEM.
# Eight threads of a warp share a row; the launch's row count is gx blocks of bx/32 warps.
# The sum is float32, then widened. A vector longer than 1024 floats is not kept.
skill rt_sw_mvf32(gx, bx, ps) -> Any {
  let W = rt_sw_arg(ps, 0)
  let X = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let k = rt_sw_arg(ps, 4)
  let nv = rt_sw_arg(ps, 5)
  let rb = rt_sw_arg(ps, 6)
  let warps = rt_untag(bx) // 32
  if warps < 1 { let warps = 1 }
  let rows = rt_untag(gx) * warps
  if rows > k { let rows = k }
  let fits = 0
  if n > 0 and n <= 1024 { let fits = 1 }
  let bytes = 0
  if rows > 0 and nv > 0 {
    if fits == 1 { let bytes = rows * n * 4 + nv * n * 8 + rows * nv * 8 }
    if fits == 0 { let bytes = rows * n * 4 + rows * nv * n * 8 + rows * nv * 8 }
  }
  do rt_sw_note(bytes)
  let base = rt_untag(rt_sw_tmem())
  let v = 0
  while v < nv {
    if fits == 1 {
      let j = 0
      while j < n {
        do rt_poke32(base + 4 * j, rt_sw_f32_of(peek(X + 8 * (v * n + j))))
        let j = j + 1
      }
    }
    let row = 0
    while row < rows {
      let acc = rt_sw_f64_of(0)
      let j = 0
      while j < n {
        let xv = rt_sw_f64_of(0)
        if fits == 1 { let xv = rt_sw_ld32(base + 4 * j) }
        if fits == 0 { let xv = rt_sw_f64_of(rt_sw_f32_of(peek(X + 8 * (v * n + j)))) }
        let acc = rt_sw_fma32(rt_sw_ld32(W + row * rb + 4 * j), xv, acc)
        let j = j + 1
      }
      do poke(Y + 8 * (v * k + row), acc)
      let row = row + 1
    }
    let v = v + 1
  }
  return rt_tag(0)
}

# IEEE binary16 at p, as f32 bits. Not an SFU approximation.
skill rt_sw_f16(p) -> Any {
  let h = peekb(p) + shl(peekb(p + 1), 8)
  let sign = shr(h, 15)
  let exp = band(shr(h, 10), 31)
  let man = band(h, 1023)
  if exp == 31 {
    if man == 0 { return bor(shl(sign, 31), 2139095040) }
    return bor(shl(sign, 31), 2143289344)
  }
  if exp == 0 {
    if man == 0 { return shl(sign, 31) }
    let e = 1
    while band(man, 1024) == 0 {
      let man = shl(man, 1)
      let e = e - 1
    }
    let man = band(man, 1023)
    return bor(shl(sign, 31), bor(shl(e + 112, 23), shl(man, 13)))
  }
  return bor(shl(sign, 31), bor(shl(exp + 112, 23), shl(man, 13)))
}

# Q8_0. A block is 34 bytes: one binary16 scale, then 32 signed bytes. weight = scale * q, once per block.
# The vector is the same shared row as mvf32.
skill rt_sw_mvq8(gx, bx, ps) -> Any {
  let W = rt_sw_arg(ps, 0)
  let X = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let k = rt_sw_arg(ps, 4)
  let nv = rt_sw_arg(ps, 5)
  let rb = rt_sw_arg(ps, 6)
  let warps = rt_untag(bx) // 32
  if warps < 1 { let warps = 1 }
  let rows = rt_untag(gx) * warps
  if rows > k { let rows = k }
  let fits = 0
  if n > 0 and n <= 1024 { let fits = 1 }
  let nb = n // 32
  let bytes = 0
  if rows > 0 and nv > 0 {
    let wbytes = rows * nb * 34
    if fits == 1 { let bytes = wbytes + nv * n * 8 + rows * nv * 8 }
    if fits == 0 { let bytes = wbytes + rows * nv * n * 8 + rows * nv * 8 }
  }
  do rt_sw_note(bytes)
  let base = rt_untag(rt_sw_tmem())
  let v = 0
  while v < nv {
    if fits == 1 {
      let j = 0
      while j < n {
        do rt_poke32(base + 4 * j, rt_sw_f32_of(peek(X + 8 * (v * n + j))))
        let j = j + 1
      }
    }
    let row = 0
    while row < rows {
      let acc = rt_sw_f64_of(0)
      let b = 0
      while b < nb {
        let blk = W + row * rb + b * 34
        let d = rt_sw_f64_of(rt_sw_f16(blk))
        let sum = rt_sw_f64_of(0)
        let j = 0
        while j < 32 {
          let q = peekb(blk + 2 + j)
          if q >= 128 { let q = q - 256 }
          let qf = rt_sw_f64_of(rt_sw_f32_of(i2f(q)))
          let xv = rt_sw_f64_of(0)
          if fits == 1 { let xv = rt_sw_ld32(base + 4 * (b * 32 + j)) }
          if fits == 0 { let xv = rt_sw_f64_of(rt_sw_f32_of(peek(X + 8 * (v * n + b * 32 + j)))) }
          let sum = rt_sw_fma32(qf, xv, sum)
          let j = j + 1
        }
        let acc = rt_sw_fma32(d, sum, acc)
        let b = b + 1
      }
      do poke(Y + 8 * (v * k + row), acc)
      let row = row + 1
    }
    let v = v + 1
  }
  return rt_tag(0)
}

# 6-bit Q4_K scale (which = 0) or min (which = 1), index j in 0..7.
# j < 4 is the low 6 bits of one byte. j >= 4 is a nibble plus the top 2 bits of an earlier byte.
skill rt_sw_q4sm(blk, j, which) -> Any {
  if j < 4 { return band(peekb(blk + 4 + j + which * 4), 63) }
  let b = peekb(blk + 12 + j - 4)
  let lo = band(b, 15)
  if which == 1 { let lo = band(shr(b, 4), 15) }
  let hb = peekb(blk + 4 + j - 4 + which * 4)
  return bor(lo, shl(band(shr(hb, 6), 3), 4))
}

# Q4_K. A block is 144 bytes of 256 weights: binary16 d and dmin, 12 bytes of 6-bit scales and mins,
# then 128 bytes of nibbles. Chunk c: low nibbles are weights 64c.., high nibbles are 64c+32..,
# scales 2c and 2c+1. Each group of 32 sums q*x and x in float32, then
# acc += (d*scale)*sum_q + (-dmin*min)*sum_x. That is the PTX total when the products fit the
# float32 mantissa, so splitting the group across a warp does not change it. n is a multiple of 256.
# The vector is the same shared row as mvf32. A longer one is not kept.
skill rt_sw_mvq4(gx, bx, ps) -> Any {
  let W = rt_sw_arg(ps, 0)
  let X = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let k = rt_sw_arg(ps, 4)
  let nv = rt_sw_arg(ps, 5)
  let rb = rt_sw_arg(ps, 6)
  let warps = rt_untag(bx) // 32
  if warps < 1 { let warps = 1 }
  let rows = rt_untag(gx) * warps
  if rows > k { let rows = k }
  let fits = 0
  if n > 0 and n <= 1024 { let fits = 1 }
  let nb = n // 256
  let bytes = 0
  if rows > 0 and nv > 0 {
    let wbytes = rows * nb * 144
    if fits == 1 { let bytes = wbytes + nv * n * 8 + rows * nv * 8 }
    if fits == 0 { let bytes = wbytes + rows * nv * n * 8 + rows * nv * 8 }
  }
  do rt_sw_note(bytes)
  let base = rt_untag(rt_sw_tmem())
  let v = 0
  while v < nv {
    if fits == 1 {
      let j = 0
      while j < n {
        do rt_poke32(base + 4 * j, rt_sw_f32_of(peek(X + 8 * (v * n + j))))
        let j = j + 1
      }
    }
    let row = 0
    while row < rows {
      let acc = rt_sw_f64_of(0)
      let b = 0
      while b < nb {
        let blk = W + row * rb + b * 144
        let d = rt_sw_f64_of(rt_sw_f16(blk))
        let dmin = rt_sw_f64_of(rt_sw_f16(blk + 2))
        let c = 0
        while c < 4 {
          let h = 0
          while h < 2 {
            let sumq = rt_sw_f64_of(0)
            let sumx = rt_sw_f64_of(0)
            let i = 0
            while i < 32 {
              let byte = peekb(blk + 16 + 32 * c + i)
              let q = band(byte, 15)
              if h == 1 { let q = band(shr(byte, 4), 15) }
              let xi = b * 256 + 64 * c + h * 32 + i
              let xv = rt_sw_f64_of(0)
              if fits == 1 { let xv = rt_sw_ld32(base + 4 * xi) }
              if fits == 0 { let xv = rt_sw_f64_of(rt_sw_f32_of(peek(X + 8 * (v * n + xi)))) }
              let qf = rt_sw_f64_of(rt_sw_f32_of(i2f(q)))
              let sumq = rt_sw_fma32(qf, xv, sumq)
              let sumx = rt_sw_add32(xv, sumx)
              let i = i + 1
            }
            let sc = rt_sw_f64_of(rt_sw_f32_of(i2f(rt_sw_q4sm(blk, 2 * c + h, 0))))
            let mn = rt_sw_f64_of(rt_sw_f32_of(i2f(rt_sw_q4sm(blk, 2 * c + h, 1))))
            let acc = rt_sw_fma32(rt_sw_mul32(d, sc), sumq, acc)
            let dm = rt_sw_mul32(dmin, mn)
            let dm = rt_sw_f64_of(rt_sw_f32_of(fsub(i2f(0), dm)))
            let acc = rt_sw_fma32(dm, sumx, acc)
            let h = h + 1
          }
          let c = c + 1
        }
        let b = b + 1
      }
      do poke(Y + 8 * (v * k + row), acc)
      let row = row + 1
    }
    let v = v + 1
  }
  return rt_tag(0)
}

# Q6_K. A block is 210 bytes of 256 weights: 128 bytes of low nibbles (ql), 64 bytes of high 2 bits (qh),
# 16 signed scales, then a binary16 d at offset 208. Weight 128*h + 32*g + l (h < 2, g < 4, l < 32)
# is the nibble of ql[64*h + l] (ql[64*h + l + 32] when g is odd; the high nibble when g >= 2)
# plus two bits of qh[32*h + l], minus 32. The 16 products that share a scale are one float32 sum,
# then acc += (d*scale)*sum. That matches the warp when the products fit the float32 mantissa.
# n is a multiple of 256. The vector is the same shared row as mvf32. A longer one is not kept.
skill rt_sw_mvq6(gx, bx, ps) -> Any {
  let W = rt_sw_arg(ps, 0)
  let X = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let k = rt_sw_arg(ps, 4)
  let nv = rt_sw_arg(ps, 5)
  let rb = rt_sw_arg(ps, 6)
  let warps = rt_untag(bx) // 32
  if warps < 1 { let warps = 1 }
  let rows = rt_untag(gx) * warps
  if rows > k { let rows = k }
  let fits = 0
  if n > 0 and n <= 1024 { let fits = 1 }
  let nb = n // 256
  let bytes = 0
  if rows > 0 and nv > 0 {
    let wbytes = rows * nb * 210
    if fits == 1 { let bytes = wbytes + nv * n * 8 + rows * nv * 8 }
    if fits == 0 { let bytes = wbytes + rows * nv * n * 8 + rows * nv * 8 }
  }
  do rt_sw_note(bytes)
  let base = rt_untag(rt_sw_tmem())
  let v = 0
  while v < nv {
    if fits == 1 {
      let j = 0
      while j < n {
        do rt_poke32(base + 4 * j, rt_sw_f32_of(peek(X + 8 * (v * n + j))))
        let j = j + 1
      }
    }
    let row = 0
    while row < rows {
      let acc = rt_sw_f64_of(0)
      let b = 0
      while b < nb {
        let blk = W + row * rb + b * 210
        let d = rt_sw_f64_of(rt_sw_f16(blk + 208))
        let h = 0
        while h < 2 {
          let g = 0
          while g < 4 {
            let sum0 = rt_sw_f64_of(0)
            let sum1 = rt_sw_f64_of(0)
            let l = 0
            while l < 32 {
              let ql = peekb(blk + 64 * h + l)
              if band(g, 1) == 1 { let ql = peekb(blk + 64 * h + 32 + l) }
              let nib = band(ql, 15)
              if g >= 2 { let nib = band(shr(ql, 4), 15) }
              let top = band(shr(peekb(blk + 128 + 32 * h + l), 2 * g), 3)
              let q = bor(nib, shl(top, 4))
              let q = q - 32
              let xi = b * 256 + 128 * h + 32 * g + l
              let xv = rt_sw_f64_of(0)
              if fits == 1 { let xv = rt_sw_ld32(base + 4 * xi) }
              if fits == 0 { let xv = rt_sw_f64_of(rt_sw_f32_of(peek(X + 8 * (v * n + xi)))) }
              let qf = rt_sw_f64_of(rt_sw_f32_of(i2f(q)))
              if l < 16 { let sum0 = rt_sw_fma32(qf, xv, sum0) }
              if l >= 16 { let sum1 = rt_sw_fma32(qf, xv, sum1) }
              let l = l + 1
            }
            let s0 = peekb(blk + 192 + 8 * h + 2 * g)
            if s0 >= 128 { let s0 = s0 - 256 }
            let s1 = peekb(blk + 192 + 8 * h + 1 + 2 * g)
            if s1 >= 128 { let s1 = s1 - 256 }
            let acc = rt_sw_fma32(rt_sw_mul32(d, rt_sw_f64_of(rt_sw_f32_of(i2f(s0)))), sum0, acc)
            let acc = rt_sw_fma32(rt_sw_mul32(d, rt_sw_f64_of(rt_sw_f32_of(i2f(s1)))), sum1, acc)
            let g = g + 1
          }
          let h = h + 1
        }
        let b = b + 1
      }
      do poke(Y + 8 * (v * k + row), acc)
      let row = row + 1
    }
    let v = v + 1
  }
  return rt_tag(0)
}

# mxf32: launch row r is local row j of expert E[s], s = r / rpe, j = r mod rpe. E holds the ids as
# doubles, taken toward zero. The input is vector s / xd of X. The PTX reads that vector from the
# block's first row; the two are the same number when rpe is a multiple of 8. The dot is mvf32's.
# A vector that fits is one shared row. A longer one is not kept, and a repeat of the vector already
# in TMEM is not read again.
skill rt_sw_mxf32(gx, bx, ps) -> Any {
  let W = rt_sw_arg(ps, 0)
  let X = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let k = rt_sw_arg(ps, 4)
  let rpe = rt_sw_arg(ps, 5)
  let rb = rt_sw_arg(ps, 6)
  let E = rt_sw_arg(ps, 7)
  let xd = rt_sw_arg(ps, 8)
  let warps = rt_untag(bx) // 32
  if warps < 1 { let warps = 1 }
  let rows = rt_untag(gx) * warps
  if rows > k { let rows = k }
  let fits = 0
  if n > 0 and n <= 1024 { let fits = 1 }
  let loads = 0
  if fits == 1 and rows > 0 {
    let prev = 0 - 1
    let r = 0
    while r < rows {
      let vi = (r // rpe) // xd
      if vi != prev {
        let loads = loads + 1
        let prev = vi
      }
      let r = r + 1
    }
  }
  let bytes = 0
  if rows > 0 {
    let wbytes = rows * n * 4
    if fits == 1 { let bytes = wbytes + loads * n * 8 + rows * 8 }
    if fits == 0 { let bytes = wbytes + rows * n * 8 + rows * 8 }
  }
  do rt_sw_note(bytes)
  let base = rt_untag(rt_sw_tmem())
  let held = 0 - 1
  let r = 0
  while r < rows {
    let s = r // rpe
    let j = r - s * rpe
    let vi = s // xd
    let expert = f2i(peek(E + 8 * s))
    if fits == 1 and vi != held {
      let t = 0
      while t < n {
        do rt_poke32(base + 4 * t, rt_sw_f32_of(peek(X + 8 * (vi * n + t))))
        let t = t + 1
      }
      let held = vi
    }
    let acc = rt_sw_f64_of(0)
    let wr = W + (expert * rpe + j) * rb
    let t = 0
    while t < n {
      let xv = rt_sw_f64_of(0)
      if fits == 1 { let xv = rt_sw_ld32(base + 4 * t) }
      if fits == 0 { let xv = rt_sw_f64_of(rt_sw_f32_of(peek(X + 8 * (vi * n + t)))) }
      let acc = rt_sw_fma32(rt_sw_ld32(wr + 4 * t), xv, acc)
      let t = t + 1
    }
    do poke(Y + 8 * r, acc)
    let r = r + 1
  }
  return rt_tag(0)
}

# mxq8: the expert table of mxf32, and the Q8_0 dot of mvq8. Same shared row.
skill rt_sw_mxq8(gx, bx, ps) -> Any {
  let W = rt_sw_arg(ps, 0)
  let X = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let k = rt_sw_arg(ps, 4)
  let rpe = rt_sw_arg(ps, 5)
  let rb = rt_sw_arg(ps, 6)
  let E = rt_sw_arg(ps, 7)
  let xd = rt_sw_arg(ps, 8)
  let warps = rt_untag(bx) // 32
  if warps < 1 { let warps = 1 }
  let rows = rt_untag(gx) * warps
  if rows > k { let rows = k }
  let fits = 0
  if n > 0 and n <= 1024 { let fits = 1 }
  let nb = n // 32
  let loads = 0
  if fits == 1 and rows > 0 {
    let prev = 0 - 1
    let r = 0
    while r < rows {
      let vi = (r // rpe) // xd
      if vi != prev {
        let loads = loads + 1
        let prev = vi
      }
      let r = r + 1
    }
  }
  let bytes = 0
  if rows > 0 {
    let wbytes = rows * nb * 34
    if fits == 1 { let bytes = wbytes + loads * n * 8 + rows * 8 }
    if fits == 0 { let bytes = wbytes + rows * n * 8 + rows * 8 }
  }
  do rt_sw_note(bytes)
  let base = rt_untag(rt_sw_tmem())
  let held = 0 - 1
  let r = 0
  while r < rows {
    let s = r // rpe
    let j = r - s * rpe
    let vi = s // xd
    let expert = f2i(peek(E + 8 * s))
    if fits == 1 and vi != held {
      let t = 0
      while t < n {
        do rt_poke32(base + 4 * t, rt_sw_f32_of(peek(X + 8 * (vi * n + t))))
        let t = t + 1
      }
      let held = vi
    }
    let acc = rt_sw_f64_of(0)
    let wr = W + (expert * rpe + j) * rb
    let b = 0
    while b < nb {
      let blk = wr + b * 34
      let d = rt_sw_f64_of(rt_sw_f16(blk))
      let sum = rt_sw_f64_of(0)
      let i = 0
      while i < 32 {
        let q = peekb(blk + 2 + i)
        if q >= 128 { let q = q - 256 }
        let qf = rt_sw_f64_of(rt_sw_f32_of(i2f(q)))
        let xv = rt_sw_f64_of(0)
        if fits == 1 { let xv = rt_sw_ld32(base + 4 * (b * 32 + i)) }
        if fits == 0 { let xv = rt_sw_f64_of(rt_sw_f32_of(peek(X + 8 * (vi * n + b * 32 + i)))) }
        let sum = rt_sw_fma32(qf, xv, sum)
        let i = i + 1
      }
      let acc = rt_sw_fma32(d, sum, acc)
      let b = b + 1
    }
    do poke(Y + 8 * r, acc)
    let r = r + 1
  }
  return rt_tag(0)
}

# mxq4: the expert table of mxf32, and the Q4_K dot of mvq4. Same shared row.
skill rt_sw_mxq4(gx, bx, ps) -> Any {
  let W = rt_sw_arg(ps, 0)
  let X = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let k = rt_sw_arg(ps, 4)
  let rpe = rt_sw_arg(ps, 5)
  let rb = rt_sw_arg(ps, 6)
  let E = rt_sw_arg(ps, 7)
  let xd = rt_sw_arg(ps, 8)
  let warps = rt_untag(bx) // 32
  if warps < 1 { let warps = 1 }
  let rows = rt_untag(gx) * warps
  if rows > k { let rows = k }
  let fits = 0
  if n > 0 and n <= 1024 { let fits = 1 }
  let nb = n // 256
  let loads = 0
  if fits == 1 and rows > 0 {
    let prev = 0 - 1
    let r = 0
    while r < rows {
      let vi = (r // rpe) // xd
      if vi != prev {
        let loads = loads + 1
        let prev = vi
      }
      let r = r + 1
    }
  }
  let bytes = 0
  if rows > 0 {
    let wbytes = rows * nb * 144
    if fits == 1 { let bytes = wbytes + loads * n * 8 + rows * 8 }
    if fits == 0 { let bytes = wbytes + rows * n * 8 + rows * 8 }
  }
  do rt_sw_note(bytes)
  let base = rt_untag(rt_sw_tmem())
  let held = 0 - 1
  let r = 0
  while r < rows {
    let s = r // rpe
    let j = r - s * rpe
    let vi = s // xd
    let expert = f2i(peek(E + 8 * s))
    if fits == 1 and vi != held {
      let t = 0
      while t < n {
        do rt_poke32(base + 4 * t, rt_sw_f32_of(peek(X + 8 * (vi * n + t))))
        let t = t + 1
      }
      let held = vi
    }
    let acc = rt_sw_f64_of(0)
    let wr = W + (expert * rpe + j) * rb
    let b = 0
    while b < nb {
      let blk = wr + b * 144
      let d = rt_sw_f64_of(rt_sw_f16(blk))
      let dmin = rt_sw_f64_of(rt_sw_f16(blk + 2))
      let c = 0
      while c < 4 {
        let h = 0
        while h < 2 {
          let sumq = rt_sw_f64_of(0)
          let sumx = rt_sw_f64_of(0)
          let i = 0
          while i < 32 {
            let byte = peekb(blk + 16 + 32 * c + i)
            let q = band(byte, 15)
            if h == 1 { let q = band(shr(byte, 4), 15) }
            let xi = b * 256 + 64 * c + h * 32 + i
            let xv = rt_sw_f64_of(0)
            if fits == 1 { let xv = rt_sw_ld32(base + 4 * xi) }
            if fits == 0 { let xv = rt_sw_f64_of(rt_sw_f32_of(peek(X + 8 * (vi * n + xi)))) }
            let qf = rt_sw_f64_of(rt_sw_f32_of(i2f(q)))
            let sumq = rt_sw_fma32(qf, xv, sumq)
            let sumx = rt_sw_add32(xv, sumx)
            let i = i + 1
          }
          let sc = rt_sw_f64_of(rt_sw_f32_of(i2f(rt_sw_q4sm(blk, 2 * c + h, 0))))
          let mn = rt_sw_f64_of(rt_sw_f32_of(i2f(rt_sw_q4sm(blk, 2 * c + h, 1))))
          let acc = rt_sw_fma32(rt_sw_mul32(d, sc), sumq, acc)
          let dm = rt_sw_mul32(dmin, mn)
          let dm = rt_sw_f64_of(rt_sw_f32_of(fsub(i2f(0), dm)))
          let acc = rt_sw_fma32(dm, sumx, acc)
          let h = h + 1
        }
        let c = c + 1
      }
      let b = b + 1
    }
    do poke(Y + 8 * r, acc)
    let r = r + 1
  }
  return rt_tag(0)
}

# mxq6: the expert table of mxf32, and the Q6_K dot of mvq6. Same shared row.
skill rt_sw_mxq6(gx, bx, ps) -> Any {
  let W = rt_sw_arg(ps, 0)
  let X = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let k = rt_sw_arg(ps, 4)
  let rpe = rt_sw_arg(ps, 5)
  let rb = rt_sw_arg(ps, 6)
  let E = rt_sw_arg(ps, 7)
  let xd = rt_sw_arg(ps, 8)
  let warps = rt_untag(bx) // 32
  if warps < 1 { let warps = 1 }
  let rows = rt_untag(gx) * warps
  if rows > k { let rows = k }
  let fits = 0
  if n > 0 and n <= 1024 { let fits = 1 }
  let nb = n // 256
  let loads = 0
  if fits == 1 and rows > 0 {
    let prev = 0 - 1
    let r = 0
    while r < rows {
      let vi = (r // rpe) // xd
      if vi != prev {
        let loads = loads + 1
        let prev = vi
      }
      let r = r + 1
    }
  }
  let bytes = 0
  if rows > 0 {
    let wbytes = rows * nb * 210
    if fits == 1 { let bytes = wbytes + loads * n * 8 + rows * 8 }
    if fits == 0 { let bytes = wbytes + rows * n * 8 + rows * 8 }
  }
  do rt_sw_note(bytes)
  let base = rt_untag(rt_sw_tmem())
  let held = 0 - 1
  let r = 0
  while r < rows {
    let s = r // rpe
    let j = r - s * rpe
    let vi = s // xd
    let expert = f2i(peek(E + 8 * s))
    if fits == 1 and vi != held {
      let t = 0
      while t < n {
        do rt_poke32(base + 4 * t, rt_sw_f32_of(peek(X + 8 * (vi * n + t))))
        let t = t + 1
      }
      let held = vi
    }
    let acc = rt_sw_f64_of(0)
    let wr = W + (expert * rpe + j) * rb
    let b = 0
    while b < nb {
      let blk = wr + b * 210
      let d = rt_sw_f64_of(rt_sw_f16(blk + 208))
      let h = 0
      while h < 2 {
        let g = 0
        while g < 4 {
          let sum0 = rt_sw_f64_of(0)
          let sum1 = rt_sw_f64_of(0)
          let l = 0
          while l < 32 {
            let ql = peekb(blk + 64 * h + l)
            if band(g, 1) == 1 { let ql = peekb(blk + 64 * h + 32 + l) }
            let nib = band(ql, 15)
            if g >= 2 { let nib = band(shr(ql, 4), 15) }
            let top = band(shr(peekb(blk + 128 + 32 * h + l), 2 * g), 3)
            let q = bor(nib, shl(top, 4))
            let q = q - 32
            let xi = b * 256 + 128 * h + 32 * g + l
            let xv = rt_sw_f64_of(0)
            if fits == 1 { let xv = rt_sw_ld32(base + 4 * xi) }
            if fits == 0 { let xv = rt_sw_f64_of(rt_sw_f32_of(peek(X + 8 * (vi * n + xi)))) }
            let qf = rt_sw_f64_of(rt_sw_f32_of(i2f(q)))
            if l < 16 { let sum0 = rt_sw_fma32(qf, xv, sum0) }
            if l >= 16 { let sum1 = rt_sw_fma32(qf, xv, sum1) }
            let l = l + 1
          }
          let s0 = peekb(blk + 192 + 8 * h + 2 * g)
          if s0 >= 128 { let s0 = s0 - 256 }
          let s1 = peekb(blk + 192 + 8 * h + 1 + 2 * g)
          if s1 >= 128 { let s1 = s1 - 256 }
          let acc = rt_sw_fma32(rt_sw_mul32(d, rt_sw_f64_of(rt_sw_f32_of(i2f(s0)))), sum0, acc)
          let acc = rt_sw_fma32(rt_sw_mul32(d, rt_sw_f64_of(rt_sw_f32_of(i2f(s1)))), sum1, acc)
          let g = g + 1
        }
        let h = h + 1
      }
      let b = b + 1
    }
    do poke(Y + 8 * r, acc)
    let r = r + 1
  }
  return rt_tag(0)
}

# exp(x) as the listing writes it: n = round(x log2 e), g = (x log2 e - n) ln2, e^g by the
# degree-12 Horner, then scale by 2^n. A product here is two roundings; it matches the fma
# when the reduced argument is zero.
skill rt_sw_exp64(x) -> Any {
  let y = fmul(x, 4609176140021203710)
  let lim = 4652183230701633536
  let neg = fsub(i2f(0), lim)
  if flt(y, neg) { let y = neg }
  if flt(lim, y) { let y = lim }
  let n = rt_sw_rni(y)
  let g = fmul(fsub(y, i2f(n)), 4604418534313441775)
  let p = 4477122120089393304
  let p = fadd(fmul(p, g), 4493156764026750180)
  let p = fadd(fmul(p, g), 4508805057796939612)
  let p = fadd(fmul(p, g), 4523617214285662003)
  let p = fadd(fmul(p, g), 4537941361671905306)
  let p = fadd(fmul(p, g), 4551452160554016794)
  let p = fadd(fmul(p, g), 4564047942368979991)
  let p = fadd(fmul(p, g), 4575957461383581969)
  let p = fadd(fmul(p, g), 4586165620538955093)
  let p = fadd(fmul(p, g), 4595172819793696085)
  let p = fadd(fmul(p, g), 4602678819172646912)
  let p = fadd(fmul(p, g), 4607182418800017408)
  let p = fadd(fmul(p, g), 4607182418800017408)
  let e = n + 1023
  if e <= 0 { return i2f(0) }
  if e >= 2047 { return shl(2047, 52) }
  return fmul(p, shl(e, 52))
}

# silu(x) = x / (1 + exp(-x)), the listing's div, not a reciprocal multiply
skill rt_sw_silu64(x) -> Any {
  return fdiv(x, fadd(rt_sw_exp64(fsub(i2f(0), x)), i2f(1)))
}

# vadd: one thread owns index ctaid.x * ntid.x + tid.x. Y = A + B in f64. A thread at or past n
# loads nothing. The bytes are the doubles that thread actually touches.
skill rt_sw_vadd(gx, bx, ps) -> Any {
  let A = rt_sw_arg(ps, 0)
  let B = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let lim = rt_untag(gx) * rt_untag(bx)
  let touched = n
  if lim < touched { let touched = lim }
  if touched < 0 { let touched = 0 }
  do rt_sw_note(touched * 24)
  let t = 0
  while t < lim {
    if t < n {
      do poke(Y + 8 * t, fadd(peek(A + 8 * t), peek(B + 8 * t)))
    }
    let t = t + 1
  }
  return rt_tag(0)
}

# silumul: the same index. Y = silu(G) * U. The exp is the listing's series.
skill rt_sw_silumul(gx, bx, ps) -> Any {
  let G = rt_sw_arg(ps, 0)
  let U = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let lim = rt_untag(gx) * rt_untag(bx)
  let touched = n
  if lim < touched { let touched = lim }
  if touched < 0 { let touched = 0 }
  do rt_sw_note(touched * 24)
  let t = 0
  while t < lim {
    if t < n {
      do poke(Y + 8 * t, fmul(rt_sw_silu64(peek(G + 8 * t)), peek(U + 8 * t)))
    }
    let t = t + 1
  }
  return rt_tag(0)
}

# butterfly add.f32 across 32 lanes. The two halves are written together, then the buffers swap.
skill rt_sw_bfly32(buf) -> Any {
  let src = buf
  let dst = buf + 128
  let k = 16
  while k >= 1 {
    let i = 0
    while i < 32 {
      let a = rt_sw_f64_of(rt_peek32(src + 4 * i))
      let b = rt_sw_f64_of(rt_peek32(src + 4 * bxor(i, k)))
      do rt_poke32(dst + 4 * i, rt_sw_f32_of(rt_sw_add32(a, b)))
      let i = i + 1
    }
    let hold = src
    let src = dst
    let dst = hold
    let k = k // 2
  }
  return rt_sw_f64_of(rt_peek32(src))
}

# rmsn: one block per vector, 8 warps, stride 256, as the listing. Squares are float32, one fma per
# element, then a warp butterfly. Lane 0 writes that warp sum as f64. Warp 0 adds the 8 sums, then
# Y = X * rcp(sqrt(sum/n + 1e-6)) * W, and W is float32 indexed inside the vector. The 8 sums and
# the scale are 72 bytes. A thread that does not exist adds a zero lane.
skill rt_sw_rmsn(gx, bx, ps) -> Any {
  let X = rt_sw_arg(ps, 0)
  let W = rt_sw_arg(ps, 1)
  let Y = rt_sw_arg(ps, 2)
  let n = rt_sw_arg(ps, 3)
  let blocks = rt_untag(gx)
  let threads = rt_untag(bx)
  let lanes = threads
  if lanes > 256 { let lanes = 256 }
  let full = 0
  let rem = 0
  if n > 0 {
    let full = n // 256
    let rem = n % 256
  }
  let tail = rem
  if tail > lanes { let tail = lanes }
  let per = full * lanes + tail
  if blocks < 0 { let blocks = 0 }
  if per < 0 { let per = 0 }
  do rt_sw_note(blocks * per * 28)
  let red = rt_alloc(64)
  let buf = rt_alloc(256)
  let b = 0
  while b < blocks {
    let base = b * n
    let w = 0
    while w < 8 {
      let lane = 0
      while lane < 32 {
        do rt_poke32(buf + 4 * lane, 0)
        let tid = w * 32 + lane
        if tid < threads {
          let acc = i2f(0)
          let i = tid
          while i < n {
            let xf = rt_sw_f64_of(rt_sw_f32_of(peek(X + 8 * (base + i))))
            let acc = rt_sw_fma32(xf, xf, acc)
            let i = i + 256
          }
          do rt_poke32(buf + 4 * lane, rt_sw_f32_of(acc))
        }
        let lane = lane + 1
      }
      do poke(red + 8 * w, rt_sw_bfly32(buf))
      let w = w + 1
    }
    let sum = peek(red)
    let w = 1
    while w < 8 {
      let sum = fadd(sum, peek(red + 8 * w))
      let w = w + 1
    }
    let scale = fdiv(i2f(1), fsqrt(fadd(fdiv(sum, i2f(n)), 4517329193108106637)))
    let t = 0
    while t < threads {
      let i = t
      while i < n {
        let x = peek(X + 8 * (base + i))
        let wf = rt_sw_f64_of(rt_peek32(W + 4 * i))
        do poke(Y + 8 * (base + i), fmul(fmul(x, scale), wf))
        let i = i + 256
      }
      let t = t + 1
    }
    let b = b + 1
  }
  return rt_tag(0)
}

# silu as a real, so a launch can be checked against the same series
skill rt_sw_silu(v) -> Any { return rt_mkreal(rt_sw_silu64(rt_realbits(v))) }

# butterfly add.rn.f64. The pairs of one step are disjoint, so both lanes take the sum in place.
skill rt_sw_bfly64(buf) -> Any {
  let k = 16
  while k >= 1 {
    let i = 0
    while i < 32 {
      let j = bxor(i, k)
      if i < j {
        let s = fadd(peek(buf + 8 * i), peek(buf + 8 * j))
        do poke(buf + 8 * i, s)
        do poke(buf + 8 * j, s)
      }
      let i = i + 1
    }
    let k = k // 2
  }
  return peek(buf)
}

# both lanes keep the larger value, and on a tie the smaller index
skill rt_sw_keep(buf, ibuf, i, j) -> Any {
  let ov = peek(buf + 8 * i)
  let bv = peek(buf + 8 * j)
  let oi = rt_peek32(ibuf + 4 * i)
  let bi = rt_peek32(ibuf + 4 * j)
  let wv = bv
  let wi = bi
  if flt(bv, ov) {
    let wv = ov
    let wi = oi
  }
  if flt(ov, bv) == 0 and flt(bv, ov) == 0 {
    if oi < bi {
      let wv = ov
      let wi = oi
    }
  }
  do poke(buf + 8 * i, wv)
  do poke(buf + 8 * j, wv)
  do rt_poke32(ibuf + 4 * i, wi)
  do rt_poke32(ibuf + 4 * j, wi)
  return 0
}

skill rt_sw_bargmax(buf, ibuf) -> Any {
  let k = 16
  while k >= 1 {
    let i = 0
    while i < 32 {
      let j = bxor(i, k)
      if i < j { do rt_sw_keep(buf, ibuf, i, j) }
      let i = i + 1
    }
    let k = k // 2
  }
  return peek(buf)
}

# gnorm: one block is one head of 128. The squares add across 4 warps, the scale divides by 128,
# and FIN becomes rmsnorm(FIN) x W x silu(Z). W is 128 float32s, reused by every head.
skill rt_sw_gnorm(gx, bx, ps) -> Any {
  let Z = rt_sw_arg(ps, 0)
  let W = rt_sw_arg(ps, 1)
  let FIN = rt_sw_arg(ps, 2)
  let blocks = rt_untag(gx)
  let threads = rt_untag(bx)
  let use = threads
  if use > 128 { let use = 128 }
  if blocks < 0 { let blocks = 0 }
  do rt_sw_note(blocks * use * 28)
  let buf = rt_alloc(256)
  let red = rt_alloc(32)
  let b = 0
  while b < blocks {
    let base = b * 128
    let w = 0
    while w < 4 {
      let lane = 0
      while lane < 32 {
        do poke(buf + 8 * lane, i2f(0))
        let tid = w * 32 + lane
        if tid < use {
          let x = peek(FIN + 8 * (base + tid))
          do poke(buf + 8 * lane, fmul(x, x))
        }
        let lane = lane + 1
      }
      do poke(red + 8 * w, rt_sw_bfly64(buf))
      let w = w + 1
    }
    let sum = peek(red)
    let w = 1
    while w < 4 {
      let sum = fadd(sum, peek(red + 8 * w))
      let w = w + 1
    }
    let scale = fdiv(i2f(1), fsqrt(fadd(fdiv(sum, 4638707616191610880), 4517329193108106637)))
    let t = 0
    while t < use {
      let x = peek(FIN + 8 * (base + t))
      let wf = rt_sw_f64_of(rt_peek32(W + 4 * t))
      let y = fmul(fmul(fmul(x, scale), wf), rt_sw_silu64(peek(Z + 8 * (base + t))))
      do poke(FIN + 8 * (base + t), y)
      let t = t + 1
    }
    let b = b + 1
  }
  return rt_tag(0)
}

# amax: one block of 1024 threads, stride 1024. The largest value, and the first index if several match.
# A thread that owns nothing keeps -inf, so it cannot win.
skill rt_sw_amax(gx, bx, ps) -> Any {
  let L = rt_sw_arg(ps, 0)
  let OUT = rt_sw_arg(ps, 1)
  let n = rt_sw_arg(ps, 2)
  let blocks = rt_untag(gx)
  let threads = rt_untag(bx)
  let lanes = threads
  if lanes > 1024 { let lanes = 1024 }
  let full = 0
  let rem = 0
  if n > 0 {
    let full = n // 1024
    let rem = n % 1024
  }
  let tail = rem
  if tail > lanes { let tail = lanes }
  let per = full * lanes + tail
  if blocks < 0 { let blocks = 0 }
  do rt_sw_note(blocks * (per * 8 + 16))
  let buf = rt_alloc(256)
  let ibuf = rt_alloc(128)
  let red = rt_alloc(256)
  let ired = rt_alloc(128)
  let ninf = 0 - 4503599627370496
  let b = 0
  while b < blocks {
    let w = 0
    while w < 32 {
      let lane = 0
      while lane < 32 {
        let tid = w * 32 + lane
        do poke(buf + 8 * lane, ninf)
        do rt_poke32(ibuf + 4 * lane, tid)
        if tid < threads {
          let i = tid
          let best = ninf
          let bi = tid
          while i < n {
            let v = peek(L + 8 * i)
            if flt(best, v) {
              let best = v
              let bi = i
            }
            let i = i + 1024
          }
          do poke(buf + 8 * lane, best)
          do rt_poke32(ibuf + 4 * lane, bi)
        }
        let lane = lane + 1
      }
      do rt_sw_bargmax(buf, ibuf)
      do poke(red + 8 * w, peek(buf))
      do rt_poke32(ired + 4 * w, rt_peek32(ibuf))
      let w = w + 1
    }
    let best = peek(red)
    let bi = rt_peek32(ired)
    let w = 1
    while w < 32 {
      let ov = peek(red + 8 * w)
      let oi = rt_peek32(ired + 4 * w)
      if flt(best, ov) {
        let best = ov
        let bi = oi
      }
      if flt(ov, best) == 0 and flt(best, ov) == 0 {
        if oi < bi {
          let best = ov
          let bi = oi
        }
      }
      let w = w + 1
    }
    do poke(OUT, best)
    do poke(OUT + 8, i2f(bi))
    let b = b + 1
  }
  return rt_tag(0)
}

# ablate: one block per token of 2048. X loses its part along D, scale in percent. 100 removes that part.
skill rt_sw_ablate(gx, bx, ps) -> Any {
  let X = rt_sw_arg(ps, 0)
  let H = rt_sw_arg(ps, 1)
  let D = rt_sw_arg(ps, 2)
  let scale = rt_sw_arg(ps, 4)
  let blocks = rt_untag(gx)
  let threads = rt_untag(bx)
  let lanes = threads
  if lanes > 256 { let lanes = 256 }
  if blocks < 0 { let blocks = 0 }
  do rt_sw_note(blocks * (8 * lanes) * 48)
  let buf = rt_alloc(256)
  let red = rt_alloc(64)
  let b = 0
  while b < blocks {
    let base = b * 2048
    let w = 0
    while w < 8 {
      let lane = 0
      while lane < 32 {
        do poke(buf + 8 * lane, i2f(0))
        let tid = w * 32 + lane
        if tid < lanes {
          let acc = i2f(0)
          let i = tid
          while i < 2048 {
            let dlt = fsub(peek(X + 8 * (base + i)), peek(H + 8 * (base + i)))
            let acc = fadd(fmul(dlt, peek(D + 8 * i)), acc)
            let i = i + 256
          }
          do poke(buf + 8 * lane, acc)
        }
        let lane = lane + 1
      }
      do poke(red + 8 * w, rt_sw_bfly64(buf))
      let w = w + 1
    }
    let dot = peek(red)
    let w = 1
    while w < 8 {
      let dot = fadd(dot, peek(red + 8 * w))
      let w = w + 1
    }
    let dot = fdiv(fmul(dot, i2f(scale)), 4636737291354636288)
    let t = 0
    while t < lanes {
      let i = t
      while i < 2048 {
        let x = peek(X + 8 * (base + i))
        do poke(X + 8 * (base + i), fsub(x, fmul(peek(D + 8 * i), dot)))
        let i = i + 256
      }
      let t = t + 1
    }
    let b = b + 1
  }
  return rt_tag(0)
}

# capd: a token whose index is a multiple of the stride. CAP gets X - H as float32.
skill rt_sw_capd(gx, bx, ps) -> Any {
  let X = rt_sw_arg(ps, 0)
  let H = rt_sw_arg(ps, 1)
  let CAP = rt_sw_arg(ps, 2)
  let stride = rt_sw_arg(ps, 4)
  let blocks = rt_untag(gx)
  let threads = rt_untag(bx)
  let lanes = threads
  if lanes > 256 { let lanes = 256 }
  if blocks < 0 { let blocks = 0 }
  let active = 0
  let b = 0
  while b < blocks {
    if stride > 0 and b % stride == 0 { let active = active + 1 }
    let b = b + 1
  }
  do rt_sw_note(active * (8 * lanes) * 20)
  let b = 0
  while b < blocks {
    if stride > 0 and b % stride == 0 {
      let row = b // stride
      let base = b * 2048
      let capb = row * 2048
      let t = 0
      while t < lanes {
        let i = t
        while i < 2048 {
          let dlt = fsub(peek(X + 8 * (base + i)), peek(H + 8 * (base + i)))
          do rt_poke32(CAP + 4 * (capb + i), rt_sw_f32_of(dlt))
          let i = i + 256
        }
        let t = t + 1
      }
    }
    let b = b + 1
  }
  return rt_tag(0)
}

# max.f64 across a warp. -inf loses to any number.
skill rt_sw_bflymax(buf) -> Any {
  let k = 16
  while k >= 1 {
    let i = 0
    while i < 32 {
      let j = bxor(i, k)
      if i < j {
        let a = peek(buf + 8 * i)
        let b = peek(buf + 8 * j)
        let m = a
        if flt(a, b) { let m = b }
        do poke(buf + 8 * i, m)
        do poke(buf + 8 * j, m)
      }
      let i = i + 1
    }
    let k = k // 2
  }
  return peek(buf)
}

# 1 / (1 + exp(-x)). The listing's reciprocal of that sum, which is this division when the sum is exact.
skill rt_sw_sigm64(x) -> Any {
  return fdiv(i2f(1), fadd(rt_sw_exp64(fsub(i2f(0), x)), i2f(1)))
}

# qkprep: one block is (token, head). Heads 0..15 are queries. The 256 squares are one reciprocal
# square root over 256, the weight is float32, and dimensions 0..63 are rotated by the rope pair.
# Heads 16 and 17 write the key and the value into the cache as float32. The position is the
# double at POS, which is what the listing loads over the integer parameter.
skill rt_sw_qkprep(gx, bx, ps) -> Any {
  let QF = rt_sw_arg(ps, 0)
  let KF = rt_sw_arg(ps, 1)
  let VF = rt_sw_arg(ps, 2)
  let QN = rt_sw_arg(ps, 3)
  let KN = rt_sw_arg(ps, 4)
  let ROPE = rt_sw_arg(ps, 5)
  let Q = rt_sw_arg(ps, 6)
  let KC = rt_sw_arg(ps, 7)
  let VC = rt_sw_arg(ps, 8)
  let POS = rt_sw_arg(ps, 9)
  let pos = f2i(peek(POS))
  if pos < 0 { let pos = 0 }
  let blocks = rt_untag(gx)
  let threads = rt_untag(bx)
  let use = threads
  if use > 256 { let use = 256 }
  if blocks < 0 { let blocks = 0 }
  let queries = 0
  let b = 0
  while b < blocks {
    if b % 18 < 16 { let queries = queries + 1 }
    let b = b + 1
  }
  let keys = blocks - queries
  do rt_sw_note(queries * use * 36 + keys * use * 44)
  let buf = rt_alloc(256)
  let red = rt_alloc(64)
  let sbuf = rt_alloc(2048)
  let kept = rt_alloc(2048)
  let wkept = rt_alloc(2048)
  let b = 0
  while b < blocks {
    let token = b // 18
    let head = b % 18
    let query = 0
    if head < 16 { let query = 1 }
    let wbase = QN
    if query == 0 { let wbase = KN }
    let src = QF
    let idx0 = token * 8192 + head * 512
    if query == 0 {
      let src = KF
      let idx0 = token * 512 + (head - 16) * 256
    }
    let w = 0
    while w < 8 {
      let lane = 0
      while lane < 32 {
        do poke(buf + 8 * lane, i2f(0))
        let tid = w * 32 + lane
        if tid < use {
          let x = peek(src + 8 * (idx0 + tid))
          do poke(kept + 8 * tid, x)
          do poke(wkept + 8 * tid, rt_sw_f64_of(rt_peek32(wbase + 4 * tid)))
          do poke(buf + 8 * lane, fmul(x, x))
        }
        let lane = lane + 1
      }
      do poke(red + 8 * w, rt_sw_bfly64(buf))
      let w = w + 1
    }
    let sum = peek(red)
    let w = 1
    while w < 8 {
      let sum = fadd(sum, peek(red + 8 * w))
      let w = w + 1
    }
    let scale = fdiv(i2f(1), fsqrt(fadd(fdiv(sum, 4643211215818981376), 4517329193108106637)))
    let t = 0
    while t < use {
      let x = peek(kept + 8 * t)
      let wf = peek(wkept + 8 * t)
      do poke(sbuf + 8 * t, fmul(fmul(x, scale), wf))
      let t = t + 1
    }
    let t = 0
    while t < use {
      let lane = band(t, 31)
      let a = peek(sbuf + 8 * lane)
      let bp = peek(sbuf + 8 * (lane + 32))
      let pair = (token * 32 + lane) * 2
      let cs = peek(ROPE + 8 * pair)
      let sn = peek(ROPE + 8 * pair + 8)
      let y = fsub(fmul(a, cs), fmul(bp, sn))
      if t >= 32 { let y = fadd(fmul(bp, cs), fmul(a, sn)) }
      if t >= 64 { let y = peek(sbuf + 8 * t) }
      if query == 1 {
        do poke(Q + 8 * (token * 4096 + head * 256 + t), y)
      } else {
        let at = (pos + token) * 512 + (head - 16) * 256 + t
        do rt_poke32(KC + 4 * at, rt_sw_f32_of(y))
        let v = peek(VF + 8 * (idx0 + t))
        do rt_poke32(VC + 4 * at, rt_sw_f32_of(v))
      }
      let t = t + 1
    }
    let b = b + 1
  }
  return rt_tag(0)
}

# attn: one block is (token, query head). Each thread scores the positions it owns, the block
# takes the max and the sum of exp(score - max), then thread i gathers value dimension i.
# The gate is the second half of the head, and sigmoid is the listing's series. The position
# count is POS[0] + token + 1.
skill rt_sw_attn(gx, bx, ps) -> Any {
  let Q = rt_sw_arg(ps, 0)
  let QF = rt_sw_arg(ps, 1)
  let KC = rt_sw_arg(ps, 2)
  let VC = rt_sw_arg(ps, 3)
  let SCR = rt_sw_arg(ps, 4)
  let ATT = rt_sw_arg(ps, 5)
  let POS = rt_sw_arg(ps, 6)
  let maxpos = rt_sw_arg(ps, 8)
  let pos = f2i(peek(POS))
  if pos < 0 { let pos = 0 }
  let blocks = rt_untag(gx)
  let threads = rt_untag(bx)
  let use = threads
  if use > 256 { let use = 256 }
  if blocks < 0 { let blocks = 0 }
  let buf = rt_alloc(256)
  let red = rt_alloc(64)
  let ninf = 0 - 4503599627370496
  let bytes = 0
  let b = 0
  while b < blocks {
    let token = shr(b, 4)
    let head = band(b, 15)
    let kh = shr(head, 3)
    let npos = pos + token + 1
    let qbase = token * 4096 + head * 256
    let sbase = b * maxpos
    let w = 0
    while w < 8 {
      let lane = 0
      while lane < 32 {
        do poke(buf + 8 * lane, ninf)
        let tid = w * 32 + lane
        if tid < use {
          let best = ninf
          let p = tid
          while p < npos {
            let dot = i2f(0)
            let d = 0
            let kbase = p * 512 + kh * 256
            while d < 256 {
              let dot = fadd(dot, fmul(peek(Q + 8 * (qbase + d)), peek(KC + 8 * (kbase + d))))
              let d = d + 1
            }
            let dot = fdiv(dot, 4625196817309499392)
            do poke(SCR + 8 * (sbase + p), dot)
            if flt(best, dot) { let best = dot }
            let bytes = bytes + 4096 + 8
            let p = p + 256
          }
          do poke(buf + 8 * lane, best)
        }
        let lane = lane + 1
      }
      do poke(red + 8 * w, rt_sw_bflymax(buf))
      let w = w + 1
    }
    let mx = peek(red)
    let w = 1
    while w < 8 {
      let other = peek(red + 8 * w)
      if flt(mx, other) { let mx = other }
      let w = w + 1
    }
    let w = 0
    while w < 8 {
      let lane = 0
      while lane < 32 {
        do poke(buf + 8 * lane, i2f(0))
        let tid = w * 32 + lane
        if tid < use {
          let acc = i2f(0)
          let p = tid
          while p < npos {
            let e = rt_sw_exp64(fsub(peek(SCR + 8 * (sbase + p)), mx))
            do poke(SCR + 8 * (sbase + p), e)
            let acc = fadd(acc, e)
            let bytes = bytes + 16
            let p = p + 256
          }
          do poke(buf + 8 * lane, acc)
        }
        let lane = lane + 1
      }
      do poke(red + 8 * w, rt_sw_bfly64(buf))
      let w = w + 1
    }
    let sm = peek(red)
    let w = 1
    while w < 8 {
      let sm = fadd(sm, peek(red + 8 * w))
      let w = w + 1
    }
    let t = 0
    while t < use {
      let acc = i2f(0)
      let p = 0
      let vdim = kh * 256 + t
      while p < npos {
        let wt = fdiv(peek(SCR + 8 * (sbase + p)), sm)
        let acc = fadd(acc, fmul(wt, peek(VC + 8 * (p * 512 + vdim))))
        let bytes = bytes + 16
        let p = p + 1
      }
      let gate = peek(QF + 8 * (token * 8192 + head * 512 + 256 + t))
      let acc = fmul(acc, rt_sw_sigm64(gate))
      do poke(ATT + 8 * (qbase + t), acc)
      let bytes = bytes + 16
      let t = t + 1
    }
    let b = b + 1
  }
  do rt_sw_note(bytes)
  return rt_tag(0)
}

# cos and sin of a double, the listing's reduction and series. A product is two roundings;
# at a zero angle every product is zero, so both are exact.
skill rt_sw_sincos(x, dst) -> Any {
  let n = rt_sw_rni(fmul(x, 4594902181429758083))
  let r = fadd(fmul(fsub(i2f(0), i2f(n)), 4618760256179416344), x)
  let r = fadd(fmul(fsub(i2f(0), i2f(n)), 4373459396149402631), r)
  let u = fsub(i2f(0), fmul(r, r))
  let sn = 4099459641245955516
  let sn = fadd(fmul(sn, u), 4143973535452453037)
  let sn = fadd(fmul(sn, u), 4187532579305213603)
  let sn = fadd(fmul(sn, u), 4229992536239136681)
  let sn = fadd(fmul(sn, u), 4271490197626435610)
  let sn = fadd(fmul(sn, u), 4311945469071521138)
  let sn = fadd(fmul(sn, u), 4351309137733304663)
  let sn = fadd(fmul(sn, u), 4389130328383466826)
  let sn = fadd(fmul(sn, u), 4425604618586929183)
  let sn = fadd(fmul(sn, u), 4460272573143870729)
  let sn = fadd(fmul(sn, u), 4493156764026750180)
  let sn = fadd(fmul(sn, u), 4523617214285662004)
  let sn = fadd(fmul(sn, u), 4551452160554016794)
  let sn = fadd(fmul(sn, u), 4575957461383581969)
  let sn = fadd(fmul(sn, u), 4595172819793696085)
  let sn = fadd(fmul(sn, u), 4607182418800017408)
  let cs = 4121799902508865037
  let cs = fadd(fmul(cs, u), 4166007270036277341)
  let cs = fadd(fmul(cs, u), 4208770557894348378)
  let cs = fadd(fmul(cs, u), 4251165982991775096)
  let cs = fadd(fmul(cs, u), 4292157190933313619)
  let cs = fadd(fmul(cs, u), 4331992437988917797)
  let cs = fadd(fmul(cs, u), 4370323941990432151)
  let cs = fadd(fmul(cs, u), 4407590220077447199)
  let cs = fadd(fmul(cs, u), 4443145680587881629)
  let cs = fadd(fmul(cs, u), 4477122120089393304)
  let cs = fadd(fmul(cs, u), 4508805057796939612)
  let cs = fadd(fmul(cs, u), 4537941361671905306)
  let cs = fadd(fmul(cs, u), 4564047942368979991)
  let cs = fadd(fmul(cs, u), 4586165620538955093)
  let cs = fadd(fmul(cs, u), 4602678819172646912)
  let cs = fadd(fmul(cs, u), 4607182418800017408)
  do poke(dst, cs)
  do poke(dst + 8, fmul(sn, r))
  return 0
}

# one Q4_K weight. d and dmin are binary16 widened through float32. The 6-bit scale and min
# and the nibble are the same bytes mvq4 reads. The products stay float64, as this listing does.
skill rt_sw_q4w(blk, within) -> Any {
  let c = shr(within, 6)
  let half = band(shr(within, 5), 1)
  let l = band(within, 31)
  let j = c * 2 + half
  let d = rt_sw_f64_of(rt_sw_f16(blk))
  let dmin = rt_sw_f64_of(rt_sw_f16(blk + 2))
  let sc = i2f(rt_sw_q4sm(blk, j, 0))
  let mn = i2f(rt_sw_q4sm(blk, j, 1))
  let nb = peekb(blk + 16 + 32 * c + l)
  let q = band(nb, 15)
  if half == 1 { let q = band(shr(nb, 4), 15) }
  return fsub(fmul(fmul(d, sc), i2f(q)), fmul(dmin, mn))
}

# one Q6_K weight. The nibble, the two high bits, and the signed scale are mvq6's. q is that
# 6-bit value minus 32. d is the binary16 at offset 208, widened through float32.
skill rt_sw_q6w(blk, within) -> Any {
  let h = shr(within, 7)
  let lo = band(within, 127)
  let g = shr(lo, 5)
  let l = band(lo, 31)
  let ql = peekb(blk + 64 * h + l)
  if band(g, 1) == 1 { let ql = peekb(blk + 64 * h + 32 + l) }
  let nib = band(ql, 15)
  if g >= 2 { let nib = band(shr(ql, 4), 15) }
  let top = band(shr(peekb(blk + 128 + 32 * h + l), 2 * g), 3)
  let q = bor(nib, shl(top, 4)) - 32
  let sc = peekb(blk + 192 + 8 * h + 2 * g + shr(l, 4))
  if sc >= 128 { let sc = sc - 256 }
  let d = rt_sw_f64_of(rt_sw_f16(blk + 208))
  return fmul(fmul(d, i2f(sc)), i2f(q))
}

# rope pairs for threads 0..31. th = pos * exp(-(2 i / 64) * ln(1e7)).
skill rt_sw_tokrope(dst, pos, lanes) -> Any {
  let n = lanes
  if n > 32 { let n = 32 }
  if n < 0 { let n = 0 }
  let t = 0
  while t < n {
    let ang = fdiv(i2f(t + t), 4634204016564240384)
    let ang = fmul(ang, 4625230058280102515)
    let th = fmul(i2f(pos), rt_sw_exp64(fsub(i2f(0), ang)))
    do rt_sw_sincos(th, dst + 16 * t)
    let t = t + 1
  }
  return n * 16
}

# 2048 embedding weights, stride 256, then the rope pairs. Q6_K when typ is 14, otherwise Q4_K.
skill rt_sw_tokbody(row, X, ROPE, pos, typ, lanes) -> Any {
  let bytes = 0
  let t = 0
  while t < lanes {
    let i = t
    while i < 2048 {
      let blk = shr(i, 8)
      let within = band(i, 255)
      if typ == 14 {
        do poke(X + 8 * i, rt_sw_q6w(row + blk * 210, within))
        let bytes = bytes + 13
      } else {
        do poke(X + 8 * i, rt_sw_q4w(row + blk * 144, within))
        let bytes = bytes + 15
        if within >= 128 { let bytes = bytes + 1 }
      }
      let i = i + 256
    }
    let t = t + 1
  }
  return bytes + rt_sw_tokrope(ROPE, pos, lanes)
}

# tokin: thread 0 records the position and the chosen token, then every thread decodes that row.
# The token is AMAX[1] and the position is POS[1], both doubles taken toward zero.
skill rt_sw_tokin(gx, bx, ps) -> Any {
  let AM = rt_sw_arg(ps, 0)
  let POS = rt_sw_arg(ps, 1)
  let TOKS = rt_sw_arg(ps, 2)
  let EMB = rt_sw_arg(ps, 3)
  let X = rt_sw_arg(ps, 4)
  let ROPE = rt_sw_arg(ps, 5)
  let rb = rt_sw_arg(ps, 6)
  let typ = rt_sw_arg(ps, 7)
  let blocks = rt_untag(gx)
  let lanes = rt_untag(bx)
  if lanes > 256 { let lanes = 256 }
  if lanes < 0 { let lanes = 0 }
  if blocks < 0 { let blocks = 0 }
  let bytes = 0
  let b = 0
  while b < blocks {
    let id = f2i(peek(AM + 8))
    let pos = f2i(peek(POS + 8))
    if lanes > 0 {
      do poke(POS, i2f(pos))
      do poke(POS + 8, i2f(pos + 1))
      do poke(TOKS + 8 * pos, peek(AM + 8))
      let bytes = bytes + 24
    }
    let bytes = bytes + lanes * 16
    let bytes = bytes + rt_sw_tokbody(EMB + id * rb, X, ROPE, pos, typ, lanes)
    let b = b + 1
  }
  do rt_sw_note(bytes)
  return rt_tag(0)
}

# tokinT: one block per token of a prefill. The token id is TOKS[POS[0] + block]. No bookkeeping.
# Row t of X is 2048 doubles past the previous one, and its rope is 64 doubles past.
skill rt_sw_tokinT(gx, bx, ps) -> Any {
  let POS = rt_sw_arg(ps, 1)
  let TOKS = rt_sw_arg(ps, 2)
  let EMB = rt_sw_arg(ps, 3)
  let X = rt_sw_arg(ps, 4)
  let ROPE = rt_sw_arg(ps, 5)
  let rb = rt_sw_arg(ps, 6)
  let typ = rt_sw_arg(ps, 7)
  let blocks = rt_untag(gx)
  let lanes = rt_untag(bx)
  if lanes > 256 { let lanes = 256 }
  if lanes < 0 { let lanes = 0 }
  if blocks < 0 { let blocks = 0 }
  let pos0 = f2i(peek(POS))
  let bytes = 0
  let b = 0
  while b < blocks {
    let pos = pos0 + b
    let id = f2i(peek(TOKS + 8 * pos))
    let bytes = bytes + lanes * 16
    let bytes = bytes + rt_sw_tokbody(EMB + id * rb, X + b * 16384, ROPE + b * 512, pos, typ, lanes)
    let b = b + 1
  }
  do rt_sw_note(bytes)
  return rt_tag(0)
}


# order-preserving key of a double. Negatives are complemented. The rest get the sign bit set,
# so an unsigned compare matches the float order, and a tie keeps the smaller index.
skill rt_sw_okey(bits) -> Any {
  let mask = bor(9223372036854775807, shl(1, 63))
  if shr(bits, 63) != 0 { return bxor(bits, mask) }
  return bor(bits, shl(1, 63))
}

# unsigned greater-than. The two sides are keys, so the high bit is set on every non-negative float.
skill rt_sw_gtu(a, b) -> Any {
  let as = shr(a, 63)
  let bs = shr(b, 63)
  if as != bs { return as }
  if a > b { return 1 }
  return 0
}

# route: one block per token, one thread per expert, at most 256. Softmax, then the eight largest
# keys. A tie keeps the smaller index. Keys sit in TMEM (2,048 bytes) with the eight chosen
# weights (64), one warp of the reduction (256), and the eight warp sums (64). 2,432 of the 4 KB.
# The bus is one double in per expert and two doubles out per chosen expert.
skill rt_sw_route(gx, bx, ps) -> Any {
  let LG = rt_sw_arg(ps, 0)
  let E = rt_sw_arg(ps, 1)
  let W = rt_sw_arg(ps, 2)
  let blocks = rt_untag(gx)
  let lanes = rt_untag(bx)
  if lanes > 256 { let lanes = 256 }
  if lanes < 0 { let lanes = 0 }
  if blocks < 0 { let blocks = 0 }
  let chosen = lanes
  if chosen > 8 { let chosen = 8 }
  do rt_sw_note(blocks * (lanes * 8 + chosen * 16))
  let mem = rt_untag(rt_sw_tmem())
  let logits = rt_alloc(2048)
  let probs = rt_alloc(2048)
  let aheads = rt_alloc(2048)
  let scratch = mem + 2112
  let red = mem + 2368
  let b = 0
  while b < blocks {
    if lanes > 0 {
      let t = 0
      while t < lanes {
        let bits = peek(LG + 8 * (b * 256 + t))
        do poke(logits + 8 * t, bits)
        do poke(mem + 8 * t, rt_sw_okey(bits))
        let t = t + 1
      }
      let warps = (lanes + 31) // 32
      let w = 0
      while w < warps {
        let lane = 0
        while lane < 32 {
          let tid = w * 32 + lane
          let v = peek(logits)
          if tid < lanes { let v = peek(logits + 8 * tid) }
          do poke(scratch + 8 * lane, v)
          let lane = lane + 1
        }
        do poke(red + 8 * w, rt_sw_bflymax(scratch))
        let w = w + 1
      }
      let mx = peek(red)
      let w = 1
      while w < warps {
        let a = peek(red + 8 * w)
        if flt(mx, a) { let mx = a }
        let w = w + 1
      }
      let w = 0
      while w < warps {
        let lane = 0
        while lane < 32 {
          let tid = w * 32 + lane
          let v = i2f(0)
          if tid < lanes { let v = rt_sw_exp64(fsub(peek(logits + 8 * tid), mx)) }
          do poke(scratch + 8 * lane, v)
          let lane = lane + 1
        }
        do poke(red + 8 * w, rt_sw_bfly64(scratch))
        let w = w + 1
      }
      let sum = peek(red)
      let w = 1
      while w < warps {
        let sum = fadd(sum, peek(red + 8 * w))
        let w = w + 1
      }
      let t = 0
      while t < lanes {
        let e = rt_sw_exp64(fsub(peek(logits + 8 * t), mx))
        do poke(probs + 8 * t, fdiv(e, sum))
        let mine = peek(mem + 8 * t)
        let ahead = 0
        let j = 0
        while j < lanes {
          let other = peek(mem + 8 * j)
          let win = rt_sw_gtu(other, mine)
          if other == mine {
            if t > j { let win = 1 }
          }
          if win == 1 { let ahead = ahead + 1 }
          let j = j + 1
        }
        do poke(aheads + 8 * t, ahead)
        if ahead < 8 { do poke(mem + 2048 + 8 * ahead, peek(probs + 8 * t)) }
        let t = t + 1
      }
      let acc = i2f(0)
      let k = 0
      while k < chosen {
        let acc = fadd(acc, peek(mem + 2048 + 8 * k))
        let k = k + 1
      }
      let t = 0
      while t < lanes {
        let ahead = peek(aheads + 8 * t)
        if ahead < 8 {
          do poke(E + 8 * (b * 8 + ahead), i2f(t))
          do poke(W + 8 * (b * 8 + ahead), fdiv(peek(probs + 8 * t), acc))
        }
        let t = t + 1
      }
    }
    let b = b + 1
  }
  return rt_tag(0)
}


# 2^x for a float32, flushed toward zero. The series is the float64 exp of x*ln2, then rounded
# back to float32. ex2(0) is 1. This is not the special-function unit.
skill rt_sw_ex2(u) -> Any {
  let u = band(u, 4294967295)
  let exp = band(shr(u, 23), 255)
  let man = band(u, 8388607)
  if exp == 0 { let u = shl(shr(u, 31), 31) }
  if exp == 255 {
    if man != 0 { return bor(shl(shr(u, 31), 31), 2143289344) }
    if shr(u, 31) != 0 { return 0 }
    return 2139095040
  }
  let y = rt_sw_exp64(fmul(rt_sw_f64_of(u), 4604418534313441775))
  return rt_sw_f32_of(y)
}

# float32 warp butterfly. op 0 adds, op 1 keeps the larger. Lane 0 holds the result.
skill rt_sw_bflyf(buf, op) -> Any {
  let k = 16
  while k >= 1 {
    let i = 0
    while i < 32 {
      let j = bxor(i, k)
      if i < j {
        let a = rt_sw_ld32(buf + 4 * i)
        let b = rt_sw_ld32(buf + 4 * j)
        let s = rt_sw_add32(a, b)
        if op == 1 {
          let s = a
          if flt(a, b) { let s = b }
        }
        do rt_sw_st32(buf + 4 * i, s)
        do rt_sw_st32(buf + 4 * j, s)
      }
      let i = i + 1
    }
    let k = k // 2
  }
  return rt_sw_ld32(buf)
}

# attn2: one block is (token, head, split). The query head is 256 floats in TMEM. This split's
# scores, at most 512, sit beside it. A key of zeros scores 0, and ex2(0) is 1.
skill rt_sw_attn2(gx, bx, ps) -> Any {
  let Q = rt_sw_arg(ps, 0)
  let KC = rt_sw_arg(ps, 1)
  let VC = rt_sw_arg(ps, 2)
  let POS = rt_sw_arg(ps, 3)
  let PM = rt_sw_arg(ps, 4)
  let PL = rt_sw_arg(ps, 5)
  let PO = rt_sw_arg(ps, 6)
  let S = rt_sw_arg(ps, 7)
  if S < 1 { return rt_tag(0 - 400) }
  let blocks = rt_untag(gx)
  let lanes = rt_untag(bx)
  if lanes > 256 { let lanes = 256 }
  if lanes < 0 { let lanes = 0 }
  if blocks < 0 { let blocks = 0 }
  let mem = rt_untag(rt_sw_tmem())
  let scores = mem + 1024
  let scratch = mem + 3104
  let bytes = 0
  let b = 0
  while b < blocks {
    let span = S * 16
    let token = b // span
    let rem = b % span
    let head = rem // S
    let split = rem % S
    let kv = head // 8
    let npos = f2i(peek(POS)) + token + 1
    let chunks = (npos + S - 1) // S
    let begin = split * chunks
    let endp = begin + chunks
    if endp > npos { let endp = npos }
    if endp < begin { let endp = begin }
    let count = endp - begin
    if count > 512 { return rt_tag(0 - 400) }
    let bytes = bytes + lanes * 16
    let bytes = bytes + count * 1024
    let bytes = bytes + lanes * count * 4
    let bytes = bytes + lanes * 4
    if lanes > 0 { let bytes = bytes + 8 }
    let t = 0
    while t < lanes {
      let qv = peek(Q + 8 * (token * 4096 + head * 256 + t))
      do rt_sw_st32(mem + 4 * t, qv)
      let t = t + 1
    }
    let warps = (lanes + 31) // 32
    let w = 0
    while w < warps {
      let p = w
      while p < count {
        let lane = 0
        while lane < 32 {
          let acc = i2f(0)
          let tid = w * 32 + lane
          if tid < lanes {
            let j = 0
            while j < 8 {
              let dim = lane + 32 * j
              let key = rt_sw_ld32(KC + 4 * ((begin + p) * 512 + kv * 256 + dim))
              let qv = rt_sw_ld32(mem + 4 * dim)
              let acc = rt_sw_fma32(key, qv, acc)
              let j = j + 1
            }
          }
          do rt_sw_st32(scratch + 4 * lane, acc)
          let lane = lane + 1
        }
        let dot = rt_sw_bflyf(scratch, 0)
        do rt_sw_st32(scores + 4 * p, rt_sw_mul32(dot, rt_sw_f64_of(1031798784)))
        let p = p + 8
      }
      let w = w + 1
    }
    let ninf = rt_sw_f64_of(4286578688)
    let t = 0
    while t < lanes {
      let a = ninf
      let c = ninf
      if t < count { let a = rt_sw_ld32(scores + 4 * t) }
      if t + 256 < count { let c = rt_sw_ld32(scores + 4 * (t + 256)) }
      let m = a
      if flt(a, c) { let m = c }
      do rt_sw_st32(scratch + 4 * (t % 32), m)
      if t % 32 == 31 or t + 1 == lanes {
        let wid = t // 32
        do rt_sw_st32(mem + 3072 + 4 * wid, rt_sw_bflyf(scratch, 1))
      }
      let t = t + 1
    }
    let mx = ninf
    if warps > 0 { let mx = rt_sw_ld32(mem + 3072) }
    let w = 1
    while w < warps {
      let a = rt_sw_ld32(mem + 3072 + 4 * w)
      if flt(mx, a) { let mx = a }
      let w = w + 1
    }
    let t = 0
    while t < lanes {
      let e0 = i2f(0)
      let e1 = i2f(0)
      if t < count {
        let d = rt_sw_sub_score(rt_sw_ld32(scores + 4 * t), mx)
        let e0 = rt_sw_f64_of(rt_sw_ex2(rt_sw_f32_of(d)))
        do rt_sw_st32(scores + 4 * t, e0)
      }
      if t + 256 < count {
        let d = rt_sw_sub_score(rt_sw_ld32(scores + 4 * (t + 256)), mx)
        let e1 = rt_sw_f64_of(rt_sw_ex2(rt_sw_f32_of(d)))
        do rt_sw_st32(scores + 4 * (t + 256), e1)
      }
      do rt_sw_st32(scratch + 4 * (t % 32), rt_sw_add32(e0, e1))
      if t % 32 == 31 or t + 1 == lanes {
        let wid = t // 32
        do rt_sw_st32(mem + 3072 + 4 * wid, rt_sw_bflyf(scratch, 0))
      }
      let t = t + 1
    }
    let sm = i2f(0)
    if warps > 0 { let sm = rt_sw_ld32(mem + 3072) }
    let w = 1
    while w < warps {
      let sm = rt_sw_add32(sm, rt_sw_ld32(mem + 3072 + 4 * w))
      let w = w + 1
    }
    let t = 0
    while t < lanes {
      let acc = i2f(0)
      let p = 0
      while p < count {
        let wt = rt_sw_ld32(scores + 4 * p)
        let vv = rt_sw_ld32(VC + 4 * ((begin + p) * 512 + kv * 256 + t))
        let acc = rt_sw_fma32(wt, vv, acc)
        let p = p + 1
      }
      do rt_sw_st32(PO + 4 * (b * 256 + t), acc)
      let t = t + 1
    }
    if lanes > 0 {
      do rt_sw_st32(PM + 4 * b, mx)
      do rt_sw_st32(PL + 4 * b, sm)
    }
    let b = b + 1
  }
  do rt_sw_note(bytes)
  return rt_tag(0)
}

# (score - max) * log2(e), in float32
skill rt_sw_sub_score(s, mx) -> Any {
  return rt_sw_mul32(rt_sw_add32(s, rt_sw_f64_of(rt_sw_f32_of(fsub(i2f(0), mx)))), rt_sw_f64_of(1069066811))
}

# acomb: one block is (token, head). The split pieces merge by the largest max, then the sigmoid of the gate.
skill rt_sw_acomb(gx, bx, ps) -> Any {
  let PM = rt_sw_arg(ps, 0)
  let PL = rt_sw_arg(ps, 1)
  let PO = rt_sw_arg(ps, 2)
  let QF = rt_sw_arg(ps, 3)
  let ATT = rt_sw_arg(ps, 4)
  let S = rt_sw_arg(ps, 5)
  if S < 1 { return rt_tag(0 - 400) }
  let blocks = rt_untag(gx)
  let lanes = rt_untag(bx)
  if lanes > 256 { let lanes = 256 }
  if lanes < 0 { let lanes = 0 }
  if blocks < 0 { let blocks = 0 }
  do rt_sw_note(blocks * lanes * (S * 12 + 16))
  let b = 0
  while b < blocks {
    let token = b // 16
    let head = b % 16
    let ninf = rt_sw_f64_of(4286578688)
    let mx = ninf
    let s = 0
    while s < S {
      let a = rt_sw_ld32(PM + 4 * (b * S + s))
      if flt(mx, a) { let mx = a }
      let s = s + 1
    }
    let t = 0
    while t < lanes {
      let den = i2f(0)
      let num = i2f(0)
      let s = 0
      while s < S {
        let d = rt_sw_sub_score(rt_sw_ld32(PM + 4 * (b * S + s)), mx)
        let e = rt_sw_f64_of(rt_sw_ex2(rt_sw_f32_of(d)))
        let den = rt_sw_fma32(e, rt_sw_ld32(PL + 4 * (b * S + s)), den)
        let num = rt_sw_fma32(e, rt_sw_ld32(PO + 4 * ((b * S + s) * 256 + t)), num)
        let s = s + 1
      }
      let out = rt_sw_div32(num, den)
      let gate = peek(QF + 8 * (token * 8192 + head * 512 + 256 + t))
      let z = rt_sw_mul32(gate, rt_sw_f64_of(3216550459))
      let sig = rt_sw_div32(i2f(1), rt_sw_add32(rt_sw_f64_of(rt_sw_ex2(rt_sw_f32_of(z))), i2f(1)))
      do poke(ATT + 8 * (token * 4096 + head * 256 + t), rt_sw_f64_of(rt_sw_f32_of(rt_sw_mul32(out, sig))))
      let t = t + 1
    }
    let b = b + 1
  }
  return rt_tag(0)
}


# conv: one thread per channel. History is three doubles at a stride of 8,192, so one channel spans
# 192 KB and lives on the SSD. The four taps are float32, oldest first. y = silu(h0*a+h1*b+h2*c+x*d).
# All 8,192 channels of one zero token are 655,360 bytes, 20,480 bus cycles, and 73,728 pages.
skill rt_sw_kconv(gx, bx, ps) -> Any {
  let M = rt_sw_arg(ps, 0)
  let H = rt_sw_arg(ps, 1)
  let TAP = rt_sw_arg(ps, 2)
  let CV = rt_sw_arg(ps, 3)
  let T = rt_sw_arg(ps, 4)
  let chans = rt_untag(gx) * rt_untag(bx)
  if chans < 0 { let chans = 0 }
  if T < 0 { let T = 0 }
  do rt_sw_note(chans * (64 + T * 16))
  let c = 0
  while c < chans {
    let h0 = rt_sw_ssd_ld(H, 8 * c)
    let h1 = rt_sw_ssd_ld(H, 8 * (c + 8192))
    let h2 = rt_sw_ssd_ld(H, 8 * (c + 16384))
    let a = rt_sw_f64_of(rt_sw_ssd_ld32(TAP, 16 * c))
    let b = rt_sw_f64_of(rt_sw_ssd_ld32(TAP, 16 * c + 4))
    let cc = rt_sw_f64_of(rt_sw_ssd_ld32(TAP, 16 * c + 8))
    let d = rt_sw_f64_of(rt_sw_ssd_ld32(TAP, 16 * c + 12))
    let t = 0
    while t < T {
      let x = rt_sw_ssd_ld(M, 8 * (t * 8192 + c))
      let y = fmul(h0, a)
      let y = fadd(y, fmul(h1, b))
      let y = fadd(y, fmul(h2, cc))
      let y = fadd(y, fmul(x, d))
      let y = rt_sw_silu64(y)
      do rt_sw_ssd_st(CV, 8 * (t * 8192 + c), y)
      let h0 = h1
      let h1 = h2
      let h2 = x
      let t = t + 1
    }
    do rt_sw_ssd_st(H, 8 * c, h0)
    do rt_sw_ssd_st(H, 8 * (c + 8192), h1)
    do rt_sw_ssd_st(H, 8 * (c + 16384), h2)
    let c = c + 1
  }
  return rt_tag(0)
}

# combine: X = H + sum of eight expert weights times their rows + sigmoid(shared gate) * shared expert.
# A row is 2,048 doubles, so the eight rows are 128 KB on the SSD. One element does not bring them all in.
# All 2,048 elements of one zero token are 327,680 bytes, 10,240 bus cycles, and 40,960 pages.
skill rt_sw_combine(gx, bx, ps) -> Any {
  let H = rt_sw_arg(ps, 0)
  let D = rt_sw_arg(ps, 1)
  let W = rt_sw_arg(ps, 2)
  let SG = rt_sw_arg(ps, 3)
  let SHD = rt_sw_arg(ps, 4)
  let X = rt_sw_arg(ps, 5)
  let T = rt_sw_arg(ps, 6)
  let lim = rt_untag(gx) * rt_untag(bx)
  if lim < 0 { let lim = 0 }
  let n = T * 2048
  if T < 0 { let n = 0 }
  let touched = lim
  if n < touched { let touched = n }
  if touched < 0 { let touched = 0 }
  do rt_sw_note(touched * 160)
  let i = 0
  while i < lim {
    if i < n {
      let token = i // 2048
      let elem = i % 2048
      let acc = i2f(0)
      let k = 0
      while k < 8 {
        let w = rt_sw_ssd_ld(W, 8 * (token * 8 + k))
        let d = rt_sw_ssd_ld(D, 8 * ((token * 8 + k) * 2048 + elem))
        let acc = fadd(acc, fmul(w, d))
        let k = k + 1
      }
      let g = rt_sw_sigm64(rt_sw_ssd_ld(SG, 8 * token))
      let acc = fadd(acc, fmul(g, rt_sw_ssd_ld(SHD, 8 * i)))
      let acc = fadd(acc, rt_sw_ssd_ld(H, 8 * i))
      do rt_sw_ssd_st(X, 8 * i, acc)
    }
    let i = i + 1
  }
  return rt_tag(0)
}


# log(1 + exp(x)). At 0 this is ln 2. The listing's series, then the same ln2 it reduces by.
skill rt_sw_softplus(x) -> Any {
  return fmul(rt_sw_log2(fadd(rt_sw_exp64(x), i2f(1))), 4604418534313441775)
}

# the two shuffles that join a column's four parts. Each lane adds the partner it is shown.
skill rt_sw_psum(buf) -> Any {
  let k = 8
  while k <= 16 {
    let i = 0
    while i < 32 {
      let j = bxor(i, k)
      if i < j {
        let a = peek(buf + 8 * i)
        let b = peek(buf + 8 * j)
        do poke(buf + 8 * i, fadd(a, b))
        do poke(buf + 8 * j, fadd(b, a))
      }
      let i = i + 1
    }
    let k = k * 2
  }
  return 0
}

# dnet4: one warp is 8 columns of one value head, four parts of 32 rows. The head's state is 128 by 128
# doubles, 128 KB, on the SSD. q and k of a zero vector normalise to 0, so a zero state stays 0 and the
# output is 0. One warp of one zero token touches 35,904 bytes, 1,122 bus cycles, and 929 pages.
# All 32 heads are 512 warps, 18,382,848 bytes, 574,464 bus cycles, and 475,648 pages. The state is 4 MB.
skill rt_sw_dnet4(gx, bx, ps) -> Any {
  let S = rt_sw_arg(ps, 0)
  let CV = rt_sw_arg(ps, 1)
  let B = rt_sw_arg(ps, 2)
  let A = rt_sw_arg(ps, 3)
  let DTB = rt_sw_arg(ps, 4)
  let SA = rt_sw_arg(ps, 5)
  let FIN = rt_sw_arg(ps, 6)
  let T = rt_sw_arg(ps, 7)
  let blocks = rt_untag(gx)
  let lanes = rt_untag(bx)
  if lanes > 32 { let lanes = 32 }
  if lanes < 0 { let lanes = 0 }
  if blocks < 0 { let blocks = 0 }
  if T < 0 { let T = 0 }
  let p0 = lanes
  if p0 > 8 { let p0 = 8 }
  do rt_sw_note(blocks * lanes * (8 + T * 1112) + blocks * p0 * T * 8)
  let mem = rt_untag(rt_sw_tmem())
  let qreg = rt_alloc(1024)
  let kreg = rt_alloc(1024)
  let sq = rt_alloc(256)
  let sks = rt_alloc(256)
  let vs = rt_alloc(256)
  let betas = rt_alloc(256)
  let os = rt_alloc(256)
  let b = 0
  while b < blocks {
    let j = b // 16
    let colg = b % 16
    let dtb = i2f(0)
    let sav = i2f(0)
    let lane = 0
    while lane < lanes {
      let dtb = rt_sw_f64_of(rt_sw_ssd_ld32(DTB, 4 * j))
      let sav = rt_sw_f64_of(rt_sw_ssd_ld32(SA, 4 * j))
      let lane = lane + 1
    }
    let t = 0
    while t < T {
      let lane = 0
      while lane < 32 {
        do poke(sq + 8 * lane, i2f(0))
        do poke(sks + 8 * lane, i2f(0))
        let lane = lane + 1
      }
      let lane = 0
      while lane < lanes {
        let keyh = j % 16
        let base = t * 8192 + keyh * 128 + lane
        let qs = i2f(0)
        let ks = i2f(0)
        let i = 0
        while i < 4 {
          let q = rt_sw_ssd_ld(CV, 8 * (base + 32 * i))
          let k = rt_sw_ssd_ld(CV, 8 * (base + 32 * i) + 16384)
          do poke(qreg + 8 * (lane * 4 + i), q)
          do poke(kreg + 8 * (lane * 4 + i), k)
          let qs = fadd(qs, fmul(q, q))
          let ks = fadd(ks, fmul(k, k))
          let i = i + 1
        }
        do poke(sq + 8 * lane, qs)
        do poke(sks + 8 * lane, ks)
        let lane = lane + 1
      }
      do rt_sw_bfly64(sq)
      do rt_sw_bfly64(sks)
      let rq = fdiv(i2f(1), fsqrt(fadd(peek(sq), 4517329193108106637)))
      let rk = fdiv(i2f(1), fsqrt(fadd(peek(sks), 4517329193108106637)))
      let lane = 0
      while lane < lanes {
        let i = 0
        while i < 4 {
          let dim = lane + 32 * i
          do poke(mem + 8 * dim, fmul(peek(qreg + 8 * (lane * 4 + i)), rq))
          do poke(mem + 1024 + 8 * dim, fmul(peek(kreg + 8 * (lane * 4 + i)), rk))
          let i = i + 1
        }
        let lane = lane + 1
      }
      let lane = 0
      while lane < lanes {
        let column = colg * 8 + (lane % 8)
        let part = lane // 8
        let v = rt_sw_ssd_ld(CV, 8 * (t * 8192 + j * 128 + column + 4096))
        let beta = rt_sw_sigm64(rt_sw_ssd_ld(B, 8 * (t * 32 + j)))
        let decay = rt_sw_exp64(fmul(rt_sw_softplus(fadd(rt_sw_ssd_ld(A, 8 * (t * 32 + j)), dtb)), sav))
        do poke(vs + 8 * lane, v)
        do poke(betas + 8 * lane, beta)
        let acc = i2f(0)
        let row = 0
        while row < 32 {
          let el = j * 16384 + part * 4096 + column + row * 128
          let sv = fmul(rt_sw_ssd_ld(S, 8 * el), decay)
          do rt_sw_ssd_st(S, 8 * el, sv)
          let kv = peek(mem + 1024 + 8 * (part * 32 + row))
          let acc = fadd(acc, fmul(sv, kv))
          let row = row + 1
        }
        do poke(sks + 8 * lane, acc)
        let lane = lane + 1
      }
      let lane = lanes
      while lane < 32 {
        do poke(sks + 8 * lane, i2f(0))
        let lane = lane + 1
      }
      do rt_sw_psum(sks)
      let lane = 0
      while lane < lanes {
        let column = colg * 8 + (lane % 8)
        let part = lane // 8
        let delta = fmul(fsub(peek(vs + 8 * lane), peek(sks + 8 * lane)), peek(betas + 8 * lane))
        let acc = i2f(0)
        let row = 0
        while row < 32 {
          let el = j * 16384 + part * 4096 + column + row * 128
          let kv = peek(mem + 1024 + 8 * (part * 32 + row))
          let sv = fadd(rt_sw_ssd_ld(S, 8 * el), fmul(kv, delta))
          do rt_sw_ssd_st(S, 8 * el, sv)
          let qv = peek(mem + 8 * (part * 32 + row))
          let acc = fadd(acc, fmul(sv, qv))
          let row = row + 1
        }
        do poke(os + 8 * lane, acc)
        let lane = lane + 1
      }
      let lane = lanes
      while lane < 32 {
        do poke(os + 8 * lane, i2f(0))
        let lane = lane + 1
      }
      do rt_sw_psum(os)
      let lane = 0
      while lane < lanes {
        if lane // 8 == 0 {
          let column = colg * 8 + (lane % 8)
          let o = fdiv(peek(os + 8 * lane), fsqrt(i2f(128)))
          do rt_sw_ssd_st(FIN, 8 * (t * 4096 + j * 128 + column), o)
        }
        let lane = lane + 1
      }
      let t = t + 1
    }
    let b = b + 1
  }
  return rt_tag(0)
}

# lsum: each of n raw integers, combined, then added. op 0 multiplies by k. op 1 squares.
# The list is read and the sum is written. n of them are n * 8 bytes, and the sum is 8 more.
skill rt_sw_lsum(gx, bx, ps) -> Any {
  let src = rt_sw_arg(ps, 0)
  let n = rt_sw_arg(ps, 1)
  let k = rt_sw_arg(ps, 2)
  let dst = rt_sw_arg(ps, 3)
  let op = rt_sw_arg(ps, 4)
  if n < 0 { let n = 0 }
  do rt_sw_note(n * 8 + 8)
  let s = 0
  let i = 0
  while i < n {
    let v = peek(src + 8 * i)
    if op == 1 { let s = s + v * v } else { let s = s + v * k }
    let i = i + 1
  }
  do poke(dst, i2f(s))
  return rt_tag(0)
}

# launch: grid gx blocks of bx threads; params = a list of integers (each sent as one 8-byte cell; a 32-bit kernel
# parameter reads its low half)
skill rt_gpu_launch(ft, gxt, bxt, ps) -> Any {
  let rec = rt_untag(ft)
  if rec <= 0 { return rt_tag(0 - 400) }
  if rt_sw_text_is(peek(rec + 8), "pi_conv") { return rt_sw_finish(rt_sw_conv(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "pi_mix") { return rt_sw_finish(rt_sw_mix(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "pi_peak") { return rt_sw_finish(rt_sw_peak(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "pi_nv12") { return rt_sw_finish(rt_sw_nv12(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mm") { return rt_sw_finish(rt_sw_gemm(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mm_atb") { return rt_sw_finish(rt_sw_atb(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mm_abt") { return rt_sw_finish(rt_sw_abt(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "addbias") { return rt_sw_finish(rt_sw_addbias(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "biasgrad") { return rt_sw_finish(rt_sw_biasgrad(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "act") { return rt_sw_finish(rt_sw_act(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "actb") { return rt_sw_finish(rt_sw_actb(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mseg") { return rt_sw_finish(rt_sw_mseg(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "adam") { return rt_sw_finish(rt_sw_adam(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "vrfwd") { return rt_sw_finish(rt_sw_vrfwd(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "vrbwd") { return rt_sw_finish(rt_sw_vrbwd(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "vrw") { return rt_sw_finish(rt_sw_vrw(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "posenc") { return rt_sw_finish(rt_sw_posenc(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "addnoise") { return rt_sw_finish(rt_sw_addnoise(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "tred") { return rt_sw_finish(rt_sw_tred(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "srow") { return rt_sw_finish(rt_sw_srow(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mvf32") { return rt_sw_finish(rt_sw_mvf32(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mvq8") { return rt_sw_finish(rt_sw_mvq8(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mvq4") { return rt_sw_finish(rt_sw_mvq4(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mvq6") { return rt_sw_finish(rt_sw_mvq6(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mxf32") { return rt_sw_finish(rt_sw_mxf32(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mxq8") { return rt_sw_finish(rt_sw_mxq8(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mxq4") { return rt_sw_finish(rt_sw_mxq4(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "mxq6") { return rt_sw_finish(rt_sw_mxq6(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "vadd") { return rt_sw_finish(rt_sw_vadd(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "silumul") { return rt_sw_finish(rt_sw_silumul(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "rmsn") { return rt_sw_finish(rt_sw_rmsn(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "gnorm") { return rt_sw_finish(rt_sw_gnorm(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "amax") { return rt_sw_finish(rt_sw_amax(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "ablate") { return rt_sw_finish(rt_sw_ablate(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "capd") { return rt_sw_finish(rt_sw_capd(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "qkprep") { return rt_sw_finish(rt_sw_qkprep(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "attn") { return rt_sw_finish(rt_sw_attn(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "tokin") { return rt_sw_finish(rt_sw_tokin(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "tokinT") { return rt_sw_finish(rt_sw_tokinT(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "route") { return rt_sw_finish(rt_sw_route(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "attn2") { return rt_sw_finish(rt_sw_attn2(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "acomb") { return rt_sw_finish(rt_sw_acomb(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "conv") { return rt_sw_finish(rt_sw_kconv(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "combine") { return rt_sw_finish(rt_sw_combine(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "dnet4") { return rt_sw_finish(rt_sw_dnet4(gxt, bxt, ps)) }
  if rt_sw_text_is(peek(rec + 8), "lsum") { return rt_sw_finish(rt_sw_lsum(gxt, bxt, ps)) }
  return rt_tag(0 - 400)
}

# the chip finishes the launch before this returns. There is no queue on a device.
skill rt_gpu_go(ft, gxt, bxt, ps) -> Any {
  return rt_gpu_launch(ft, gxt, bxt, ps)
}

# a stream is not a device queue. The launch is the same one the chip runs.
skill rt_gpu_gos(ft, gxt, bxt, ps, st) -> Any {
  return rt_gpu_launch(ft, gxt, bxt, ps)
}

# dynamic shared memory is not this chip. The name still has to be one the chip runs, or the launch is -400.
skill rt_gpu_gosm(ft, gxt, bxt, ps, st, smt) -> Any {
  return rt_gpu_launch(ft, gxt, bxt, ps)
}

# console_utf8(): the console reads and writes UTF-8 (Windows consoles default to an old code page, which showed
# Pi's em dashes and emoji as "ΓÇö" and "≡ƒæï") -> true when it took
skill rt_console_utf8() -> Any {
  let a = wcallp(rt_proc("kernel32.dll", "SetConsoleOutputCP"), 65001)
  do wcallp(rt_proc("kernel32.dll", "SetConsoleCP"), 65001)
  if rt_u32(a) == 0 { return rt_tag(0) }
  return rt_tag(1)
}

# text added to the end of a file (made if absent), written at once -> true when it took: a log survives a crash
skill rt_append_file(path, data) -> Any {
  let s = rt_str(data)
  let h = wcall("CreateFileA", rt_cstr(path), 4, 3, 0, 4, 128, 0)
  if h == 0 - 1 { return rt_tag(0) }
  do wcall("WriteFile", h, s + 16, peek(s + 8), gaddr(2), 0)
  do wcall("CloseHandle", h)
  return rt_tag(1)
}

# a file's size in bytes (0 if it cannot be opened)
skill rt_file_size(path) -> Any {
  let h = wcall("CreateFileA", rt_cstr(path), 2147483648, 3, 0, 3, 128, 0)
  if h == 0 - 1 { return rt_tag(0) }
  let p = rt_zero(rt_alloc(8), 8)
  do wcallp(rt_proc("kernel32.dll", "GetFileSizeEx"), h, p)
  do wcall("CloseHandle", h)
  return rt_tag(peek(p))
}

# the local time -> [year, month, day, hour, minute, second]
skill rt_now() -> Any {
  let t = rt_zero(rt_alloc(16), 16)
  do wcallp(rt_proc("kernel32.dll", "GetLocalTime"), t)
  let out = rt_list_new(6)
  do poke(out + 16, rt_tag(peekb(t) + 256 * peekb(t + 1)))
  do poke(out + 24, rt_tag(peekb(t + 2) + 256 * peekb(t + 3)))
  do poke(out + 32, rt_tag(peekb(t + 6) + 256 * peekb(t + 7)))
  do poke(out + 40, rt_tag(peekb(t + 8) + 256 * peekb(t + 9)))
  do poke(out + 48, rt_tag(peekb(t + 10) + 256 * peekb(t + 11)))
  do poke(out + 56, rt_tag(peekb(t + 12) + 256 * peekb(t + 13)))
  return out
}

# a process handle's id
skill rt_pid(ht) -> Any { return rt_tag(rt_u32(wcallp(rt_proc("kernel32.dll", "GetProcessId"), rt_untag(ht)))) }

# Softwell, the only machine Pi needs: [RAM bytes, SSD bytes, page bytes, bus bytes, SMs].
# The CPU retires one Pi statement per cycle. The kernel body is not the CPU.
skill rt_softwell() -> Any {
  let out = rt_list_new(0)
  let out = rt_append(out, rt_tag(65536))
  let out = rt_append(out, rt_tag(8388608))
  let out = rt_append(out, rt_tag(4096))
  let out = rt_append(out, rt_tag(32))
  return rt_append(out, rt_tag(256))
}

# the GPU's memory -> [free bytes, total bytes]
skill rt_gpu_meminfo() -> Any {
  let total = 65536
  let used = peek(gaddr(21))
  let out = rt_list_new(0)
  let out = rt_append(out, rt_tag(total - used))
  return rt_append(out, rt_tag(total))
}

# no device stream and no graph. Making one is -400. A launch has already finished, so a wait is 0.
skill rt_gpu_event() -> Any { return rt_tag(0 - 400) }

skill rt_gpu_event_record(et, st) -> Any { return rt_tag(0 - 400) }

skill rt_gpu_event_wait(et) -> Any { return rt_tag(0) }

skill rt_gpu_stream() -> Any { return rt_tag(0 - 400) }

skill rt_gpu_capture(st) -> Any { return rt_tag(0 - 400) }

skill rt_gpu_capture_end(st) -> Any { return rt_tag(0 - 400) }

skill rt_gpu_graph_go(et, st) -> Any { return rt_tag(0 - 400) }

skill rt_gpu_sync() -> Any {
  return rt_tag(0)
}

# dotmax, with no driver. Integers that fit in the f32 mantissa, so the sum is the same number the
# kernel rounds. A tie keeps the earlier row. A chunk with no rows is not this.
skill rt_sw_dotmax(at, bt, mt, nt, kt, ct) -> Any {
  let m = rt_untag(mt)
  let n = rt_untag(nt)
  let k = rt_untag(kt)
  let c = rt_untag(ct)
  let res = rt_arr(rt_tag(2 * m * c))
  if c < 1 or m < 1 { return res }
  let chunk = (n + c - 1) // c
  let t = 0
  while t < m * c {
    let i = t // c
    let ch = t % c
    let j0 = ch * chunk
    let j1 = j0 + chunk
    if j1 > n { let j1 = n }
    let best = 0
    let idx = 0
    let have = 0
    let j = j0
    while j < j1 {
      let s = 0
      let q = 0
      while q < k {
        let av = rt_untag(peek(at + 16 + 8 * (i * k + q)))
        let bv = rt_untag(peek(bt + 16 + 8 * (j * k + q)))
        let s = s + av * bv
        let q = q + 1
      }
      if have == 0 or s > best {
        let best = s
        let idx = j
        let have = 1
      }
      let j = j + 1
    }
    do poke(res + 16 + 8 * (2 * t), rt_tag(best))
    do poke(res + 16 + 8 * (2 * t + 1), rt_tag(idx))
    let t = t + 1
  }
  return res
}

# rt_gpu_dotmax(ptx, A, B, m, n, k, chunks): rows of A (m x k) against rows of B (n x k), integers sent as 32-bit and
# multiplied as floats on the GPU (kernel "dotmax", Pi-written); for every row of A and every chunk of B's rows, the
# best dot product and which row of B gave it -> an array of m * chunks * 2 integers [best, index]. Called by name.
skill rt_gpu_dotmax(ptx, at, bt, mt, nt, kt, ct) -> Any {
  return rt_sw_dotmax(at, bt, mt, nt, kt, ct)
}

skill rt_sw_u(t, a, bad) -> Any {
  if t == 13 {
    let v = a
    if v < 0 { let v = 0 - v }
    let s = 0
    while v > 0 {
      let s = s + v % 10
      let v = v // 10
    }
    return s
  }
  if t == 14 {
    if a < 0 { do poke(bad, 1) return 0 }
    let r = 0
    while (r + 1) * (r + 1) <= a { let r = r + 1 }
    return r
  }
  if a > 1000000 { do poke(bad, 1) return 0 }
  if t == 11 {
    if a < 2 { return 0 }
    let d = 2
    while d * d <= a {
      if a % d == 0 { return 0 }
      let d = d + 1
    }
    return 1
  }
  if a < 1 { return 0 }
  let c = 0
  let d = 1
  while d * d <= a {
    if a % d == 0 {
      let c = c + 2
      if d * d == a { let c = c - 1 }
    }
    let d = d + 1
  }
  return c
}

skill rt_sw_bin(t, a, b, bad) -> Any {
  if t == 6 { return a + b }
  if t == 7 { return a - b }
  if t == 8 { return a * b }
  if b == 0 { do poke(bad, 1) return 0 }
  if t == 9 { return a // b }
  return a % b
}

# seqw. Same ids as the kernel: words (18 ints each), unaries, and the leaf-order pruning. A compiled
# word and the table are the same definition, so this runs the table.
skill rt_sw_seqw(tg, st, lt, bt, nt, mt, wt) -> Any {
  let S = rt_untag(st)
  let L = rt_untag(lt)
  let B = rt_untag(bt)
  let N = rt_untag(nt)
  let off = rt_untag(mt)
  let c = rt_arr(rt_tag(S))
  for s in range(0, S) { do poke(c + 16 + 8 * s, rt_tag(0 - 1)) }
  if L < 1 or B < 2 or N < 1 { return c }
  let toks = rt_alloc(8 * L)
  let stk = rt_alloc(8 * 48)
  let lf = rt_alloc(8 * 48)
  let bad = rt_alloc(8)
  let nw = peek(wt + 8) // 18
  let p = 0
  while p < N {
    let id = off + p
    let sp = 0
    let ok = 1
    let start = 0
    let i = 0
    while i < L and ok == 1 {
      let tok = id % B
      let id = id // B
      do poke(toks + 8 * i, tok)
      if tok == 1 and start < 1 { let start = 1 }
      if tok == 2 { let start = 2 }
      if tok < 6 {
        if sp >= 47 { let ok = 0 } else {
          do poke(lf + 8 * sp, tok)
          let sp = sp + 1
        }
      } else {
        if tok < 11 {
          if sp < 2 { let ok = 0 } else {
            let a = peek(lf + 8 * (sp - 2))
            let b = peek(lf + 8 * (sp - 1))
            if a < 6 and b < 6 {
              if (tok == 6 or tok == 8) and a > b { let ok = 0 }
              if (tok == 7 or tok >= 9) and a == b { let ok = 0 }
              if tok == 8 and (a == 3 or b == 3) { let ok = 0 }
              if tok == 9 and b == 3 { let ok = 0 }
            }
            if ok == 1 {
              do poke(lf + 8 * (sp - 2), 99)
              let sp = sp - 1
            }
          }
        } else {
          if tok < 15 {
            if sp < 1 { let ok = 0 } else { do poke(lf + 8 * (sp - 1), 99) }
          } else {
            let wi = tok - 15
            if wi >= nw or sp < rt_untag(peek(wt + 16 + 8 * (18 * wi))) { let ok = 0 } else {
              let ln = rt_untag(peek(wt + 16 + 8 * (18 * wi + 1)))
              let j = 0
              while j < ln {
                let bt = rt_untag(peek(wt + 16 + 8 * (18 * wi + 2 + j)))
                if bt == 1 and start < 1 { let start = 1 }
                if bt == 2 { let start = 2 }
                let j = j + 1
              }
              let ar = rt_untag(peek(wt + 16 + 8 * (18 * wi)))
              let sp = sp - ar + 1
              do poke(lf + 8 * (sp - 1), 99)
            }
          }
        }
      }
      let i = i + 1
    }
    if sp != 1 { let ok = 0 }
    if ok == 1 {
      for s in range(0, S) {
        let have = rt_untag(peek(c + 16 + 8 * s))
        let n = start
        let match = 1
        while n <= 7 and match == 1 {
          let term = rt_untag(peek(tg + 16 + 8 * (s * 12 + n)))
          let a1 = 0
          let a2 = 0
          if n >= 1 { let a1 = rt_untag(peek(tg + 16 + 8 * (s * 12 + n - 1))) }
          if n >= 2 { let a2 = rt_untag(peek(tg + 16 + 8 * (s * 12 + n - 2))) }
          let sp = 0
          do poke(bad, 0)
          let i = 0
          while i < L and peek(bad) == 0 {
            let tok = peek(toks + 8 * i)
            if tok < 6 {
              let v = n
              if tok == 1 { let v = a1 }
              if tok == 2 { let v = a2 }
              if tok == 3 { let v = 1 }
              if tok == 4 { let v = 2 }
              if tok == 5 { let v = 3 }
              do poke(stk + 8 * sp, v)
              let sp = sp + 1
            } else {
              if tok < 15 {
                if tok < 11 {
                  let b = peek(stk + 8 * (sp - 1))
                  let a = peek(stk + 8 * (sp - 2))
                  let sp = sp - 1
                  do poke(stk + 8 * (sp - 1), rt_sw_bin(tok, a, b, bad))
                } else {
                  do poke(stk + 8 * (sp - 1), rt_sw_u(tok, peek(stk + 8 * (sp - 1)), bad))
                }
              } else {
                let wi = tok - 15
                let ar = rt_untag(peek(wt + 16 + 8 * (18 * wi)))
                let ln = rt_untag(peek(wt + 16 + 8 * (18 * wi + 1)))
                let arg1 = 0
                let arg0 = 0
                if ar == 2 {
                  let arg1 = peek(stk + 8 * (sp - 1))
                  let sp = sp - 1
                }
                if ar >= 1 {
                  let arg0 = peek(stk + 8 * (sp - 1))
                  let sp = sp - 1
                }
                let j = 0
                while j < ln and peek(bad) == 0 {
                  let bt = rt_untag(peek(wt + 16 + 8 * (18 * wi + 2 + j)))
                  if bt == 100 { do poke(stk + 8 * sp, arg0) let sp = sp + 1 }
                  if bt == 101 { do poke(stk + 8 * sp, arg1) let sp = sp + 1 }
                  if bt < 6 {
                    let v = n
                    if bt == 1 { let v = a1 }
                    if bt == 2 { let v = a2 }
                    if bt == 3 { let v = 1 }
                    if bt == 4 { let v = 2 }
                    if bt == 5 { let v = 3 }
                    do poke(stk + 8 * sp, v)
                    let sp = sp + 1
                  }
                  if bt >= 6 and bt < 11 {
                    let b = peek(stk + 8 * (sp - 1))
                    let a = peek(stk + 8 * (sp - 2))
                    let sp = sp - 1
                    do poke(stk + 8 * (sp - 1), rt_sw_bin(bt, a, b, bad))
                  }
                  if bt >= 11 and bt <= 14 {
                    do poke(stk + 8 * (sp - 1), rt_sw_u(bt, peek(stk + 8 * (sp - 1)), bad))
                  }
                  let j = j + 1
                }
              }
            }
            let i = i + 1
          }
          if peek(bad) != 0 or peek(stk) != term { let match = 0 }
          let n = n + 1
        }
        if match == 1 {
          if have < 0 or off + p < have { do poke(c + 16 + 8 * s, rt_tag(off + p)) }
        }
      }
    }
    let p = p + 1
  }
  return c
}

# rt_gpu_seqw(ptx, targets, S, L, B, N, first id, words): as gpu_seq, with Pi's learned words for the kernel "seqw"
# (words = an integer table, 18 per word: arity, length, 16 tokens), sent as 32-bit integers. Called by name.
skill rt_gpu_seqw(ptx, tg, st, lt, bt, nt, mt, wt) -> Any {
  return rt_sw_seqw(tg, st, lt, bt, nt, mt, wt)
}

# ---- gpu for. The same bytecode, on the chip, one thread per item, in order. ------------------------------
# The same floor division, and a write of zero when a divisor is zero. PTX is not launched.

skill sw_binop(t, a, b) -> Any {
  if t == 10 { return a + b }
  if t == 11 { return a - b }
  if t == 12 { return a * b }
  if t == 13 or t == 14 {
    if b == 0 { return 0 }
    if t == 13 { return a // b }
    return a % b
  }
  if t == 15 { if a < b { return 1 } return 0 }
  if t == 16 { if a <= b { return 1 } return 0 }
  if t == 17 { if a > b { return 1 } return 0 }
  if t == 18 { if a >= b { return 1 } return 0 }
  if t == 19 { if a == b { return 1 } return 0 }
  if t == 20 { if a != b { return 1 } return 0 }
  if t == 21 { return min(a, b) }
  if t == 22 { return max(a, b) }
  if a != 0 and b != 0 { return 1 }
  if t == 24 { if a != 0 or b != 0 { return 1 } }
  return 0
}

skill sw_expr(code, q, stop, w, caps) -> Any {
  let st = []
  while code[q] != stop {
    let t = code[q]
    if t == 2 or t == 3 or t == 4 {
      let v = 0
      if t == 2 { let v = aget(w, code[q + 1]) }
      if t == 3 { let v = code[q + 1] }
      if t == 4 { let v = caps[code[q + 1]] }
      let st = append(st, v)
      let q = q + 2
    } else {
      if t >= 30 {
        let a = st[len(st) - 1]
        let v = a
        if t == 30 { let v = abs(a) }
        if t == 31 { let v = 0 - a }
        if t == 32 { if a == 0 { let v = 1 } else { let v = 0 } }
        let st = slice(st, 0, len(st) - 1)
        let st = append(st, v)
      } else {
        let b = st[len(st) - 1]
        let a = st[len(st) - 2]
        let st = slice(st, 0, len(st) - 2)
        let st = append(st, sw_binop(t, a, b))
      }
      let q = q + 1
    }
  }
  return [st[len(st) - 1], q + 1]
}

skill sw_skip_expr(code, q, stop) -> Any {
  while code[q] != stop {
    if code[q] == 2 or code[q] == 3 or code[q] == 4 { let q = q + 2 } else { let q = q + 1 }
  }
  return q + 1
}

skill sw_skip_stmts(code, q) -> Any {
  while q < len(code) and code[q] != 197 and code[q] != 196 {
    let t = code[q]
    if t == 100 { let q = sw_skip_expr(code, q + 2, 199) }
    if t == 101 {
      let q = sw_skip_expr(code, q + 1, 198)
      let q = sw_skip_stmts(code, q) + 1
    }
    if t == 102 {
      let q = sw_skip_expr(code, q + 1, 198)
      let q = sw_skip_stmts(code, q) + 1
      let q = sw_skip_stmts(code, q) + 1
    }
  }
  return q
}

skill sw_stmts(code, q, w, caps) -> Any {
  while q < len(code) and code[q] != 197 and code[q] != 196 {
    let t = code[q]
    if t == 100 {
      let r = sw_expr(code, q + 2, 199, w, caps)
      do aset(w, code[q + 1], r[0])
      let q = r[1]
    }
    if t == 101 {
      let head = q
      let again = 1
      let nq = q
      while again {
        let rc = sw_expr(code, head + 1, 198, w, caps)
        if rc[0] == 0 {
          let again = 0
          let nq = sw_skip_stmts(code, rc[1]) + 1
        } else {
          let nq = sw_stmts(code, rc[1], w, caps) + 1
        }
      }
      let q = nq
    }
    if t == 102 {
      let rc = sw_expr(code, q + 1, 198, w, caps)
      if rc[0] != 0 {
        let nq = sw_stmts(code, rc[1], w, caps) + 1
        let q = sw_skip_stmts(code, nq) + 1
      } else {
        let nq = sw_skip_stmts(code, rc[1]) + 1
        let q = sw_stmts(code, nq, w, caps) + 1
      }
    }
  }
  return q
}

skill sw_gpu_map(code, xs, a, n, caps, nvars, vid) -> Any {
  let out = arr(n)
  let w = arr(nvars)
  for i in range(0, n) {
    let m = mark()
    let x = a + i
    if xs != null { let x = xs[i] }
    for j in range(0, nvars) { do aset(w, j, 0) }
    do aset(w, 0, x)
    do sw_stmts(code, 0, w, caps)
    do aset(out, i, release(m, aget(w, vid)))
  }
  return out
}

# ---- gpu for (pic compiles the body to integer bytecode; the chip runs that, one item at a time) ------------------
skill gpu_map(code, xs, a, n, caps, nvars, vid) -> Any {
  if n <= 0 { return arr(0) }
  return sw_gpu_map(code, xs, a, n, caps, nvars, vid)
}

skill gpu_reg(k) -> Any { return "%s" ++ str(k) }

# one expression (postfix) up to the stop code -> [instructions, position after the stop]; the value ends in %s0
skill gpu_pexpr(code, p, stop) -> Any {
  let parts = []
  let sp = 0
  let q = p
  while code[q] != stop {
    let t = code[q]
    if t == 2 or t == 3 or t == 4 {
      let d = gpu_reg(sp)
      if t == 2 { let parts = parts ++ ["mov.s64 " ++ d ++ ", %w" ++ str(code[q + 1]) ++ ";"] }
      if t == 3 { let parts = parts ++ ["mov.s64 " ++ d ++ ", " ++ str(code[q + 1]) ++ ";"] }
      if t == 4 { let parts = parts ++ ["ld.global.s64 " ++ d ++ ", [%a6+" ++ str(8 * code[q + 1]) ++ "];"] }
      let sp = sp + 1
      let q = q + 2
    } else {
      if t >= 30 {
        let a = gpu_reg(sp - 1)
        if t == 30 { let parts = parts ++ ["abs.s64 " ++ a ++ ", " ++ a ++ ";"] }
        if t == 31 { let parts = parts ++ ["neg.s64 " ++ a ++ ", " ++ a ++ ";"] }
        if t == 32 { let parts = parts ++ ["setp.eq.s64 %p3, " ++ a ++ ", 0;", "selp.s64 " ++ a ++ ", 1, 0, %p3;"] }
      } else {
        let a = gpu_reg(sp - 2)
        let b = gpu_reg(sp - 1)
        if t == 10 { let parts = parts ++ ["add.s64 " ++ a ++ ", " ++ a ++ ", " ++ b ++ ";"] }
        if t == 11 { let parts = parts ++ ["sub.s64 " ++ a ++ ", " ++ a ++ ", " ++ b ++ ";"] }
        if t == 12 { let parts = parts ++ ["mul.lo.s64 " ++ a ++ ", " ++ a ++ ", " ++ b ++ ";"] }
        if t == 13 or t == 14 {
          # floor division / modulo as in Pi; by zero -> 0
          let parts = parts ++ ["setp.eq.s64 %p3, " ++ b ++ ", 0;", "@%p3 mov.s64 " ++ b ++ ", 1;", "div.s64 %t3, " ++ a ++ ", " ++ b ++ ";", "rem.s64 %t4, " ++ a ++ ", " ++ b ++ ";"]
          let parts = parts ++ ["setp.ne.s64 %p4, %t4, 0;", "xor.b64 %t5, %t4, " ++ b ++ ";", "setp.lt.s64 %p5, %t5, 0;", "and.pred %p6, %p4, %p5;", "@%p6 sub.s64 %t3, %t3, 1;", "@%p6 add.s64 %t4, %t4, " ++ b ++ ";"]
          if t == 13 { let parts = parts ++ ["mov.s64 " ++ a ++ ", %t3;"] } else { let parts = parts ++ ["mov.s64 " ++ a ++ ", %t4;"] }
          let parts = parts ++ ["@%p3 mov.s64 " ++ a ++ ", 0;"]
        }
        if t >= 15 and t <= 20 {
          let cmp = ["lt", "le", "gt", "ge", "eq", "ne"][t - 15]
          let parts = parts ++ ["setp." ++ cmp ++ ".s64 %p3, " ++ a ++ ", " ++ b ++ ";", "selp.s64 " ++ a ++ ", 1, 0, %p3;"]
        }
        if t == 21 { let parts = parts ++ ["min.s64 " ++ a ++ ", " ++ a ++ ", " ++ b ++ ";"] }
        if t == 22 { let parts = parts ++ ["max.s64 " ++ a ++ ", " ++ a ++ ", " ++ b ++ ";"] }
        if t == 23 or t == 24 {
          let op = "and"
          if t == 24 { let op = "or" }
          let parts = parts ++ ["setp.ne.s64 %p3, " ++ a ++ ", 0;", "setp.ne.s64 %p4, " ++ b ++ ", 0;", op ++ ".pred %p5, %p3, %p4;", "selp.s64 " ++ a ++ ", 1, 0, %p5;"]
        }
        let sp = sp - 1
      }
      let q = q + 1
    }
  }
  return [join(parts, "\n"), q + 1]
}

# statements up to an end code (197 or 196) or the end -> [instructions, position, label counter]
skill gpu_pstmts(code, p, lab) -> Any {
  let parts = []
  let q = p
  let lb = lab
  while q < len(code) and code[q] != 197 and code[q] != 196 {
    let t = code[q]
    if t == 100 {
      let r = gpu_pexpr(code, q + 2, 199)
      let parts = parts ++ [r[0], "mov.s64 %w" ++ str(code[q + 1]) ++ ", %s0;"]
      let q = r[1]
    }
    if t == 101 {
      let n = lb
      let lb = lb + 1
      let rc = gpu_pexpr(code, q + 1, 198)
      let rb = gpu_pstmts(code, rc[1], lb)
      let lb = rb[2]
      let parts = parts ++ ["W" ++ str(n) ++ ":", rc[0], "setp.eq.s64 %p7, %s0, 0;", "@%p7 bra E" ++ str(n) ++ ";", rb[0], "bra W" ++ str(n) ++ ";", "E" ++ str(n) ++ ":"]
      let q = rb[1] + 1
    }
    if t == 102 {
      let n = lb
      let lb = lb + 1
      let rc = gpu_pexpr(code, q + 1, 198)
      let rt = gpu_pstmts(code, rc[1], lb)
      let re = gpu_pstmts(code, rt[1] + 1, rt[2])
      let lb = re[2]
      let parts = parts ++ [rc[0], "setp.eq.s64 %p7, %s0, 0;", "@%p7 bra F" ++ str(n) ++ ";", rt[0], "bra G" ++ str(n) ++ ";", "F" ++ str(n) ++ ":", re[0], "G" ++ str(n) ++ ":"]
      let q = re[1] + 1
    }
  }
  return [join(parts, "\n"), q, lb]
}

# the whole kernel "gmap": x = xs[i] (or a + i), the body, out[i] = the result variable
skill gpu_ptx(code, nvars, vid) -> Any {
  let k = ".version 6.0\n.target sm_50\n.address_size 64\n.visible .entry gmap(.param .u64 pX, .param .u64 pY, .param .u32 pN, .param .s64 pA, .param .u64 pC)\n{\n"
  let k = k ++ ".reg .pred %p<8>;\n.reg .u32 %r<8>;\n.reg .u64 %a<12>;\n.reg .s64 %t<12>;\n.reg .s64 %s<48>;\n.reg .s64 %w<" ++ str(nvars + 1) ++ ">;\n"
  let k = k ++ "mov.u32 %r1, %ctaid.x;\nmov.u32 %r2, %ntid.x;\nmov.u32 %r3, %tid.x;\nmad.lo.u32 %r4, %r1, %r2, %r3;\nld.param.u32 %r5, [pN];\nsetp.ge.u32 %p1, %r4, %r5;\n@%p1 bra DONE;\n"
  let k = k ++ "cvt.u64.u32 %a3, %r4;\nld.param.s64 %t1, [pA];\ncvt.s64.u32 %t2, %r4;\nadd.s64 %w0, %t1, %t2;\n"
  let k = k ++ "ld.param.u64 %a1, [pX];\nsetp.eq.u64 %p2, %a1, 0;\n@%p2 bra HAVEX;\ncvta.to.global.u64 %a1, %a1;\nshl.b64 %a4, %a3, 3;\nadd.u64 %a5, %a1, %a4;\nld.global.s64 %w0, [%a5];\nHAVEX:\n"
  let k = k ++ "ld.param.u64 %a6, [pC];\ncvta.to.global.u64 %a6, %a6;\n"
  for j in range(1, nvars) { let k = k ++ "mov.s64 %w" ++ str(j) ++ ", 0;\n" }
  let k = k ++ gpu_pstmts(code, 0, 0)[0] ++ "\n"
  let k = k ++ "ld.param.u64 %a7, [pY];\ncvta.to.global.u64 %a7, %a7;\nshl.b64 %a8, %a3, 3;\nadd.u64 %a9, %a7, %a8;\nst.global.s64 [%a9], %w" ++ str(vid) ++ ";\nDONE:\nret;\n}\n"
  return k
}

# gpu_run takes PTX. This chip does not run PTX. gpu for runs the bytecode instead.
skill rt_gpu_run(ptx, xs, at, nt, caps) -> Any { return rt_tag(0 - 400) }

# ---- par for (the language's own parallel loop; pic desugars "par for x in xs -> v { B }" into these) -----------
# a worker is this same program started again with "__par <id> <w> <W>" at the end of its arguments
skill par_info() -> Any {
  let i = 1
  while arg(i) != null {
    if arg(i) == "__par" { return [arg(i + 1), par_int(arg(i + 2)), par_int(arg(i + 3))] }
    let i = i + 1
  }
  return null
}

skill par_int(t) -> Any {
  let v = 0
  for i in range(0, len(t)) {
    let c = ord(slice(t, i, i + 1))
    if c >= 48 and c <= 57 { let v = v * 10 + (c - 48) }
  }
  return v
}

# worker processes per par loop: 8 (the machine's heat limit; more cores are there, the cooling is not)
skill par_workers() -> Any { return 8 }

skill par_file(id, w) -> Any { return "out\\par_" ++ id ++ "_" ++ str(w) ++ ".txt" }

# this program's own command line, each argument quoted
skill par_cmd() -> Any {
  let out = "\"" ++ arg(0) ++ "\""
  let i = 1
  while arg(i) != null {
    let out = out ++ " \"" ++ arg(i) ++ "\""
    let i = i + 1
  }
  return out
}

# the parent: start W workers, wait, read their files, put each item's value back in its place
skill par_gather(id, n, nw) -> Any {
  let hs = []
  for w in range(0, nw) {
    do write_file(par_file(id, w), "")
    let hs = hs ++ [spawn(par_cmd() ++ " __par " ++ id ++ " " ++ str(w) ++ " " ++ str(nw))]
  }
  for h in hs { do wait(h, 360000000) }
  let parts = []
  for w in range(0, nw) {
    let t = read_file(par_file(id, w))
    let vals = []
    if t != null {
      let p = 0
      while p < len(t) {
        let r = par_dec(t, p)
        let vals = append(vals, r[0])
        let p = r[1]
      }
    }
    let parts = parts ++ [vals]
  }
  let out = []
  let blk = []
  for i in range(0, n) {
    let vs = parts[i % nw]
    let k = i // nw
    let v = null
    if k < len(vs) { let v = vs[k] }
    let blk = append(blk, v)
    if len(blk) >= 1000 {
      let out = out ++ blk
      let blk = []
    }
  }
  return out ++ blk
}

# values as self-delimiting text: n | i<int>; | r<real>; | b0/b1 | s<len>:<text> | l<n>:<items> | m<n>:<k v ...> | a<n>:<ints>
skill par_enc(v) -> Any {
  let t = typeof(v)
  if t == "null" { return "n" }
  if t == "int" { return "i" ++ str(v) ++ ";" }
  if t == "real" { return "r" ++ str(v) ++ ";" }
  if t == "text" { return "s" ++ str(len(v)) ++ ":" ++ v }
  if t == "list" {
    let parts = []
    for x in v { let parts = append(parts, par_enc(x)) }
    return "l" ++ str(len(v)) ++ ":" ++ join(parts, "")
  }
  if t == "map" {
    let parts = []
    for k in keys(v) { let parts = append(parts, par_enc(k) ++ par_enc(v[k])) }
    return "m" ++ str(len(parts)) ++ ":" ++ join(parts, "")
  }
  if t == "array" {
    let parts = []
    for i in range(0, len(v)) { let parts = append(parts, str(aget(v, i)) ++ ";") }
    return "a" ++ str(len(v)) ++ ":" ++ join(parts, "")
  }
  return "n"
}

skill par_upto(t, p, c) -> Any {
  let q = p
  while slice(t, q, q + 1) != c { let q = q + 1 }
  return q
}

skill par_sint(t) -> Any {
  if slice(t, 0, 1) == "-" { return 0 - par_int(t) }
  return par_int(t)
}

# -> [value, position after it]
skill par_dec(t, p) -> Any {
  let c = slice(t, p, p + 1)
  if c == "n" { return [null, p + 1] }
  if c == "i" {
    let q = par_upto(t, p + 1, ";")
    return [par_sint(slice(t, p + 1, q)), q + 1]
  }
  if c == "r" {
    let q = par_upto(t, p + 1, ";")
    return [num(slice(t, p + 1, q)), q + 1]
  }
  let q = par_upto(t, p + 1, ":")
  let n = par_int(slice(t, p + 1, q))
  if c == "s" { return [slice(t, q + 1, q + 1 + n), q + 1 + n] }
  if c == "l" {
    let out = []
    let r = [null, q + 1]
    for i in range(0, n) {
      let r = par_dec(t, r[1])
      let out = append(out, r[0])
    }
    return [out, r[1]]
  }
  if c == "m" {
    let out = {}
    let r = [null, q + 1]
    for i in range(0, n) {
      let rk = par_dec(t, r[1])
      let r = par_dec(t, rk[1])
      let out = put(out, rk[0], r[0])
    }
    return [out, r[1]]
  }
  if c == "a" {
    let out = arr(n)
    let pos = q + 1
    for i in range(0, n) {
      let e = par_upto(t, pos, ";")
      do aset(out, i, par_sint(slice(t, pos, e)))
      let pos = e + 1
    }
    return [out, pos]
  }
  return [null, p + 1]
}

# fgwin(): the window in front (the one the user is working in) -> [left, top, right, bottom] in screen pixels
skill rt_s32(v) -> Any {
  if v >= 2147483648 { return v - 4294967296 }
  return v
}

skill rt_fgwin() -> Any {
  if ostarget() != 0 { return rt_sw_fgwin() }
  do wcallp(rt_proc("user32.dll", "SetProcessDPIAware"))
  let h = wcallp(rt_proc("user32.dll", "GetForegroundWindow"))
  let r = rt_zero(rt_alloc(16), 16)
  do wcallp(rt_proc("user32.dll", "GetWindowRect"), h, r)
  let out = rt_list_new(0)
  let out = rt_append(out, rt_tag(rt_s32(rt_peek32(r))))
  let out = rt_append(out, rt_tag(rt_s32(rt_peek32(r + 4))))
  let out = rt_append(out, rt_tag(rt_s32(rt_peek32(r + 8))))
  return rt_append(out, rt_tag(rt_s32(rt_peek32(r + 12))))
}

# focus(window class): bring that app's window to the front (Windows lets a program do this right after a key
# event, so an Alt tap goes first -- Alt alone does nothing in the app) -> true, or null if there is no such window
skill rt_focus(cls) -> Any {
  if ostarget() != 0 { return rt_sw_focus(cls) }
  let h = wcallp(rt_proc("user32.dll", "FindWindowA"), rt_cstr(cls), 0)
  if h == 0 { return 0 }
  do wcallp(rt_proc("user32.dll", "keybd_event"), 18, 0, 0, 0)
  do wcallp(rt_proc("user32.dll", "keybd_event"), 18, 0, 2, 0)
  do wcallp(rt_proc("user32.dll", "ShowWindow"), h, 9)
  do wcallp(rt_proc("user32.dll", "SetForegroundWindow"), h)
  return 3
}

# mouse(x, y, button): move the pointer, then click (0 none, 1 left, 2 right) -- Pi's hands; guarded in senses.pi
skill rt_mouse(xt, yt, bt) -> Any {
  if ostarget() != 0 { return rt_sw_mouse(xt, yt, bt) }
  do wcallp(rt_proc("user32.dll", "SetProcessDPIAware"))
  do wcallp(rt_proc("user32.dll", "SetCursorPos"), rt_untag(xt), rt_untag(yt))
  let b = rt_untag(bt)
  if b == 1 {
    do wcallp(rt_proc("user32.dll", "mouse_event"), 2, 0, 0, 0, 0)
    do wcallp(rt_proc("user32.dll", "mouse_event"), 4, 0, 0, 0, 0)
  }
  if b == 2 {
    do wcallp(rt_proc("user32.dll", "mouse_event"), 8, 0, 0, 0, 0)
    do wcallp(rt_proc("user32.dll", "mouse_event"), 16, 0, 0, 0, 0)
  }
  return 3
}

# key(virtual key code): press and release one key
skill rt_key(vt) -> Any {
  if ostarget() != 0 { return rt_sw_key(vt) }
  let v = rt_untag(vt)
  do wcallp(rt_proc("user32.dll", "keybd_event"), v, 0, 0, 0)
  do wcallp(rt_proc("user32.dll", "keybd_event"), v, 0, 2, 0)
  return 3
}

# play(path of a .wav): Pi's voice, through winmm; returns when the sound has finished
skill rt_play(path) -> Any {
  if ostarget() != 0 { return rt_sw_play(path) }
  let r = rt_u32(wcallp(rt_proc("winmm.dll", "PlaySoundA"), rt_cstr(path), 0, 131072))
  if r == 0 { return 0 }
  return 3
}

# ---- arrays of integers, changed in place (kind 8). Only integers go in, so freeing a region can never leave one
# pointing at freed memory -- the same rule as the hash set. arr(n) is n zeros.
skill rt_arr(nt) -> Any {
  let n = rt_untag(nt)
  let p = rt_alloc(16 + 8 * n)
  do poke(p, 8)
  do poke(p + 8, n)
  for i in range(0, n) { do poke(p + 16 + 8 * i, 1) }
  return p
}

skill rt_aget(a, it) -> Any {
  let i = rt_untag(it)
  if i < 0 or i >= peek(a + 8) { do rt_fail("aget: index out of range") }
  return peek(a + 16 + 8 * i)
}

skill rt_aset(a, it, v) -> Any {
  let i = rt_untag(it)
  if i < 0 or i >= peek(a + 8) { do rt_fail("aset: index out of range") }
  if v % 2 == 0 { do rt_fail("aset: arrays hold integers only") }
  do poke(a + 16 + 8 * i, v)
  return v
}

# ---- listdir(dir): the names in a directory (files and folders, without . and ..), or null if it cannot be read ----
skill rt_listdir(dir) -> Any {
  let n = peek(dir + 8)
  let pat = rt_alloc(n + 3)
  for i in range(0, n) { do pokeb(pat + i, peekb(dir + 16 + i)) }
  do pokeb(pat + n, 92)
  do pokeb(pat + n + 1, 42)
  do pokeb(pat + n + 2, 0)
  let fd = rt_alloc(400)
  let h = wcall("FindFirstFileA", pat, fd)
  if h == 0 - 1 { return 0 }
  let out = rt_list_new(0)
  let going = 1
  while going == 1 {
    let k = 0
    while peekb(fd + 44 + k) != 0 { let k = k + 1 }
    let dot = 0
    if peekb(fd + 44) == 46 {
      if k == 1 { let dot = 1 }
      if k == 2 {
        if peekb(fd + 45) == 46 { let dot = 1 }
      }
    }
    if dot == 0 {
      let t = rt_text_new(k)
      for i in range(0, k) { do pokeb(t + 16 + i, peekb(fd + 44 + i)) }
      let out = rt_append(out, t)
    }
    if rt_u32(wcall("FindNextFileA", h, fd)) == 0 { let going = 0 }
  }
  do wcall("FindClose", h)
  return out
}

# ---- read_at(path, offset, n): up to n bytes of a file from byte offset (for files too big to read whole), null on failure
skill rt_read_at(path, offt, nt) -> Any {
  let off = rt_untag(offt)
  let n = rt_untag(nt)
  let h = wcall("CreateFileA", rt_cstr(path), 2147483648, 3, 0, 3, 128, 0)
  if h == 0 - 1 { return 0 }
  if rt_u32(wcall("SetFilePointerEx", h, off, 0, 0)) == 0 {
    do wcall("CloseHandle", h)
    return 0
  }
  let s = rt_text_new(n)
  do poke(gaddr(2), 0)
  do wcall("ReadFile", h, s + 16, n, gaddr(2), 0)
  let got = peek(gaddr(2)) % 4294967296
  do wcall("CloseHandle", h)
  do poke(s + 8, got)
  return s
}

# ---- read_bytes(path, offset, n): up to n bytes of a file as an in-place integer array (one byte per entry) ----------
skill rt_read_bytes(path, offt, nt) -> Any {
  let t = rt_read_at(path, offt, nt)
  if t == 0 { return 0 }
  let n = peek(t + 8)
  let p = rt_alloc(16 + 8 * n)
  do poke(p, 8)
  do poke(p + 8, n)
  for i in range(0, n) { do poke(p + 16 + 8 * i, 2 * peekb(t + 16 + i) + 1) }
  return p
}

# ---- arr_text(a, from, to): the bytes a[from..to) of an integer array as text ----------------------------------------
skill rt_arr_text(a, ft, tt) -> Any {
  let f = rt_untag(ft)
  let e = rt_untag(tt)
  let n = peek(a + 8)
  if f < 0 { let f = 0 }
  if e > n { let e = n }
  if e < f { let e = f }
  let t = rt_text_new(e - f)
  for i in range(0, e - f) { do pokeb(t + 16 + i, rt_untag(peek(a + 16 + 8 * (f + i))) % 256) }
  return t
}

# ---- Linux -----------------------------------------------------------------------------------------------------------
# Everything above speaks to Windows: wcall("Name", ...) calls kernel32, wcallp(address, ...) calls whatever was found
# at run time. Compiled for Linux, pic sends each wcall("Name", ...) to the skill rt_lx_Name below, and wcallp to the
# skill rt_lx_GetProcAddress handed out -- skills that do the same job with Linux system calls (lsys). So one runtime
# serves both systems, and nothing above this line knows which it is running on.
#   Handles: a file is its Linux descriptor + 4096 (so no handle is 0 or -1); a process is the address of its record.
#   Memory: scratch comes from Pi's heap and is given back before the skill returns (memused() reads the same on both
#   systems); whatever outlives the call is mapped apart from the heap.
#   Globals: 16 the stack pointer the program started with (argc, the arguments, the environment), 17 the command
#   line built from it, 18 the name last asked of LoadLibraryA / GetProcAddress (for the message when it is missing).
#   Paths: a \ is read as / (Pi's programs name files the Windows way).

# platform(): "linux" or "windows" -- the system this program was compiled for
skill rt_platform() -> Any {
  if ostarget() { return "linux" }
  return "windows"
}

skill rt_lx_len(p) -> Any {
  let n = 0
  while peekb(p + n) != 0 { let n = n + 1 }
  return n
}

skill rt_lx_path(name) -> Any {
  let n = rt_lx_len(name)
  let p = rt_alloc(n + 1)
  for i in range(0, n) {
    let c = peekb(name + i)
    if c == 92 { let c = 47 }
    do pokeb(p + i, c)
  }
  do pokeb(p + n, 0)
  return p
}

# is the C string at p the text t
skill rt_lx_is(p, t) -> Any {
  let n = peek(t + 8)
  for i in range(0, n) {
    if peekb(p + i) != peekb(t + 16 + i) { return 0 }
  }
  return peekb(p + n) == 0
}

# n bytes of fresh memory outside the heap (read, write; private, anonymous), or 0
skill rt_lx_map(n) -> Any {
  let p = lsys(9, 0, n, 3, 34, 0 - 1, 0)
  if p < 0 and p > 0 - 4096 { return 0 }
  return p
}

skill rt_lx_say(t) -> Any {
  do lsys(1, 1, t + 16, peek(t + 8))
  return 0
}

# a Windows function nothing here stands in for was called: say which, and stop as fail() does
skill rt_lx_missing() -> Any {
  let name = peek(gaddr(18))
  do rt_lx_say("PiRuntimeError: ")
  if name != 0 { do lsys(1, 1, name, rt_lx_len(name)) }
  do rt_lx_say(" is a Windows facility that Pi does not have on Linux yet\n")
  do lsys(231, 1)
  return 0
}

# -- the fifteen kernel32 calls of wcall --
skill rt_lx_ExitProcess(code) -> Any {
  do lsys(231, code)
  return 0
}

skill rt_lx_GetStdHandle(n) -> Any {
  if n == 0 - 10 { return 4096 }
  if n == 0 - 11 { return 4097 }
  return 4098
}

skill rt_lx_WriteFile(h, buf, n, wr, ov) -> Any {
  # a new file that starts with the ELF mark is a program: Linux runs it only if it is marked as one (rwxr-xr-x)
  if n >= 4 and peekb(buf) == 127 and peekb(buf + 1) == 69 and peekb(buf + 2) == 76 and peekb(buf + 3) == 70 {
    if lsys(8, h - 4096, 0, 1) == 0 { do lsys(91, h - 4096, 493) }
  }
  let done = 0
  let going = 1
  while going and done < n {
    let r = lsys(1, h - 4096, buf + done, n - done)
    if r <= 0 { let going = 0 } else { let done = done + r }
  }
  if wr != 0 { do rt_poke32(wr, done) }
  return done == n
}

# as much as there is, up to n bytes (a read of nothing at the end of the input still succeeds, as on Windows)
skill rt_lx_ReadFile(h, buf, n, rd, ov) -> Any {
  let done = 0
  let going = 1
  while going and done < n {
    let want = n - done
    if want > 1073741824 { let want = 1073741824 }
    let r = lsys(0, h - 4096, buf + done, want)
    if r <= 0 { let going = 0 } else { let done = done + r }
  }
  if rd != 0 { do rt_poke32(rd, done) }
  return 1
}

# reserve (8192): address space that costs nothing until it is committed; commit (4096): make it readable and
# writable -- the two steps the heap takes on Windows, as mmap and mprotect
skill rt_lx_VirtualAlloc(addr, size, kind, prot) -> Any {
  if addr == 0 {
    let pr = 0
    if band(kind, 4096) != 0 { let pr = 3 }
    let p = lsys(9, 0, size, pr, 16418, 0 - 1, 0)
    if p < 0 and p > 0 - 4096 { return 0 }
    return p
  }
  let a = addr // 4096 * 4096
  let e = (addr + size + 4095) // 4096 * 4096
  if lsys(10, a, e - a, 3) != 0 { return 0 }
  return addr
}

# access: 2147483648 read, 1073741824 write, 4 append; disp: 1 new, 2 create or empty, 3 must exist, 4 open or create
skill rt_lx_CreateFileA(name, access, share, sa, disp, flags, tmpl) -> Any {
  let top = peek(gaddr(0))
  let fl = 0
  if band(access, 1073741824) != 0 {
    let fl = 1
    if band(access, 2147483648) != 0 { let fl = 2 }
  }
  if band(access, 4) != 0 and fl == 0 { let fl = 1025 }
  let ro = fl == 0
  if disp == 1 { let fl = fl + 192 }
  if disp == 2 { let fl = fl + 576 }
  if disp == 4 { let fl = fl + 64 }
  let fd = lsys(2, rt_lx_path(name), fl + 524288, 420)
  if fd >= 0 and ro {
    # a folder is not a file to read (Windows refuses; Linux would open it)
    let st = rt_alloc(144)
    if lsys(5, fd, st) == 0 and band(rt_peek32(st + 24), 61440) == 16384 {
      do lsys(3, fd)
      let fd = 0 - 1
    }
  }
  do poke(gaddr(0), top)
  if fd < 0 { return 0 - 1 }
  return fd + 4096
}

# a descriptor's file size, or -1
skill rt_lx_fsize(fd) -> Any {
  let top = peek(gaddr(0))
  let st = rt_alloc(144)
  let size = 0 - 1
  if lsys(5, fd, st) == 0 { let size = peek(st + 48) }
  do poke(gaddr(0), top)
  return size
}

skill rt_lx_GetFileSize(h, high) -> Any {
  let size = rt_lx_fsize(h - 4096)
  if size < 0 { return 4294967295 }
  if high != 0 { do rt_poke32(high, size // 4294967296) }
  return size % 4294967296
}

skill rt_lx_CloseHandle(h) -> Any {
  if h >= 4099 and h < 1052672 {
    do lsys(3, h - 4096)
    return 1
  }
  # a process record (rt_lx_CreateProcessA): its page goes back
  if h >= 1052672 and h % 4096 == 0 {
    if peek(h + 24) == 5788003 { do lsys(11, h, 4096) }
  }
  return 1
}

# the command line as Windows gives it: the arguments in one line, any with a space in it quoted
skill rt_lx_GetCommandLineA() -> Any {
  if peek(gaddr(17)) != 0 { return peek(gaddr(17)) }
  let sp = peek(gaddr(16))
  let argc = peek(sp)
  let total = 1
  for i in range(0, argc) { let total = total + rt_lx_len(peek(sp + 8 + 8 * i)) + 3 }
  let buf = rt_lx_map(total)
  let o = 0
  for i in range(0, argc) {
    let a = peek(sp + 8 + 8 * i)
    let k = rt_lx_len(a)
    let q = k == 0
    for j in range(0, k) {
      if peekb(a + j) == 32 { let q = 1 }
    }
    if i > 0 {
      do pokeb(buf + o, 32)
      let o = o + 1
    }
    if q {
      do pokeb(buf + o, 34)
      let o = o + 1
    }
    for j in range(0, k) { do pokeb(buf + o + j, peekb(a + j)) }
    let o = o + k
    if q {
      do pokeb(buf + o, 34)
      let o = o + 1
    }
  }
  do pokeb(buf + o, 0)
  do poke(gaddr(17), buf)
  return buf
}

# the "libraries" that have skills standing in for them here: 1 kernel32, 2 ws2_32 (sockets); 0 none
skill rt_lx_LoadLibraryA(name) -> Any {
  do poke(gaddr(18), name)
  if rt_lx_is(name, "kernel32.dll") { return 1 }
  if rt_lx_is(name, "ws2_32.dll") { return 2 }
  return 0
}

skill rt_lx_GetProcAddress(m, name) -> Any {
  do poke(gaddr(18), name)
  if m == 1 {
    if rt_lx_is(name, "CloseHandle") { return faddr("rt_lx_CloseHandle") }
    if rt_lx_is(name, "ReadFile") { return faddr("rt_lx_ReadFile") }
    if rt_lx_is(name, "SetFilePointerEx") { return faddr("rt_lx_SetFilePointerEx") }
    if rt_lx_is(name, "GetTickCount64") { return faddr("rt_lx_GetTickCount64") }
    if rt_lx_is(name, "QueryPerformanceCounter") { return faddr("rt_lx_QueryPerformanceCounter") }
    if rt_lx_is(name, "QueryPerformanceFrequency") { return faddr("rt_lx_QueryPerformanceFrequency") }
    if rt_lx_is(name, "GetFileSizeEx") { return faddr("rt_lx_GetFileSizeEx") }
    if rt_lx_is(name, "CreateFileMappingA") { return faddr("rt_lx_CreateFileMappingA") }
    if rt_lx_is(name, "MapViewOfFile") { return faddr("rt_lx_MapViewOfFile") }
    if rt_lx_is(name, "MoveFileExA") { return faddr("rt_lx_MoveFileExA") }
    if rt_lx_is(name, "SetConsoleOutputCP") { return faddr("rt_lx_SetConsoleCP") }
    if rt_lx_is(name, "SetConsoleCP") { return faddr("rt_lx_SetConsoleCP") }
    if rt_lx_is(name, "GetLocalTime") { return faddr("rt_lx_GetLocalTime") }
    if rt_lx_is(name, "CreateProcessA") { return faddr("rt_lx_CreateProcessA") }
    if rt_lx_is(name, "WaitForSingleObject") { return faddr("rt_lx_WaitForSingleObject") }
    if rt_lx_is(name, "GetExitCodeProcess") { return faddr("rt_lx_GetExitCodeProcess") }
    if rt_lx_is(name, "TerminateProcess") { return faddr("rt_lx_TerminateProcess") }
    if rt_lx_is(name, "GetProcessId") { return faddr("rt_lx_GetProcessId") }
  }
  if m == 2 {
    if rt_lx_is(name, "WSAStartup") { return faddr("rt_lx_WSAStartup") }
    if rt_lx_is(name, "socket") { return faddr("rt_lx_socket") }
    if rt_lx_is(name, "connect") { return faddr("rt_lx_connect") }
    if rt_lx_is(name, "send") { return faddr("rt_lx_send") }
    if rt_lx_is(name, "recv") { return faddr("rt_lx_recv") }
    if rt_lx_is(name, "closesocket") { return faddr("rt_lx_closesocket") }
    if rt_lx_is(name, "bind") { return faddr("rt_lx_bind") }
    if rt_lx_is(name, "listen") { return faddr("rt_lx_listen") }
    if rt_lx_is(name, "accept") { return faddr("rt_lx_accept") }
  }
  return 0
}

skill rt_lx_SetFilePointerEx(h, off, newp, method) -> Any {
  let r = lsys(8, h - 4096, off, method)
  if r < 0 { return 0 }
  if newp != 0 { do poke(newp, r) }
  return 1
}

# -- a folder's names. Windows (NTFS) lists them sorted, . and .. first, letters compared in upper case; Linux lists
# them in no order at all. So the whole folder is read, sorted that way, and handed out one name at a time.
# The record (mapped): [bytes mapped, names, next] then a pointer per name, then each name as [kind byte, name, 0].
skill rt_lx_dots(p) -> Any {
  if peekb(p) == 46 {
    if peekb(p + 1) == 0 { return 0 }
    if peekb(p + 1) == 46 and peekb(p + 2) == 0 { return 1 }
  }
  return 2
}

skill rt_lx_up(c) -> Any {
  if c >= 97 and c <= 122 { return c - 32 }
  return c
}

skill rt_lx_before(a, b) -> Any {
  let ra = rt_lx_dots(a + 1)
  let rb = rt_lx_dots(b + 1)
  if ra != rb { return ra < rb }
  let i = 1
  while 1 {
    let x = rt_lx_up(peekb(a + i))
    let y = rt_lx_up(peekb(b + i))
    if x != y { return x < y }
    if x == 0 { return 0 }
    let i = i + 1
  }
  return 0
}

skill rt_lx_sift(base, i, n) -> Any {
  let going = 1
  while going {
    let l = 2 * i + 1
    let big = i
    if l < n and rt_lx_before(peek(base + 8 * big), peek(base + 8 * l)) { let big = l }
    if l + 1 < n and rt_lx_before(peek(base + 8 * big), peek(base + 8 * (l + 1))) { let big = l + 1 }
    if big == i { let going = 0 } else {
      let t = peek(base + 8 * i)
      do poke(base + 8 * i, peek(base + 8 * big))
      do poke(base + 8 * big, t)
      let i = big
    }
  }
  return 0
}

skill rt_lx_sort(base, n) -> Any {
  let i = n // 2 - 1
  while i >= 0 {
    do rt_lx_sift(base, i, n)
    let i = i - 1
  }
  let e = n - 1
  while e > 0 {
    let t = peek(base)
    do poke(base, peek(base + 8 * e))
    do poke(base + 8 * e, t)
    do rt_lx_sift(base, 0, e)
    let e = e - 1
  }
  return 0
}

# the next name into Windows' find record: attributes at 0 (16 a folder, 128 a file), the name at 44
skill rt_lx_fill(rec, fd) -> Any {
  let e = peek(rec + 24 + 8 * peek(rec + 16))
  for i in range(0, 320) { do pokeb(fd + i, 0) }
  let attr = 128
  if peekb(e) == 4 { let attr = 16 }
  do rt_poke32(fd, attr)
  let k = 0
  while k < 259 and peekb(e + 1 + k) != 0 {
    do pokeb(fd + 44 + k, peekb(e + 1 + k))
    let k = k + 1
  }
  return 0
}

# pat is "folder\*" (the only pattern the runtime asks for): every name in that folder
skill rt_lx_FindFirstFileA(pat, fd) -> Any {
  let top = peek(gaddr(0))
  let p = rt_lx_path(pat)
  let n = rt_lx_len(p)
  let cut = 0 - 1
  for i in range(0, n) {
    if peekb(p + i) == 47 { let cut = i }
  }
  let dir = rt_alloc(n + 2)
  if cut < 0 {
    do pokeb(dir, 46)
    do pokeb(dir + 1, 0)
  } else {
    let k = cut
    if k == 0 { let k = 1 }
    for i in range(0, k) { do pokeb(dir + i, peekb(p + i)) }
    do pokeb(dir + k, 0)
  }
  let d = lsys(2, dir, 589824, 0)
  if d < 0 {
    do poke(gaddr(0), top)
    return 0 - 1
  }
  # once through to count the names and their bytes, then again to keep them
  let buf = rt_alloc(32768)
  let count = 0
  let bytes = 0
  let going = 1
  while going {
    let r = lsys(217, d, buf, 32768)
    if r <= 0 { let going = 0 } else {
      let o = 0
      while o < r {
        let count = count + 1
        let bytes = bytes + rt_lx_len(buf + o + 19) + 2
        let o = o + peekb(buf + o + 16) + 256 * peekb(buf + o + 17)
      }
    }
  }
  let size = 24 + 8 * count + bytes
  let rec = 0
  if count > 0 { let rec = rt_lx_map(size) }
  if rec == 0 {
    do lsys(3, d)
    do poke(gaddr(0), top)
    return 0 - 1
  }
  do lsys(8, d, 0, 0)
  let w = rec + 24 + 8 * count
  let k = 0
  let going = 1
  while going {
    let r = lsys(217, d, buf, 32768)
    if r <= 0 { let going = 0 } else {
      let o = 0
      while o < r {
        let ln = rt_lx_len(buf + o + 19)
        if k < count and w + ln + 2 <= rec + size {
          do poke(rec + 24 + 8 * k, w)
          do pokeb(w, peekb(buf + o + 18))
          for i in range(0, ln + 1) { do pokeb(w + 1 + i, peekb(buf + o + 19 + i)) }
          let w = w + ln + 2
          let k = k + 1
        }
        let o = o + peekb(buf + o + 16) + 256 * peekb(buf + o + 17)
      }
    }
  }
  do lsys(3, d)
  do poke(gaddr(0), top)
  do poke(rec, size)
  do poke(rec + 8, k)
  do poke(rec + 16, 0)
  do rt_lx_sort(rec + 24, k)
  do rt_lx_fill(rec, fd)
  return rec
}

skill rt_lx_FindNextFileA(h, fd) -> Any {
  let i = peek(h + 16) + 1
  if i >= peek(h + 8) { return 0 }
  do poke(h + 16, i)
  do rt_lx_fill(h, fd)
  return 1
}

skill rt_lx_FindClose(h) -> Any {
  do lsys(11, h, peek(h))
  return 1
}

# -- kernel32 by name (rt_proc("kernel32.dll", ...)) --
# a clock in nanoseconds: 0 the time of day (since 1970), 1 one that only moves forward
skill rt_lx_clock(which) -> Any {
  let top = peek(gaddr(0))
  let ts = rt_alloc(16)
  do lsys(228, which, ts)
  let ns = peek(ts) * 1000000000 + peek(ts + 8)
  do poke(gaddr(0), top)
  return ns
}

skill rt_lx_GetTickCount64() -> Any { return rt_lx_clock(1) // 1000000 }

skill rt_lx_QueryPerformanceCounter(p) -> Any {
  do poke(p, rt_lx_clock(1))
  return 1
}

skill rt_lx_QueryPerformanceFrequency(p) -> Any {
  do poke(p, 1000000000)
  return 1
}

skill rt_lx_GetFileSizeEx(h, p) -> Any {
  let size = rt_lx_fsize(h - 4096)
  if size < 0 { return 0 }
  do poke(p, size)
  return 1
}

# a file mapped into memory: the "mapping" is the file's own handle, the view is the whole file, read only
skill rt_lx_CreateFileMappingA(h, sa, prot, hi, lo, name) -> Any { return h }

skill rt_lx_MapViewOfFile(mp, access, hi, lo, bytes) -> Any {
  let size = rt_lx_fsize(mp - 4096)
  if size <= 0 { return 0 }
  let p = lsys(9, 0, size, 1, 2, mp - 4096, 0)
  if p < 0 and p > 0 - 4096 { return 0 }
  return p
}

skill rt_lx_MoveFileExA(src, dst, flags) -> Any {
  let top = peek(gaddr(0))
  let r = lsys(82, rt_lx_path(src), rt_lx_path(dst))
  do poke(gaddr(0), top)
  return r == 0
}

# a Linux terminal reads and writes UTF-8 already
skill rt_lx_SetConsoleCP(cp) -> Any { return 1 }

skill rt_lx_poke16(p, v) -> Any {
  do pokeb(p, v % 256)
  do pokeb(p + 1, v // 256 % 256)
  return 0
}

skill rt_lx_be32(p) -> Any {
  let v = peekb(p) * 16777216 + peekb(p + 1) * 65536 + peekb(p + 2) * 256 + peekb(p + 3)
  if v >= 2147483648 { return v - 4294967296 }
  return v
}

# how many seconds local time is ahead of UTC at the moment secs: read from the system's zone file (/etc/localtime,
# a table of the moments the offset changed and what it changed to); 0, which is UTC, if there is no such file
skill rt_lx_tzoff(secs) -> Any {
  let top = peek(gaddr(0))
  let off = 0
  let fd = lsys(2, rt_cstr("/etc/localtime"), 524288, 0)
  if fd >= 0 {
    let buf = rt_alloc(16384)
    let n = lsys(0, fd, buf, 16384)
    do lsys(3, fd)
    if n >= 44 and peekb(buf) == 84 and peekb(buf + 1) == 90 and peekb(buf + 2) == 105 and peekb(buf + 3) == 102 {
      let timecnt = rt_lx_be32(buf + 32)
      let typecnt = rt_lx_be32(buf + 36)
      let times = buf + 44
      let idx = times + 4 * timecnt
      let types = idx + timecnt
      if timecnt >= 0 and typecnt > 0 and types + 6 * typecnt <= buf + n {
        let ty = 0
        for i in range(0, timecnt) {
          if rt_lx_be32(times + 4 * i) <= secs { let ty = peekb(idx + i) }
        }
        if ty < typecnt { let off = rt_lx_be32(types + 6 * ty) }
      }
    }
  }
  do poke(gaddr(0), top)
  return off
}

# the local date and time into Windows' record of eight 16-bit numbers (year, month, weekday, day, hour, minute,
# second, millisecond)
skill rt_lx_GetLocalTime(t) -> Any {
  let ns = rt_lx_clock(0)
  let secs = ns // 1000000000
  let secs = secs + rt_lx_tzoff(secs)
  let days = secs // 86400
  let rem = secs % 86400
  # the calendar date of a day number: the years are counted from a 1 March so the leap day comes last
  let z = days + 719468
  let era = z // 146097
  let doe = z - era * 146097
  let yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
  let y = yoe + era * 400
  let doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
  let mp = (5 * doy + 2) // 153
  let d = doy - (153 * mp + 2) // 5 + 1
  let m = mp + 3
  if mp >= 10 { let m = mp - 9 }
  if m <= 2 { let y = y + 1 }
  do rt_lx_poke16(t, y)
  do rt_lx_poke16(t + 2, m)
  do rt_lx_poke16(t + 4, (days + 4) % 7)
  do rt_lx_poke16(t + 6, d)
  do rt_lx_poke16(t + 8, rem // 3600)
  do rt_lx_poke16(t + 10, rem % 3600 // 60)
  do rt_lx_poke16(t + 12, rem % 60)
  do rt_lx_poke16(t + 14, ns % 1000000000 // 1000000)
  return 0
}

# -- processes. The record (one mapped page): [process id, 1 once it has ended, its exit code, a mark]. The child is
# made by fork and becomes the program by execve; with no handles to inherit (a program started with no window) its
# input and output go nowhere, as on Windows.
skill rt_lx_std(h, nul, fd) -> Any {
  if h >= 4096 and h < 1052672 { do lsys(33, h - 4096, fd) } else { do lsys(33, nul, fd) }
  return 0
}

skill rt_lx_CreateProcessA(app, cmd, pa, ta, inherit, flags, env, cwd, si, pi) -> Any {
  let top = peek(gaddr(0))
  let n = rt_lx_len(cmd)
  # the command line cut into its words (quotes respected, as arg() reads them): each a C string, then the list
  let text = rt_alloc(n + 1)
  for i in range(0, n + 1) { do pokeb(text + i, peekb(cmd + i)) }
  let words = rt_alloc(8 * (n + 2))
  let argc = 0
  let p = text
  let going = 1
  while going {
    while peekb(p) == 32 { let p = p + 1 }
    if peekb(p) == 0 { let going = 0 } else {
      let quoted = 0
      if peekb(p) == 34 {
        let quoted = 1
        let p = p + 1
      }
      do poke(words + 8 * argc, p)
      let argc = argc + 1
      if quoted {
        while peekb(p) != 0 and peekb(p) != 34 { let p = p + 1 }
      } else {
        while peekb(p) != 0 and peekb(p) != 32 { let p = p + 1 }
      }
      if peekb(p) != 0 {
        do pokeb(p, 0)
        let p = p + 1
      }
    }
  }
  do poke(words + 8 * argc, 0)
  if argc == 0 {
    do poke(gaddr(0), top)
    return 0
  }
  let prog = rt_lx_path(peek(words))
  do poke(words, prog)
  let argv = words
  if lsys(21, prog, 1) != 0 {
    # not a program in reach by that path: a path that names a folder fails as it does on Windows; a bare name
    # goes to the shell, which looks along PATH
    let slash = 0
    for i in range(0, rt_lx_len(prog)) {
      if peekb(prog + i) == 47 { let slash = 1 }
    }
    if slash {
      do poke(gaddr(0), top)
      return 0
    }
    let argv = rt_alloc(32)
    let prog = rt_cstr("/bin/sh")
    do poke(argv, prog)
    do poke(argv + 8, rt_cstr("-c"))
    do poke(argv + 16, cmd)
    do poke(argv + 24, 0)
  }
  let rec = rt_lx_map(4096)
  if rec == 0 {
    do poke(gaddr(0), top)
    return 0
  }
  let sp = peek(gaddr(16))
  let envp = sp + 16 + 8 * peek(sp)
  let devnull = rt_cstr("/dev/null")
  let pid = lsys(57)
  if pid == 0 {
    let nul = lsys(2, devnull, 2, 0)
    if inherit == 0 {
      do rt_lx_std(0, nul, 0)
      do rt_lx_std(0, nul, 1)
      do rt_lx_std(0, nul, 2)
    } else {
      if band(rt_peek32(si + 60), 256) != 0 {
        do rt_lx_std(peek(si + 80), nul, 0)
        do rt_lx_std(peek(si + 88), nul, 1)
        do rt_lx_std(peek(si + 96), nul, 2)
      }
    }
    do lsys(59, prog, argv, envp)
    do lsys(231, 127)
  }
  do poke(gaddr(0), top)
  if pid < 0 {
    do lsys(11, rec, 4096)
    return 0
  }
  do poke(rec, pid)
  do poke(rec + 8, 0)
  do poke(rec + 16, 259)
  do poke(rec + 24, 5788003)
  do poke(pi, rec)
  do poke(pi + 8, 0)
  do rt_poke32(pi + 16, pid)
  do rt_poke32(pi + 20, pid)
  return 1
}

# 0 once the process has ended, 258 if it is still running after ms milliseconds (4294967295: wait however long)
skill rt_lx_WaitForSingleObject(h, ms) -> Any {
  if peek(h + 8) != 0 { return 0 }
  let top = peek(gaddr(0))
  let st = rt_alloc(32)
  let pid = peek(h)
  let start = rt_lx_clock(1)
  let res = 258
  let going = 1
  while going {
    do poke(st, 0)
    let opt = 1
    if ms >= 4294967295 { let opt = 0 }
    let r = lsys(61, pid, st, opt, 0)
    if r == pid {
      let s = rt_peek32(st)
      let code = s // 256 % 256
      if s % 128 != 0 { let code = 1 }
      do poke(h + 8, 1)
      do poke(h + 16, code)
      let res = 0
      let going = 0
    } else {
      if r < 0 and r != 0 - 4 {
        do poke(h + 8, 1)
        do poke(h + 16, 0)
        let res = 0
        let going = 0
      } else {
        if (rt_lx_clock(1) - start) // 1000000 >= ms { let going = 0 } else {
          do poke(st + 16, 0)
          do poke(st + 24, 2000000)
          do lsys(35, st + 16, 0)
        }
      }
    }
  }
  do poke(gaddr(0), top)
  return res
}

skill rt_lx_GetExitCodeProcess(h, p) -> Any {
  do rt_poke32(p, peek(h + 16))
  return 1
}

skill rt_lx_TerminateProcess(h, code) -> Any {
  if peek(h + 8) == 0 { do lsys(62, peek(h), 9) }
  return 1
}

skill rt_lx_GetProcessId(h) -> Any { return peek(h) }

# -- sockets (ws2_32 by name): the same calls and the same address record on both systems; a socket is its descriptor
skill rt_lx_WSAStartup(ver, data) -> Any { return 0 }

skill rt_lx_socket(af, kind, proto) -> Any {
  let s = lsys(41, af, kind + 524288, proto)
  if s < 0 { return 0 - 1 }
  return s
}

skill rt_lx_connect(s, sa, n) -> Any {
  if lsys(42, s, sa, n) != 0 { return 0 - 1 }
  return 0
}

# 16384: a connection the other side closed gives an error here, not a signal that ends the program
skill rt_lx_send(s, buf, n, flags) -> Any {
  let r = lsys(44, s, buf, n, 16384, 0, 0)
  if r < 0 { return 0 - 1 }
  return r
}

skill rt_lx_recv(s, buf, n, flags) -> Any {
  let r = lsys(45, s, buf, n, 0, 0, 0)
  if r < 0 { return 0 - 1 }
  return r
}

skill rt_lx_closesocket(s) -> Any {
  do lsys(3, s)
  return 0
}

# a port just let go can be taken again at once, as on Windows (Linux would hold it for a minute)
skill rt_lx_bind(s, sa, n) -> Any {
  let top = peek(gaddr(0))
  let one = rt_alloc(8)
  do poke(one, 1)
  do lsys(54, s, 1, 2, one, 4)
  do poke(gaddr(0), top)
  if lsys(49, s, sa, n) != 0 { return 0 - 1 }
  return 0
}

skill rt_lx_listen(s, n) -> Any {
  if lsys(50, s, n) != 0 { return 0 - 1 }
  return 0
}

skill rt_lx_accept(s, a, b) -> Any {
  let c = lsys(43, s, 0, 0)
  if c < 0 { return 0 - 1 }
  return c
}
