# nimage_hr: a HIGH-RESOLUTION neural image. Same idea as nimage.pi (a network trained from scratch on this PC's GPU
# learns pixel (x,y) -> colour, so the weights ARE the real photo), but built for big photos. nimage.pi is full-batch:
# it uploads every pixel each step, which blows past VRAM past ~0.5 MP. This trainer is MINI-BATCH -- each step it
# draws a random handful of pixels, computes their Fourier features on the CPU, and takes one SGD step -- so training
# cost no longer grows with the image. The final picture is drawn in horizontal TILES, one net evaluation per tile,
# at the photo's native resolution (the net is a continuous function of (x,y), so any grid works).
#   nimage_hr IN.ppm OUT.png [steps] [hidden] [L] [batch]
import "grad.pi"

# ---- read a binary PPM (P6): -> [width, height, bytes(int array), pixel-start offset] ----
skill nih_tok(b, i) -> Any {
  let n = len(b)
  while i < n {
    let c = aget(b, i)
    if c == 35 {
      while i < n and aget(b, i) != 10 { i += 1 }
    } else if c == 32 or c == 9 or c == 10 or c == 13 {
      i += 1
    } else {
      break
    }
  }
  let v = 0
  while i < n and aget(b, i) >= 48 and aget(b, i) <= 57 {
    v = v * 10 + aget(b, i) - 48
    i += 1
  }
  return [v, i]
}
skill nih_read_ppm(path) -> Any {
  let size = rt_file_size(path)
  if size == 0 { fail("cannot read " ++ path) }
  let b = read_bytes(path, 0, size)
  if len(b) < 2 or aget(b, 0) != 80 or aget(b, 1) != 54 { fail(path ++ " is not a binary PPM (P6)") }
  let w = nih_tok(b, 2)
  let h = nih_tok(b, w[1])
  let mx = nih_tok(b, h[1])
  return [w[0], h[0], b, mx[1] + 1]
}

skill nih_nfeat(L) -> Any { return 2 + 4 * L }

# Fourier features of one pixel (fx, fy) written as F float32 words at host offset `base`.
skill nih_feat(host, base, fx, fy, L) -> Any {
  rt_g_putbits(host, base, g_f32bits(fx))
  rt_g_putbits(host, base + 1, g_f32bits(fy))
  let idx = base + 2
  let freq = 3.14159265358979
  for k in range(0, L) {
    rt_g_putbits(host, idx, g_f32bits(sin(freq * fx)))
    idx += 1
    rt_g_putbits(host, idx, g_f32bits(cos(freq * fx)))
    idx += 1
    rt_g_putbits(host, idx, g_f32bits(sin(freq * fy)))
    idx += 1
    rt_g_putbits(host, idx, g_f32bits(cos(freq * fy)))
    idx += 1
    freq = freq * 2.0
  }
  return 0
}

# a small LCG so the batch is a different random set of pixels each step
skill nih_rand(rs, n) -> Any {
  let s = aget(rs, 0)
  s = (s * 1103515245 + 12345) % 2147483648
  aset(rs, 0, s)
  return s % n
}

# ---- the network: Fourier features -> ReLU hidden layers -> 3 colours ----
skill nih_net(G, st, F, hid, nlayers) -> Any {
  let sizes = [F]
  for i in range(0, nlayers) { sizes = append(sizes, hid) }
  sizes = append(sizes, 3)
  let layers = []
  for l in range(0, len(sizes) - 1) {
    let fin = sizes[l]
    let fout = sizes[l + 1]
    let w = g_param(G, fin, fout)
    let b = g_param(G, 1, fout)
    let scale = if l == len(sizes) - 2 { 0.01 } else { sqrt(2.0 / float(fin)) }
    g_randn(w, st, scale)
    layers = append(layers, [w, b])
  }
  return layers
}
skill nih_fwd(G, layers, x) -> Any {
  let h = x
  let n = len(layers)
  for l in range(0, n) {
    let act = if l == n - 1 { "" } else { "relu" }
    h = g_dense(G, h, layers[l][0], layers[l][1], act, 0.0)
  }
  return h
}

skill rt_nih_pack(bt) -> Any {
  let b = bt
  let n = peek(b + 8)
  let p = rt_alloc(n)
  for i in range(0, n) { do pokeb(p + i, rt_untag(peek(b + 16 + 8 * i)) % 256) }
  return rt_tag(p)
}

# draw the whole image into `out` (bytes) in horizontal tiles of `block` rows. Each tile runs inside mark()/release()
# with a manual graph free (no GC), so the transient features/reads of a 1.4 MP render don't pile up on the heap.
skill nih_render(G, layers, w, h, L, block, out) -> Any {
  let F = nih_nfeat(L)
  let rows = block
  let xt = g_tensor(rows * w, F)
  let host = rt_host_alloc(4 * rows * w * F)
  let ph = rt_host_alloc(4 * rows * w * 3)
  let EMPTY = []
  let nt = (h + block - 1) // block
  for t in range(0, nt) {
    let mm = mark()
    let r0 = t * block
    let idx = 0
    for rr in range(0, rows) {
      let py = r0 + rr
      if py >= h { py = h - 1 }
      let fy = (float(py) + 0.5) / float(h) * 2.0 - 1.0
      for xx in range(0, w) {
        let fx = (float(xx) + 0.5) / float(w) * 2.0 - 1.0
        nih_feat(host, idx, fx, fy, L)
        idx += F
      }
    }
    rt_host_to_gpu(xt[0], host, 4 * rows * w * F)
    let pred = nih_fwd(G, layers, xt)
    rt_gpu_to_host(ph, pred[0], 4 * rows * w * 3)
    for rr in range(0, rows) {
      let py = r0 + rr
      if py < h {
        for xx in range(0, w) {
          let base = (rr * w + xx) * 3
          let o = (py * w + xx) * 3
          for c in range(0, 3) {
            let v = g_bits_real(rt_g_getbits(ph, base + c))
            let q = int(v * 255.0 + 0.5)
            if q < 0 { q = 0 }
            if q > 255 { q = 255 }
            aset(out, o + c, q)
          }
        }
      }
    }
    for gt in rt_sh_get(G["graph"]) {
      rt_gpu_free(gt[0])
      rt_gpu_free(gt[1])
    }
    rt_sh_set(G["graph"], EMPTY)
    rt_sh_set(G["tape"], EMPTY)
    do release(mm, 0)
  }
  rt_host_free(host)
  rt_host_free(ph)
  rt_gpu_free(xt[0])
  rt_gpu_free(xt[1])
  return 0
}

skill main() -> Any {
  if arg(1) == null or arg(2) == null { return "nimage_hr IN.ppm OUT.png [steps] [hidden] [L] [batch]" }
  let img = nih_read_ppm(arg(1))
  let w = img[0]
  let h = img[1]
  let bytes = img[2]
  let pstart = img[3]
  let N = w * h
  let steps = if arg(3) != null { int(arg(3)) } else { 6000 }
  let hid = if arg(4) != null { int(arg(4)) } else { 384 }
  let L = if arg(5) != null { int(arg(5)) } else { 12 }
  let batch = if arg(6) != null { int(arg(6)) } else { 16384 }
  let F = nih_nfeat(L)
  print("photo " ++ str(w) ++ " x " ++ str(h) ++ " = " ++ str(N) ++ " px; " ++ str(F) ++ " feats, " ++ str(hid) ++ " hidden, batch " ++ str(batch))
  let t0 = ticks()

  let G = g_open()
  let st = arr(1)
  aset(st, 0, 1234567)
  let rs = arr(1)
  aset(rs, 0, 20260104)

  # Compute every pixel's Fourier features and colour ONCE, in pixel order, into pinned host buffers (the trig runs
  # here, not per step). Each training step then GATHERS a random batch of rows out of these with plain memory reads.
  # (A mid-buffer slice can't be uploaded directly: rt_host_to_gpu/rt_gpu_copy pass the pointer through wcall, which
  # only handles an alloc-returned pointer, not a computed offset one -- so we stage each batch contiguously in a
  # fixed buffer and upload it from offset 0, the path that works.)
  let axh = rt_host_alloc(4 * N * F)
  let ayh = rt_host_alloc(4 * N * 3)
  for p in range(0, N) {
    let px = p % w
    let py = p // w
    let fx = (float(px) + 0.5) / float(w) * 2.0 - 1.0
    let fy = (float(py) + 0.5) / float(h) * 2.0 - 1.0
    nih_feat(axh, p * F, fx, fy, L)
    rt_g_putbits(ayh, p * 3, g_f32bits(float(aget(bytes, pstart + 3 * p)) / 255.0))
    rt_g_putbits(ayh, p * 3 + 1, g_f32bits(float(aget(bytes, pstart + 3 * p + 1)) / 255.0))
    rt_g_putbits(ayh, p * 3 + 2, g_f32bits(float(aget(bytes, pstart + 3 * p + 2)) / 255.0))
  }
  print("features precomputed in " ++ str((ticks() - t0) // 1000) ++ " s")

  let layers = nih_net(G, st, F, hid, 4)
  let opt = g_opt(G, 0.003)
  # the GPU has no garbage collector, so each step runs inside mark()/release(); the graph/tape boxes are pointed at
  # one persistent EMPTY list (allocated before the loop) so release never leaves them dangling (nerf.pi's pattern).
  let EMPTY = []
  let hostx = rt_host_alloc(4 * batch * F)
  let hosty = rt_host_alloc(4 * batch * 3)
  let tt = ticks()
  for step in range(0, steps + 1) {
    let mm = mark()
    # gather a random batch of pixels out of the precomputed buffers (plain memory copies, no trig)
    for r in range(0, batch) {
      let p = nih_rand(rs, N)
      let sb = p * F
      let db = r * F
      for j in range(0, F) { rt_g_putbits(hostx, db + j, rt_g_getbits(axh, sb + j)) }
      rt_g_putbits(hosty, r * 3, rt_g_getbits(ayh, p * 3))
      rt_g_putbits(hosty, r * 3 + 1, rt_g_getbits(ayh, p * 3 + 1))
      rt_g_putbits(hosty, r * 3 + 2, rt_g_getbits(ayh, p * 3 + 2))
    }
    let x = g_tensor(batch, F)
    do rt_host_to_gpu(x[0], hostx, 4 * batch * F)
    let tgt = g_tensor(batch, 3)
    do rt_host_to_gpu(tgt[0], hosty, 4 * batch * 3)
    let L2 = g_mse(G, nih_fwd(G, layers, x), tgt)
    g_backward(G)
    g_step(G, opt)
    if step % 500 == 0 {
      let psnr = 0.0 - 10.0 * log10(L2 + 0.0000000001)
      print("step " ++ str(step) ++ "  batch-loss " ++ format("{:.6f}", L2) ++ "  batch-PSNR " ++ format("{:.2f}", psnr) ++ " dB  (" ++ str((ticks() - tt) // 1000) ++ " s)")
    }
    rt_gpu_free(x[0])
    rt_gpu_free(x[1])
    rt_gpu_free(tgt[0])
    rt_gpu_free(tgt[1])
    for t in rt_sh_get(G["graph"]) {
      rt_gpu_free(t[0])
      rt_gpu_free(t[1])
    }
    rt_sh_set(G["graph"], EMPTY)
    rt_sh_set(G["tape"], EMPTY)
    do release(mm, 0)
  }
  rt_host_free(hostx)
  rt_host_free(hosty)
  rt_host_free(axh)
  rt_host_free(ayh)

  # draw the full image at native resolution (small tiles keep each forward's GPU buffers modest)
  let out = arr(N * 3)
  do nih_render(G, layers, w, h, L, 2, out)
  # full-image PSNR from integer byte errors (no reals to survive a release); MSE normalised to [0,1]
  let sse = 0
  for i in range(0, N * 3) {
    let d = aget(out, i) - aget(bytes, pstart + i)
    sse = sse + d * d
  }
  let mse = float(sse) / float(N * 3) / (255.0 * 255.0)
  let fullpsnr = 0.0 - 10.0 * log10(mse + 0.0000000001)
  let size = rt_png_write(arg(2), rt_nih_pack(out), w, h)
  print("wrote " ++ arg(2) ++ ", " ++ str(size) ++ " bytes; FULL-IMAGE PSNR " ++ format("{:.2f}", fullpsnr) ++ " dB; total " ++ str((ticks() - t0) // 1000) ++ " s")
  return 0
}
