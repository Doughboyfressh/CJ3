# The teacher labels every split in one pass. No law is stored except the survivors.
# A survivor that disagrees with the teacher on the grid is a miss. No survivor is a refusal.
# Thirty-six teachers are inside Heed: scale or shift, before or after, from -4 to 4.
# The range of a list is not. Agreement without the teacher is not counted as a match.
import "mindcore.pi"

skill range_of(xs) -> Any {
  let hi = xs[0]
  let lo = xs[0]
  for v in xs {
    if v > hi { let hi = v }
    if v < lo { let lo = v }
  }
  return hi - lo
}

skill split_probe(laws) -> Any {
  if len(laws) < 2 { return null }
  for xs in [[0], [1], [2], [4], [0 - 1], [2, 3], [1, 1], [0 - 2, 4], [0, 1, 3], [3, 5, 7], [8, 1, 3], [2, 2, 2], [1, 4]] {
    for reducer in hm_reducers() {
      let y = hm_predict(laws[0], [reducer, xs])
      let split = false
      for law in laws {
        if hm_predict(law, [reducer, xs]) != y { let split = true }
      }
      if split { return [reducer, xs] }
    }
  }
  return null
}

skill keep(laws, probe, y) -> Any {
  let kept = []
  for law in laws {
    if hm_predict(law, probe) == y { let kept = append(kept, law) }
  }
  return kept
}

skill grid() -> Any {
  let out = []
  for reducer in ["product", "sum", "count"] {
    for xs in [[3, 5, 7], [1, 4], [4], [0], [0 - 2, 4], [2, 2, 2]] {
      let out = append(out, [reducer, xs])
    }
  }
  return out
}

skill matches(laws, law) -> Any {
  if len(laws) == 0 { return 0 }
  for ex in grid() {
    let y = null
    let seen = false
    for L in laws {
      let v = hm_predict(L, ex)
      if seen == false {
        let y = v
        let seen = true
      }
      if v != y { return 0 }
    }
    if y != hm_predict(law, ex) { return 0 - 1 }
  }
  return 1
}

skill transfer(law) -> Any {
  let seed = ["product", [2, 3]]
  let laws = hm_laws([["product", [2, 3], hm_predict(law, seed)]])
  let steps = 0
  while steps < 12 {
    let probe = split_probe(laws)
    if probe == null { return [laws, steps] }
    let laws = keep(laws, probe, hm_predict(law, probe))
    let steps = steps + 1
  }
  return [laws, steps]
}

skill transfer_range() -> Any {
  let laws = hm_laws([["sum", [2, 3], 1]])
  let steps = 0
  while steps < 12 {
    let probe = split_probe(laws)
    if probe == null { return [laws, steps] }
    let laws = keep(laws, probe, range_of(probe[1]))
    let steps = steps + 1
  }
  return [laws, steps]
}

skill main() -> Any {
  let hit = 0
  let miss = 0
  let open = 0
  let asked = 0
  for k in range(0 - 4, 5) {
    for op in ["*", "+"] {
      for before in [true, false] {
        let law = [O(op, [V("e"), Q(k)]), before]
        let done = transfer(law)
        let verdict = matches(done[0], law)
        let asked = asked + done[1]
        if verdict == 1 { let hit = hit + 1 }
        if verdict == 0 { let open = open + 1 }
        if verdict == 0 - 1 { let miss = miss + 1 }
      }
    }
  }
  let gap = transfer_range()
  let text = "the teacher is the filter\n"
  let slot = rt_sw_ssd_alloc(64)
  let other = rt_sw_ssd_alloc(8)
  do rt_sw_ssd_puts(slot, text)
  do rt_sw_ssd_puts(other, "x")
  let pg = rt_sw_pg()
  let got = rt_sw_ssd_gets(slot)
  let readp = rt_sw_pg() - pg
  print(hit + miss + open == 36)
  print(hit == 36)
  print(miss == 0)
  print(open == 0)
  print(asked == 27)
  print(len(gap[0]) == 0)
  print(readp == 1024)
  print(got == text)
  return 0
}
