import "tracestates.pi"

# Run native entry points from this checkout. Libraries have no main of their own.
skill chat_program_name(name) -> Any {
  if len(name) == 0 { return false }
  for ch in chars(name) {
    if not contains("abcdefghijklmnopqrstuvwxyz0123456789_",ch) { return false }
  }
  return true
}

skill chat_source(name) -> Any {
  if not chat_program_name(name) { return null }
  let path = "examples/native/" ++ name ++ ".pi"
  let src = read_file(path)
  if src == null { return null }
  for line in split(src,"\n") {
    if slice(line,0,11) == "skill main(" { return path }
  }
  return null
}

skill chat_programs() -> Any {
  let files = listdir("examples/native")
  if files == null { return "Start chat from the Pi checkout to discover its programs." }
  let names = []
  for file in files {
    if ends(file,".pi") {
      let name = slice(file,0,len(file)-3)
      let m = mark()
      let found = release(m,chat_source(name) != null)
      if found and name != "chat" { let names = append(names,name) }
    }
  }
  return "Run a program with 'run program NAME'. Separate arguments with |.\n" ++ join(sort(names),", ")
}

skill chat_exec(command, log) -> Any {
  let h = rt_spawn_out(command,log)
  if h == null { return [false,"Could not start the program."] }
  let rc = wait(h,1000)
  while rc == null { let rc = wait(h,1000) }
  let n = rt_file_size(log)
  let reply = read_at(log,0,min(n,65536))
  if reply == null { let reply = "" }
  if n > 65536 { let reply = reply ++ "\nOutput truncated at 65536 bytes." }
  if rc != 0 { return [false,"Program exited with " ++ str(rc) ++ ".\n" ++ reply] }
  return [true,trim(reply)]
}

skill chat_run(name,args) -> Any {
  if name == "chat" { return "You are already in chat." }
  let src = chat_source(name)
  if src == null { return "Unknown native program. Ask 'list programs' from the Pi checkout." }
  let suffix = if platform() == "windows" { ".exe" } else { "" }
  let base = "out/chat-worker-" ++ str(rt_chat_pid())
  let exe = base ++ suffix
  let log = base ++ ".log"
  let cmd = exe
  for a in args {
    # Both runtime command-line parsers accept a double-quoted argument.
    if contains(a,"\"") or ends(a,"\\") { return "An argument cannot contain a double quote or end in a backslash." }
    let cmd = cmd ++ " \"" ++ a ++ "\""
  }
  let compiler = "out/pic" ++ suffix
  if rt_file_size(compiler) == 0 { return "Build the native Pi compiler in out/ first." }
  do rt_chat_unlink(exe)
  let built = chat_exec(compiler ++ " " ++ src ++ " " ++ exe,log)
  let reply = "Compilation failed. " ++ built[1]
  if built[0] and rt_file_size(exe) > 0 { let reply = chat_exec(cmd,log)[1] }
  do rt_chat_unlink(exe)
  do rt_chat_unlink(log)
  return reply
}

skill chat_program_turn(line) -> Any {
  let text = lower(line)
  let language = chat_language(line)
  if language != null { return language }
  if text == "list programs" or text == "list programs." { return chat_programs() }
  if text == "read the screen" or text == "read the screen." { return chat_run("look",["screen"]) }
  if slice(text,0,12) != "run program " { return null }
  let parts = split(slice(line,12,len(line)),"|")
  let args = []
  for i in range(1,len(parts)) { let args = append(args,trim(parts[i])) }
  return chat_run(lower(trim(parts[0])),args)
}

# A research record carries its question, claim, source and evidence together.
# Bind a lookup to the system under study and the exact ordered event trace.
skill chat_research(st,line) -> Any {
  let text = lower(line)
  if slice(text,0,9) != "research " { return null }
  let q = trim(slice(line,9,len(line)))
  let subject = st["plan_subject"]
  let pending = st["plan_probe"]
  let shortcut = text == "research plan" or slice(text,0,18) == "research plan for "
  if shortcut {
    if pending == null { return ["There is no pending planning observation.",st,false] }
    if text != "research plan" {
      let name = trim(slice(line,18,len(line)))
      if subject != null and research_key(name) != research_key(subject) {
        return ["This plan is already researching " ++ subject ++ ".",st,false]
      }
      let subject = name
    }
    if subject == null or trim(subject) == "" { return ["Use research plan for SYSTEM to identify the system under study.",st,false] }
    let st = put(st,"plan_subject",subject)
  }
  let question = null
  if pending != null and subject != null {
    let experiment = if pending == "" { "before any events" } else { "after " ++ pending }
    let question = "For " ++ subject ++ ", starting from reset, what is the outcome " ++ experiment ++ "?"
    if shortcut { let q = question }
  }
  if question == null or research_key(q) != research_key(question) {
    let reply = chat_run("research",["--question",q])
    return [reply,put(st,"program_result",reply),false]
  }
  let record = research_recall(q)
  let reply = ""
  if record == null {
    let reply = chat_run("research",["--question",q])
    let record = research_recall(q)
  }
  if record != null {
    let reply = record[0] ++ "\n" ++ record[1] ++ "\nevidence: " ++ record[3] ++ "\nsource: " ++ record[2]
  }
  let next = put(st,"program_result",reply)
  if record == null or not contains(["0","1"],trim(record[1])) or trim(record[2]) == "" or trim(record[3]) == "" {
    return [reply ++ "\nThe plan still needs a sourced binary outcome.",next,false]
  }
  let plan = chat_plan(st,"outcome " ++ trim(record[1]))
  return [reply ++ "\n" ++ plan[0],put(plan[1],"program_result",reply),false]
}

# Learn phrases from demonstrations with Tongue, keeping corrections across sessions.
skill chat_language(line) -> Any {
  let text = lower(line)
  let teach = slice(text,0,15) == "teach language "
  if not teach and slice(text,0,10) != "interpret " { return null }
  let path = "out/chat_language.txt"
  if teach {
    let pair = split(slice(line,15,len(line))," => ")
    if len(pair) != 2 or trim(pair[0]) == "" or trim(pair[1]) == "" {
      return "Use teach language PHRASE => MEANING."
    }
    if not rt_append_file(path,join(pair," => ") ++ "\n") { return "Could not save the language example." }
    return "Learned the example."
  }
  let result = chat_meaning(slice(text,10,len(text)))
  if result == null { return "I need another language example to interpret that phrase." }
  return result
}

skill chat_meaning(text) -> Any {
  let history = read_file("out/chat_language.txt")
  if history == null or text == "" { return null }
  let vocabulary = {}
  let known = {}
  let phrases = []
  for record in split(history,"\n") {
    let pair = split(record," => ")
    if len(pair) == 2 {
      let phrase = join(split(lower(pair[0]))," ")
      for word in split(phrase) { let vocabulary = put(vocabulary,word,true) }
      if known[phrase] == null { let phrases = append(phrases,phrase) }
      let known = put(known,phrase,split(trim(pair[1])))
    }
  }
  let words = split(text)
  for word in words { if vocabulary[word] == null { return null } }
  let examples = []
  for phrase in phrases { let examples = append(examples,[split(phrase),known[phrase]]) }
  let rules = tg_learn(examples)
  let result = tg_understand(rules,tg_familiar(rules,examples),words)
  if result == null { return null }
  return join(result," ")
}

# Keep observations, goal and starting prefix together. Replies refer to the
# exact experiment requested, even across unrelated conversation turns.
skill chat_plan(st,line) -> Any {
  let text = lower(line)
  let probed = false
  let expected = null
  let witness = null
  let current = st["planning"]
  let pending = st["plan_probe"]
  if text == "cancel plan" {
    return ["Plan cleared.",put(put(put(st,"planning",null),"plan_probe",null),"neuron_expected",null),false]
  }
  let raw = null
  let goal = null
  let prefix = null
  if slice(text,0,10) == "plan goal " {
    let spec = slice(line,10,len(line))
    let fields = split(spec," | ")
    if len(fields) == 2 or len(fields) == 3 {
      let goal = hm_number(fields[0])
      let raw = read_file(fields[1])
      if raw == null { return ["Missing trace file.",st,false] }
      if len(fields) == 3 { let prefix = fields[2] }
      let current = null
    } else {
      let words = split(spec)
      let goal = hm_number(words[0])
      if len(words) == 1 and current != null {
        let raw = current[0]
        let prefix = current[2]
      } else {
        if len(words) < 4 or lower(words[1]) != "using" or lower(words[2]) != "events" {
          return ["Use plan goal 1 using events EVENT ... or plan goal 1 | observation file | optional event prefix.",st,false]
        }
        let raw = "events " ++ join(slice(words,3,len(words))," ")
        let current = null
      }
    }
    if goal != 0 and goal != 1 { return ["Give a binary goal (0 or 1).",st,false] }
  } else {
    let labelled = slice(text,0,8) == "outcome "
    if pending == null {
      if labelled { return ["There is no pending planning observation.",st,false] }
      return null
    }
    # A bare number may already answer Heed’s arithmetic clarification.
    if not labelled and (st["lesson_probe"] != null or not contains(["0","1"],text)) { return null }
    let bit = if labelled { trim(slice(text,8,len(text))) } else { text }
    if not contains(["0","1"],bit) { return ["Give outcome 0 or outcome 1.",st,false] }
    let probed = st["neuron_probed"]
    if st["neuron_expected"] != null {
      let st = neuron_observe(st,if bit == st["neuron_expected"] { 0 } else { 1 })
    }
    let raw = current[0] ++ "\n" ++ trim(bit ++ " " ++ pending)
    let goal = current[1]
    let prefix = current[2]
    if probed and bit == str(goal) {
      let steps = split(pending)
      let start = if prefix == null { [] } else { split(prefix) }
      if slice(steps,0,len(start)) == start {
        let witness = trim("plan " ++ join(slice(steps,len(start),len(steps))," "))
      }
    }
  }
  let answer = if witness == null { ts_observations(raw,prefix,null,goal) } else { witness }
  if answer == "Goal unreachable in learned model." and not probed and neuron_gate(st) {
    let check = ts_observations(raw,prefix,2,goal)
    if slice(check,0,8) == "observe " {
      let answer = check
      let predicted = ts_observations(raw,slice(check,8,len(check)),null,null)
      if slice(predicted,0,8) == "predict " { let expected = slice(predicted,8,len(predicted)) }
      let probed = true
    }
  }
  let probe = null
  if slice(answer,0,8) == "observe " {
    let probe = slice(answer,8,len(answer))
    let experiment = if probe == "" { "before any events" } else { "after " ++ probe }
    let answer = "Starting from reset, what is the outcome " ++ experiment ++ "? Reply outcome 0 or outcome 1."
  } else {
    if slice(answer,0,4) != "plan" and answer != "Goal unreachable in learned model." { return [answer,st,false] }
  }
  if current == null { let st = put(st,"plan_subject",null) }
  let updated = put(put(st,"planning",[raw,goal,prefix]),"plan_probe",probe)
  let updated = put(put(updated,"neuron_expected",expected),"neuron_probed",probed)
  return [answer,put(updated,"program_result",answer),false]
}

skill chat_repair(st,text) -> Any {
  if slice(text,0,12) != "repair task " { return null }
  let name = slice(text,12,len(text))
  if not hm_word(name) { return ["Give a task name using letters.",st,false] }
  let python = if platform() == "windows" { "python" } else { "python3" }
  let log = "out/chat-repair-" ++ str(rt_chat_pid()) ++ ".log"
  let tie = if neuron_gate(st) { "library" } else { "ordinary" }
  let result = chat_exec(python ++ " tools/chat_repair.py " ++ name ++ " " ++ tie,log)
  do rt_chat_unlink(log)
  if not result[0] { return [result[1],st,false] }
  let lines = split(result[1],"\n")
  if len(lines) < 2 or not contains(["0","1","none"],lines[0]) { return ["Incomplete repair result.",st,false] }
  if lines[0] != "none" { let st = neuron_observe(st,hm_number(lines[0])) }
  let reply = join(slice(lines,1,len(lines)),"\n")
  return [reply,put(st,"program_result",reply),false]
}
