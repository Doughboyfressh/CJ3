# grad: Pi learns on its own GPU. Float32 tensors that stay resident in GPU memory, a tape of the operations that made
# each one, and a backward pass that fills every tensor's gradient. With an Adam step, Pi can train a network it wrote
# itself, from scratch, on real data -- no outside model, no framework. This is the half the forward engine was missing.
#   G = g_open()                   load the kernels (once)
#   t = g_tensor(rows, cols)       a tensor of zeros; g_param(G, r, c) is a trainable one
#   g_matmul(G, x, w), g_dense(G, x, w, b, act, a), g_mse(G, pred, tgt)   forward, each recording how to go back
#   g_backward(G)                 fill every .grad
#   g_step(G, opt)                one Adam step; g_zero_grad(G) resets grads and the tape between steps
# A forward pass must be a tree (each tensor produced once) -- true for a feedforward net; branching would need grads
# to accumulate, which is a later addition.
import "shade.pi"

skill G_V() -> Any { return ".version 7.0\n.target sm_80\n.address_size 64\n" }

# C[M,N] = A[M,K] . B[K,N], one thread per output element
skill g_k_mm() -> Any {
  return ".visible .entry mm (.param .u64 pa, .param .u64 pb, .param .u64 pc, .param .u32 pM, .param .u32 pK, .param .u32 pN)
{
.reg .u32 %u<12>;
.reg .u64 %d<12>;
.reg .f32 %f<6>;
.reg .pred %p<4>;
ld.param.u32 %u0, [pM];
ld.param.u32 %u1, [pK];
ld.param.u32 %u2, [pN];
mov.u32 %u3, %ctaid.x;
mov.u32 %u4, %ntid.x;
mov.u32 %u5, %tid.x;
mad.lo.u32 %u3, %u3, %u4, %u5;
mul.lo.u32 %u6, %u0, %u2;
setp.ge.u32 %p0, %u3, %u6;
@%p0 exit;
div.u32 %u7, %u3, %u2;
rem.u32 %u8, %u3, %u2;
ld.param.u64 %d0, [pa];
ld.param.u64 %d1, [pb];
ld.param.u64 %d2, [pc];
mul.lo.u32 %u9, %u7, %u1;
mul.wide.u32 %d3, %u9, 4;
add.u64 %d3, %d0, %d3;
mul.wide.u32 %d4, %u8, 4;
add.u64 %d4, %d1, %d4;
mul.wide.u32 %d9, %u2, 4;
mov.f32 %f0, 0f00000000;
mov.u32 %u10, 0;
L1:
setp.ge.u32 %p1, %u10, %u1;
@%p1 bra E1;
ld.global.f32 %f1, [%d3];
ld.global.f32 %f2, [%d4];
fma.rn.f32 %f0, %f1, %f2, %f0;
add.u64 %d3, %d3, 4;
add.u64 %d4, %d4, %d9;
add.u32 %u10, %u10, 1;
bra L1;
E1:
mul.wide.u32 %d6, %u3, 4;
add.u64 %d6, %d2, %d6;
st.global.f32 [%d6], %f0;
exit;
}
"
}

# C[K,N] = A[M,K]^T . B[M,N]  (a weight's gradient: X^T . dZ)
skill g_k_atb() -> Any {
  return ".visible .entry mm_atb (.param .u64 pa, .param .u64 pb, .param .u64 pc, .param .u32 pM, .param .u32 pK, .param .u32 pN)
{
.reg .u32 %u<12>;
.reg .u64 %d<12>;
.reg .f32 %f<6>;
.reg .pred %p<4>;
ld.param.u32 %u0, [pM];
ld.param.u32 %u1, [pK];
ld.param.u32 %u2, [pN];
mov.u32 %u3, %ctaid.x;
mov.u32 %u4, %ntid.x;
mov.u32 %u5, %tid.x;
mad.lo.u32 %u3, %u3, %u4, %u5;
mul.lo.u32 %u6, %u1, %u2;
setp.ge.u32 %p0, %u3, %u6;
@%p0 exit;
div.u32 %u7, %u3, %u2;
rem.u32 %u8, %u3, %u2;
ld.param.u64 %d0, [pa];
ld.param.u64 %d1, [pb];
ld.param.u64 %d2, [pc];
mul.wide.u32 %d3, %u7, 4;
add.u64 %d3, %d0, %d3;
mul.wide.u32 %d4, %u8, 4;
add.u64 %d4, %d1, %d4;
mul.wide.u32 %d7, %u1, 4;
mul.wide.u32 %d8, %u2, 4;
mov.f32 %f0, 0f00000000;
mov.u32 %u10, 0;
L2:
setp.ge.u32 %p1, %u10, %u0;
@%p1 bra E2;
ld.global.f32 %f1, [%d3];
ld.global.f32 %f2, [%d4];
fma.rn.f32 %f0, %f1, %f2, %f0;
add.u64 %d3, %d3, %d7;
add.u64 %d4, %d4, %d8;
add.u32 %u10, %u10, 1;
bra L2;
E2:
mul.wide.u32 %d6, %u3, 4;
add.u64 %d6, %d2, %d6;
st.global.f32 [%d6], %f0;
exit;
}
"
}

# C[M,K] = A[M,N] . B[K,N]^T  (an input's gradient: dZ . W^T)
skill g_k_abt() -> Any {
  return ".visible .entry mm_abt (.param .u64 pa, .param .u64 pb, .param .u64 pc, .param .u32 pM, .param .u32 pK, .param .u32 pN)
{
.reg .u32 %u<14>;
.reg .u64 %d<12>;
.reg .f32 %f<6>;
.reg .pred %p<4>;
ld.param.u32 %u0, [pM];
ld.param.u32 %u1, [pK];
ld.param.u32 %u2, [pN];
mov.u32 %u3, %ctaid.x;
mov.u32 %u4, %ntid.x;
mov.u32 %u5, %tid.x;
mad.lo.u32 %u3, %u3, %u4, %u5;
mul.lo.u32 %u6, %u0, %u1;
setp.ge.u32 %p0, %u3, %u6;
@%p0 exit;
div.u32 %u7, %u3, %u1;
rem.u32 %u8, %u3, %u1;
ld.param.u64 %d0, [pa];
ld.param.u64 %d1, [pb];
ld.param.u64 %d2, [pc];
mul.lo.u32 %u9, %u7, %u2;
mul.wide.u32 %d3, %u9, 4;
add.u64 %d3, %d0, %d3;
mul.lo.u32 %u11, %u8, %u2;
mul.wide.u32 %d4, %u11, 4;
add.u64 %d4, %d1, %d4;
mov.f32 %f0, 0f00000000;
mov.u32 %u10, 0;
L3:
setp.ge.u32 %p1, %u10, %u2;
@%p1 bra E3;
ld.global.f32 %f1, [%d3];
ld.global.f32 %f2, [%d4];
fma.rn.f32 %f0, %f1, %f2, %f0;
add.u64 %d3, %d3, 4;
add.u64 %d4, %d4, 4;
add.u32 %u10, %u10, 1;
bra L3;
E3:
mul.wide.u32 %d6, %u3, 4;
add.u64 %d6, %d2, %d6;
st.global.f32 [%d6], %f0;
exit;
}
"
}

# Z[M,N] += b[N], broadcast over rows
skill g_k_addbias() -> Any {
  return ".visible .entry addbias (.param .u64 pz, .param .u64 pb, .param .u32 pM, .param .u32 pN)
{
.reg .u32 %u<10>;
.reg .u64 %d<8>;
.reg .f32 %f<4>;
.reg .pred %p<4>;
ld.param.u32 %u0, [pM];
ld.param.u32 %u1, [pN];
mov.u32 %u2, %ctaid.x;
mov.u32 %u3, %ntid.x;
mov.u32 %u4, %tid.x;
mad.lo.u32 %u2, %u2, %u3, %u4;
mul.lo.u32 %u5, %u0, %u1;
setp.ge.u32 %p0, %u2, %u5;
@%p0 exit;
rem.u32 %u6, %u2, %u1;
ld.param.u64 %d0, [pz];
ld.param.u64 %d1, [pb];
mul.wide.u32 %d2, %u2, 4;
add.u64 %d2, %d0, %d2;
mul.wide.u32 %d3, %u6, 4;
add.u64 %d3, %d1, %d3;
ld.global.f32 %f0, [%d2];
ld.global.f32 %f1, [%d3];
add.f32 %f0, %f0, %f1;
st.global.f32 [%d2], %f0;
exit;
}
"
}

# db[j] = sum over rows of dZ[,j]
skill g_k_biasgrad() -> Any {
  return ".visible .entry biasgrad (.param .u64 pdz, .param .u64 pdb, .param .u32 pM, .param .u32 pN)
{
.reg .u32 %u<10>;
.reg .u64 %d<8>;
.reg .f32 %f<4>;
.reg .pred %p<4>;
ld.param.u32 %u0, [pM];
ld.param.u32 %u1, [pN];
mov.u32 %u2, %ctaid.x;
mov.u32 %u3, %ntid.x;
mov.u32 %u4, %tid.x;
mad.lo.u32 %u2, %u2, %u3, %u4;
setp.ge.u32 %p0, %u2, %u1;
@%p0 exit;
ld.param.u64 %d0, [pdz];
ld.param.u64 %d1, [pdb];
mul.wide.u32 %d2, %u2, 4;
add.u64 %d2, %d0, %d2;
mul.wide.u32 %d4, %u1, 4;
mov.f32 %f0, 0f00000000;
mov.u32 %u5, 0;
LB:
setp.ge.u32 %p1, %u5, %u0;
@%p1 bra EB;
ld.global.f32 %f1, [%d2];
add.f32 %f0, %f0, %f1;
add.u64 %d2, %d2, %d4;
add.u32 %u5, %u5, 1;
bra LB;
EB:
mul.wide.u32 %d3, %u2, 4;
add.u64 %d3, %d1, %d3;
st.global.f32 [%d3], %f0;
exit;
}
"
}

# Y = act(a*X): mode 0 relu (a unused), mode 1 sin(a*X)
skill g_k_act() -> Any {
  return ".visible .entry act (.param .u64 px, .param .u64 py, .param .u32 pn, .param .u32 pmode, .param .f32 pa)
{
.reg .u32 %u<8>;
.reg .u64 %d<6>;
.reg .f32 %f<8>;
.reg .pred %p<4>;
ld.param.u32 %u0, [pn];
mov.u32 %u1, %ctaid.x;
mov.u32 %u2, %ntid.x;
mov.u32 %u3, %tid.x;
mad.lo.u32 %u1, %u1, %u2, %u3;
setp.ge.u32 %p0, %u1, %u0;
@%p0 exit;
ld.param.u32 %u4, [pmode];
ld.param.f32 %f5, [pa];
ld.param.u64 %d0, [px];
ld.param.u64 %d1, [py];
mul.wide.u32 %d2, %u1, 4;
add.u64 %d3, %d0, %d2;
add.u64 %d4, %d1, %d2;
ld.global.f32 %f0, [%d3];
setp.eq.u32 %p1, %u4, 0;
@!%p1 bra SIN;
max.f32 %f1, %f0, 0f00000000;
st.global.f32 [%d4], %f1;
exit;
SIN:
mul.f32 %f0, %f0, %f5;
mul.f32 %f6, %f0, 0f3E22F983;
cvt.rni.f32.f32 %f6, %f6;
mul.f32 %f7, %f6, 0f40C90FDB;
sub.f32 %f0, %f0, %f7;
sin.approx.f32 %f1, %f0;
st.global.f32 [%d4], %f1;
exit;
}
"
}

# dX = dY * act'(a*X)
skill g_k_actb() -> Any {
  return ".visible .entry actb (.param .u64 px, .param .u64 pdy, .param .u64 pdx, .param .u32 pn, .param .u32 pmode, .param .f32 pa)
{
.reg .u32 %u<8>;
.reg .u64 %d<8>;
.reg .f32 %f<8>;
.reg .pred %p<4>;
ld.param.u32 %u0, [pn];
mov.u32 %u1, %ctaid.x;
mov.u32 %u2, %ntid.x;
mov.u32 %u3, %tid.x;
mad.lo.u32 %u1, %u1, %u2, %u3;
setp.ge.u32 %p0, %u1, %u0;
@%p0 exit;
ld.param.u32 %u4, [pmode];
ld.param.f32 %f5, [pa];
ld.param.u64 %d0, [px];
ld.param.u64 %d1, [pdy];
ld.param.u64 %d2, [pdx];
mul.wide.u32 %d3, %u1, 4;
add.u64 %d4, %d0, %d3;
add.u64 %d5, %d1, %d3;
add.u64 %d6, %d2, %d3;
ld.global.f32 %f0, [%d4];
ld.global.f32 %f1, [%d5];
setp.eq.u32 %p1, %u4, 0;
@!%p1 bra SINB;
setp.gt.f32 %p2, %f0, 0f00000000;
selp.f32 %f2, %f1, 0f00000000, %p2;
st.global.f32 [%d6], %f2;
exit;
SINB:
mul.f32 %f0, %f0, %f5;
mul.f32 %f6, %f0, 0f3E22F983;
cvt.rni.f32.f32 %f6, %f6;
mul.f32 %f7, %f6, 0f40C90FDB;
sub.f32 %f0, %f0, %f7;
cos.approx.f32 %f2, %f0;
mul.f32 %f2, %f2, %f5;
mul.f32 %f2, %f2, %f1;
st.global.f32 [%d6], %f2;
exit;
}
"
}

# dpred = 2(pred - tgt)/P, and the sum of squared error atomically into loss[0]
skill g_k_mse() -> Any {
  return ".visible .entry mseg (.param .u64 pp, .param .u64 pt, .param .u64 pd, .param .u64 pl, .param .u32 pn)
{
.reg .u32 %u<8>;
.reg .u64 %d<8>;
.reg .f32 %f<8>;
.reg .pred %p<4>;
ld.param.u32 %u0, [pn];
mov.u32 %u1, %ctaid.x;
mov.u32 %u2, %ntid.x;
mov.u32 %u3, %tid.x;
mad.lo.u32 %u1, %u1, %u2, %u3;
setp.ge.u32 %p0, %u1, %u0;
@%p0 exit;
ld.param.u64 %d0, [pp];
ld.param.u64 %d1, [pt];
ld.param.u64 %d2, [pd];
ld.param.u64 %d3, [pl];
mul.wide.u32 %d4, %u1, 4;
add.u64 %d5, %d0, %d4;
add.u64 %d6, %d1, %d4;
add.u64 %d7, %d2, %d4;
ld.global.f32 %f0, [%d5];
ld.global.f32 %f1, [%d6];
sub.f32 %f2, %f0, %f1;
cvt.rn.f32.u32 %f3, %u0;
mul.f32 %f4, %f2, %f2;
div.rn.f32 %f4, %f4, %f3;
red.global.add.f32 [%d3], %f4;
add.f32 %f5, %f2, %f2;
div.rn.f32 %f5, %f5, %f3;
st.global.f32 [%d7], %f5;
exit;
}
"
}

# one Adam step over n parameters. mc = 1 - b1^t, vc = 1 - b2^t passed in.
skill g_k_adam() -> Any {
  return ".visible .entry adam (.param .u64 pp, .param .u64 pg, .param .u64 pm, .param .u64 pv, .param .u32 pn, .param .f32 plr, .param .f32 pb1, .param .f32 pb2, .param .f32 peps, .param .f32 pmc, .param .f32 pvc)
{
.reg .u32 %u<8>;
.reg .u64 %d<10>;
.reg .f32 %f<20>;
.reg .pred %p<4>;
ld.param.u32 %u0, [pn];
mov.u32 %u1, %ctaid.x;
mov.u32 %u2, %ntid.x;
mov.u32 %u3, %tid.x;
mad.lo.u32 %u1, %u1, %u2, %u3;
setp.ge.u32 %p0, %u1, %u0;
@%p0 exit;
ld.param.f32 %f10, [plr];
ld.param.f32 %f11, [pb1];
ld.param.f32 %f12, [pb2];
ld.param.f32 %f13, [peps];
ld.param.f32 %f14, [pmc];
ld.param.f32 %f15, [pvc];
ld.param.u64 %d0, [pp];
ld.param.u64 %d1, [pg];
ld.param.u64 %d2, [pm];
ld.param.u64 %d3, [pv];
mul.wide.u32 %d4, %u1, 4;
add.u64 %d5, %d0, %d4;
add.u64 %d6, %d1, %d4;
add.u64 %d7, %d2, %d4;
add.u64 %d8, %d3, %d4;
ld.global.f32 %f0, [%d5];
ld.global.f32 %f1, [%d6];
ld.global.f32 %f2, [%d7];
ld.global.f32 %f3, [%d8];
mov.f32 %f4, 0f3F800000;
sub.f32 %f5, %f4, %f11;
mul.f32 %f2, %f2, %f11;
fma.rn.f32 %f2, %f1, %f5, %f2;
sub.f32 %f6, %f4, %f12;
mul.f32 %f7, %f1, %f1;
mul.f32 %f3, %f3, %f12;
fma.rn.f32 %f3, %f7, %f6, %f3;
st.global.f32 [%d7], %f2;
st.global.f32 [%d8], %f3;
div.rn.f32 %f8, %f2, %f14;
div.rn.f32 %f9, %f3, %f15;
sqrt.rn.f32 %f9, %f9;
add.f32 %f9, %f9, %f13;
div.rn.f32 %f8, %f8, %f9;
mul.f32 %f8, %f8, %f10;
sub.f32 %f0, %f0, %f8;
st.global.f32 [%d5], %f0;
exit;
}
"
}


# ---- volume rendering: per-ray samples (density+colour) composited into a pixel; the heart of a neural field --------
# raw[(Nr*M) x 4]: for each sample, column 0 = density logit (density = relu), 1..3 = colour logits (sigmoid). The ray's
# M samples are consecutive. delta = sample spacing; bg = background brightness (white = 1). -> C[Nr x 3]. T[Nr*M] keeps
# each sample's transmittance for the backward pass.
skill g_k_vrfwd() -> Any {
  return ".visible .entry vrfwd (.param .u64 praw, .param .u64 pc, .param .u64 pt, .param .u32 pNr, .param .u32 pM, .param .u64 pdelta, .param .f32 pbg)
{
.reg .u32 %u<12>;
.reg .u64 %d<12>;
.reg .f32 %f<24>;
.reg .pred %p<4>;
ld.param.u32 %u0, [pNr];
ld.param.u32 %u1, [pM];
mov.u32 %u2, %ctaid.x;
mov.u32 %u3, %ntid.x;
mov.u32 %u4, %tid.x;
mad.lo.u32 %u2, %u2, %u3, %u4;
setp.ge.u32 %p0, %u2, %u0;
@%p0 exit;
ld.param.u64 %d6, [pdelta];
mul.wide.u32 %d7, %u2, 4;
add.u64 %d6, %d6, %d7;
ld.global.f32 %f0, [%d6];
ld.param.f32 %f1, [pbg];
ld.param.u64 %d0, [praw];
ld.param.u64 %d1, [pc];
ld.param.u64 %d2, [pt];
mul.lo.u32 %u5, %u2, %u1;
mul.wide.u32 %d3, %u5, 16;
add.u64 %d3, %d0, %d3;
mul.wide.u32 %d4, %u5, 4;
add.u64 %d4, %d2, %d4;
mov.f32 %f2, 0f3F800000;
mov.f32 %f3, 0f00000000;
mov.f32 %f4, 0f00000000;
mov.f32 %f5, 0f00000000;
mov.u32 %u6, 0;
LF:
setp.ge.u32 %p1, %u6, %u1;
@%p1 bra EF;
ld.global.f32 %f6, [%d3];
max.f32 %f7, %f6, 0f00000000;
mul.f32 %f8, %f7, %f0;
neg.f32 %f8, %f8;
mul.f32 %f8, %f8, 0f3FB8AA3B;
ex2.approx.f32 %f8, %f8;
mov.f32 %f9, 0f3F800000;
sub.f32 %f10, %f9, %f8;
ld.global.f32 %f11, [%d3+4];
neg.f32 %f14, %f11;
mul.f32 %f14, %f14, 0f3FB8AA3B;
ex2.approx.f32 %f14, %f14;
add.f32 %f14, %f14, 0f3F800000;
rcp.approx.f32 %f11, %f14;
ld.global.f32 %f12, [%d3+8];
neg.f32 %f14, %f12;
mul.f32 %f14, %f14, 0f3FB8AA3B;
ex2.approx.f32 %f14, %f14;
add.f32 %f14, %f14, 0f3F800000;
rcp.approx.f32 %f12, %f14;
ld.global.f32 %f13, [%d3+12];
neg.f32 %f14, %f13;
mul.f32 %f14, %f14, 0f3FB8AA3B;
ex2.approx.f32 %f14, %f14;
add.f32 %f14, %f14, 0f3F800000;
rcp.approx.f32 %f13, %f14;
mul.f32 %f15, %f2, %f10;
fma.rn.f32 %f3, %f15, %f11, %f3;
fma.rn.f32 %f4, %f15, %f12, %f4;
fma.rn.f32 %f5, %f15, %f13, %f5;
st.global.f32 [%d4], %f2;
sub.f32 %f2, %f2, %f15;
add.u64 %d3, %d3, 16;
add.u64 %d4, %d4, 4;
add.u32 %u6, %u6, 1;
bra LF;
EF:
fma.rn.f32 %f3, %f2, %f1, %f3;
fma.rn.f32 %f4, %f2, %f1, %f4;
fma.rn.f32 %f5, %f2, %f1, %f5;
mul.wide.u32 %d5, %u2, 12;
add.u64 %d5, %d1, %d5;
st.global.f32 [%d5], %f3;
st.global.f32 [%d5+4], %f4;
st.global.f32 [%d5+8], %f5;
exit;
}
"
}

skill g_k_vrbwd() -> Any {
  return ".visible .entry vrbwd (.param .u64 praw, .param .u64 pt, .param .u64 pdc, .param .u64 pdraw, .param .u32 pNr, .param .u32 pM, .param .u64 pdelta, .param .f32 pbg)
{
.reg .u32 %u<14>;
.reg .u64 %d<14>;
