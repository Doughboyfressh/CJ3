# Entries are [distinct increasing input, shape A, shape B, positive error bound].
# All values use integer units. Each law may have its own unknown offset and slope.
skill pl_abs(x) -> Any { return if x < 0 { 0 - x } else { x } }

skill pl_plan(rows) -> Any {
  let n = len(rows)
  if n < 3 { return [] }
  for i in range(0, n) {
    if len(rows[i]) != 4 { return [] }
    if rows[i][3] <= 0 { return [] }
    if i > 0 {
      if rows[i][0] <= rows[i - 1][0] { return [] }
    }
  }
  let best = []
  let best_gap = 0
  let best_noise = 1
  for i in range(0, n - 2) {
    for j in range(i + 1, n - 1) {
      for k in range(j + 1, n) {
        let a = rows[i]
        let b = rows[j]
        let c = rows[k]
        let left = c[0] - b[0]
        let right = b[0] - a[0]
        let span = left + right
        let gap = pl_abs(left * (a[1] - a[2]) - span * (b[1] - b[2]) + right * (c[1] - c[2]))
        let noise = left * a[3] + span * b[3] + right * c[3]
        if len(best) == 0 or gap * best_noise > best_gap * noise {
          best = [i, j, k]
          best_gap = gap
          best_noise = noise
        }
      }
    }
  }
  return [best, best_gap, best_noise, best_gap > 2 * best_noise]
}

skill main() -> Any {
  let rows = []
  for x in range(0, 9) { rows = append(rows, [x, 0, x * x, 1]) }
  let plan = pl_plan(rows)
  return "Probe indices, separation, single-law error radius, guaranteed: " ++ str(plan)
}
