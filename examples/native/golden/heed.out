PRACTICE -- each task solved by search, from examples:
  sum: sum(x)
  length: len(x)
  reverse: rev(x)
  sort: sort(x)
  double each: map(e -> (e + e), x)
  add one to each: map(e -> (e + 1), x)
  square each: map(e -> (e * e), x)
  keep positives: filter(e -> (0 < e), x)
  keep evens: filter(e -> (0 == (e % 2)), x)
  count positives: len(filter(e -> (0 < e), x))
  sum of squares: sum(map(e -> (e * e), x))
  largest: maxl(x)
  spread: (maxl(x) - minl(x))
  sort descending: rev(sort(x))
  sum of positives: sum(filter(e -> (0 < e), x))
  squares sorted: sort(map(e -> (e * e), x))
  two smallest: take(2, sort(x))
  count evens: len(filter(e -> (0 == (e % 2)), x))
  sum of evens: sum(filter(e -> (0 == (e % 2)), x))
  largest two, biggest first: take(2, rev(sort(x)))
  clamp negatives to zero: map(e -> if((e < 0), 0, e), x)
  product: fold((acc, e) -> (acc * e), 1, x)
  product of squares: fold((acc, e) -> (acc * e), 1, (x ++ x))
  reverse the word: rev(x)
  word length: len(x)
  first letter: head(x)
  uppercase: map(e -> (e + -32), x)
  mirror: (x ++ rev(x))
  next letter of each: map(e -> (e + 1), x)
  letters after m: filter(e -> (109 < e), x)
  first letter as capital: (-32 + head(x))
  uppercase, reversed: rev(map(e -> (e + -32), x))
  letters before n: filter(e -> (e < 110), x)
  flip upside down: gflipv(g)
  mirror left-right: gfliph(g)
  transpose: gtrans(g)
  height: gh(g)
  width: gw(g)
  rotate 180: gflipv(gfliph(g))
  rotate right: gfliph(gtrans(g))
  rotate left: gflipv(gtrans(g))
  recolour 1 to 5: gmap(e -> recolour(e, 1->5), g)
  recolour 1 to 5, then flip: gflipv(gmap(e -> recolour(e, 1->5), g))

