# Teaching a whole transformation. A grid meaning and a list meaning can share a name.
# A candidate is a Pi expression with a hole for the result of the preceding instruction.
skill ht_pool(domain) -> Any {
  let h = hd_hole()
  if domain == "order" {
    let sorted = O("sort", [h])
    return [h, O("rev", [h]), sorted, O("rev", [sorted])]
  }
  let horizontal = O("gfliph", [h])
  let vertical = O("gflipv", [h])
  let transpose = O("gtrans", [h])
  return [h, horizontal, vertical, O("gflipv", [horizontal]), transpose,
    O("gfliph", [transpose]), O("gflipv", [transpose]),
    O("gflipv", [O("gfliph", [transpose])]), O("++", [h, O("rev", [h])])]
}

skill ht_value(domain, text) -> Any {
  if text == null or text == "" { return null }
  if domain == "order" {
    let xs = hm_numbers(text)
    if xs == null or hm_csv(xs) != text { return null }
    return xs
  }
  let grid = []
  let width = 0
  for row in split(text, "/") {
    let xs = hm_numbers(row)
    if xs == null or hm_csv(xs) != row { return null }
    if width != 0 and len(xs) != width { return null }
    width = len(xs)
    grid = append(grid, xs)
  }
  if len(grid) == 0 or ht_format(domain, grid) != text { return null }
  return grid
}

skill ht_format(domain, value) -> Any {
  if domain == "order" { return hm_csv(value) }
  let rows = []
  for row in value { rows = append(rows, hm_csv(row)) }
  return join(rows, "/")
}

skill ht_name(phrase) -> Any {
  let words = hd_words(phrase)
  if len(words) == 0 { return null }
  for word in words { if not hm_word(word) { return null } }
  return join(words, " ")
}

skill ht_run(step, value) -> Any {
  return sev(hd_plug(step, V("x")), null, value, null, [])
}

skill ht_laws(domain, observations) -> Any {
  let laws = []
  let pool = ht_pool(domain)
  for step in pool {
    let fits = true
    for ex in observations { if ht_run(step, ex[1]) != ex[2] { fits = false } }
    if fits { laws = append(laws, step) }
  }
  if len(laws) > 0 { return laws }
  if domain == "grid" {
    let region = mark()
    laws = release(region,hc_laws(pool,observations))
    if len(laws) > 0 { return laws }
  }
  # The familiar operations failed. Ask the existing typed program synthesizer for a
  # proposal. Its first fit is provisional and must still explain every demonstration.
  let m = mark()
  let examples = []
  for ex in observations { examples = append(examples,[ex[1],ex[2]]) }
  let result = solve(examples, [], [], [], pools(), prelude(), 5, 1800)
  if result[0] != null {
    let step = hd_holed(result[0])
    let fits = true
    for ex in examples { if ht_run(step,ex[0]) != ex[1] { fits = false } }
    if fits { laws = [step] }
  }
  return release(m,laws)
}

# Generate one labeling per pattern of equal cells. All nine grid hypotheses commute
# with renaming cell values, so a second permutation of the palette gives the same split.
skill ht_grid_probes() -> Any {
  let probes = []
  let patterns = [[[1],1]]
  for area in range(1,5) {
    for colors in range(1,area+1) {
      for height in range(1,area+1) {
        if area % height == 0 {
          let width = area // height
          for pattern in patterns {
            if pattern[1] == colors {
              let grid = []
              for y in range(0,height) { grid = append(grid,slice(pattern[0],y*width,(y+1)*width)) }
              probes = append(probes,grid)
            }
          }
        }
      }
    }
    if area < 4 {
      let next = []
      for pattern in patterns {
        for label in range(1,pattern[1]+2) {
          next = append(next,[append(pattern[0],label),max(pattern[1],label)])
        }
      }
      patterns = next
    }
  }
  return probes
}

# Minimize the largest surviving group, then display area, then distinct labels.
skill ht_question(domain, name, laws, observations) -> Any {
  if len(laws) == 0 { return "Bounded search found no " ++ domain ++ " transformation for these demonstrations." }
  if len(laws) == 1 {
    if not contains(ht_pool(domain),laws[0]) { return "Provisional program for " ++ name ++ ": " ++ show(laws[0]) ++ "." }
    return "Learned " ++ name ++ " as " ++ show(laws[0]) ++ "."
  }
  if domain == "grid" and laws[0][1] == "iteG" {
    let probe = hc_question(laws,observations)
    if probe == null { return "Supply a different demonstration for " ++ name ++ "." }
    return "Show " ++ name ++ " on " ++ ht_format(domain,probe) ++ "."
  }
  let probes = [[1], [1,2], [2,1], [2,1,3]]
  if domain == "grid" { probes = ht_grid_probes() }
  let worst = len(laws)
  let best = null
  for input in probes {
    let groups = {}
    let largest = 0
    for law in laws {
      let output = ht_format(domain, ht_run(law, input))
      let count = 1 + get(groups, output, 0)
      groups = put(groups, output, count)
      largest = max(largest, count)
    }
    if largest < worst { best = input; worst = largest }
    if worst == 1 { return "Show " ++ name ++ " on " ++ ht_format(domain, best) ++ "." }
  }
  if best == null { return "Supply a different demonstration for " ++ name ++ "." }
  return "Show " ++ name ++ " on " ++ ht_format(domain, best) ++ "."
}

# A complete clause can be replaced by its demonstrated meaning. A private terminal prevents
# a longer memorized rule from silently using an old reading of that clause. Other clauses
# still go through the regular chart parser (including learned rules such as "$1 , then flip").
skill ht_read(domain, phrase, readings, rules, steps, book) -> Any {
  if contains(phrase,"#") { return [null,"cannot read"] }
  let tokens = []
  let used = false
  let clauses = split(lower(phrase), ",")
  for i in range(0,len(clauses)) {
    let words = hd_words(clauses[i])
    if len(words) == 0 { return [null,"cannot read"] }
    if i > 0 {
      tokens = append(tokens, ",")
      if words[0] == "then" {
        tokens = append(tokens, "then")
        words = slice(words,1,len(words))
        if len(words) == 0 { return [null,"cannot read"] }
      }
    }
    let name = join(words, " ")
    let key = domain ++ ":" ++ name
    let laws = readings[key]
    if book != null {
      if book[key] != null { laws = ht_laws(domain,book[key]) }
      if laws == null and ht_name(name) != null { laws = ht_pool(domain) }
    }
    if laws == null { tokens = tokens ++ words } else {
      if len(laws) != 1 {
        let evidence = if book == null { get(readings,"#book",{}) } else { book }
        return [null,ht_question(domain,name,laws,get(evidence,key,[]))]
      }
      let marker = "#" ++ str(i)
      let token = hd_token(laws[0])
      rules = [[[marker],[token]]] ++ rules
      steps = put(steps, token, laws[0])
      tokens = append(tokens, marker)
      used = true
    }
  }
  if not used { return null }
  let sequence = [[["$1",",","then","$2"],["$2","$1"]], [["$1",",","$2"],["$2","$1"]]]
  let meaning = tg_understand(sequence ++ rules, null, tokens)
  if meaning == null { return [null,"cannot read"] }
  let input = if domain == "grid" { V("g") } else { V("x") }
  return [hd_program(meaning, steps, input), "read"]
}

# Detect a conflict from actual practice names and programs, before evaluating final instructions.
# For example, a text word and a longer grid instruction can share the same first word.
skill ht_conflicts(readings, practice) -> Any {
  let pool = ht_pool("grid")
  for a in practice {
    if a[0] != "grids" and len(a[1]) == 1 and contains(pool,a[2]) {
      for b in practice {
        if b[0] == "grids" and b[1][0] == a[1][0] and a[2] != b[2] and contains(pool,b[2]) {
          let key = "grid:" ++ a[1][0]
          if readings[key] == null { readings = put(readings,key,pool) }
        }
      }
    }
  }
  return readings
}

skill ht_command(domain, path, command, phrase, raw, reply) -> Any {
  let usage = "Usage: heed " ++ domain ++ " FILE ask NAME | teach NAME INPUT OUTPUT | use INSTRUCTION INPUT"
  if path == null or phrase == null or arg(7) != null { return usage }
  let name = ht_name(phrase)
  let input = ht_value(domain, raw)
  let key = domain ++ ":" ++ if name == null { "" } else { name }
  let book = hm_load(path)
  if book == null { return "Unreadable or incomplete lesson file." }
  if command == "teach" {
    let output = ht_value(domain, reply)
    if name == null or input == null or output == null { return usage }
    let label = join(split(name," "), "_")
    let line = "heed2 " ++ label ++ " " ++ domain ++ " " ++ raw ++ " " ++ reply ++ "\n"
    if not rt_append_file(path,line) { return "Could not save the observation." }
    book = hm_load(path)
    if book == null { return "Could not read the saved observation." }
  } else {
    if command == "ask" {
      if name == null or raw != null or reply != null { return usage }
    } else {
      if command != "use" or input == null or reply != null { return usage }
    }
  }
  if command != "use" {
    let observations = get(book,key,[])
    return ht_question(domain,name,ht_laws(domain,observations),observations)
  }
  let readings = {}
  let ops = if domain == "grid" { {"flip":"gflipv","transpose":"gtrans"} } else { {"reverse":"rev","sort":"sort"} }
  for op in keys(ops) { readings = put(readings,domain ++ ":" ++ op,[O(ops[op],[hd_hole()])]) }
  let reading = ht_read(domain,phrase,readings,[],{},book)
  if reading == null { return "cannot read" }
  if reading[0] == null { return reading[1] }
  return str(sev(reading[0],null,input,null,[]))
}
