import "chatneuron.pi"
import "curvenet.pi"
import "researchmemory.pi"
import "heedlessons.pi"
import "english.pi"
import "chatprograms.pi"
import "notes.pi"

# Read a list-word statement or question, leaving unrelated English to the fact engine.
skill chat_lesson(text) -> Any {
  let command = "teach"
  for prefix in ["what is ", "what's ", "what’s "] {
    if slice(text,0,len(prefix)) == prefix {
      let text = slice(text,len(prefix),len(text))
      let command = "use"
      break
    }
  }
  if slice(text,0,4) == "the " { let text = slice(text,4,len(text)) }
  let parts = split(text," for ")
  if len(parts) != 2 { let parts = split(text," on ") }
  if len(parts) != 2 { return null }
  let ws = hm_phrase(parts[0])
  if ws == null { return null }
  let list = parts[1]
  let answer = null
  if command == "teach" {
    let sides = split(list," is ")
    if len(sides) != 2 or hm_number(sides[1]) == null { return null }
    let list = sides[0]
    let answer = sides[1]
  }
  let list = join(split(list,", and "),",")
  let list = join(split(list," and "),",")
  let xs = []
  for item in split(list,",") {
    let n = hm_number(trim(item))
    if n == null { return null }
    let xs = append(xs,n)
  }
  if len(xs) == 0 { return null }
  return [command,ws,xs,answer]
}

# Each complete journal record supersedes the previous one. Delimit both ends
# so a partial append cannot erase the last complete question.
skill chat_save_probe(probe) -> Any {
  let record = "clear"
  if probe != null {
    let record = hm_prompt(probe[0][1],[probe[0][0],probe[1]])
    if probe[2] != null {
      let target = probe[2]
      let record = record ++ "|" ++ hm_prompt(target[1][1],[target[1][0],target[2]])
    }
  }
  return rt_append_file("out/chat_questions.txt","\n" ++ record ++ "!\n")
}

skill chat_saved_probe() -> Any {
  let data = read_file("out/chat_questions.txt")
  if data == null { return null }
  for line in reverse(split(data,"\n")) {
    if line == "clear!" { return null }
    if ends(line,"?!") {
      let parts = split(slice(line,0,len(line)-1),"|")
      if len(parts) <= 2 {
        let questions = []
        for part in parts {
          let q = chat_lesson(lower(slice(part,0,len(part)-1)))
          if ends(part,"?") and q != null and q[0] == "use" { let questions = append(questions,q) }
        }
        if len(questions) == len(parts) {
          let q = questions[0]
          let target = if len(parts) == 2 { questions[1] } else { null }
          return [q[1],q[2],target]
        }
      }
    }
  }
  return null
}

skill chat_handle(st,line) -> Any {
  let text = lower(trim(line))
  if ends(text,".") or ends(text,"?") { let text = trim(slice(text,0,len(text)-1)) }
  if text == "what do you need" {
    let questions = []
    let lesson = st["lesson_probe"]
    if lesson != null { let questions = append(questions,hm_prompt(lesson[0][1],[lesson[0][0],lesson[1]])) }
    let goal = st["goal_request"]
    if goal != null { let questions = append(questions,goal["question"]) }
    if len(questions) == 0 { return ["There is no pending goal observation.",st,false] }
    return [join(questions,"\n"),st,false]
  }
  let why_number = text == "how did you get that number"
  let why_either = contains(["why","why will that work","why does that work","how did you get that"],text)
  if why_number or why_either {
    if st["number_reason"] != null { return [st["number_reason"],st,false] }
    if why_number { return ["Which calculation do you mean?",st,false] }
    if st["planning"] != null { return [chat_plan_reason(st),st,false] }
  }
  if text != "" { let st = put(st,"number_reason",null) }
  let request = chat_lesson(text)
  for prefix in ["no, it should be ", "it should be ", "the correct answer is "] {
    if slice(text,0,len(prefix)) != prefix { continue }
    let prediction = st["last_prediction"]
    if prediction == null { return ["Which result? Give the word, inputs, and corrected answer.",st,false] }
    let answer = trim(slice(text,len(prefix),len(text)))
    if hm_number(answer) == null { return ["Give a whole-number correction.",st,false] }
    let request = ["teach",prediction[0],prediction[1],answer]
    break
  }
  if text != "" { let st = put(st,"last_prediction",null) }
  let st = neuron_start(st)
  if text == "neuron status" {
    let slot = st["neuron_slot"]
    if slot < 0 { return ["Shared unit unavailable: Softwell SSD is full.",st,false] }
    let value = int(rt_sw_ssd_real(slot,0))
    let note = if st["neuron_unsaved"] { " Some feedback is session-only." } else { "" }
    return ["Shared surprise estimate: " ++ str(value) ++ "/1024." ++ note,st,false]
  }
  let repair = chat_repair(st,text)
  if repair != null { return repair }
  let curve = chat_curve(st,text)
  if curve != null { return curve }
  if text == "what can you do" {
    return ["Teach me facts, list or grid operations, language examples, or numeric curves. Ask me to remember or recall a note, research a question, read the screen, plan a goal from observations, or compare repairs with repair task NAME. Ask 'list programs' for native programs.",st,false]
  }
  if text == "remember that result" {
    if st["program_result"] == null { return ["Run a program or ask for a result first.",st,false] }
    return [note_command(true,st["program_result"]),st,false]
  }
  let notebook = chat_note(trim(line))
  if notebook != null { return [notebook,st,false] }
  let plan = chat_goal_turn(st,trim(line))
  if plan != null { return plan }
  let finding = chat_research(st,trim(line))
  if finding != null { return finding }
  let program = chat_program_turn(trim(line))
  if program != null { return [program,put(st,"program_result",program),false] }
  let transform = chat_transform(st,text)
  if transform != null { return transform }
  let pending = st["lesson_probe"]
  if pending != null and text == "cancel" {
    if not chat_save_probe(null) { return ["Could not save the cancellation.",st,false] }
    return ["Question cancelled.",put(st,"lesson_probe",null),false]
  }
  let target = null
  if pending != null and hm_number(text) != null {
    let request = ["teach",pending[0],pending[1],text]
    let target = pending[2]
  }
  if request == null {
    let fact = handle(st,line)
    let reply = fact[0]
    if reply != "I don't understand that yet." and reply != "Not as far as I know." and slice(reply,0,12) != "I don't know" { return fact }
    let grounded = chat_grounded(st,text,line)
    return if grounded == null { fact } else { grounded }
  }
  let ws = request[1]
  let xs = request[2]
  let command = request[0]
  let r = hm_turn("out/chat_lessons.txt",request[0],ws,join(ws," of "),xs,request[3])
  if target != null and (r[1] != null or r[2] != null) {
    let command = "use"
    let ws = target[1]
    let xs = target[2]
    let r = hm_turn("out/chat_lessons.txt","use",ws,join(ws," of "),xs,null)
  }
  if request[0] == "use" { let target = request }
  let next = null
  if r[1] != null { let next = [[r[1][0],ws[1]],r[1][1],target] }
  if pending != next {
    if not chat_save_probe(next) { return ["Could not save the clarification state. Please retry.",st,false] }
  }
  let reply = r[0]
  if command == "use" and r[2] != null {
    let law = r[2]
    let reason = ""
    if law[1] {
      let values = sev(O("map",[law[0],V("x")]),null,xs,null,[])
      let reason = "The learned rule " ++ show(law[0]) ++ " maps " ++ hm_csv(xs) ++ " to " ++ hm_csv(values) ++ ". Their " ++ ws[0] ++ " is " ++ r[0] ++ "."
      let reply = reply ++ ". I applied " ++ show(law[0]) ++ " to each input, then took the " ++ ws[0] ++ " of " ++ hm_csv(values) ++ "."
    } else {
      let reply = reply ++ ". I took the " ++ ws[0] ++ " first, then applied " ++ show(law[0]) ++ "."
    }
    let st = put(st,"number_reason",reason)
  }
  let last = null
  if command == "use" and hm_number(r[0]) != null { let last = [ws,xs] }
  let st = put(st,"last_prediction",last)
  return [reply,put(st,"lesson_probe",next),false]
}

# Keep the input and the successful instruction together for the next turn.
# Heed owns the observations, program selection, and evaluation for both interfaces.
skill chat_transform(st,text) -> Any {
  let path = "out/chat_lessons.txt"
  let domain = "order"
  for kind in ["list","grid"] {
    let lesson = split(text," maps " ++ kind ++ " ")
    if len(lesson) == 2 {
      let pair = split(lesson[1]," to ")
      if len(pair) != 2 { return ["Give the input and output separated by 'to'.",st,false] }
      if kind == "grid" { let domain = "grid" }
      return [ht_command(domain,path,"teach",lesson[0],pair[0],pair[1]),st,false]
    }
  }
  return chat_apply(st,text)
}

skill chat_apply(st,text) -> Any {
  let path = "out/chat_lessons.txt"
  let domain = "order"
  let steps = []
  let raw = null
  if text == "reverse the order" {
    let last = st["transform_request"]
    if last == null { return ["Apply a sequence to a list or grid first.",st,false] }
    let domain = last[0]
    let steps = reverse(last[1])
    let raw = last[2]
  } else {
    if slice(text,0,6) != "apply " { return null }
    let parts = split(slice(text,6,len(text))," to ")
    if len(parts) < 2 { return null }
    let raw = parts[len(parts)-1]
    if slice(raw,0,5) == "grid " {
      let domain = "grid"
      let raw = slice(raw,5,len(raw))
    } else {
      if slice(raw,0,5) == "list " { let raw = slice(raw,5,len(raw)) } else {
        if contains(raw,"/") { let domain = "grid" }
        if ht_value(domain,raw) == null { return null }
      }
    }
    let names = join(slice(parts,0,len(parts)-1)," to ")
    let phrase = join(split(names,", then ")," then ")
    let steps = split(phrase," then ")
  }
  for step in steps {
    if ht_name(step) == null { return ["Give a name for each operation.",st,false] }
  }
  if ht_value(domain,raw) == null {
    if domain == "grid" { return ["Give a rectangular grid, for example 1,2/3,4.",st,false] }
    return ["Give a list of integers, for example 4,9,1.",st,false]
  }
  let result = ht_command(domain,path,"use",join(steps,", then "),raw,null)
  if slice(result,0,1) == "[" { let st = put(st,"transform_request",[domain,steps,raw]) }
  return [result,st,false]
}

# An interpretation can name a Heed operation. Only transformations with an
# actual numeric input enter that evaluator; learned text stays data elsewhere.
skill chat_grounded(st,text,line) -> Any {
  let parts = split(text," on ")
  if len(parts) > 1 {
    let raw = parts[len(parts)-1]
    let domain = if contains(raw,"/") { "grid" } else { "order" }
    if ht_value(domain,raw) != null {
      let phrase = join(slice(parts,0,len(parts)-1)," on ")
      let names = chat_meaning(phrase)
      let taught = names != null
      if names == null { let names = phrase }
      let action = chat_apply(st,"apply " ++ lower(names) ++ " to " ++ raw)
      if action != null {
        if slice(action[0],0,1) == "[" { return [action[0],put(action[1],"program_result",action[0]),false] }
        let book = hm_load("out/chat_lessons.txt")
        if taught or (book != null and book[domain ++ ":" ++ phrase] != null) { return action }
      }
    }
  }
  let meaning = chat_meaning(text)
  if meaning != null { return [meaning,put(st,"program_result",meaning),false] }
  let words = split(text)
  if len(words) == 0 { return null }
  if not ends(trim(line),"?") and not contains(["who","what","when","where","which","how","why"],words[0]) { return null }
  let item = research_recall(text)
  if item != null {
    let reply = item[1] ++ "\nevidence: " ++ item[3] ++ "\nsource: " ++ item[2]
    return [reply,put(st,"program_result",reply),false]
  }
  let notes = mem_find(text,3)
  if len(notes) == 0 { return null }
  let reply = "Related notebook entries:\n" ++ join(notes,"\n")
  return [reply,put(st,"program_result",reply),false]
}
