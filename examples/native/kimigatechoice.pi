# Winner among the five saved gate rows on an integer mixture of token embeddings.
skill main() -> Any {
  if arg(2) == null { return "Usage: kimigatechoice WORD WEIGHT [WORD WEIGHT ...]" }
  let data = read_file("examples/native/kimi_gate_projection.txt")
  if data == null { return "Missing gate projection." }
  let rows = {}
  for line in split(trim(data),"\n") {
    let cells = split(line," ")
    if len(cells) != 5 { return "Invalid projection." }
    let rows = put(rows,cells[0],cells)
  }
  let scores = arr(5)
  let budget = 0
  let i = 1
  while arg(i) != null {
    let row = rows[arg(i)]
    if row == null { return "Unknown token: " ++ arg(i) }
    let s = arg(i+1)
    if s == null or len(s) == 0 or len(s) > 7 { return "Invalid weight." }
    let start = if slice(s,0,1) == "-" { 1 } else { 0 }
    if start == len(s) { return "Invalid weight." }
    for c in chars(slice(s,start,len(s))) {
      if not contains("0123456789",c) { return "Invalid weight." }
    }
    let w = int(s)
    let budget = budget + abs(w)
    if budget > 1000000 { return "Total absolute weight exceeds 1000000." }
    for k in range(1,5) { do aset(scores,k,aget(scores,k)+w*int(row[k])) }
    let i = i+2
  }
  let best = 0
  for k in range(1,5) { if aget(scores,k) > aget(scores,best) { let best = k } }
  for k in range(0,5) {
    if k != best and aget(scores,best)-aget(scores,k) <= budget { return "uncertain" }
  }
  return best
}
