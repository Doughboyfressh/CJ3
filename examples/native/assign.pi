# assign: name = value and name += / -= / *= value rebind a name (the same as let name = value), so code written the
# way most languages write it compiles. The 8-queens program is the brain's own first attempt, unchanged (92).
skill contains(xs, v) -> Any {
  let found = false
  for x in xs {
    if x == v { found = true }
  }
  return found
}

skill solve(n, row, cols, d1, d2) -> Any {
  if row == n { return 1 }
  let total = 0
  for c in range(0, n) {
    if not contains(cols, c) and not contains(d1, row + c) and not contains(d2, row - c + n) {
      total = total + solve(n, row + 1, append(cols, c), append(d1, row + c), append(d2, row - c + n))
    }
  }
  return total
}

# other languages' forms: a typed return, a tuple (a list), destructuring, if-expressions
skill divmod2(a, b) -> (int, int) {
  return (a // b, a % b)
}

skill grade(n) -> str {
  return if n >= 90 { "A" } else if n >= 80 { "B" } else { "C" }
}

skill sign(x) -> Any {
  if x > 0 { return "plus" } else if x < 0 { return "minus" } else { return "zero" }
}

skill main() -> Any {
  let x = 5
  x = x * 2
  x += 7
  x -= 2
  x *= 3
  let s = "a"
  s = s ++ "b"
  let k = 0
  while k < 4 { k += 1 }
  do print(str(x) ++ " " ++ s ++ " " ++ str(k) ++ " " ++ sign(3) ++ " " ++ sign(0 - 2) ++ " " ++ sign(0))
  // a comment the way C writes it, and loop headers in parentheses
  let t = 0
  for (v in [1, 2, 3]) { t += v }
  for (i in range(0, 3)) { t += i }
  do print("loops " ++ str(t) ++ " floor " ++ str(17 // 5))
  let xs = [1, 2, 3]
  let ys = xs
  xs[1] = 20
  xs[0 - 1] = 30
  let m = {"a": 1}
  m["b"] = 2
  m["a"] = 5
  do print(str(xs) ++ " " ++ str(ys) ++ " " ++ str(m["a"]) ++ " " ++ str(m["b"]))
  // ++= on lists and text; a mod b as an operator while mod is also a name; a UTF-8 literal (len counts bytes)
  let out = []
  for c in chars("abc") { out ++= [c] }
  let w = "x"
  w ++= "yz"
  let mod = 7
  let h = 100 mod mod
  mod = mod + 1
  do print(str(out) ++ " " ++ w ++ " " ++ str(h) ++ " " ++ str(mod) ++ " " ++ str(17 mod 5) ++ " æ→ " ++ str(len("æ→")))
  let (q, r) = divmod2(47, 5)
  let [p1, p2] = [7, 8]
  let big = if q > 5 { "big" } else { "small" }
  let tag = "none"
  tag = if r == 2 { "two" } else { "other" }
  do print(str(q) ++ " " ++ str(r) ++ " " ++ str(p1 + p2) ++ " " ++ big ++ " " ++ tag ++ " " ++ grade(95) ++ grade(85) ++ grade(10) ++ " " ++ str((1, 2, 3)))
  do print(format("{:.2f} {:.0f} {:?} {} {:.3f}", 3.14159, 2.5, [1], 7, 0.0 - 1.0005))
  // if-expressions anywhere; break / continue; a whole real as an index
  let cells = []
  for k2 in range(0, 6) { cells = append(cells, if k2 % 3 == 0 { 1 } else { 0 }) }
  let me = 1
  let walls = 6
  let nv = if me == 1 { if walls >= 5 { "wall" } else { "floor" } } else { "?" }
  let row = ""
  for c2 in cells { row = row ++ (if c2 == 1 { "#" } else { "." }) }
  let i2 = 0
  while true {
    if i2 * i2 > 50 { break }
    i2 += 1
  }
  let found = 0 - 1
  for j2 in range(0, 100) {
    if j2 * 7 % 13 == 5 {
      found = j2
      break
    }
  }
  let odd = 0
  for v2 in [1, 2, 3, 4, 5, 6, 7] {
    if v2 % 2 == 0 { continue }
    odd += v2
  }
  let pairs = 0
  for a2 in range(0, 4) {
    for b2 in range(0, 4) {
      if b2 > a2 { break }
      pairs += 1
    }
  }
  let kept = 0
  for z2 in range(0, 10) {
    if z2 == 3 { break }
    kept = z2
  }
  print("a call on its own needs no do")
  let grid = [[0, 0, 0], [0, 0, 0]]
  grid[1][2] = 7
  grid[0][1] += 5
  let counts = {"a": 1}
  counts["a"] += 2
  let words = ["x"]
  words[0] ++= "yz"
  print(str(grid) ++ " " ++ str(counts["a"]) ++ " " ++ words[0])
  do print(str(cells) ++ " " ++ nv ++ " " ++ row ++ " " ++ str(i2) ++ " " ++ str(found) ++ " " ++ str(odd) ++ " " ++ str(pairs) ++ " " ++ str(kept) ++ " " ++ str(cells[6 / 2]))
  return solve(8, 0, [], [], [])
}
