# heed: Pi does what it is told, in English.
#
# Pi's mind (mindcore.pi) finds programs from examples: shown what "sum of squares" does to a few lists, it searches
# out sum(map(e -> e * e, x)). Every task it practises comes with a name. tonguelib.pi learns a language from pairs of
# utterance and meaning. Put together: the names are the utterances, the programs Pi found are the meanings, and
# what comes out is English that Pi can act on -- an instruction it was never given, read as a program and run.
#
# A meaning here is a chain of steps, outermost first: "sum of squares" is [sum(_)] [map(e -> e * e, _)], the _ being
# where the next step (and at last the input) goes. A program whose steps are not a chain (the input used twice,
# as in maxl(x) - minl(x)) is one step, whole. A word's meaning is then a piece of a chain, and to put words
# together is to join their pieces -- which is all tonguelib knows how to do.
#
#   1. Pi practises: each named task solved by search, from examples (no words of its own yet, and no language).
#   2. It learns English for what it found: the rules tonguelib makes from (name, chain) pairs.
#   3. TOLD ONLY: instructions never practised, with no examples at all. Pi reads each as a program; the program is
#      run on inputs and compared with what the instruction's author meant. For each one it gets right, the same
#      task is also given to the search with examples and no words, to see whether the words reached further.
#   4. SHOWN ONCE: where the words fail it (a word it has never met), Pi is shown examples, finds the program by
#      search as it always could -- and now learns the new word from that single sentence.
#   5. TOLD AGAIN: new instructions built from the words it has just learned, again with no examples.
import "mindcore.pi"
import "doorworld.pi"
import "doorexplore.pi"
import "tonguelib.pi"
import "scopelearn.pi"
import "heedmemory.pi"

# an instruction's words: lower case, a comma a word of its own
skill hd_words(text) -> Any { return split(join(split(lower(text), ","), " , ")) }

# does t use the input (outside an element function)?
skill hd_uses(t) -> Any {
  if t[0] == "v" { return isinput(t[1]) }
  if t[0] == "q" or t[0] == "p" { return false }
  for i in range(0, len(t[2])) {
    if is_fp(t, i) == false {
      if hd_uses(t[2][i]) { return true }
    }
  }
  return false
}

# the hole in a step lives in heedmemory.pi

# a program as a chain of steps, outermost first; each step a tree with a hole where the rest goes
skill hd_chain(t) -> Any {
  let out = []
  let cur = t
  let going = true
  while going {
    if cur[0] == "v" { let going = false } else {
      let which = 0 - 1
      let count = 0
      if cur[0] == "op" or cur[0] == "w" {
        for i in range(0, len(cur[2])) {
          if is_fp(cur, i) == false {
            if hd_uses(cur[2][i]) {
              let which = i
              let count = count + 1
            }
          }
        }
      }
      if count == 1 {
        let args = []
        for i in range(0, len(cur[2])) {
          if i == which { let args = append(args, hd_hole()) } else { let args = append(args, cur[2][i]) }
        }
        let out = append(out, [cur[0], cur[1], args])
        let cur = cur[2][which]
      } else {
        # the input used twice, or not at all: what is left is one step, the input its hole
        let out = append(out, hd_holed(cur))
        let going = false
      }
    }
  }
  return out
}

# a step as one word of meaning, written as Pi writes programs, with _ for the hole
skill hd_token(step) -> Any { return "[" ++ show(step) ++ "]" }

# the chain as words of meaning; steps: every step met so far, by its word -> [words, steps]
skill hd_meaning(t, steps) -> Any {
  let toks = []
  for st in hd_chain(t) {
    let k = hd_token(st)
    let toks = append(toks, k)
    let steps = put(steps, k, st)
  }
  return [toks, steps]
}

# words of meaning back into a program: each step's hole takes what follows, the last takes the input
skill hd_program(toks, steps, xin) -> Any {
  let cur = xin
  let i = len(toks) - 1
  while i >= 0 {
    let st = steps[toks[i]]
    if st == null { return null }
    let cur = hd_plug(st, cur)
    let i = i - 1
  }
  return cur
}

skill hd_input(domain) -> Any {
  if domain == "grids" { return ["v", "g"] }
  return ["v", "x"]
}

# is this program what the task's author meant? run on every input Pi has for the domain, the held-out ones too
skill hd_right(tree, f, domain) -> Any {
  if tree == null { return false }
  for v in train_inputs(domain) ++ held_inputs(domain) {
    let y = sev(tree, null, v, null, [])
    if y == null { return false }
    if y != f(v) { return false }
  }
  return true
}

skill hd_tasks(domain, unseen) -> Any {
  if unseen {
    if domain == "lists" { return unseen_lists() }
    if domain == "text" { return unseen_text() }
    return unseen_grids()
  }
  if domain == "lists" { return list_tasks() }
  if domain == "text" { return text_tasks() }
  return grid_tasks()
}

# ---- new instructions, made of words Pi will by then have met (stage 5): never practised, never shown -----------
skill hd_new_lists() -> Any {
  return [
    ["sum of negatives", fn(xs) => sum(tfilter(xs, fn(v) => v < 0))],
    ["product of negatives", fn(xs) => t_prod(tfilter(xs, fn(v) => v < 0))],
    ["negatives sorted", fn(xs) => sort(tfilter(xs, fn(v) => v < 0))],
    ["squares of negatives", fn(xs) => tmap(tfilter(xs, fn(v) => v < 0), fn(v) => v * v)],
    ["count doubles", fn(xs) => len(tmap(xs, fn(v) => v * 2))],
    ["product of doubles", fn(xs) => t_prod(tmap(xs, fn(v) => v * 2))],
    ["largest square of positives", fn(xs) => tmax(tmap(tfilter(xs, fn(v) => v > 0), fn(v) => v * v))],
    ["sum of squares of evens", fn(xs) => sum(tmap(tfilter(xs, fn(v) => v % 2 == 0), fn(v) => v * v))],
    ["evens sorted", fn(xs) => sort(tfilter(xs, fn(v) => v % 2 == 0))],
    ["squares sorted, biggest first", fn(xs) => reverse(sort(tmap(xs, fn(v) => v * v)))],
    ["three smallest, biggest first", fn(xs) => reverse(ttake(3, sort(xs)))],
    ["count evens", fn(xs) => len(tfilter(xs, fn(v) => v % 2 == 0))]
  ]
}

skill hd_new_text() -> Any {
  return [
    ["count letters before n", fn(xs) => len(tfilter(xs, fn(v) => v < 110))],
    ["letters before n, reversed", fn(xs) => reverse(tfilter(xs, fn(v) => v < 110))],
    ["letters after m, sorted", fn(xs) => sort(tfilter(xs, fn(v) => v > 109))],
    ["uppercase, reversed, sorted", fn(xs) => sort(reverse(tmap(xs, fn(v) => v - 32)))]
  ]
}

skill hd_new_grids() -> Any {
  return [
    ["rotate left, recolour 1 to 5", fn(g) => t_rotl(t_recol(g, 1, 5))],
    ["transpose, then flip", fn(g) => reverse(transpose(g))],
    ["rotate right, then flip", fn(g) => reverse(t_rotr(g))],
    ["mirror, then flip", fn(g) => reverse(t_fliph(g))]
  ]
}

skill hd_new(domain) -> Any {
  if domain == "lists" { return hd_new_lists() }
  if domain == "text" { return hd_new_text() }
  return hd_new_grids()
}

skill hd_read_tree(rules, fam, steps, phrase, domain) -> Any {
  let toks = tg_understand(rules, fam, hd_words(phrase))
  if toks == null { return null }
  return hd_program(toks, steps, hd_input(domain))
}

skill hm_phrase(phrase) -> Any {
  if phrase == null { return null }
  let ws = hd_words(phrase)
  if len(ws) == 3 and ws[1] == "of" { ws = [ws[0], ws[2]] }
  if len(ws) != 2 { return null }
  if not contains(hm_reducers(), ws[0]) or not hm_word(ws[1]) { return null }
  return ws
}

# Export each resolved meaning into the same grammar/step vocabulary that ordinary Heed reads.
skill hm_grammar(word, law, rules, steps) -> Any {
  let step = if law[1] { O("map", [law[0], hd_hole()]) } else { subst_e(law[0], hd_hole()) }
  let key = hd_token(step)
  let meaning = if law[1] { ["$1", key] } else { [key, "$1"] }
  let lexical = []
  steps = put(steps, key, step)
  for name in hm_reducers() {
    let tree = hm_reduce(name, hd_hole())
    let token = hd_token(tree)
    lexical = append(lexical, [[name], [token]])
    steps = put(steps, token, tree)
  }
  let word_rules = [[["$1", "of", word], meaning], [["$1", word], meaning]]
  return [word_rules ++ lexical ++ rules, steps]
}

skill hm_read(word, law, phrase, xs) -> Any {
  let fitted = hm_grammar(word, law, [], {})
  let tree = hd_read_tree(fitted[0], null, fitted[1], phrase, "lists")
  if tree == null { return null }
  return sev(tree, null, xs, null, [])
}

# Learn the outer arithmetic from target examples. Persist the expression
# and source phrase, so a later process can bind it to revised evidence.
skill hd_compose(path,from,to) -> Any {
  let src = hm_phrase(from)
  let dst = hm_phrase(to)
  if path == null or src == null or dst == null or src == dst or arg(5) != null {
    return "Usage: heed compose FILE \"sum of SOURCE\" \"sum of TARGET\""
  }
  let text = read_file(path)
  let book = hm_book(text)
  if book == null { return "Unreadable or incomplete lesson file." }
  let name = src[0] ++ " of " ++ src[1]
  let target = dst[0] ++ " of " ++ dst[1]
  let bindings = hm_recipes(text)
  if bindings[target] != null { return "A composition is already recorded for " ++ target ++ "." }
  for other in keys(bindings) {
    if bindings[other] == target { return "This phrase already supplies a saved composition." }
  }
  let source = hm_named(hm_lessons(text),name)
  if source == null { return "Teach or resolve " ++ name ++ " first." }
  let train = []
  let values = {}
  for ex in get(book,dst[1],[]) {
    if ex[0] == dst[0] {
      let v = sev(source[0],ex[1],null,null,[])
      if v == null { return "Source is undefined on a target lesson." }
      values = put(values,str(v),true)
      train = append(train,[v,ex[2]])
    }
  }
  if len(keys(values)) < 2 { return "Teach target examples with distinct source values first." }
  let fitted = solve(train,[],[],[],pools(),prelude(),4,10000)[0]
  if fitted == null { return "No supported composition fits the target lessons." }
  let line = join(["compose1",dst[1],dst[0],src[1],src[0],ser(xparam(fitted))]," ")
  if hm_recipe(split(line," ")) == null { return "No supported composition fits the target lessons." }
  if not rt_append_file(path,line ++ "\n") { return "Could not save the composition." }
  return "Learned " ++ target ++ " from " ++ name ++ ": " ++ show(fitted)
}

# Restrict automatic dependencies to words present before the target was
# introduced. Replay their current observations so corrections are visible.
skill hd_prior(text,word) -> Any {
  let allowed = {}
  let before = true
  let lines = []
  for line in split(text,"\n") {
    let f = split(trim(line)," ")
    if len(f) >= 5 {
      if f[1] == word { before = false }
      if before and f[0] == "heed1" { allowed = put(allowed,f[1],true) }
      if allowed[f[1]] == true {
        if f[0] == "heed1" or (f[0] == "compose1" and allowed[f[3]] == true) {
          lines = append(lines,line)
        }
      }
    }
  }
  return join(lines,"\n")
}

# One offset per named source. Equal current predictions do not make two
# dependency names interchangeable: their lessons can later be corrected.
skill hd_source_reply(path,text,ws,obs,xs,teaching) -> Any {
  let rows = []
  for ex in obs { if ex[0] == ws[0] { rows = append(rows,ex) } }
  if len(rows) < 2 { return null }
  let prior = hd_prior(text,ws[1])
  if prior == "" { return null }
  let matches = []
  let names = []
  let offsets = []
  for lesson in hm_lessons(prior) {
    let src = hm_phrase(lesson[1])
    if src != null and lesson[2][1] == "L" and lesson[2][2] == "I" {
      let offset = null
      let varied = false
      let valid = true
      for row in rows {
        let v = sev(lesson[2][0],row[1],null,null,[])
        if v == null { valid = false } else {
          let delta = row[2]-v
          if offset == null { offset = delta }
          if offset != delta { valid = false }
          if rows[0][2] != row[2] { varied = true }
        }
      }
      if valid and varied {
        let body = O("+",[lesson[2][0],Q(offset)])
        for row in rows { if sev(body,row[1],null,null,[]) != row[2] { valid = false } }
        if valid {
          matches = append(matches,subst(body,V("x")))
          names = append(names,src)
          offsets = append(offsets,offset)
        }
      }
    }
  }
  if len(matches) == 0 { return null }
  if len(matches) == 1 and offsets[0] != 0 and len(rows) >= 3 and teaching {
    let target = ws[0] ++ " of " ++ ws[1]
    let bindings = hm_recipes(text)
    for name in keys(bindings) { if bindings[name] == target { return null } }
    let src = names[0]
    let line = join(["compose1",ws[1],ws[0],src[1],src[0],"+","p0",str(offsets[0])]," ")
    # Confirm the normal replay path resolves the proposed record before saving.
    let learned = hm_named(hm_lessons(text ++ line ++ "\n"),target)
    if learned == null { return null }
    if not rt_append_file(path,line ++ "\n") { return "Could not save the composition." }
    return "Learned " ++ target ++ " from " ++ src[0] ++ " of " ++ src[1] ++ " with offset " ++ str(offsets[0]) ++ "."
  }
  if len(matches) < 2 { return null }
  if not teaching {
    let value = sev(matches[0],null,xs,null,[])
    let agree = true
    for model in matches { if sev(model,null,xs,null,[]) != value { agree = false } }
    if value != null and agree { return str(value) }
  }
  let best = null
  let bound = len(matches)
  for row in rows {
    let input = row[1]
    for i in range(0,len(input)) {
      let probe = slice(input,0,i) ++ [input[i]+1] ++ slice(input,i+1,len(input))
      let worst = wn_probe_worst(matches,probe)
      if worst < bound {
        best = probe
        bound = worst
      }
      if bound == 1 { return hm_prompt(ws[1],[ws[0],best]) }
    }
  }
  if best != null { return hm_prompt(ws[1],[ws[0],best]) }
  return "Several earlier skills fit. Teach a different example for " ++ ws[1] ++ "."
}

skill hm_command(path, command, phrase, csv, answer) -> Any {
  let ws = hm_phrase(phrase)
  let xs = hm_numbers(csv)
  let extra = arg(7) != null or (command == "use" and answer != null)
  if ws == null or xs == null or path == null or not contains(["teach", "use"], command) or extra {
    return "Usage: heed memory FILE teach|use \"sum of WORD\" 2,3 [answer]"
  }
  let text = read_file(path)
  let book = hm_book(text)
  if book == null { return "Unreadable or incomplete lesson file." }
  let word = ws[1]
  if command == "teach" {
    let y = hm_number(answer)
    if y == null { return "Give a whole-number observation." }
    let record = hm_line(word, [ws[0], xs, y])
    if not rt_append_file(path, record) { return "Could not save the observation." }
    text = read_file(path)
    book = hm_book(text)
    if book == null { return "Could not read the saved observation." }
  }
  let name = ws[0] ++ " of " ++ word
  let dependency = hm_recipes(text)[name]
  if dependency != null {
    let replay = hm_replay(text,name)
    let lessons = replay[0]
    let repairs = replay[1]
    let derived = hm_named(lessons,name)
    if derived == null {
      if hm_named(lessons,dependency) == null {
        if hm_recipes(text)[dependency] != null { return "Resolve the saved composition for " ++ dependency ++ " first." }
        return "Resolve " ++ dependency ++ " before using " ++ name ++ ". Teach its answer for " ++ csv ++ "."
      }
      if len(repairs) > 1 {
        if command == "use" {
          let y = sev(repairs[0],null,xs,null,[])
          let agree = y != null
          for model in repairs { if sev(model,null,xs,null,[]) != y { agree = false } }
          if agree { return str(y) }
        }
        let probe = wn_switch_question(repairs,book[word],ws[0])
        if probe != null { return hm_prompt(word,[ws[0],probe]) }
        return "Several repairs fit. Teach a different example for " ++ name ++ "."
      }
      return "The composition conflicts with a saved target lesson."
    }
    if command == "teach" and len(repairs) == 1 { return "Revised " ++ name ++ ": " ++ show(repairs[0]) }
    let value = sev(derived[0],xs,null,null,[])
    if value == null { return "Meaning undefined for this input." }
    return str(value)
  }
  let obs = book[word]
  if obs == null { return "Teach an example for " ++ word ++ " first." }
  let automatic = hd_source_reply(path,text,ws,obs,xs,command == "teach")
  if automatic != null { return automatic }
  let laws = hm_laws(obs)
  if len(laws) == 0 {
    let reply = wn_book_reply(book,word,obs,ws[0],xs,command == "teach")
    if reply != null { return reply }
    let candidates = hm_replay(text,name)[1]
    if len(candidates) == 0 { return "Observations saved. Bounded search found no consistent meaning." }
    let y = sev(candidates[0],null,xs,null,[])
    if len(candidates) > 1 {
      if command == "teach" or y != sev(candidates[1],null,xs,null,[]) {
        return "Mind hypotheses disagree. Teach the answer for " ++ hm_csv(candidates[2]) ++ "."
      }
    }
    if command == "teach" { return "Mind hypothesis: " ++ show(candidates[0]) }
    if y == null { return "Meaning undefined for this input." }
    return str(y)
  }
  if len(laws) == 1 {
    if command == "teach" { return "Learned " ++ word ++ ": " ++ show(laws[0][0]) ++ if laws[0][1] { " before reduction." } else { " after reduction." } }
    let y = hm_read(word, laws[0], phrase, xs)
    if y == null { return "Meaning undefined for this input." }
    return str(y)
  }
  if command == "use" {
    let y = hm_read(word, laws[0], phrase, xs)
    let agree = y != null
    for law in laws { if hm_read(word, law, phrase, xs) != y { agree = false } }
    if agree { return str(y) }
    let probe = hm_target_question(laws,[ws[0],xs])
    if probe != null { return hm_prompt(word,probe) }
  }
  return hm_ask(word, laws)
}

# Read learned corrections before less specific grammar rules, only in the taught domain.
skill hd_told(rules, fam, steps, task, domain, readings) -> Any {
  if domain == "lists" {
    let phrase = hm_phrase(task[0])
    if phrase != null {
      let laws = readings[phrase[1]]
      if laws != null {
        if len(laws) == 0 { return [null,"no consistent meaning"] }
        if len(laws) > 1 { return [null,hm_ask(phrase[1],laws)] }
        let fitted = hm_grammar(phrase[1],laws[0],rules,steps)
        let rules = fitted[0]
        let steps = fitted[1]
        let fam = null
      }
    }
  }
  let tree = hd_read_tree(rules, fam, steps, task[0], domain)
  if tree == null { return [null, "cannot read"] }
  if hd_right(tree, task[1], domain) { return [tree, "right"] }
  return [tree, "wrong"]
}

skill hd_pct(a, b) -> Any { return str(a) ++ " of " ++ str(b) }

skill main() -> Any {
  if arg(1) == "explore" { return dx_run(arg(2),arg(3),arg(4)) }
  if arg(1) == "room" { return dw_run(arg(2),arg(3),arg(4)) }
  if arg(1) == "compose" { return hd_compose(arg(2),arg(3),arg(4)) }
  if arg(1) == "inquire" { return sl_session(arg(2), arg(3)) }
  if arg(1) == "memory" { return hm_command(arg(2),arg(3),arg(4),arg(5),arg(6)) }
  let readings = {}
  if arg(1) == "review" {
    if arg(2) == null { return "Usage: heed review FILE" }
    let book = hm_load(arg(2))
    if book == null { return "Unreadable or incomplete lesson file." }
    for word in keys(book) { readings = put(readings,word,hm_laws(book[word])) }
  }
  let domains = ["lists", "text", "grids"]
  let pl = pools()
  let pre = prelude()
  let g = default_genome()
  # 1. practice: by search, from examples
  do print("1. Pi practises (each task solved by search, from examples):")
  let pairs = []
  let steps = {}
  for d in domains {
    for t in hd_tasks(d, false) {
      let r = attempt_task_g(t, d, [], [], pl, pre, g)
      if r[0] == null { do print("  " ++ t[0] ++ ": not found") } else {
        let mn = hd_meaning(r[0], steps)
        let steps = mn[1]
        let pairs = append(pairs, [hd_words(t[0]), mn[0]])
        do print("  " ++ t[0] ++ ": " ++ show(r[0]) ++ "   = " ++ join(mn[0], " "))
      }
    }
  }
  # 2. the language
  let rules = tg_learn(pairs)
  let fam = tg_familiar(rules, pairs)
  do print("")
  do print("2. the English Pi made of it: " ++ str(len(rules)) ++ " rules from " ++ str(len(pairs)) ++ " names")
  do print(tg_show(rules))
  # 3. told only
  do print("3. TOLD ONLY -- instructions never practised, no examples:")
  let right = 0
  let total = 0
  let beyond = 0
  let failed = []
  let previous_readings = readings
  for d in domains {
    for t in hd_tasks(d, true) {
      let r = hd_told(rules, fam, steps, t, d, readings)
      let total = total + 1
      let line = "  " ++ t[0] ++ ": " ++ r[1]
      if r[0] != null { let line = line ++ "   " ++ show(r[0]) }
      if r[1] == "right" {
        let right = right + 1
        # could Pi have found this one from examples, by search, as it found the tasks it practised?
        let s = attempt_task_g(t, d, [], [], pl, pre, g)
        if s[0] == null {
          let beyond = beyond + 1
          let line = line ++ "   (beyond its search: shown examples and no words, it finds nothing)"
        }
      } else { let failed = append(failed, [t, d]) }
      do print(line)
    }
  }
  do print("  told only: " ++ hd_pct(right, total) ++ " done rightly; " ++ str(beyond) ++ " of those " ++ str(right) ++ " are beyond what its search finds from examples")
  # 4. shown once
  do print("")
  do print("4. SHOWN ONCE -- for those, examples; Pi searches as before, and learns from the one sentence:")
  let learned = 0
  for ft in failed {
    let t = ft[0]
    let d = ft[1]
    let r = attempt_task_g(t, d, [], [], pl, pre, g)
    if r[0] == null { do print("  " ++ t[0] ++ ": not found by search") } else {
      let mn = hd_meaning(r[0], steps)
      let steps = mn[1]
      # In a continuing session, carry genuinely ambiguous demonstrations into the
      # next lesson. Read only practice inputs. Reserve final tasks for transfer.
      if arg(1) == "review" and d == "lists" {
        let phrase = hm_phrase(t[0])
        if phrase != null and readings[phrase[1]] == null {
          let obs = []
          for ex in examples_of(t[1], train_inputs(d)) { obs = append(obs,[phrase[0],ex[0],ex[1]]) }
          let laws = hm_simple(obs)
          if len(laws) > 1 and hm_question(laws) != null {
            let records = ""
            for ex in obs { records = records ++ hm_line(phrase[1],ex) }
            if not rt_append_file(arg(2),records) { return "Could not save the practice observations." }
            readings = put(readings,phrase[1],laws)
            do print("  " ++ hm_ask(phrase[1],laws))
          }
        }
      }
      let pairs = append(pairs, [hd_words(t[0]), mn[0]])
      let learned = learned + 1
      do print("  " ++ t[0] ++ ": " ++ show(r[0]))
    }
  }
  let before = len(rules)
  let rules2 = tg_learn(pairs)
  let fam2 = tg_familiar(rules2, pairs)
  do print("  " ++ str(learned) ++ " sentences heard once each; the English is now " ++ str(len(rules2)) ++ " rules (was " ++ str(before) ++ "):")
  do print(tg_show(rules2))
  # 5. told again
  do print("5. TOLD AGAIN -- new instructions from the words just learned, no examples:")
  let right0 = 0
  let right2 = 0
  let total2 = 0
  for d in domains {
    for t in hd_new(d) {
      let r0 = hd_told(rules, fam, steps, t, d, previous_readings)
      let r2 = hd_told(rules2, fam2, steps, t, d, readings)
      let total2 = total2 + 1
      if r0[1] == "right" { let right0 = right0 + 1 }
      if r2[1] == "right" { let right2 = right2 + 1 }
      let line = "  " ++ t[0] ++ ": " ++ r2[1]
      if r2[0] != null { let line = line ++ "   " ++ show(r2[0]) }
      do print(line ++ "   (before stage 4: " ++ r0[1] ++ ")")
    }
  }
  do print("  told again: " ++ hd_pct(right2, total2) ++ " done rightly (with the English of stage 2 alone: " ++ hd_pct(right0, total2) ++ ")")
  return "done"
}
