import "heedlessons.pi"
import "english.pi"

# Read a list-word statement or question, leaving unrelated English to the fact engine.
skill chat_lesson(text) -> Any {
  let command = "teach"
  for prefix in ["what is ", "what's ", "what’s "] {
    if slice(text,0,len(prefix)) == prefix {
      let text = slice(text,len(prefix),len(text))
      let command = "use"
      break
    }
  }
  if slice(text,0,4) == "the " { let text = slice(text,4,len(text)) }
  let parts = split(text," for ")
  if len(parts) != 2 { let parts = split(text," on ") }
  if len(parts) != 2 { return null }
  let ws = hm_phrase(parts[0])
  if ws == null { return null }
  let list = parts[1]
  let answer = null
  if command == "teach" {
    let sides = split(list," is ")
    if len(sides) != 2 or hm_number(sides[1]) == null { return null }
    let list = sides[0]
    let answer = sides[1]
  }
  let list = join(split(list,", and "),",")
  let list = join(split(list," and "),",")
  let xs = []
  for item in split(list,",") {
    let n = hm_number(trim(item))
    if n == null { return null }
    let xs = append(xs,n)
  }
  if len(xs) == 0 { return null }
  return [command,ws,xs,answer]
}

# Each complete journal record supersedes the previous one. Delimit both ends
# so a partial append cannot erase the last complete question.
skill chat_save_probe(probe) -> Any {
  let record = "clear"
  if probe != null {
    let record = hm_prompt(probe[0][1],[probe[0][0],probe[1]])
    if probe[2] != null {
      let target = probe[2]
      let record = record ++ "|" ++ hm_prompt(target[1][1],[target[1][0],target[2]])
    }
  }
  return rt_append_file("out/chat_questions.txt","\n" ++ record ++ "!\n")
}

skill chat_saved_probe() -> Any {
  let data = read_file("out/chat_questions.txt")
  if data == null { return null }
  for line in reverse(split(data,"\n")) {
    if line == "clear!" { return null }
    if ends(line,"?!") {
      let parts = split(slice(line,0,len(line)-1),"|")
      if len(parts) <= 2 {
        let questions = []
        for part in parts {
          let q = chat_lesson(lower(slice(part,0,len(part)-1)))
          if ends(part,"?") and q != null and q[0] == "use" { let questions = append(questions,q) }
        }
        if len(questions) == len(parts) {
          let q = questions[0]
          let target = if len(parts) == 2 { questions[1] } else { null }
          return [q[1],q[2],target]
        }
      }
    }
  }
  return null
}

skill chat_handle(st,line) -> Any {
  let text = lower(trim(line))
  if ends(text,".") or ends(text,"?") { let text = trim(slice(text,0,len(text)-1)) }
  let spatial = chat_grid(st,text)
  if spatial != null { return spatial }
  let pending = st["lesson_probe"]
  if pending != null and text == "cancel" {
    if not chat_save_probe(null) { return ["Could not save the cancellation.",st,false] }
    return ["Question cancelled.",put(st,"lesson_probe",null),false]
  }
  let request = chat_lesson(text)
  let target = null
  if pending != null and hm_number(text) != null {
    let request = ["teach",pending[0],pending[1],text]
    let target = pending[2]
  }
  if request == null { return handle(st,line) }
  let ws = request[1]
  let xs = request[2]
  let command = request[0]
  let r = hm_turn("out/chat_lessons.txt",request[0],ws,join(ws," of "),xs,request[3])
  if target != null and (r[1] != null or r[2] != null) {
    let command = "use"
    let ws = target[1]
    let xs = target[2]
    let r = hm_turn("out/chat_lessons.txt","use",ws,join(ws," of "),xs,null)
  }
  if request[0] == "use" { let target = request }
  let next = null
  if r[1] != null { let next = [[r[1][0],ws[1]],r[1][1],target] }
  if pending != next {
    if not chat_save_probe(next) { return ["Could not save the clarification state. Please retry.",st,false] }
  }
  let reply = r[0]
  if command == "use" and r[2] != null {
    let law = r[2]
    if law[1] {
      let values = sev(O("map",[law[0],V("x")]),null,xs,null,[])
      let reply = reply ++ ". I applied " ++ show(law[0]) ++ " to each input, then took the " ++ ws[0] ++ " of " ++ hm_csv(values) ++ "."
    } else {
      let reply = reply ++ ". I took the " ++ ws[0] ++ " first, then applied " ++ show(law[0]) ++ "."
    }
  }
  return [reply,put(st,"lesson_probe",next),false]
}

# Keep the input and the successful instruction together for the next turn.
# Heed owns the observations, program selection, and evaluation for both interfaces.
skill chat_grid(st,text) -> Any {
  let path = "out/chat_lessons.txt"
  let lesson = split(text," maps grid ")
  if len(lesson) == 2 {
    let pair = split(lesson[1]," to ")
    if len(pair) != 2 { return ["Give the input grid and output grid separated by 'to'.",st,false] }
    return [ht_command("grid",path,"teach",lesson[0],pair[0],pair[1]),st,false]
  }
  let steps = []
  let grid = null
  if text == "reverse the order" {
    let last = st["grid_request"]
    if last == null { return ["Apply a sequence to a grid first.",st,false] }
    let steps = reverse(last[0])
    let grid = last[1]
  } else {
    if slice(text,0,6) != "apply " { return null }
    let parts = split(slice(text,6,len(text))," to grid ")
    if len(parts) != 2 { return null }
    let phrase = join(split(parts[0],", then ")," then ")
    let steps = split(phrase," then ")
    let grid = parts[1]
  }
  for step in steps {
    if ht_name(step) == null { return ["Give a name for each grid operation.",st,false] }
  }
  if ht_value("grid",grid) == null { return ["Give a rectangular grid, for example 1,2/3,4.",st,false] }
  let result = ht_command("grid",path,"use",join(steps,", then "),grid,null)
  if slice(result,0,1) == "[" { let st = put(st,"grid_request",[steps,grid]) }
  return [result,st,false]
}
