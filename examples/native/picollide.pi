# Integer law. Two particles move by their velocities. If they stand on the same
# integer at time t, they exchange velocities and keep the place.
# The path x + v t does not bounce. The name does. So after a meeting, each name
# sits on the other path. If the gap is not divisible by the relative speed, or
# the meeting is in the past, the names keep their paths.
# A third particle does not change the set of places: the places are the three
# free paths, whatever the names did. Momentum and energy are the same before and after.
skill meet(x1, v1, x2, v2) -> Any {
  let rel = v1 - v2
  if rel == 0 { return 0 - 1 }
  let gap = x2 - x1
  if gap % rel != 0 { return 0 - 1 }
  return gap // rel
}
skill predict(x1, v1, x2, v2, t) -> Any {
  let m = meet(x1, v1, x2, v2)
  if m < 0 { return [x1 + v1 * t, v1, x2 + v2 * t, v2] }
  if m > t { return [x1 + v1 * t, v1, x2 + v2 * t, v2] }
  return [x2 + v2 * t, v2, x1 + v1 * t, v1]
}
skill run2(x1, v1, x2, v2, t) -> Any {
  if x1 == x2 {
    let s = v1
    let v1 = v2
    let v2 = s
  }
  for n in range(0, t) {
    let x1 = x1 + v1
    let x2 = x2 + v2
    if x1 == x2 {
      let s = v1
      let v1 = v2
      let v2 = s
    }
  }
  return [x1, v1, x2, v2]
}
skill run3(t) -> Any {
  let x1 = 0
  let v1 = 2
  let x2 = 6
  let v2 = 1
  let x3 = 20
  let v3 = 0
  for n in range(0, t) {
    let x1 = x1 + v1
    let x2 = x2 + v2
    let x3 = x3 + v3
    if x1 == x2 {
      let s = v1
      let v1 = v2
      let v2 = s
    }
    if x2 == x3 {
      let s = v2
      let v2 = v3
      let v3 = s
    }
    if x1 == x3 {
      let s = v1
      let v1 = v3
      let v3 = s
    }
  }
  return [x1, v1, x2, v2, x3, v3]
}
skill sort3(a, b, c) -> Any {
  if a > b {
    let s = a
    let a = b
    let b = s
  }
  if b > c {
    let s = b
    let b = c
    let c = s
  }
  if a > b {
    let s = a
    let a = b
    let b = s
  }
  return [a, b, c]
}

skill main() -> Any {
  let a = predict(0, 3, 12, 1, 10)
  let b = run2(0, 3, 12, 1, 10)
  let c = predict(2, 5, 14, 1, 7)
  let d = run2(2, 5, 14, 1, 7)
  let e = predict(0, 2, 5, 0, 3)
  let f = run2(0, 2, 5, 0, 3)
  let g = predict(10, 0 - 1, 0, 1, 7)
  let h = run2(10, 0 - 1, 0, 1, 7)
  let p = predict(0, 2, 0, 0 - 1, 3)
  let q = run2(0, 2, 0, 0 - 1, 3)
  let z = run3(10)
  let places = sort3(z[0], z[2], z[4])
  let free = sort3(0 + 2 * 10, 6 + 1 * 10, 20 + 0 * 10)
  let text = "names bounce, paths do not\n"
  let slot = rt_sw_ssd_alloc(64)
  let other = rt_sw_ssd_alloc(8)
  do rt_sw_ssd_puts(slot, text)
  do rt_sw_ssd_puts(other, "x")
  let pg = rt_sw_pg()
  let got = rt_sw_ssd_gets(slot)
  let readp = rt_sw_pg() - pg
  print(a == b)
  print(a == [22, 1, 30, 3])
  print(c == d)
  print(c == [21, 1, 37, 5])
  print(e == f)
  print(e == [6, 2, 5, 0])
  print(g == h)
  print(g == [7, 1, 3, 0 - 1])
  print(p == q)
  print(p == [0 - 3, 0 - 1, 6, 2])
  print(z == [16, 1, 20, 0, 20, 2])
  print(places == free)
  print(1 + 0 + 2 == 2 + 1 + 0)
  print(1 * 1 + 0 * 0 + 2 * 2 == 2 * 2 + 1 * 1 + 0 * 0)
  print(readp == 1024)
  print(got == text)
  return 0
}
