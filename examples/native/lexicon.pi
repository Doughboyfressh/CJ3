# Pi's vocabulary, counted from its own data: the Wikipedia sentences in data\pairs\wikipedia_pairs.jsonl.
#   out\lexicon.exe [megabytes]   -> out\lexicon.txt, one "word count" per line, words seen at least 3 times
# Bytes are read raw (read_bytes); only the text inside "sentence": "..." fields is counted; words are runs of letters,
# lower-cased. A hash table on flat arrays holds the counts; each new word's letters go into one byte pool.

skill SRC() -> Any { return "C:\\Users\\Dough\\laya-plus\\data\\pairs\\wikipedia_pairs.jsonl" }

skill main() -> Any {
  let mb = 40
  if arg(1) != null { let mb = num(arg(1)) }
  let hsz = 2097152
  let hkey = arr(hsz)
  let hcnt = arr(hsz)
  let hpos = arr(hsz)
  let hlen = arr(hsz)
  let pool = arr(16000000)
  let used = 0
  let nwords = 0
  let distinct = 0
  let pat = [115, 101, 110, 116, 101, 110, 99, 101, 34, 58, 32, 34]
  let chunk = 8000000
  let off = 0
  let inside = false
  let wh = 0
  let wl = 0
  let wbuf = arr(64)
  while off < mb * 1000000 {
    let m = mark()
    let b = read_bytes(SRC(), off, chunk)
    let n = 0
    if b != null { let n = len(b) }
    let i = 0
    while i < n {
      let c = aget(b, i)
      if inside == false {
        if c == 115 and i + 12 <= n {
          let ok = true
          let k = 1
          while ok and k < 12 {
            if aget(b, i + k) != pat[k] { let ok = false }
            let k = k + 1
          }
          if ok {
            let inside = true
            let i = i + 11
          }
        }
      } else {
        let letter = false
        let lc = c
        if c >= 65 and c <= 90 {
          let letter = true
          let lc = c + 32
        }
        if c >= 97 and c <= 122 { let letter = true }
        if letter {
          if wl < 40 {
            do aset(wbuf, wl, lc)
            let wh = (wh * 31 + lc) % 1000000007
          }
          let wl = wl + 1
        } else {
          if wl > 0 and wl <= 40 {
            let nwords = nwords + 1
            let key = wh * 64 + wl + 1
            let s = key % hsz
            let going = true
            while going {
              let kk = aget(hkey, s)
              if kk == 0 {
                if used + wl < 16000000 and distinct < hsz // 2 {
                  do aset(hkey, s, key)
                  do aset(hcnt, s, 1)
                  do aset(hpos, s, used)
                  do aset(hlen, s, wl)
                  for t in range(0, wl) { do aset(pool, used + t, aget(wbuf, t)) }
                  let used = used + wl
                  let distinct = distinct + 1
                }
                let going = false
              } else {
                if kk == key {
                  do aset(hcnt, s, aget(hcnt, s) + 1)
                  let going = false
                } else { let s = (s + 1) % hsz }
              }
            }
          }
          let wl = 0
          let wh = 0
          # the closing quote of the sentence (an escaped quote is preceded by a backslash)
          if c == 34 {
            if i == 0 or aget(b, i - 1) != 92 { let inside = false }
          }
        }
      }
      let i = i + 1
    }
    do release(m, 0)
    if n < chunk { let off = mb * 1000000 } else { let off = off + chunk }
  }
  # the vocabulary: words seen at least 3 times, written as bytes
  let outb = arr(used + 12 * distinct + 16)
  let o = 0
  let kept = 0
  for s in range(0, hsz) {
    if aget(hkey, s) != 0 and aget(hcnt, s) >= 3 {
      let p = aget(hpos, s)
      for t in range(0, aget(hlen, s)) { do aset(outb, o + t, aget(pool, p + t)) }
      let o = o + aget(hlen, s)
      do aset(outb, o, 32)
      let o = o + 1
      let cs = str(aget(hcnt, s))
      for t in range(0, len(cs)) { do aset(outb, o + t, ord(slice(cs, t, t + 1))) }
      let o = o + len(cs)
      do aset(outb, o, 10)
      let o = o + 1
      let kept = kept + 1
    }
  }
  do write_file("out\\lexicon.txt", arr_text(outb, 0, o))
  return "read " ++ str(mb) ++ " MB of Wikipedia sentences: " ++ str(nwords) ++ " words, " ++ str(distinct) ++ " distinct; vocabulary (seen 3+ times): " ++ str(kept) ++ " words -> out\\lexicon.txt"
}
