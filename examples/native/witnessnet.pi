# Train a two-input integer readout. When it misses a lesson, grow one
# rectifier of the endpoint gap. Its correction is zero on both pivot lessons.
# Keep the verified candidates so they can vote on a new input.
skill wn_hinge(row,k) -> Any { return max(0,row[0]-row[1]-k) }

skill wn_program(weights,k) -> Any {
  let head = O("head",[V("x")])
  let tail = O("last",[V("x")])
  let gap = O("-",[head,tail])
  if k != 0 { gap = O("-",[gap,Q(k)]) }
  let features = [head,tail,O("max",[Q(0),gap])]
  let tree = null
  for i in range(0,3) {
    let w = weights[i]
    if w != 0 {
      let term = features[i]
      if w != 1 { term = O("*",[Q(w),term]) }
      if tree == null { tree = term } else { tree = O("+",[tree,term]) }
    }
  }
  if tree == null { return Q(0) }
  return tree
}

skill wn_verify(rows,nums,den,k) -> Any {
  let weights = []
  for v in nums {
    if v % den != 0 { return null }
    weights = append(weights,v // den)
  }
  let tree = wn_program(weights,k)
  for r in rows {
    if sev(tree,null,r[3],null,[]) != r[2] { return null }
  }
  return tree
}

# Subtract the endpoint plane matching the hinge at the two anchors.
# The scaled residual is piecewise affine in the threshold k.
skill wn_plane(p,q,k) -> Any {
  let zp = wn_hinge(p,k)
  let zq = wn_hinge(q,k)
  return [zp*q[1]-p[1]*zq,p[0]*zq-zp*q[0]]
}

skill wn_gain(r,k,plane,d) -> Any {
  return d*wn_hinge(r,k)-plane[0]*r[0]-plane[1]*r[1]
}

# For a fit, each row and the missed lesson must need the same correction
# multiplier. Cross-multiply to avoid division. Between consecutive gaps
# this consistency equation is affine, so two endpoint values give its root.
skill wn_missing_knot(rows,p,q,miss,d,a,b,lo,hi) -> Any {
  let left = wn_plane(p,q,lo)
  let right = wn_plane(p,q,hi)
  let ml = wn_gain(miss,lo,left,d)
  let mr = wn_gain(miss,hi,right,d)
  let err = d*miss[2]-a*miss[0]-b*miss[1]
  for r in rows {
    let e = d*r[2]-a*r[0]-b*r[1]
    let l = e*ml-err*wn_gain(r,lo,left,d)
    let h = e*mr-err*wn_gain(r,hi,right,d)
    if l != 0 or h != 0 {
      if (l < 0) == (h < 0) or l == 0 or h == 0 { return null }
      let num = l*(hi-lo)
      let den = l-h
      if num % den != 0 { return null }
      return lo+num // den
    }
  }
  # With zero gain throughout, the missed lesson cannot be corrected.
  if ml == 0 and mr == 0 { return null }
  return "interval"
}

skill wn_search(obs,reducer) -> Any {
  let rows = []
  let knots = [0]
  let p = null
  let q = null
  for ex in obs {
    if ex[0] == reducer {
      let xs = ex[1]
      let r = [xs[0],xs[len(xs)-1],ex[2],xs]
      rows = append(rows,r)
      let gap = r[0]-r[1]
      if not contains(knots,gap) { knots = append(knots,gap) }
      if p == null {
        if r[0] != 0 or r[1] != 0 { p = r }
      } else {
        if q == null and p[0]*r[1] != p[1]*r[0] { q = r }
      }
    }
  }
  if q == null { return [[],false] }
  let d = p[0]*q[1]-p[1]*q[0]
  let a = p[2]*q[1]-p[1]*q[2]
  let b = p[0]*q[2]-p[2]*q[0]
  let linear = wn_verify(rows,[a,b,0],d,0)
  if linear != null { return [[linear],false] }
  let miss = null
  for r in rows {
    if d*r[2] != a*r[0]+b*r[1] { miss = r }
  }
  if miss == null { return [[],false] }
  let incomplete = false
  let remaining = 256
  let boundaries = sort(knots)
  for i in range(1,len(boundaries)) {
    let lo = boundaries[i-1]
    let hi = boundaries[i]
    if hi-lo > 1 {
      let k = wn_missing_knot(rows,p,q,miss,d,a,b,lo,hi)
      if k == "interval" {
        if hi-lo-1 > remaining {
          incomplete = true
        } else {
          knots = knots ++ range(lo+1,hi)
          remaining = remaining-(hi-lo-1)
        }
      } else {
        if k != null { knots = append(knots,k) }
      }
    }
  }
  let models = []
  for k in knots {
    # d*hinge - u*head - v*last vanishes on p and q by construction.
    let plane = wn_plane(p,q,k)
    let u = plane[0]
    let v = plane[1]
    let gain = wn_gain(miss,k,plane,d)
    if gain != 0 {
      let err = d*miss[2]-a*miss[0]-b*miss[1]
      let model = wn_verify(rows,[a*gain-err*u,b*gain-err*v,d*err],d*gain,k)
      if model != null { models = append(models,model) }
    }
  }
  return [models,incomplete]
}

skill wn_fit(obs,reducer) -> Any {
  let result = wn_search(obs,reducer)
  if result[1] { return [] }
  return result[0]
}

# Ask a nearby, different question only if every possible reply identifies
# one target answer among the verified models.
skill wn_probe(obs,reducer,xs,models,answers) -> Any {
  let t = xs[len(xs)-1]
  let gap = xs[0]-t
  for ex in obs {
    if ex[0] == reducer {
      let trained = ex[1][0]-ex[1][len(ex[1])-1]
      for step in [0-1,1] {
        let g = trained+step
        if g != gap {
          let probe = [t+g,t]
          let buckets = {}
          let settles = true
          for i in range(0,len(models)) {
            let reply = sev(models[i],null,probe,null,[])
            let key = str(reply)
            if reply == null or get(buckets,key,answers[i]) != answers[i] { settles = false }
            buckets = put(buckets,key,answers[i])
          }
          if settles { return probe }
        }
      }
    }
  }
  return xs
}

# A collision proves that every endpoint-only rule fails. Only then search
# for a positional selector. Nonnegative ids count from the left, negative
# ids from the right, and null denotes the right middle on even lengths.
skill wn_position_ids(obs,reducer) -> Any {
  let seen = {}
  let collision = false
  let rows = []
  let shortest = null
  for ex in obs {
    if ex[0] == reducer {
      let xs = ex[1]
      let key = str([xs[0],xs[len(xs)-1]])
      if get(seen,key,ex[2]) != ex[2] { collision = true }
      seen = put(seen,key,ex[2])
      rows = append(rows,ex)
      if shortest == null or len(xs) < shortest { shortest = len(xs) }
    }
  }
  if not collision { return [] }
  let ids = [null]
  for i in range(1,shortest) {
    ids = append(ids,i)
    ids = append(ids,0-1-i)
  }
  for ex in rows {
    let xs = ex[1]
    let label = ex[2]
    # One software GPU lane per position. Left/right/center candidates
    # sharing an input position reuse its equality result.
    gpu for value in xs -> matches {
      let matches = 0
      if value == label { let matches = 1 }
    }
    let kept = []
    for id in ids {
      let at = len(xs) // 2
      if id != null { if id < 0 { at = len(xs)+id } else { at = id } }
      if aget(matches,at) == 1 { kept = append(kept,id) }
    }
    ids = kept
    if len(ids) == 0 { return [] }
  }
  return ids
}

skill wn_position_models(obs,reducer,ids) -> Any {
  let models = []
  for id in ids {
    let source = V("x")
    let offset = O("//",[O("len",[source]),Q(2)])
    if id != null {
      if id < 0 { source = O("rev",[source]) }
      offset = Q(if id < 0 { 0-1-id } else { id })
    }
    let tree = O("head",[O("drop",[offset,source])])
    let valid = true
    for ex in obs { if ex[0] == reducer and sev(tree,null,ex[1],null,[]) != ex[2] { valid = false } }
    if valid { models = append(models,tree) }
  }
  return models
}

skill wn_positions(obs,reducer) -> Any {
  return wn_position_models(obs,reducer,wn_position_ids(obs,reducer))
}

# An index-labelled list gives distinct answers wherever the selectors differ.
# If m is the largest offset from either end, length 2*m+3 separates the
# left offsets, the midpoint, and the right offsets. Shorter valid lengths
# are tried first, so the first perfect split also minimizes question length.
skill wn_position_question(ids,models) -> Any {
  let lanes = []
  let m = 0
  for id in ids {
    if id == null { lanes = append(lanes,0) } else {
      lanes = append(lanes,id)
      m = max(m,if id < 0 { 0-1-id } else { id })
    }
  }
  for n in range(max(m+1,len(models)),2*m+4) {
    gpu for code in lanes -> position {
      let position = code
      if code == 0 { let position = n // 2 }
      if code < 0 { let position = n+code }
    }
    let seen = {}
    for i in range(0,len(lanes)) { seen = put(seen,str(aget(position,i)),true) }
    if len(keys(seen)) == len(models) {
      let probe = range(0,n)
      let replies = {}
      for model in models {
        let y = sev(model,null,probe,null,[])
        if y == null { return null }
        replies = put(replies,str(y),true)
      }
      if len(keys(replies)) == len(models) { return probe }
    }
  }
  return null
}

# Reuse only positional skills uniquely resolved for other phrases.
skill wn_switches(book,word,reducer) -> Any {
  let rows = []
  for ex in book[word] { if ex[0] == reducer { rows = append(rows,ex) } }
  if len(rows) < 2 { return [] }
  let skills = []
  for other in keys(book) {
    if other != word {
      let candidates = wn_positions(book[other],reducer)
      if len(candidates) == 1 and len(hm_laws(book[other])) == 0 {
        if not contains(skills,candidates[0]) { skills = append(skills,candidates[0]) }
      }
    }
  }
  if len(skills) == 0 { return [] }
  let x = V("x")
  let head = O("head",[x])
  let last = O("last",[x])
  let gates = [O("<",[head,last]),O("<",[last,head]),O("==",[head,last]),O("==",[O("%",[O("len",[x]),Q(2)]),Q(0)])]
  let yes = [skills,skills,skills,skills]
  let no = yes
  for ex in rows {
    let xs = ex[1]
    let h = xs[0]
    let n = len(xs)
    let t = xs[n-1]
    gpu for gate in range(0,4) -> side {
      let side = 0
      if gate == 0 and h < t { let side = 1 }
      if gate == 1 and t < h { let side = 1 }
      if gate == 2 and h == t { let side = 1 }
      if gate == 3 and n % 2 == 0 { let side = 1 }
    }
    let fit = []
    for skilltree in skills {
      if sev(skilltree,null,xs,null,[]) == ex[2] { fit = append(fit,skilltree) }
    }
    let nextyes = []
    let nextno = []
    for g in range(0,4) {
      let keep = []
      let branch = if aget(side,g) == 1 { yes[g] } else { no[g] }
      for tree in branch { if contains(fit,tree) { keep = append(keep,tree) } }
      if aget(side,g) == 1 {
        nextyes = append(nextyes,keep)
        nextno = append(nextno,no[g])
      } else {
        nextyes = append(nextyes,yes[g])
        nextno = append(nextno,keep)
      }
    }
    yes = nextyes
    no = nextno
  }
  let models = []
  for g in range(0,4) {
    # Each branch must exclude at least one skill. This also excludes
    # unseen branches and preserves simpler explanations.
    if len(yes[g]) < len(skills) and len(no[g]) < len(skills) {
      for a in yes[g] {
        for b in no[g] {
          if a != b {
            let model = O("ite",[gates[g],a,b])
            let valid = true
            for ex in rows { if sev(model,null,ex[1],null,[]) != ex[2] { valid = false } }
            if valid { models = append(models,model) }
          }
        }
      }
    }
  }
  if len(models) > 0 { return models }
  # Construct predicates from the resolved vocabulary. Keep the constant
  # grammar finite and check both outcome branches against actual lessons.
  let outputs = skills ++ [head,last]
  let columns = []
  let fits = []
  for tree in outputs {
    let col = []
    for ex in rows { col = append(col,sev(tree,null,ex[1],null,[])) }
    columns = append(columns,col)
  }
  for i in range(0,len(rows)) {
    let matches = []
    for j in range(0,len(outputs)) {
      if columns[j][i] == rows[i][2] { matches = append(matches,outputs[j]) }
    }
    fits = append(fits,matches)
  }
  for f in range(0,len(outputs)) {
    if not contains(columns[f],null) {
      let comparisons = []
      if f < len(skills) {
        for t in range(0-4,5) { comparisons = append(comparisons,[Q(t),null,t]) }
      }
      for j in range(0,len(outputs)) {
        if f != j and (f < len(skills) or j < len(skills)) and not contains(columns[j],null) {
          comparisons = append(comparisons,[outputs[j],columns[j],0])
        }
      }
      for comparison in comparisons {
        let diffs = columns[f]
        let threshold = comparison[2]
        if comparison[1] != null {
          diffs = []
          for i in range(0,len(rows)) { diffs = append(diffs,columns[f][i]-comparison[1][i]) }
        }
        gpu for value in diffs -> left {
          let left = 0
          if value < threshold { let left = 1 }
        }
        let yesfits = outputs
        let nofits = outputs
        for i in range(0,len(rows)) {
          let side = aget(left,i)
          let branch = if side == 1 { yesfits } else { nofits }
          let keep = []
          for tree in branch { if contains(fits[i],tree) { keep = append(keep,tree) } }
          if side == 1 { yesfits = keep } else { nofits = keep }
        }
        if len(yesfits) < len(outputs) and len(nofits) < len(outputs) {
          let gate = O("<",[outputs[f],comparison[0]])
          for a in yesfits {
            for b in nofits {
              if a != b {
                let model = O("ite",[gate,a,b])
                let valid = true
                for ex in rows { if sev(model,null,ex[1],null,[]) != ex[2] { valid = false } }
                if valid { models = append(models,model) }
              }
            }
          }
        }
      }
    }
  }
  return models
}

skill wn_probe_worst(models,probe) -> Any {
  let buckets = {}
  let worst = 0
  for model in models {
    let y = sev(model,null,probe,null,[])
    if y == null { return len(models) }
    let key = str(y)
    let count = get(buckets,key,0)+1
    buckets = put(buckets,key,count)
    worst = max(worst,count)
  }
  return worst
}

skill wn_switch_question(models,obs,reducer) -> Any {
  let longest = 2
  for ex in obs { if ex[0] == reducer { longest = max(longest,len(ex[1])) } }
  let best = null
  let bound = len(models)
  # Isolate a learned threshold by changing one lesson value at a time.
  let cuts = []
  let dynamic = []
  let endpoints = [O("head",[V("x")]),O("last",[V("x")])]
  for model in models {
    let gate = model[2][0]
    if gate[1] == "<" and gate[2][1][0] == "q" {
      let k = gate[2][1][1]
      if not contains(cuts,k) { cuts = append(cuts,k) }
    }
    if gate[1] == "<" and gate[2][1][0] == "op" {
      if not contains(endpoints,gate[2][0]) or not contains(endpoints,gate[2][1]) {
        for operand in gate[2] {
          if not contains(dynamic,operand) { dynamic = append(dynamic,operand) }
        }
      }
    }
  }
  for ex in obs {
    if ex[0] == reducer {
      let xs = ex[1]
      let values = cuts
      for operand in dynamic {
        let v = sev(operand,null,xs,null,[])
        if v != null and not contains(values,v) { values = append(values,v) }
      }
      for k in values {
        for i in range(0,len(xs)) {
          let probe = slice(xs,0,i) ++ [k] ++ slice(xs,i+1,len(xs))
          let worst = wn_probe_worst(models,probe)
          if worst < bound {
            best = probe
            bound = worst
          }
          if bound == 1 { return best }
        }
      }
    }
  }
  for n in range(2,2*longest+4) {
    let inner = range(1,n-1)
    for ends in [[0,0],[0,n],[n,0]] {
      let probe = [ends[0]] ++ inner ++ [ends[1]]
      let worst = wn_probe_worst(models,probe)
      if worst < bound {
        best = probe
        bound = worst
      }
      if bound == 1 { return best }
    }
  }
  return best
}

skill wn_reply(obs,reducer,xs,teaching) -> Any {
  return wn_book_reply({}, "",obs,reducer,xs,teaching)
}

skill wn_book_reply(book,word,obs,reducer,xs,teaching) -> Any {
  let result = wn_search(obs,reducer)
  let models = result[0]
  if result[1] {
    for ex in obs {
      if not teaching and ex[0] == reducer and ex[1] == xs { return str(ex[2]) }
    }
    return "Endpoint threshold search is incomplete. Teach another example."
  }
  let ids = []
  let positional = false
  if len(models) == 0 {
    ids = wn_position_ids(obs,reducer)
    models = wn_position_models(obs,reducer,ids)
    positional = len(models) > 0
  }
  let switching = false
  if len(models) == 0 and len(keys(book)) > 1 {
    models = wn_switches(book,word,reducer)
    switching = len(models) > 0
  }
  if len(models) == 0 { return null }
  if teaching {
    if switching {
      if len(models) == 1 { return "Conditional hypothesis: " ++ show(models[0]) }
      let probe = wn_switch_question(models,obs,reducer)
      if probe != null { return "Conditional hypotheses disagree. Teach the answer for " ++ hm_csv(probe) ++ "." }
      return "Multiple conditional hypotheses fit the lessons."
    }
    if positional {
      if len(models) == 1 { return "Position hypothesis: " ++ show(models[0]) }
      let message = str(len(models)) ++ " position hypotheses fit the lessons."
      let probe = wn_position_question(ids,models)
      if probe != null { return message ++ " Teach the answer for " ++ hm_csv(probe) ++ "." }
      return message
    }
    if len(models) == 1 { return "Endpoint hypothesis: " ++ show(models[0]) }
    return str(len(models)) ++ " endpoint hypotheses fit the lessons."
  }
  let y = sev(models[0],null,xs,null,[])
  let answers = []
  let agree = true
  for model in models {
    let value = sev(model,null,xs,null,[])
    answers = append(answers,value)
    if value != y { agree = false }
  }
  if not agree {
    if switching { return "Conditional hypotheses disagree. Teach the answer for " ++ hm_csv(xs) ++ "." }
    if positional { return "Position hypotheses disagree. Teach the answer for " ++ hm_csv(xs) ++ "." }
    let probe = wn_probe(obs,reducer,xs,models,answers)
    let parts = []
    for n in probe { parts = append(parts,str(n)) }
    return "Endpoint hypotheses disagree. Teach the answer for " ++ join(parts,",") ++ "."
  }
  if y == null { return "Meaning undefined for this input." }
  return str(y)
}
