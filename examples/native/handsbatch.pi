# handsbatch IN OUT [maxtokens] [edits file]: each question in IN (separated by "@@@TEXT@@@") goes to the brain with hands (hthink);
# OUT gets one record per question, records separated by "@@@REC@@@": "tokens|programs|ms|stopped" then a line, the
# answer, "@@@ALL@@@", the whole conversation (rewritten after every question)
import "brain.pi"

skill main() -> Any {
  # arg 4: an edits file, or - for none
  let ed = arg(4)
  if ed == "-" { let ed = null }
  let br = brain_open_with(ed)
  if typeof(br) == "text" { return br }
  let maxt = 10000
  if arg(3) != null { let maxt = rd_int(arg(3)) }
  # arg 5: the thinking cap per turn (0 or absent: none)
  let cap = 0
  if arg(5) != null { let cap = rd_int(arg(5)) }
  let qs = split(read_file(arg(1)), "@@@TEXT@@@")
  let out = ""
  let k = 0
  for q in qs {
    if len(trim(q)) > 0 {
      let mm = mark()
      let t0 = ticks()
      let r = hthinkc(br, trim(q), maxt, cap)
      let rec = str(r[2]) ++ "|" ++ str(r[4]) ++ "|" ++ str(ticks() - t0) ++ "|" ++ str(r[3]) ++ "\n" ++ r[1] ++ "@@@ALL@@@" ++ r[5] ++ "@@@TH@@@" ++ r[0] ++ "@@@REC@@@"
      let out = release(mm, out ++ rec)
      do write_file(arg(2), out)
      let k = k + 1
    }
  }
  return "handsbatch: " ++ str(k) ++ " questions"
}
