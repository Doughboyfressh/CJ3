# bigint: whole numbers of any size. Small integers stay machine words; + - * // % ^ that would pass 2^62 give the
# exact big result instead of wrapping, and results that fit become small again. Expected output: computed by
# Python's exact integers (golden/bigint.out).
skill yn(c) -> Any {
  if c { return "yes" }
  return "no"
}

skill fact(n) -> Any {
  let r = 1
  for i in range(2, n + 1) { r = r * i }
  return r
}

skill fib(n) -> Any {
  let a = 0
  let b = 1
  for i in range(0, n) {
    let t = a + b
    a = b
    b = t
  }
  return a
}

skill digitsum(x) -> Any {
  let s = 0
  for c in chars(str(x)) { s += ord(c) - 48 }
  return s
}

skill main() -> Any {
  let p = 2 ^ 1000
  do print("2^1000 digits " ++ str(len(str(p))) ++ ", digit sum " ++ str(digitsum(p)))
  do print("2^1000 tail " ++ slice(str(p), 290, 302))
  let top = 4611686018427387903
  let up = top + 1
  do print("top + 1 = " ++ str(up) ++ " " ++ typeof(up) ++ ", back " ++ str(up - 1) ++ " same " ++ yn(up - 1 == top))
  let low = 0 - top - 1
  do print("low = " ++ str(low) ++ ", low - 1 = " ++ str(low - 1) ++ ", -low = " ++ str(0 - low) ++ ", abs " ++ str(abs(low - 5)))
  do print("square " ++ str(3037000500 * 3037000500) ++ " / neg " ++ str((0 - 3037000500) * 3037000500))
  do print("50! = " ++ str(fact(50)))
  do print("fib 300 = " ++ str(fib(300)))
  let t = 10 ^ 30
  do print("floor " ++ str(t // 7) ++ " " ++ str(t % 7) ++ " " ++ str((0 - t) // 7) ++ " " ++ str((0 - t) % 7))
  do print("floor neg divisor " ++ str(t // (0 - 7)) ++ " " ++ str(t % (0 - 7)) ++ " " ++ str((0 - t) // (0 - 7)) ++ " " ++ str((0 - t) % (0 - 7)))
  let u = 3 ^ 100
  let v = 7 ^ 40
  do print("big // big " ++ str(u // v) ++ " rem " ++ str(u % v) ++ " check " ++ yn((u // v) * v + u % v == u))
  do print("neg big // big " ++ str((0 - u) // v) ++ " rem " ++ str((0 - u) % v))
  do print("exact " ++ str((2 ^ 200) // (2 ^ 100)) ++ " " ++ str((2 ^ 200) % (2 ^ 100)))
  do print("powmod " ++ str((3 ^ 200) % 1000000007))
  let lit = 123456789012345678901234567890
  do print("literal " ++ str(lit * 2) ++ " " ++ str(0 - 98765432109876543210987654321))
  let n = num("123456789012345678901234567890")
  do print("num " ++ str(n + 1) ++ " equal " ++ yn(n == lit) ++ " " ++ typeof(n))
  do print("compare " ++ yn(2 ^ 100 < 2 ^ 101) ++ " " ++ yn(0 - 2 ^ 100 < 5) ++ " " ++ yn(2 ^ 64 > top) ++ " " ++ yn(2 ^ 64 == 18446744073709551616))
  do print("sorted " ++ str(sort([2 ^ 70, 5, 0 - 2 ^ 65, 3, 2 ^ 64])))
  do print("sum " ++ str(sum([top, top, top, 1])) ++ " min " ++ str(min(2 ^ 80, 0 - 2 ^ 80, 7)) ++ " max " ++ str(max(2 ^ 80, 2.5, 7)))
  let m = {}
  let m = put(m, 2 ^ 100, "found")
  do print("map key " ++ m[2 * 2 ^ 99])
  do print("mixed " ++ str(2 ^ 70 + 0.5) ++ " half " ++ str(2 ^ 61 / 2))
  do print("real print " ++ str(2.0 ^ 1000) ++ " " ++ str(0.0 - 1.5 * 10.0 ^ 20))
  do print("small " ++ str(7 // 2) ++ " " ++ str(0 - 7 // 2) ++ " " ++ str((0 - 7) % 2) ++ " " ++ str(2 ^ 10) ++ " " ++ typeof(2 ^ 10))
  return "done"
}
