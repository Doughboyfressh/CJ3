# Named positions are relative to each grid. Axis selectors 0, 1 and 2 mean
# first, middle and last; for even lengths the middle is the earlier of the two cells.
skill hc_sites() -> Any {
  return [[0,0], [0,2], [2,0], [2,2], [1,1], [0,1], [2,1], [1,0], [1,2]]
}

skill hc_pick(axis, tree) -> Any {
  if axis == 0 { return O("head",[tree]) }
  if axis == 2 { return O("last",[tree]) }
  let offset = O("//",[O("-",[O("len",[tree]),Q(1)]),Q(2)])
  return O("head",[O("drop",[offset,tree])])
}

skill hc_sensor(site) -> Any { return hc_pick(site[1],hc_pick(site[0],hd_hole())) }
skill hc_index(axis, size) -> Any { return axis * (size-1) // 2 }

skill hc_site_name(site) -> Any {
  if site == [1,1] { return "center" }
  return ["top","middle","bottom"][site[0]] ++ "-" ++ ["left","middle","right"][site[1]]
}

# Keep the original program notation for corner/constant rules. Name the sensors
# in new rules so users need not read the list slicing used to compute a midpoint.
skill hc_display(law) -> Any {
  if law[0] != "op" or law[1] != "iteG" { return show(law) }
  let parts = law[2]
  let guard = parts[0]
  if guard[0] != "op" or guard[1] != "==" { return show(law) }
  let args = guard[2]
  let left = null
  let right = null
  for site in hc_sites() {
    let sensor = hc_sensor(site)
    if sensor == args[0] { left = site }
    if sensor == args[1] { right = hc_site_name(site) }
  }
  if left == null { return show(law) }
  if args[1][0] == "q" {
    if not contains(left,1) { return show(law) }
    right = show(args[1])
  }
  if right == null { return show(law) }
  return "if(" ++ hc_site_name(left) ++ " == " ++ right ++ ", " ++ show(parts[1]) ++ ", " ++ show(parts[2]) ++ ")"
}

skill hc_cell(grid, site) -> Any {
  return grid[hc_index(site[0],len(grid))][hc_index(site[1],len(grid[0]))]
}

# A midpoint becomes a new feature once it can be distinct from the ends in a demonstration.
skill hc_visible(site, observations) -> Any {
  for ex in observations {
    if (site[0] != 1 or len(ex[1]) >= 3) and (site[1] != 1 or len(ex[1][0]) >= 3) { return true }
  }
  return false
}

# Each example lists the operations that reproduce its output. Intersect these
# lists separately on both sides of a proposed condition; both sides need evidence.
skill hc_fit_guard(pool, matches, values, target, guard) -> Any {
  let yes = range(0,len(pool))
  let no = yes
  let hits = 0
  for i in range(0,len(values)) {
    let hit = values[i] == target
    let prior = if hit { yes } else { no }
    let keep = []
    for id in prior { if contains(matches[i],id) { keep = append(keep,id) } }
    if len(keep) == 0 { return [] }
    if hit { yes = keep; hits += 1 } else { no = keep }
  }
  let laws = []
  if hits > 0 and hits < len(values) {
    for a in yes { for b in no { laws = append(laws,O("iteG",[guard,pool[a],pool[b]])) } }
  }
  return laws
}

skill hc_laws(pool, observations) -> Any {
  if len(observations) < 2 { return [] }
  let matches = []
  for ex in observations {
    let region = mark()
    let ids = []
    for i in range(0,len(pool)) {
      if ht_run(pool[i],ex[1]) == ex[2] { ids = append(ids,i) }
    }
    ids = release(region,ids)
    if len(ids) == 0 { return [] }
    matches = append(matches,ids)
  }
  let laws = []
  let sensors = []
  let columns = []
  for site in hc_sites() {
    if hc_visible(site,observations) {
      let values = []
      let labels = []
      for ex in observations {
        let value = hc_cell(ex[1],site)
        values = append(values,value)
        if not contains(labels,value) { labels = append(labels,value) }
      }
      let sensor = hc_sensor(site)
      for label in labels {
        let guard = O("==",[sensor,Q(label)])
        laws = laws ++ hc_fit_guard(pool,matches,values,label,guard)
      }
      # Equality is symmetric, so compare each unordered pair just once.
      for j in range(0,len(columns)) {
        let equal = []
        for i in range(0,len(values)) { equal = append(equal,columns[j][i] == values[i]) }
        let guard = O("==",[sensors[j],sensor])
        laws = laws ++ hc_fit_guard(pool,matches,equal,true,guard)
      }
      sensors = append(sensors,sensor)
      columns = append(columns,values)
    }
  }
  return laws
}

skill hc_change(grid, site, value) -> Any {
  let y = hc_index(site[0],len(grid))
  let row = grid[y]
  let x = hc_index(site[1],len(row))
  let changed = slice(row,0,x) ++ [value] ++ slice(row,x+1,len(row))
  return slice(grid,0,y) ++ [changed] ++ slice(grid,y+1,len(grid))
}

# Compile the ASTs once per question so probing needs only nine cell reads and
# at most nine transformed outputs per candidate grid, regardless of the number of laws.
skill hc_plan(laws) -> Any {
  let sites = hc_sites()
  let sensors = {}
  for i in range(0,len(sites)) { sensors = put(sensors,hd_token(hc_sensor(sites[i])),i) }
  let pool = ht_pool("grid")
  let ops = {}
  for i in range(0,len(pool)) { ops = put(ops,hd_token(pool[i]),i) }
  let labels = []
  let pairs = []
  let tests = []
  for law in laws {
    let parts = law[2]
    let operands = parts[0][2]
    let lhs = sensors[hd_token(operands[0])]
    let rhs = -1
    let value = null
    if operands[1][0] == "q" {
      value = operands[1][1]
      if not contains(labels,value) { labels = append(labels,value) }
    } else {
      rhs = sensors[hd_token(operands[1])]
      if not contains(pairs,[lhs,rhs]) { pairs = append(pairs,[lhs,rhs]) }
    }
    tests = append(tests,[lhs,rhs,value,ops[hd_token(parts[1])],ops[hd_token(parts[2])]])
  }
  return {"sites":sites,"pool":pool,"tests":tests,"labels":labels,"pairs":pairs}
}

skill hc_worst(plan, grid, bound) -> Any {
  let m = mark()
  let cells = []
  for site in plan["sites"] { cells = append(cells,hc_cell(grid,site)) }
  let predictions = {}
  let groups = {}
  let largest = 0
  for test in plan["tests"] {
    let right = test[2]
    if test[1] >= 0 { right = cells[test[1]] }
    let op = if cells[test[0]] == right { test[3] } else { test[4] }
    let key = str(op)
    let answer = predictions[key]
    if answer == null {
      answer = ht_format("grid",ht_run(plan["pool"][op],grid))
      predictions = put(predictions,key,answer)
    }
    let count = get(groups,answer,0) + 1
    groups = put(groups,answer,count)
    largest = max(largest,count)
    if largest >= bound { return release(m,largest) }
  }
  return release(m,largest)
}

# Try constants, a fresh label to break equalities, and copying the other cell to
# make a relationship true. Compare only edits to one physical cell at a time.
skill hc_probe(plan, controls) -> Any {
  let best = null
  let worst = len(plan["tests"])
  let sites = plan["sites"]
  for grid in controls {
    let cells = []
    for site in sites { cells = append(cells,hc_cell(grid,site)) }
    let fresh = 0
    while contains(plan["labels"],fresh) or contains(cells,fresh) { fresh += 1 }
    for i in range(0,len(sites)) {
      let labels = append(plan["labels"],fresh)
      for pair in plan["pairs"] {
        let value = null
        if i == pair[0] { value = cells[pair[1]] }
        if i == pair[1] { value = cells[pair[0]] }
        if value != null and not contains(labels,value) { labels = append(labels,value) }
      }
      for label in labels {
        if label != cells[i] {
          let m = mark()
          let edit = hc_change(grid,sites[i],label)
          let score = hc_worst(plan,edit,worst)
          if score < worst {
            best = release(m,edit)
            worst = score
            if worst == 1 { return best }
          } else { do release(m,null) }
        }
      }
    }
  }
  return best
}

skill hc_question(laws, observations) -> Any {
  let plan = hc_plan(laws)
  let controls = []
  for ex in observations { controls = append(controls,ex[1]) }
  let best = hc_probe(plan,controls)
  if best != null { return best }
  # A neutral 3x3 grid puts every named site at a distinct location. Copying one
  # label makes exactly one pair equal, leaving seven other cells uniquely marked.
  let fresh = []
  let value = 0
  while len(fresh) < 9 {
    if not contains(plan["labels"],value) { fresh = append(fresh,value) }
    value += 1
  }
  let neutral = [slice(fresh,0,3),slice(fresh,3,6),slice(fresh,6,9)]
  let bound = hc_worst(plan,neutral,len(laws))
  let edit = hc_probe(plan,[neutral])
  if edit == null {
    if bound < len(laws) { return neutral }
    return null
  }
  if bound <= hc_worst(plan,edit,len(laws)) { return neutral }
  return edit
}
