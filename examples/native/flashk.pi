# flashk: flashgpu's fmv on real Qwen3.8 Flash Next weights (shard 2) -> out\flashk.txt, one line per test:
# "name n rows y0 y1 ..." for x[i] = sin(0.37 i + 0.1); checked against gguf-py's dequantization by flashk_check.py
import "flashgpu.pi"

skill SHARD2() -> Any { return "C:\\Users\\Dough\\.cache\\huggingface\\hub\\models--unsloth--Qwen3.8-Flash-Next-GGUF\\snapshots\\38bb39ee97821de2c9009abb7e93950eec396e66\\UD-IQ4_XS\\Qwen3.8-Flash-Next-UD-IQ4_XS-00002-of-00003.gguf" }

skill main() -> Any {
  let r = rt_gpu_open()
  if r != 1 { return "gpu open failed " ++ str(r) }
  print("gpu open")
  let fs = fg_kernels()
  print("kernels " ++ typeof(fs))
  if typeof(fs) == "text" { return fs }
  let m = open_model(SHARD2())
  print("model " ++ str(len(m[0])) ++ " tensors, data at " ++ str(m[1]))
  let xs = []
  for i in range(0, 10240) { xs ++= [sin(0.37 * i + 0.1)] }
  let dx = rt_gpu_alloc(8 * 10240)
  rt_gpu_put(dx, xs)
  let dy = rt_gpu_alloc(8 * 8192)
  let out = ""
  // name, expert (or -1), rows to test
  let tests = [["output.weight", 0 - 1, 64], ["output_hc_up.weight", 0 - 1, 64], ["output_hc_down.weight", 0 - 1, 64], ["output_hc_norm.weight", 0 - 1, 1], ["per_layer_token_embd.weight", 0 - 1, 100]]
  if arg(1) == "all" { tests = [["blk.0.ffn_gate_exps.weight", 0, 640], ["blk.0.ffn_down_exps.weight", 0, 2560], ["blk.0.attn_qkv.weight", 0 - 1, 64], ["blk.0.ffn_gate_inp.weight", 0 - 1, 512], ["blk.3.indexer.k_proj.weight", 0 - 1, 128], ["blk.0.ffn_up_exps.weight", 5, 640]] ++ tests }
  for tc in tests {
    let t = tensor(m, tc[0])
    if t == null { return "no tensor " ++ tc[0] }
    let n = t[1][0]
    let rb = fg_rowbytes(t[2], n)
    let per = rb * t[1][1]
    let off = m[1] + t[3]
    if tc[1] > 0 { off += tc[1] * per }
    let rows = tc[2]
    print(tc[0] ++ " type " ++ str(t[2]) ++ " n " ++ str(n) ++ " rb " ++ str(rb))
    let dw = rt_gpu_alloc(rb * rows)
    let got = rt_gpu_file(dw, SHARD2(), off, rb * rows)
    if got != rb * rows { return "short read of " ++ tc[0] ++ ": " ++ str(got) ++ " of " ++ str(rb * rows) ++ " bytes" }
    if arg(2) == "w" { fg_mvw(fs, dw, t[2], rb, n, rows, dx, dy, 1, 0) } else { fg_mv(fs, dw, t[2], rb, n, rows, dx, dy, 1, 0) }
    rt_gpu_sync()
    let ys = rt_gpu_get(dy, rows)
    out = out ++ tc[0] ++ " " ++ str(tc[1]) ++ " " ++ str(t[2]) ++ " " ++ str(n) ++ " " ++ str(rows) ++ " " ++ join(map(ys, fn(v) => format("{:.9f}", v)), " ") ++ "\n"
    rt_gpu_free(dw)
  }
  if arg(1) != "all" {
    write_file("out\\flashk.txt", out)
    return "flashk: " ++ str(len(tests)) ++ " tests written (the experts' IQ3_S needs arg all, once layer 0 is downloaded)"
  }
  // table mode: experts 0 and 5 of ffn_gate_exps in two slots (one input vector, xd = 2)
  let t = tensor(m, "blk.0.ffn_gate_exps.weight")
  let rb = fg_rowbytes(t[2], 2560)
  let per = rb * 640
  let slots = rt_gpu_alloc(2 * per)
  rt_gpu_file(slots, SHARD2(), m[1] + t[3], per)
  rt_gpu_file(slots + per, SHARD2(), m[1] + t[3] + 5 * per, per)
  // the table holds raw device pointers (8-byte words), one a slot
  let tab = rt_gpu_alloc(16)
  rt_gpu_put_u64(tab, [slots, slots + per])
  fg_mvx(fs, tab, t[2], rb, 2560, 640, 2, dx, 2, dy, 0)
  rt_gpu_sync()
  let ys = rt_gpu_get(dy, 1280)
  out = out ++ "table 0+5 21 2560 1280 " ++ join(map(ys, fn(v) => format("{:.9f}", v)), " ") ++ "\n"
  write_file("out\\flashk.txt", out)
  return "flashk: " ++ str(len(split(trim(out), "\n"))) ++ " tests written"
}
