import "doororder.pi"

# Learn from raw events. A model is [event, required count]; event 0 is
# elapsed actions, events 1..5 are visible action types. [-1,0] reads the
# switch now. Count thresholds generate the memory candidates uniformly.
skill dx_models() -> Any {
  let models = [[0-1,0]]
  for event in range(0,6) {
    for count in range(1,4) { models = append(models,[event,count]) }
  }
  return models
}

# Six saturated counters suffice for predicting the complete candidate family.
skill dx_update(counts,event) -> Any {
  let next = []
  for i in range(0,6) {
    let c = counts[i]
    if i == 0 or i == event { c = min(3,c+1) }
    next = append(next,c)
  }
  return next
}

skill dx_predict(model,on,counts) -> Any {
  if model[0] < 0 { return on }
  return if counts[model[0]] >= model[1] { 1 } else { 0 }
}

# Predict a crossing from the observable history, with counters cached by
# the caller. Search and replay share the projected-context transition.
skill dx_history_predict(m,events,on,counts) -> Any {
  if m[0] == 0-3 {
    return if contains(m[3],dx_context(m,events)) { 1 } else { 0 }
  }
  if m[0] == 0-2 { return sev(m[4],null,events,null,[]) }
  return dx_predict(m,on,counts)
}

skill dx_filter(models,on,counts,outcome) -> Any {
  let keep = []
  for m in models {
    if dx_predict(m,on,counts) == outcome { keep = append(keep,m) }
  }
  return keep
}

skill dx_event(kind,on) -> Any {
  if kind == 3 { return if on == 0 { 2 } else { 3 } }
  if kind == 1 { return 4 }
  if kind == 2 { return 5 }
  return 1
}

skill dx_zero() -> Any { return [0,0,0,0,0,0] }

# Search reachable histories shared by all surviving models. A diagnostic
# path ends at the first crossing that splits them; ties cost fewest actions.
# A goal path ends at the exit. The simulator's hidden mode is never passed.
skill dx_path(room,models,experiment) -> Any {
  let ordinary = []
  let ordered = []
  let initial = []
  for model in models {
    if model[0] <= 0-2 {
      ordered = append(ordered,model)
      initial = append(initial,if model[0] == 0-3 { [] } else { 0 })
    } else { ordinary = append(ordinary,model) }
  }
  let queue = [[room[0],0,dx_zero(),[],initial]]
  let index = 0
  let seen = {}
  let best = null
  let bound = len(models)
  while index < len(queue) {
    let item = queue[index]
    index = index+1
    let pos = item[0]
    let on = item[1]
    let counts = item[2]
    for a in dw_actions(room,pos) {
      let kind = a[1]
      let path = append(item[3],a)
      let dest = a[0]
      if kind == 1 {
        let yes = len(dx_filter(ordinary,on,counts,1))
        for i in range(0,len(ordered)) {
          let state = item[4][i]
          let open = if ordered[i][0] == 0-3 { contains(ordered[i][3],state) } else { state == 2 }
          if open { yes = yes+1 }
        }
        if yes > 0 and yes < len(models) {
          let worst = max(yes,len(models)-yes)
          if experiment and worst < bound {
            best = path
            bound = worst
            if 2*bound <= len(models)+1 { return best }
          }
          # The successor is uncertain; never plan past this crossing.
          dest = null
        } else {
          if yes == 0 { dest = pos }
        }
      }
      if kind == 2 and on == 1 { dest = pos }
      if dest != null {
        if dest == room[1] and not experiment { return path }
        let bit = if kind == 3 { 1-on } else { on }
        let event = dx_event(kind,on)
        let next = if len(ordinary) == 0 { counts } else { dx_update(counts,event) }
        let states = dx_order_next(item[4],ordered,event)
        let key = str([dest,bit,next,states])
        if dest != room[1] and seen[key] == null {
          seen = put(seen,key,true)
          queue = append(queue,[dest,bit,next,path,states])
        }
      }
    }
  }
  return best
}

skill dx_rows(text) -> Any {
  let rows = []
  if text == null or text == "" { return rows }
  if slice(text,len(text)-1,len(text)) != "\n" { return null }
  for line in split(text,"\n") {
    if line != "" {
      let parts = split(line," ")
      if len(parts) != 3 or parts[0] != "door2" { return null }
      let events = hm_numbers(parts[1])
      let y = hm_number(parts[2])
      if events == null or (y != 0 and y != 1) { return null }
      let on = 0
      for e in events {
        if e < 1 or e > 5 { return null }
        if (e == 2 and on == 1) or (e == 3 and on == 0) { return null }
        if e == 2 or e == 3 { on = 1-on }
      }
      let row = [events,y]
      if not contains(rows,row) { rows = append(rows,row) }
    }
  }
  return rows
}

skill dx_refit(rows) -> Any {
  let models = dx_models()
  for row in rows {
    let counts = dx_zero()
    let on = 0
    for e in row[0] {
      if e == 2 or e == 3 { on = 1-on }
      counts = dx_update(counts,e)
    }
    models = dx_filter(models,on,counts,row[1])
  }
  if len(models) == 0 { models = dx_order_fit(rows) }
  if len(models) == 0 { return dx_context_fit(rows) }
  return models
}

# A generated corridor has two doors, a starting switch, and an alcove
# switch behind the first door. Moving the doors changes the optimal route.
skill dx_layout(layout) -> Any {
  if layout == "hall" or layout == "annex" { return dw_layout(layout) }
  let f = split(layout,"-")
  if len(f) != 3 or f[0] != "corridor" { return null }
  let size = hm_number(f[1])
  let door = hm_number(f[2])
  if size == null or door == null { return null }
  if size < 4 or size > 16 or door < 1 or door >= size-2 { return null }
  let edges = []
  for i in range(0,size-1) {
    let kind = if i == door { 1 } else { if i == size-2 { 2 } else { 0 } }
    edges = append(edges,[i,i+1,kind])
  }
  return [0,size-1,[0,size],append(edges,[door+1,size,0])]
}

skill dx_run(layout,mode,path) -> Any {
  let room = dx_layout(layout)
  if room == null or not contains(["follow","latch","retry","delay","sequence","rearm"],mode) {
    return "Usage: heed explore hall|annex|corridor-SIZE-DOOR follow|latch|retry|delay|sequence|rearm [event-file]"
  }
  let rows = []
  if path != null { rows = dx_rows(read_file(path)) }
  if rows == null { return "Invalid door event file." }
  let models = dx_refit(rows)
  let experiments = 0
  let steps = 0
  let widened = len(models) > 0 and models[0][0] <= 0-2
  while len(models) > 0 {
    let testing = len(models) > 1
    let plan = dx_path(room,models,testing)
    if testing and plan == null {
      testing = false
      plan = dx_path(room,models,false)
    }
    if plan == null and not widened {
      models = models ++ dx_order_fit(rows)
      widened = true
      testing = true
      plan = dx_path(room,models,true)
    }
    if plan == null { return "No distinguishing experiment or common route available." }
    if testing { experiments = experiments+1 }
    # Each trial begins in a fresh copy of the public layout.
    let world = [room[0],0,0]
    let attempts = 0
    let ticks = 0
    let armed = false
    let first_on = null
    let first_attempt = null
    let expanded = false
    let events = []
    let counts = dx_zero()
    let before = len(models)
    let step = 0
    while step < len(plan) and not expanded {
      let a = plan[step]
      step = step+1
      let event = dx_event(a[1],world[1])
      let override = 0-1
      if a[1] == 1 and (mode == "retry" or mode == "delay") {
        # Independent simulator counters; the learner sees only the resulting move.
        let open = (mode == "retry" and attempts > 0) or (mode == "delay" and ticks >= 3)
        override = if open { 1 } else { 0 }
      }
      if mode == "sequence" and a[1] == 1 {
        override = if first_on != null and first_attempt != null and first_attempt < first_on { 1 } else { 0 }
      }
      if mode == "rearm" and a[1] == 1 { override = if armed { 1 } else { 0 } }
      if event == 2 { armed = false }
      if event == 4 { armed = true }
      if first_on == null and event == 2 { first_on = ticks }
      if first_attempt == null and event == 4 { first_attempt = ticks }
      let next = dw_step(world,a,mode == "latch",override)
      if a[1] == 1 { attempts = attempts+1 }
      ticks = ticks+1
      steps = steps+1
      if a[1] == 1 {
        let y = if next[0] == a[0] { 1 } else { 0 }
        let row = [events,y]
        if not contains(rows,row) {
          if path != null {
            if not rt_append_file(path,"door2 " ++ hm_csv(events) ++ " " ++ str(y) ++ "\n") { return "Could not save events." }
          }
          rows = append(rows,row)
        }
        let keep = []
        for m in models {
          let predicted = dx_history_predict(m,events,world[1],counts)
          if predicted == y { keep = append(keep,m) }
        }
        if len(keep) == 0 and not widened {
          keep = dx_order_fit(rows)
          widened = true
          expanded = true
        }
        if len(keep) == 0 {
          keep = dx_context_fit(rows)
          expanded = true
        }
        models = keep
        if len(models) == 0 { return "No bounded door memory fits the observations." }
      }
      events = append(events,event)
      counts = dx_update(counts,event)
      world = next
    }
    if not testing and not expanded {
      if world[0] != room[1] { return "Predicted route failed." }
      let m = models[0]
      let rule = "current switch"
      if m[0] >= 0 {
        let names = ["elapsed actions","passage attempts","switch-on events","switch-off events","first-door attempts","second-door attempts"]
        rule = names[m[0]] ++ " >= " ++ str(m[1])
      }
      if m[0] == 0-2 {
        let names = ["passage","switch-on","switch-off","first-door attempt","second-door attempt"]
        let a = names[m[1]-1]
        let b = names[m[2]-1]
        rule = if m[3] == 0 { a ++ " occurred before the first " ++ b ++ "; both occurred" } else {
          if m[3] == 1 { a ++ " followed later by " ++ b } else { a ++ " was first of {" ++ a ++ ", " ++ b ++ "}" }
        }
      }
      if m[0] == 0-3 { rule = "last " ++ str(m[2]) ++ " of " ++ str(m[1]) ++ " opens for " ++ str(m[3]) }
      if len(models) > 1 { rule = str(len(models)) ++ " consistent candidates" }
      return layout ++ " exit; rule " ++ rule ++ "; experiments " ++ str(experiments) ++ "; actions " ++ str(steps)
    }
    if not expanded and len(models) >= before { return "Experiment failed to distinguish candidates." }
  }
  return "Stored observations contradict the candidate family."
}

# Fit on the saved observations once and score a separate log without
# allowing held-out outcomes to update the memory.
skill dx_score(train_path,test_path) -> Any {
  if train_path == null or test_path == null { return "Usage: heed explore-score TRAIN TEST" }
  let train = dx_rows(read_file(train_path))
  let test = dx_rows(read_file(test_path))
  if train == null or test == null or len(train) == 0 or len(test) == 0 { return "Expected two nonempty event logs." }
  let models = dx_refit(train)
  if len(models) == 0 { return "No bounded door memory fits the observations." }
  let right = 0
  let disputed = 0
  for row in test {
    for known in train { if known[0] == row[0] { return "Training and scoring histories overlap." } }
    let on = 0
    let counts = dx_zero()
    for event in row[0] {
      if event == 2 or event == 3 { on = 1-on }
      counts = dx_update(counts,event)
    }
    let yes = 0
    for m in models { yes = yes+dx_history_predict(m,row[0],on,counts) }
    if yes > 0 and yes < len(models) { disputed = disputed+1 } else {
      if (yes > 0 and row[1] == 1) or (yes == 0 and row[1] == 0) { right = right+1 }
    }
  }
  return str(right) ++ "/" ++ str(len(test)) ++ " correct; " ++ str(disputed) ++ " disputed"
}
