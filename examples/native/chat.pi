# Native Pi dialogue with persistent facts and searchable notes.
import "conversation.pi"
import "notes.pi"
import "chatlessons.pi"

skill main() -> Any {
  # Console output uses UTF-8.
  do rt_console_utf8()
  if arg(1) == "memory" { return hm_command(arg(2),arg(3),arg(4),arg(5),arg(6)) }
  if arg(1) == "--remember" or arg(1) == "--recall" {
    let words = []
    let i = 2
    while arg(i) != null {
      let words = append(words, arg(i))
      let i = i + 1
    }
    return note_command(arg(1) == "--remember",join(words," "))
  }
  if arg(1) != null { return "Usage: chat [--remember NOTE | --recall QUERY | memory FILE teach|use PHRASE LIST [ANSWER]]" }
  let pending = chat_saved_probe()
  let st = load_facts("out/chat_facts.txt")
  if pending != null {
    let st = put(st,"lesson_probe",pending)
    do print(hm_prompt(pending[0][1],[pending[0][0],pending[1]]))
  }
  return converse_with("out/chat_facts.txt",chat_handle,st)
}
