# nested loops, %, early return, booleans
skill is_prime(n) -> Any {
  if n < 2 { return false }
  let d = 2
  while d * d <= n {
    if n % d == 0 { return false }
    let d = d + 1
  }
  return true
}

skill main() -> Any {
  let count = 0
  for k in range(2, 20000) {
    if is_prime(k) { let count = count + 1 }
  }
  return count
}
