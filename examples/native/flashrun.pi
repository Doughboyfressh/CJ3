# flashrun [dump] TOKEN_ID ...: Qwen3.8 Flash Next on Pi's engine -- one pass over the tokens, the top 5 next tokens
# (dump: each layer's residual to out\flash_L<i>.bin, for the check against the numpy reference)
import "flash.pi"

skill main() -> Any {
  let t0 = ticks()
  let fl = fl_open()
  if typeof(fl) == "text" { return fl }
  print("open: " ++ str(fl["dense"] // 1000000) ++ " MB of dense weights on the GPU, " ++ str(ticks() - t0) ++ " ms")
  let dump = arg(1) == "dump"
  let i = if dump { 2 } else { 1 }
  let toks = []
  while arg(i) != null {
    toks ++= [int(arg(i))]
    i += 1
  }
  let t1 = ticks()
  let top = null
  let p = 0
  while p < len(toks) {
    let n = min(FL_TMAX(), len(toks) - p)
    top = fl_forward(fl, toks, p, p, n, dump)
    p += n
  }
  let ctr = fl["ctr"]
  print(str(len(toks)) ++ " tokens in " ++ str(ticks() - t1) ++ " ms; experts loaded " ++ str(aget(ctr, 1)) ++ ", reused " ++ str(aget(ctr, 2)))
  return top
}
