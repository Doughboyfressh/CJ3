# Kimi has two attentions. DSA keeps the top 2048 indexer scores.
# KDA is a memory: decay every slot, erase the written key, then write the value.
# Orthogonal keys do not clobber each other. A second write replaces only its own key.
# A zero write keeps the state. A zero decay clears it.
# The values 4, 6, 1 and the state [3, 8] are not the examples the formula was checked on before.
# young is not here. The indexer weights were not read.
skill attend(s, beta, k, alpha, v) -> Any {
  let d0 = alpha[0] * s[0]
  let d1 = alpha[1] * s[1]
  let proj = k[0] * d0 + k[1] * d1
  let y0 = d0 - beta * k[0] * proj + beta * k[0] * v
  let y1 = d1 - beta * k[1] * proj + beta * k[1] * v
  return [y0, y1]
}
skill read(s, k) -> Any { return k[0] * s[0] + k[1] * s[1] }
skill top2(xs) -> Any {
  let used = arr(len(xs))
  let out = []
  for n in range(0, 2) {
    let bi = 0
    let best = 0
    let seen = 0
    for i in range(0, len(xs)) {
      if aget(used, i) == 0 {
        if seen == 0 {
          let best = xs[i]
          let bi = i
          let seen = 1
        }
        if xs[i] > best {
          let best = xs[i]
          let bi = i
        }
      }
    }
    do aset(used, bi, 1)
    let out = append(out, bi)
  }
  return out
}

skill main() -> Any {
  let s = attend([0, 0], 1, [1, 0], [1, 1], 5)
  let s = attend(s, 1, [0, 1], [1, 1], 7)
  let both = s
  let s = attend(s, 1, [1, 0], [1, 1], 9)
  let kept = attend(s, 0, [1, 0], [1, 1], 100)
  let cleared = attend(s, 0, [1, 0], [0, 0], 100)
  let h = attend([0, 0], 1, [1, 0], [1, 1], 4)
  let h = attend(h, 1, [0, 1], [1, 1], 6)
  let h = attend(h, 1, [1, 0], [1, 1], 1)
  let faded = attend(h, 0, [0, 1], [1, 0], 0)
  let mixed = attend([3, 8], 1, [1, 1], [1, 1], 2)
  let ab = attend(attend([0, 0], 1, [1, 0], [1, 1], 4), 1, [0, 1], [1, 1], 6)
  let ba = attend(attend([0, 0], 1, [0, 1], [1, 1], 6), 1, [1, 0], [1, 1], 4)
  let text = "attention keeps a key\n"
  let slot = rt_sw_ssd_alloc(64)
  let other = rt_sw_ssd_alloc(8)
  do rt_sw_ssd_puts(slot, text)
  do rt_sw_ssd_puts(other, "x")
  let p = rt_sw_pg()
  let got = rt_sw_ssd_gets(slot)
  let readp = rt_sw_pg() - p
  print(both == [5, 7])
  print(s == [9, 7])
  print(read(s, [1, 0]) == 9)
  print(read(s, [0, 1]) == 7)
  print(kept == [9, 7])
  print(cleared == [0, 0])
  print(h == [1, 6])
  print(faded == [1, 0])
  print(mixed == [0 - 6, 0 - 1])
  print(read(mixed, [1, 1]) == 0 - 7)
  print(ab == ba)
  print(ab == [4, 6])
  print(top2([3, 9, 1, 8, 4, 2, 7, 0]) == [1, 3])
  print(32 * 128 == 4096)
  print(512 * 3 == 1536)
  print(23 + 1 == 24)
  print(93 - 24 == 69)
  print(readp == 1024)
  print(got == text)
  return 0
}
