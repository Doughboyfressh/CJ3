# Train a two-input integer readout. When it misses a lesson, grow one
# rectifier of the endpoint gap. Its correction is zero on both pivot lessons.
# Keep the verified candidates so they can vote on a new input.
skill wn_hinge(row,k) -> Any { return max(0,row[0]-row[1]-k) }

skill wn_program(weights,k) -> Any {
  let head = O("head",[V("x")])
  let tail = O("last",[V("x")])
  let gap = O("-",[head,tail])
  if k != 0 { gap = O("-",[gap,Q(k)]) }
  let features = [head,tail,O("max",[Q(0),gap])]
  let tree = null
  for i in range(0,3) {
    let w = weights[i]
    if w != 0 {
      let term = features[i]
      if w != 1 { term = O("*",[Q(w),term]) }
      if tree == null { tree = term } else { tree = O("+",[tree,term]) }
    }
  }
  if tree == null { return Q(0) }
  return tree
}

skill wn_verify(rows,nums,den,k) -> Any {
  let weights = []
  for v in nums {
    if v % den != 0 { return null }
    weights = append(weights,v // den)
  }
  let tree = wn_program(weights,k)
  for r in rows {
    if sev(tree,null,r[3],null,[]) != r[2] { return null }
  }
  return tree
}

# Subtract the endpoint plane matching the hinge at the two anchors.
# The scaled residual is piecewise affine in the threshold k.
skill wn_plane(p,q,k) -> Any {
  let zp = wn_hinge(p,k)
  let zq = wn_hinge(q,k)
  return [zp*q[1]-p[1]*zq,p[0]*zq-zp*q[0]]
}

skill wn_gain(r,k,plane,d) -> Any {
  return d*wn_hinge(r,k)-plane[0]*r[0]-plane[1]*r[1]
}

# For a fit, each row and the missed lesson must need the same correction
# multiplier. Cross-multiply to avoid division. Between consecutive gaps
# this consistency equation is affine, so two endpoint values give its root.
skill wn_missing_knot(rows,p,q,miss,d,a,b,lo,hi) -> Any {
  let left = wn_plane(p,q,lo)
  let right = wn_plane(p,q,hi)
  let ml = wn_gain(miss,lo,left,d)
  let mr = wn_gain(miss,hi,right,d)
  let err = d*miss[2]-a*miss[0]-b*miss[1]
  for r in rows {
    let e = d*r[2]-a*r[0]-b*r[1]
    let l = e*ml-err*wn_gain(r,lo,left,d)
    let h = e*mr-err*wn_gain(r,hi,right,d)
    if l != 0 or h != 0 {
      if (l < 0) == (h < 0) or l == 0 or h == 0 { return null }
      let num = l*(hi-lo)
      let den = l-h
      if num % den != 0 { return null }
      return lo+num // den
    }
  }
  # These rows do not identify an isolated threshold in this interval.
  return null
}

skill wn_fit(obs,reducer) -> Any {
  let rows = []
  let knots = [0]
  let p = null
  let q = null
  for ex in obs {
    if ex[0] == reducer {
      let xs = ex[1]
      let r = [xs[0],xs[len(xs)-1],ex[2],xs]
      rows = append(rows,r)
      let gap = r[0]-r[1]
      if not contains(knots,gap) { knots = append(knots,gap) }
      if p == null {
        if r[0] != 0 or r[1] != 0 { p = r }
      } else {
        if q == null and p[0]*r[1] != p[1]*r[0] { q = r }
      }
    }
  }
  if q == null { return [] }
  let d = p[0]*q[1]-p[1]*q[0]
  let a = p[2]*q[1]-p[1]*q[2]
  let b = p[0]*q[2]-p[2]*q[0]
  let linear = wn_verify(rows,[a,b,0],d,0)
  if linear != null { return [linear] }
  let miss = null
  for r in rows {
    if d*r[2] != a*r[0]+b*r[1] { miss = r }
  }
  if miss == null { return [] }
  let boundaries = sort(knots)
  for i in range(1,len(boundaries)) {
    let lo = boundaries[i-1]
    let hi = boundaries[i]
    if hi-lo > 1 {
      let k = wn_missing_knot(rows,p,q,miss,d,a,b,lo,hi)
      if k != null { knots = append(knots,k) }
    }
  }
  let models = []
  for k in knots {
    # d*hinge - u*head - v*last vanishes on p and q by construction.
    let plane = wn_plane(p,q,k)
    let u = plane[0]
    let v = plane[1]
    let gain = wn_gain(miss,k,plane,d)
    if gain != 0 {
      let err = d*miss[2]-a*miss[0]-b*miss[1]
      let model = wn_verify(rows,[a*gain-err*u,b*gain-err*v,d*err],d*gain,k)
      if model != null { models = append(models,model) }
    }
  }
  return models
}

skill wn_reply(obs,reducer,xs,teaching) -> Any {
  let models = wn_fit(obs,reducer)
  if len(models) == 0 { return "Observations saved. Bounded search found no consistent meaning." }
  if teaching {
    if len(models) == 1 { return "Endpoint hypothesis: " ++ show(models[0]) }
    return str(len(models)) ++ " endpoint hypotheses fit the lessons."
  }
  let y = sev(models[0],null,xs,null,[])
  for model in models {
    if sev(model,null,xs,null,[]) != y { return "Endpoint hypotheses disagree on this input. Teach its answer." }
  }
  if y == null { return "Meaning undefined for this input." }
  return str(y)
}
