# render SCENE OUT.png [width] [height] [samples]: a scene in Pi's GPU dialect (see shade.pi, shadelib.pi) -> a picture,
# light traced on the GPU by Pi's own code. No model, no library.
import "shade.pi"

skill main() -> Any {
  if arg(1) == null or arg(2) == null { return "render SCENE OUT.png [width] [height] [samples]" }
  let src = read_file(arg(1))
  if src == null { return "cannot read " ++ arg(1) }
  let w = if arg(3) != null { int(arg(3)) } else { 1280 }
  let h = if arg(4) != null { int(arg(4)) } else { 720 }
  let spp = if arg(5) != null { int(arg(5)) } else { 64 }
  sh_render(src, w, h, spp, arg(2))
  return 0
}
