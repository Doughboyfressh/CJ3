# JSON, read and written by Pi. json_parse(text) -> Pi values (maps, lists, integers, reals, text, true/false/null);
# json_text(value) -> text. Used to talk to services over the network (the ARC-AGI-3 game server).

skill js_ws(cs, i) -> Any {
  let n = len(cs)
  while i < n and (cs[i] == " " or cs[i] == "\n" or cs[i] == "\r" or cs[i] == "\t") { let i = i + 1 }
  return i
}

# -> [value, next position]
skill js_value(cs, i) -> Any {
  let i = js_ws(cs, i)
  let c = cs[i]
  if c == "{" {
    let m = {}
    let i = js_ws(cs, i + 1)
    if cs[i] == "}" { return [m, i + 1] }
    let going = true
    while going {
      let k = js_value(cs, i)
      let i = js_ws(cs, k[1])
      let v = js_value(cs, i + 1)
      let m = put(m, k[0], v[0])
      let i = js_ws(cs, v[1])
      if cs[i] == "," { let i = i + 1 } else { let going = false }
    }
    return [m, i + 1]
  }
  if c == "[" {
    let out = []
    let i = js_ws(cs, i + 1)
    if cs[i] == "]" { return [out, i + 1] }
    let going = true
    while going {
      let v = js_value(cs, i)
      let out = append(out, v[0])
      let i = js_ws(cs, v[1])
      if cs[i] == "," { let i = i + 1 } else { let going = false }
    }
    return [out, i + 1]
  }
  if c == "\"" {
    let parts = []
    let j = i + 1
    while cs[j] != "\"" {
      if cs[j] == "\\" {
        let e = cs[j + 1]
        if e == "n" { let parts = append(parts, "\n") } else {
          if e == "t" { let parts = append(parts, "\t") } else { let parts = append(parts, e) }
        }
        let j = j + 2
      } else {
        let parts = append(parts, cs[j])
        let j = j + 1
      }
    }
    return [join(parts, ""), j + 1]
  }
  if c == "t" { return [true, i + 4] }
  if c == "f" { return [false, i + 5] }
  if c == "n" { return [null, i + 4] }
  # a number: integers fast, anything with a fraction or exponent through num()
  let neg = false
  let j = i
  if c == "-" {
    let neg = true
    let j = j + 1
  }
  let v = 0
  let n = len(cs)
  while j < n and contains("0123456789", cs[j]) {
    let v = v * 10 + ord(cs[j]) - 48
    let j = j + 1
  }
  if j < n and (cs[j] == "." or cs[j] == "e" or cs[j] == "E") {
    while j < n and contains("0123456789.eE+-", cs[j]) { let j = j + 1 }
    return [num(join(slice(cs, i, j), "")), j]
  }
  if neg { return [0 - v, j] }
  return [v, j]
}

skill json_parse(text) -> Any { return js_value(chars(text), 0)[0] }

skill json_text(v) -> Any {
  let t = typeof(v)
  if t == "null" { return "null" }
  if t == "bool" {
    if v { return "true" }
    return "false"
  }
  if t == "int" or t == "real" { return str(v) }
  if t == "text" { return "\"" ++ v ++ "\"" }
  if t == "list" {
    let parts = []
    for x in v { let parts = append(parts, json_text(x)) }
    return "[" ++ join(parts, ",") ++ "]"
  }
  let parts = []
  for k in keys(v) { let parts = append(parts, "\"" ++ k ++ "\":" ++ json_text(v[k])) }
  return "{" ++ join(parts, ",") ++ "}"
}
