import "witnessnet.pi"

# the hole in a step. Mind and Heed both use it, so it lives with the lesson file.
skill hd_hole() -> Any { return ["v", "_"] }

skill hd_holed(t) -> Any {
  if t[0] == "v" {
    if isinput(t[1]) { return hd_hole() }
    return t
  }
  if t[0] == "q" or t[0] == "p" { return t }
  let out = []
  for a in t[2] { let out = append(out, hd_holed(a)) }
  return [t[0], t[1], out]
}

skill hd_plug(t, v) -> Any {
  if t[0] == "v" {
    if t[1] == "_" { return v }
    return t
  }
  if t[0] == "q" or t[0] == "p" { return t }
  let out = []
  for a in t[2] { let out = append(out, hd_plug(a, v)) }
  return [t[0], t[1], out]
}

# Durable list-word lessons. An observation names the operation, the word, the input and the result.
# A replay derives meanings from the evidence, including corrections to an earlier observation.
skill hm_reducers() -> Any { return ["product", "sum", "count", "largest", "smallest"] }

skill hm_reduce(name, input_tree) -> Any {
  if name == "product" { return O("fold", [O("*", [["p",0], V("e")]), Q(1), input_tree]) }
  let op = {"sum":"sum", "count":"len", "largest":"maxl", "smallest":"minl"}[name]
  return O(op, [input_tree])
}

# law = [pointwise expression in e, apply before reduction?]
skill hm_predict(law, ex) -> Any {
  let xs = ex[1]
  let inner = V("x")
  if law[1] { inner = O("map", [law[0], inner]) }
  let tree = hm_reduce(ex[0], inner)
  if not law[1] { tree = subst_e(law[0], tree) }
  return sev(tree, null, xs, null, [])
}

skill hm_fits(law, observations) -> Any {
  for ex in observations {
    if hm_predict(law, ex) != ex[2] { return false }
  }
  return true
}

# If the cheap explanations fail, synthesize a numeric program from the observations:
# after a reduction the input to the unknown function is known. A one-item sum or product
# also directly observes the element function. Check either proposal against ALL contexts.
skill hm_scalar(tree) -> Any {
  if tree[0] == "v" { return tree[1] == "n" }
  if tree[0] == "q" { return typeof(tree[1]) == "int" }
  if tree[0] != "op" or contains(["map","filter","gmap","fold","rec2"],tree[1]) { return false }
  for child in tree[2] { if not hm_scalar(child) { return false } }
  return true
}

skill hm_expand(observations) -> Any {
  let found = []
  let pl = pools()
  # Reuse the core searcher's scalar functions first. Jointly observing a sum and a
  # product can identify an element function even without any single-element example.
  for level in [1,3] {
    for candidate in pl[0][level] {
      for before in [true,false] {
        let law = [candidate[0],before]
        if hm_fits(law,observations) { found = append(found,law) }
      }
    }
  }
  if len(found) > 0 { return found }
  let pre = prelude()
  for before in [true, false] {
    let data = []
    for ex in observations {
      if not before or (len(ex[1]) == 1 and ex[0] != "count") {
        let x = sev(hm_reduce(ex[0], V("x")), null, ex[1], null, [])
        data = append(data, [x, ex[2]])
      }
    }
    if len(data) > 0 {
      let m = mark()
      let result = solve(data, [], [], [], pl, pre, 5, 1800)
      let tree = release(m, result[0])
      if tree != null and hm_scalar(tree) {
        # The scalar solver uses n. Its input becomes the element where the word is applied.
        let law = [hd_plug(hd_holed(tree), V("e")), before]
        if hm_fits(law, observations) { found = append(found, law) }
      }
    }
  }
  return found
}

skill hm_simple(observations) -> Any {
  let laws = []
  for k in range(0 - 4, 5) {
    for op in ["*", "+"] {
      for before in [true, false] {
        let law = [O(op, [V("e"), Q(k)]), before]
        if hm_fits(law, observations) { laws = append(laws, law) }
      }
    }
  }
  return laws
}

skill hm_laws(observations) -> Any {
  let m = mark()
  let laws = hm_simple(observations)
  if len(laws) == 0 { laws = hm_expand(observations) }
  return release(m,laws)
}

# Minimize the largest surviving group after an exact answer. Ignore measurements where
# any candidate is undefined, since undefined is not an instrument or teacher response.
skill hm_question(laws) -> Any {
  let best = null
  let worst = len(laws)
  for xs in [[2,3], [1], [3,5,7], [0-2,4], [0,1,3], [1,1]] {
    for reducer in hm_reducers() {
      let cells = {}
      let largest = 0
      let ok = true
      for law in laws {
        let y = hm_predict(law, [reducer, xs])
        if y == null { ok = false } else {
          let count = get(cells, str(y), 0) + 1
          cells = put(cells, str(y), count)
          largest = max(largest, count)
        }
      }
      if ok and largest < worst {
        worst = largest
        best = [reducer, xs]
        if worst == 1 { return best }
      }
    }
  }
  return best
}

# For a pending prediction, minimize the number of different target answers left
# in the worst reply bucket. Equivalent laws may stay unresolved.
skill hm_target_question(laws, target) -> Any {
  let predictions = []
  let outcomes = {}
  for law in laws {
    let answer = str(hm_predict(law,target))
    let predictions = append(predictions,answer)
    let outcomes = put(outcomes,answer,true)
  }
  let best = null
  let bound = len(keys(outcomes))
  for xs in [[0],[1],[2],[0-1],[2,3],[1,1],[0-2,4],[0,1,3],[3,5,7]] {
    if xs != target[1] {
      for reducer in hm_reducers() {
        let buckets = {}
        let worst = 0
        for i in range(0,len(laws)) {
          let reply = hm_predict(laws[i],[reducer,xs])
          if reply == null { let worst = bound }
          let key = str(reply)
          let answers = put(get(buckets,key,{}),predictions[i],true)
          let buckets = put(buckets,key,answers)
          let worst = max(worst,len(keys(answers)))
        }
        if worst < bound {
          let best = [reducer,xs]
          let bound = worst
          if bound == 1 { return best }
        }
      }
    }
  }
  return best
}

skill hm_word(s) -> Any {
  if s == null or s == "" { return false }
  for c in chars(s) { if not contains("abcdefghijklmnopqrstuvwxyz", c) { return false } }
  return true
}

skill hm_number(s) -> Any {
  if s == null or s == "" { return null }
  let start = if slice(s,0,1) == "-" { 1 } else { 0 }
  if len(s) == start { return null }
  for i in range(start,len(s)) {
    if not contains("0123456789", slice(s,i,i+1)) { return null }
  }
  let v = int(s)
  if str(v) != s { return null }
  return v
}

skill hm_numbers(csv) -> Any {
  if csv == null { return null }
  let xs = []
  for s in split(csv,",") {
    let v = hm_number(s)
    if v == null { return null }
    xs = append(xs,v)
  }
  if len(xs) == 0 { return null }
  return xs
}

skill hm_csv(xs) -> Any {
  let parts = []
  for x in xs { parts = append(parts,str(x)) }
  return join(parts,",")
}

skill hm_record(book, word, reducer, xs, y) -> Any {
  let updated = []
  for ex in get(book, word, []) {
    if ex[0] != reducer or ex[1] != xs { updated = append(updated,ex) }
  }
  return put(book,word,append(updated,[reducer,xs,y]))
}

skill hm_load(path) -> Any {
  return hm_book(read_file(path))
}

skill hm_book(text) -> Any {
  let book = {}
  if text == null or text == "" { return book }
  if slice(text,len(text)-1,len(text)) != "\n" { return null }
  for line in split(text,"\n") {
    if line != "" {
      let f = split(trim(line)," ")
      if f[0] == "compose1" {
        if hm_recipe(f) == null { return null }
      } else {
        if len(f) != 5 or f[0] != "heed1" { return null }
        if not hm_word(f[1]) or not contains(hm_reducers(),f[2]) { return null }
        let xs = hm_numbers(f[3])
        let y = hm_number(f[4])
        if xs == null or y == null { return null }
        book = hm_record(book,f[1],f[2],xs,y)
      }
    }
  }
  return book
}

skill hm_line(word, ex) -> Any {
  return "heed1 " ++ word ++ " " ++ ex[0] ++ " " ++ hm_csv(ex[1]) ++ " " ++ str(ex[2]) ++ "\n"
}

skill hm_ask(word,laws) -> Any {
  return hm_prompt(word,hm_question(laws))
}

skill hm_prompt(word,q) -> Any {
  if q == null { return "Still ambiguous. Supply a different example." }
  return "What is " ++ q[0] ++ " of " ++ word ++ " on " ++ hm_csv(q[1]) ++ "?"
}

# One meaning, as a word Mind can use. The parameter is a. Before the reduction it is a list
# and the word maps the element expression over it. After, it is the number the reduction made.
skill hm_param(t) -> Any {
  if t[0] == "v" and t[1] == "e" { return ["p", 0] }
  if t[0] != "op" and t[0] != "w" { return t }
  let out = []
  for a in t[2] { let out = append(out, hm_param(a)) }
  return [t[0], t[1], out]
}

skill hm_as_word(law) -> Any {
  if law[1] { return [["op", "map", [law[0], ["p", 0]]], "L", "L"] }
  return [hm_param(law[0]), "I", "I"]
}

skill hm_take(book, line) -> Any {
  let f = split(trim(line), " ")
  if len(f) != 5 or f[0] != "heed1" { return null }
  if not hm_word(f[1]) or not contains(hm_reducers(), f[2]) { return null }
  let xs = hm_numbers(f[3])
  let y = hm_number(f[4])
  if xs == null or y == null { return null }
  return hm_record(book, f[1], f[2], xs, y)
}

# Keep the saved arithmetic, but test an alternate source on one branch.
# Require observations on which each source alone fails. Only vocabulary
# already available at the original recipe can participate (no cycles).
skill hm_repair(recipe,source,lessons,rows) -> Any {
  let x = V("x")
  let n = O("len",[x])
  let even = O("==",[O("%",[n,Q(2)]),Q(0)])
  let lengths = []
  for row in rows {
    let size = len(row[1])
    if not contains(lengths,size) { lengths = append(lengths,size) }
  }
  let gates = [even]
  for size in lengths { gates = append(gates,O("<",[n,Q(size)])) }
  let original = subst(recipe[2],subst(source[0],x))
  let fits = []
  for lesson in lessons {
    if lesson[1] != recipe[1] and lesson[2][1] == "L" and lesson[2][2] == "I" {
      let alternate = subst(recipe[2],subst(lesson[2][0],x))
      let needs_original = false
      let possible = true
      for row in rows {
        if sev(alternate,null,row[1],null,[]) != row[2] {
          needs_original = true
          if sev(original,null,row[1],null,[]) != row[2] { possible = false }
        }
      }
      if possible and needs_original {
        for gate in gates {
          for branches in [[original,alternate],[alternate,original]] {
            let tree = O("ite",[gate,branches[0],branches[1]])
            let valid = true
            for row in rows { if sev(tree,null,row[1],null,[]) != row[2] { valid = false } }
            if valid and not contains(fits,tree) { fits = append(fits,tree) }
          }
        }
      }
    }
  }
  return fits
}

# A Heed lesson file, as Mind lessons. A word with one meaning becomes a building block.
# A word that is still ambiguous is left out: Mind must not guess.
skill hm_lessons(text) -> Any {
  return hm_replay(text,null)[0]
}

skill hm_replay(text,query) -> Any {
  let decision = []
  let pending = []
  let book = {}
  let targets = {}
  if text == null { return [[],decision] }
  let bindings = hm_recipes(text)
  let recorded = {}
  let revised = {}
  for line in split(text,"\n") {
    let f = split(trim(line)," ")
    if f[0] == "compose1" and len(f) >= 6 { recorded = put(recorded,f[2] ++ " of " ++ f[1],true) }
    if len(f) == 5 and f[0] == "heed1" {
      let phrase = f[2] ++ " of " ++ f[1]
      if recorded[phrase] == true { revised = put(revised,phrase,true) }
      if bindings[f[2] ++ " of " ++ f[1]] != null {
        let next = hm_take(targets,line)
        if next != null { targets = next }
      } else {
        let next = hm_take(book,line)
        if next != null { book = next }
      }
    }
  }
  let out = []
  for word in keys(book) {
    let laws = hm_laws(book[word])
    if len(laws) == 1 { let out = append(out, ["word", word, hm_as_word(laws[0])]) }
    if len(laws) == 0 {
      for reducer in hm_reducers() {
        let rows = []
        for ex in book[word] { if ex[0] == reducer { rows = append(rows,[ex[1],ex[2]]) } }
        if len(rows) > 0 {
          let selectors = wn_positions(book[word],reducer)
          if len(selectors) == 0 {
            let endpoints = wn_search(book[word],reducer)
            if len(endpoints[0]) == 0 and not endpoints[1] {
              if len(keys(book)) > 1 { selectors = wn_switches(book,word,reducer) }
              if len(selectors) == 0 {
                pending = append(pending,[reducer ++ " of " ++ word,rows])
              }
            }
          }
          if len(selectors) == 1 {
            let typed = [xparam(selectors[0]),"L","I"]
            out = append(out,["word",reducer ++ " of " ++ word,typed])
          }
        }
      }
    }
  }
  # Replay from observations and the current base vocabulary. Fallback words
  # never depend on other fallback words in this pass, so order cannot create cycles.
  let lib = []
  for lesson in out { lib = append(lib,lesson[2]) }
  for item in pending {
    let m = mark()
    let candidates = hm_mind_search(item[1],lib)
    candidates = release(m,candidates)
    if item[0] == query { decision = candidates }
    if len(candidates) == 1 {
      out = append(out,["word",item[0],[xparam(candidates[0]),"L","I"]])
    }
  }
  # Dependencies are recorded only after their sources resolve. Walk the
  # append order, substituting today's source before replaying target lessons.
  for line in split(text,"\n") {
    let f = split(trim(line)," ")
    if f[0] == "compose1" {
      let recipe = hm_recipe(f)
      if recipe != null {
        let source = hm_named(out,recipe[1])
        if source != null {
          let body = subst(recipe[2],source[0])
          let ok = true
          let rows = []
          for ex in get(targets,f[1],[]) {
            if ex[0] == f[2] {
              rows = append(rows,ex)
              if sev(body,ex[1],null,null,[]) != ex[2] { ok = false }
            }
          }
          if not ok and revised[recipe[0]] == true {
            let fits = hm_repair(recipe,source,out,rows)
            if recipe[0] == query { decision = fits }
            if len(fits) == 1 {
              body = xparam(fits[0])
              ok = true
            }
          }
          if ok { out = append(out,["word",recipe[0],[body,"L","I"]]) }
        }
      }
    }
  }
  return [out,decision]
}

# compose1 TARGET REDUCER SOURCE REDUCER PREFIX-EXPRESSION
skill hm_recipe(f) -> Any {
  if len(f) < 6 or f[0] != "compose1" { return null }
  if not hm_word(f[1]) or not hm_word(f[3]) { return null }
  if not contains(hm_reducers(),f[2]) or not contains(hm_reducers(),f[4]) { return null }
  let tokens = slice(f,5,len(f))
  let slots = 1
  for token in tokens {
    if slots == 0 { return null }
    if contains(["+","-","*","min","max"],token) { slots = slots+1 } else {
      if token != "p0" and hm_number(token) == null { return null }
      slots = slots-1
    }
  }
  if slots != 0 or not contains(tokens,"p0") { return null }
  return [f[2] ++ " of " ++ f[1],f[4] ++ " of " ++ f[3],parse_at(tokens,0,[])[0]]
}

skill hm_recipes(text) -> Any {
  let bindings = {}
  if text == null { return bindings }
  for line in split(text,"\n") {
    let recipe = hm_recipe(split(trim(line)," "))
    if recipe != null { bindings = put(bindings,recipe[0],recipe[1]) }
  }
  return bindings
}

skill hm_named(lessons,name) -> Any {
  for lesson in lessons {
    if lesson[0] == "word" and lesson[1] == name { return lesson[2] }
  }
  return null
}

skill hm_mind_search(rows,lib) -> Any {
  let active = all_awake(lib)
  let pl = pools()
  let pre = prelude()
  let m = mark()
  let first = solve(rows,[],lib,active,pl,pre,5,30000)[0]
  first = release(m,first)
  if first == null { return [] }
  let probes = [[0],[3,1],[1,3],[5,2,7],[2,5,0-3,8],[4,0,7,1,2]]
  for ex in rows { probes = append(probes,reverse(ex[0])) }
  let second = solve_search(rows,[],lib,active,pl,pre,min(5,tsize(first)),30000,first,probes)[0]
  if second != null {
    for xs in probes {
      if different_on(second,first,[xs],lib) { return [expand(first,lib),expand(second,lib),xs] }
    }
  }
  return [expand(first,lib)]
}
