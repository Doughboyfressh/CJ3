# a golden Mandelbulb in a dark studio: a shape no one could model by hand, lit only by two soft panels

let MAX_BOUNCES = 8
let MAX_STEPS = 220
let MAX_DIST = 60.0
let HIT_EPS = 0.00025

skill bulb(p) {
  let z = p
  let dr = 1.0
  let r = 0.0
  for i in range(0, 7) {
    r = length(z)
    if r > 2.0 { break }
    let th = acos(z.y / r) * 8.0
    let ph = atan2(z.z, z.x) * 8.0
    let r7 = r * r * r
    r7 = r7 * r7 * r
    dr = r7 * 8.0 * dr + 1.0
    let st = sin(th)
    z = [st * cos(ph), cos(th), st * sin(ph)] * (r7 * r) + p
  }
  return 0.5 * log(r) * r / dr
}

skill scene(p) {
  let d = [p.y + 1.25, 1.0, 0.0]
  let q = rot_y(p, 0.5 + time * 0.12)
  d = near(d, [bulb(q), 2.0, 0.0])
  d = near(d, [sd_sphere(p - [1.75, -0.72, 0.85], 0.53), 4.0, 0.0])
  d = near(d, [sd_sphere(p - [-1.85, -0.92, 1.05], 0.33), 5.0, 0.0])
  # the lights: a large soft panel above and to the left, a narrow warm strip behind on the right
  d = near(d, [sd_box(p - [-3.2, 5.2, 2.2], [2.6, 0.04, 2.0]), 3.0, 0.0])
  d = near(d, [sd_box(p - [4.6, 1.4, -3.4], [0.05, 2.2, 1.0]), 6.0, 0.0])
  return d
}

skill emission(p, n, id) {
  if id > 2.5 and id < 3.5 { return [40.0, 38.0, 35.0] }
  if id > 5.5 { return [70.0, 31.0, 10.0] }
  return [0.0, 0.0, 0.0]
}
skill albedo(p, n, id) {
  if id < 1.5 {
    # polished black stone, faintly veined
    let v = abs(sin(p.x * 2.1 + fbm(p * 1.3, 4) * 5.0))
    return mix([0.012, 0.012, 0.016], [0.05, 0.045, 0.05], pow(1.0 - v, 9.0))
  }
  if id < 2.5 { return mix([1.0, 0.71, 0.29], [0.95, 0.64, 0.54], saturate(0.5 + fbm(p * 3.0, 3))) }
  if id > 4.5 and id < 5.5 { return [0.95, 0.93, 0.88] }
  return [1.0, 1.0, 1.0]
}
skill roughness(p, n, id) {
  if id < 1.5 { return 0.09 }
  if id < 2.5 { return 0.17 }
  if id > 4.5 and id < 5.5 { return 0.05 }
  return 0.0
}
skill metallic(p, n, id) { return if (id > 1.5 and id < 2.5) or (id > 4.5 and id < 5.5) { 1.0 } else { 0.0 } }
skill glass(p, n, id) { return if id > 3.5 and id < 4.5 { 1.0 } else { 0.0 } }
skill glass_tint(id) { return [0.62, 0.82, 0.92] }
skill ior(id) { return 1.62 }

# no sun, no sky: a dark room
skill sky(rd, with_sun) { return mix([0.003, 0.0035, 0.005], [0.012, 0.014, 0.022], saturate(rd.y * 0.5 + 0.5)) }
skill atmosphere(rd, sun) { return [0.0, 0.0, 0.0] }
skill sun_light() { return [0.0, 0.0, 0.0] }
skill exposure() { return 0.9 }

skill cam_from() { return [0.5, 0.75, 5.3] }
skill cam_at() { return [0.0, -0.18, 0.0] }
skill cam_fov() { return 0.56 }
skill cam_aperture() { return 0.022 }
skill cam_focus() { return 4.8 }
