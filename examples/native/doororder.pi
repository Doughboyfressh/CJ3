# Build a Mind fold from two event symbols. States: unseen, armed, open,
# blocked. A strict rule blocks on a premature B. A subsequence rule can
# arm later. A first-of rule opens on A immediately unless B came first.
skill dx_order_model(a,b,kind) -> Any {
  let event = V("e")
  let acc = ["p",0]
  let hit_a = O("==",[event,Q(a)])
  let hit_b = O("==",[event,Q(b)])
  let premature = if kind == 1 { Q(0) } else { O("ite",[hit_b,Q(3),Q(0)]) }
  let start = O("ite",[hit_a,Q(if kind == 2 { 2 } else { 1 }),premature])
  let armed = O("ite",[hit_b,Q(2),Q(1)])
  let transition = O("ite",[O("==",[acc,Q(0)]),start,O("ite",[O("==",[acc,Q(1)]),armed,acc])])
  let folded = O("fold",[transition,Q(0),V("x")])
  let expression = O("ite",[O("==",[folded,Q(2)]),Q(1),Q(0)])
  return [0-2,a,b,kind,expression,transition]
}

skill dx_order_fit(rows) -> Any {
  let keep = []
  for a in range(1,6) {
    for b in range(1,6) {
      if a != b {
        for kind in range(0,3) {
          let m = dx_order_model(a,b,kind)
          let ok = true
          for row in rows {
            if ok and sev(m[4],null,row[0],null,[]) != row[1] { ok = false }
          }
          if ok {
            # Compile only survivors for the planner. Both execution paths
            # come from the same Mind transition expression.
            let table = []
            for s in range(0,4) {
              for e in range(1,6) { table = append(table,sev(m[5],s,null,e,[])) }
            }
            keep = append(keep,append(m,table))
          }
        }
      }
    }
  }
  return keep
}

skill dx_order_next(states,models,event) -> Any {
  let next = []
  for i in range(0,len(models)) {
    let m = models[i]
    let state = states[i]
    if m[0] == 0-4 { state = dx_pair_step(m,state,event) } else {
      if m[0] == 0-3 { state = dx_context_step(state,m[1],m[2],event) } else {
        state = m[6][state*5+event-1]
      }
    }
    next = append(next,state)
  }
  return next
}

# Learn a projected suffix memory. The symbols to remember and the open
# contexts both come from observations. An unseen context predicts closed.
skill dx_context_step(context,symbols,width,event) -> Any {
  if not contains(symbols,event) { return context }
  let tail = append(context,event)
  return slice(tail,max(0,len(tail)-width),len(tail))
}

skill dx_context(model,events) -> Any {
  let context = []
  for event in events { context = dx_context_step(context,model[1],model[2],event) }
  return context
}

skill dx_context_fit(rows) -> Any {
  let alphabets = [[]]
  for e in range(1,6) {
    let extra = []
    for symbols in alphabets { extra = append(extra,append(symbols,e)) }
    alphabets = alphabets ++ extra
  }
  for width in range(1,4) {
    for size in range(1,6) {
      let keep = []
      for symbols in alphabets {
        if len(symbols) == size {
          let model = [0-3,symbols,width]
          let opened = []
          let labels = {}
          let fits = true
          for row in rows {
            let context = dx_context(model,row[0])
            let key = str(context)
            if labels[key] != null and labels[key] != row[1] { fits = false }
            labels = put(labels,key,row[1])
            if row[1] == 1 and not contains(opened,context) { opened = append(opened,context) }
          }
          if fits { keep = append(keep,append(model,opened)) }
        }
      }
      if len(keep) > 0 { return keep }
    }
  }
  return []
}


# A composed reset monitors an ordered subsequence since the latest trigger.
# 0 = closed, 2 = armed, 1 = armed with the first reset event observed.
skill dx_pair_step(m,state,event) -> Any {
  if event == m[1] { return 2 }
  if state == 1 and event == m[3] { return 0 }
  if state == 2 and event == m[2] { return 1 }
  return state
}

skill dx_pair_fit(rows,trigger) -> Any {
  let keep = []
  for t in range(1,6) {
    if trigger == 0 or t == trigger {
      for a in range(1,6) {
        for b in range(1,6) {
          if a != t and b != t {
            let m = [0-4,t,a,b]
            let fits = true
            for row in rows {
              if fits {
                let state = 0
                for event in row[0] { state = dx_pair_step(m,state,event) }
                if (state > 0) != (row[1] == 1) { fits = false }
              }
            }
            if fits { keep = append(keep,m) }
          }
        }
      }
    }
  }
  return keep
}
