# Pi's local Wikipedia, indexed by title: every article of out\wiki\NN_KK.txt (wikitext.pi) -> where it sits, so the
# research agent reads whole articles from the SSD (no web request, no rate limit).
#   out\wikiindex.exe part <from> <to>   files from..to-1: titles (Pi's Parquet reader) + article offsets -> out\wikiidx\NN.txt
#   out\wikiindex.exe shard              the 41 lists -> 256 shards by title key (out\wikiidx\s<k>.txt): a lookup reads one
#   out\wikiindex.exe all                part (8 workers) then shard
# index line: lower-case title ||| piece NN_KK ||| byte offset ||| length
import "parquet.pi"

skill DIR() -> Any { return "C:\\Users\\Dough\\laya-plus\\data\\corpus\\wikipedia\\20231101.en\\" }

skill fname(i) -> Any {
  let s = str(i)
  if i < 10 { let s = "0" ++ s }
  return DIR() ++ "train-000" ++ s ++ "-of-00041.parquet"
}

skill two(i) -> Any {
  if i < 10 { return "0" ++ str(i) }
  return str(i)
}

skill wi_key(w) -> Any {
  let h = 0
  for i in range(0, len(w)) { let h = (h * 31 + ord(slice(w, i, i + 1))) % 1000000007 }
  return h * 64 + len(w) + 1
}

skill imin(a, b) -> Any {
  if a < b { return a }
  return b
}

# one Parquet file: its pieces were written 16 row groups at a time, articles joined by "\n=====\n"
skill index_file(i) -> Any {
  let pf = pq_open(fname(i), "title")
  if pf == null { return "no file " ++ str(i) }
  let blocks = []
  let n = 0
  let bad = 0
  let g = 0
  let piece = 0
  while g < len(pf[2]) {
    let m = mark()
    let e = imin(len(pf[2]), g + 16)
    let titles = []
    for gg in range(g, e) { let titles = titles ++ pq_texts(pf, gg) }
    let pname = two(i) ++ "_" ++ two(piece)
    let text = read_file("out\\wiki\\" ++ pname ++ ".txt")
    let lines = []
    let sep = "\n=====\n"
    let parts = split(text, sep)
    let pos = 0
    let k = 0
    while k < len(parts) and k < len(titles) {
      let lines = append(lines, lower(titles[k]) ++ " ||| " ++ pname ++ " ||| " ++ str(pos) ++ " ||| " ++ str(len(parts[k])))
      let pos = pos + len(parts[k]) + len(sep)
      let k = k + 1
    }
    let ok = 0
    if len(parts) == len(titles) and pos == len(text) + len(sep) { let ok = 1 }
    let keep = release(m, [join(lines, "\n"), k, ok])
    let blocks = append(blocks, keep[0])
    let n = n + keep[1]
    if keep[2] == 0 { let bad = bad + 1 }
    let g = e
    let piece = piece + 1
  }
  do write_file("out\\wikiidx\\" ++ two(i) ++ ".txt", join(blocks, "\n"))
  return str(n) ++ " articles, " ++ str(bad) ++ " pieces with a count mismatch"
}

skill shard() -> Any {
  let ns = 256
  # 4 passes of 64 shards each (keeps the memory small)
  for pass in range(0, 4) {
    let m = mark()
    let chunks = []
    for s in range(0, 64) { let chunks = append(chunks, []) }
    for i in range(0, 41) {
      let t = read_file("out\\wikiidx\\" ++ two(i) ++ ".txt")
      if t != null {
        let mi = mark()
        let per = []
        for s in range(0, 64) { let per = append(per, []) }
        for line in split(t, "\n") {
          let p = split(line, " ||| ")
          if len(p) == 4 {
            let s = wi_key(p[0]) % ns
            if s // 64 == pass {
              let b = s % 64
              let per = slice(per, 0, b) ++ [append(per[b], line)] ++ slice(per, b + 1, 64)
            }
          }
        }
        let joined = []
        for s in range(0, 64) { let joined = append(joined, join(per[s], "\n")) }
        let joined = release(mi, joined)
        let nb = []
        for s in range(0, 64) { let nb = append(nb, chunks[s] ++ [joined[s]]) }
        let chunks = nb
      }
    }
    for s in range(0, 64) { do write_file("out\\wikiidx\\s" ++ str(pass * 64 + s) ++ ".txt", join(chunks[s], "\n")) }
    do release(m, 0)
  }
  return "256 shards written"
}

skill main() -> Any {
  if arg(1) == "part" {
    let out = []
    for i in range(num(arg(2)), num(arg(3))) { let out = append(out, "file " ++ str(i) ++ ": " ++ index_file(i)) }
    return join(out, "\n")
  }
  if arg(1) == "shard" { return shard() }
  if arg(1) == "all" {
    let t0 = ticks()
    let hs = []
    for w in range(0, 8) {
      let a = 41 * w // 8
      let b = 41 * (w + 1) // 8
      let hs = append(hs, spawn(arg(0) ++ " part " ++ str(a) ++ " " ++ str(b)))
    }
    for h in hs { do wait(h, 36000000) }
    let t1 = ticks()
    let r = shard()
    return "indexed by 8 workers in " ++ str((t1 - t0) // 1000) ++ " s; " ++ r ++ " in " ++ str((ticks() - t1) // 1000) ++ " s"
  }
  return "usage: wikiindex.exe part <from> <to> | shard | all"
}
