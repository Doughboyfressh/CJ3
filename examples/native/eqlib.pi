# The equation solver's core, as an importable module: evaluate an arithmetic expression, or solve a linear or
# quadratic equation for x. Operators + - * / % ^, parentheses, unary minus; x is the unknown.

skill isdigit(c) -> Any { return contains("0123456789", c) }

skill skipsp(cs, i) -> Any {
  while i < len(cs) and (cs[i] == " " or cs[i] == "\t") { let i = i + 1 }
  return i
}

skill ev_num(cs, i) -> Any {
  let n = len(cs)
  let val = 0
  while i < n and isdigit(cs[i]) {
    let val = val * 10 + (ord(cs[i]) - 48)
    let i = i + 1
  }
  if i < n and cs[i] == "." {
    let i = i + 1
    let fv = 0
    let fs = 1
    while i < n and isdigit(cs[i]) {
      let fv = fv * 10 + (ord(cs[i]) - 48)
      let fs = fs * 10
      let i = i + 1
    }
    let val = val + fv / fs
  }
  return [val, i]
}

skill ev_prim(cs, i, x) -> Any {
  let i = skipsp(cs, i)
  let c = cs[i]
  if c == "(" {
    let r = ev_add(cs, i + 1, x)
    let j = skipsp(cs, r[1])
    return [r[0], j + 1]
  }
  if c == "-" {
    let r = ev_prim(cs, i + 1, x)
    return [0 - r[0], r[1]]
  }
  if c == "x" { return [x, i + 1] }
  return ev_num(cs, i)
}

skill ev_pow(cs, i, x) -> Any {
  let b = ev_prim(cs, i, x)
  let j = skipsp(cs, b[1])
  if j < len(cs) and cs[j] == "^" {
    let e = ev_pow(cs, j + 1, x)
    return [b[0] ^ e[0], e[1]]
  }
  return b
}

skill ev_mul(cs, i, x) -> Any {
  let r = ev_pow(cs, i, x)
  let acc = r[0]
  let i = r[1]
  let go = 1
  while go {
    let j = skipsp(cs, i)
    if j < len(cs) and (cs[j] == "*" or cs[j] == "/" or cs[j] == "%") {
      let rhs = ev_pow(cs, j + 1, x)
      if cs[j] == "*" { let acc = acc * rhs[0] }
      if cs[j] == "/" { let acc = acc / rhs[0] }
      if cs[j] == "%" { let acc = acc % rhs[0] }
      let i = rhs[1]
    } else {
      let go = 0
    }
  }
  return [acc, i]
}

skill ev_add(cs, i, x) -> Any {
  let r = ev_mul(cs, i, x)
  let acc = r[0]
  let i = r[1]
  let go = 1
  while go {
    let j = skipsp(cs, i)
    if j < len(cs) and (cs[j] == "+" or cs[j] == "-") {
      let rhs = ev_mul(cs, j + 1, x)
      if cs[j] == "+" { let acc = acc + rhs[0] } else { let acc = acc - rhs[0] }
      let i = rhs[1]
    } else {
      let go = 0
    }
  }
  return [acc, i]
}

skill evalexpr(s, x) -> Any {
  let r = ev_add(chars(s), 0, x)
  return r[0]
}

skill find_eq(cs) -> Any {
  for i in range(0, len(cs)) {
    if cs[i] == "=" { return i }
  }
  return 0 - 1
}

skill equation(s) -> Any {
  let cs = chars(s)
  let eq = find_eq(cs)
  if eq < 0 { return {"status": "value", "value": evalexpr(s, 0)} }
  let lhs = slice(s, 0, eq)
  let rhs = slice(s, eq + 1, len(s))
  let g0 = evalexpr(lhs, 0) - evalexpr(rhs, 0)
  let g1 = evalexpr(lhs, 1) - evalexpr(rhs, 1)
  let g2 = evalexpr(lhs, 2) - evalexpr(rhs, 2)
  let g3 = evalexpr(lhs, 3) - evalexpr(rhs, 3)
  let c = g0
  let a = (g2 - 2 * g1 + g0) / 2
  let b = g1 - g0 - a
  if a * 9 + b * 3 + c != g3 { return {"status": "degree too high"} }
  if a == 0 {
    if b == 0 {
      if c == 0 { return {"status": "every x is a solution"} }
      return {"status": "no solution"}
    }
    return {"status": "solved", "x": (0 - c) / b}
  }
  let disc = b * b - 4 * a * c
  if disc < 0 { return {"status": "no real solution"} }
  let sq = sqrt(disc)
  let r1 = (0 - b - sq) / (2 * a)
  let r2 = (0 - b + sq) / (2 * a)
  if r1 <= r2 { return {"status": "solved", "roots": [r1, r2]} }
  return {"status": "solved", "roots": [r2, r1]}
}
