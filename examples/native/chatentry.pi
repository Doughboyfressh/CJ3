# Native Pi dialogue with persistent facts and searchable notes.
import "conversation.pi"
import "notes.pi"
import "chatlessons.pi"

skill chat_state() -> Any {
  let st = load_facts(chat_data("chat_facts.txt"))
  return put(st,"lesson_probe",chat_saved_probe())
}

skill chat_ask(first) -> Any {
  let words = []
  let i = first
  while arg(i) != null {
    let words = append(words,arg(i))
    let i = i+1
  }
  if len(words) == 0 { return "Usage: pi ask QUESTION" }
  let r = chat_handle(chat_state(),join(words," "))
  if r[2] {
    if write_file(chat_data("chat_facts.txt"),join(r[1]["said"],"\n")) == null { return "Could not save chat facts." }
  }
  return r[0]
}
