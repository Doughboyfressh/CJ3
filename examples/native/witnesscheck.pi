import "mindcore.pi"

# Use the same lesson reader and typed search as Mind after Heed exits.
skill wc_transfer(text) -> Any {
  let lessons = load_lessons(text)
  if len(lessons) != 1 { return "expected one resolved lesson" }
  let woke = awake_lessons([],{"lists":[]},lessons)
  let encoded = save_lib(woke[0])
  let slot = rt_sw_ssd_alloc(len(encoded)+8)
  do rt_sw_ssd_puts(slot,encoded)
  let lib = load_lib(rt_sw_ssd_gets(slot))
  if lib != woke[0] { return "Softwell vocabulary round trip failed" }
  let train = [[[1,9,3],10],[[6,1,8],2],[[3,0,7,2],8],[[4,6,3,1,9],4]]
  let held = [[[11,3,0-8,2],0-7]]
  let pl = pools()
  let pre = prelude()
  let bare = solve(train,held,[],[],pl,pre,4,10000)
  let fitted = solve(train,held,lib,woke[1]["lists"],pl,pre,4,10000)
  if bare[0] != null or fitted[0] == null { return "transfer comparison failed" }
  return lessons[0][1] ++ " -> " ++ show(fitted[0]) ++ " -> " ++ str(sev(fitted[0],null,held[0][0],null,lib))
}

# Transfer the learned switch to a second task: add one to its output.
skill wc_switch(text,train,held) -> Any {
  let lessons = load_lessons(text)
  let base = []
  let full = []
  for lesson in lessons {
    full = append(full,lesson[2])
    if lesson[1] != "sum of zells" { base = append(base,lesson[2]) }
  }
  if len(full) != len(base)+1 { return "missing unique switch" }
  let mem = save_lib(full)
  let slot = rt_sw_ssd_alloc(len(mem)+8)
  do rt_sw_ssd_puts(slot,mem)
  full = load_lib(rt_sw_ssd_gets(slot))
  let pl = pools()
  let pre = prelude()
  if solve(train,held,base,all_awake(base),pl,pre,4,10000)[0] != null { return "baseline solved" }
  let tree = solve(train,held,full,all_awake(full),pl,pre,4,10000)[0]
  if tree == null { return "composition failed" }
  return [sev(tree,null,held[0][0],null,full),sev(tree,null,held[1][0],null,full)]
}

skill wc_order(text) -> Any {
  let train = [[[1,7,4,8,9],8],[[10,7,4,8,9],5],[[2,3,8,2],9],[[1,5,8,9],6]]
  let held = [[[6,1,0-8,4],0-7],[[3,8,5,3],6]]
  return wc_switch(text,train,held)
}

skill wc_boundary(text) -> Any {
  let train = [[[1,7,0-2,8,9],8],[[1,7,2,8,9],10],[[3,4,0,2],3],[[2,9,0-1,3],10]]
  let held = [[[9,3,0-8,6],4],[[3,7,0,1,4],5]]
  return wc_switch(text,train,held)
}

skill wc_relation(text) -> Any {
  let train = [[[3,7,5,8,9],10],[[6,7,5,8,9],8],[[3,4,3,2],3],[[9,4,3,2],5]]
  let held = [[[103,7,105,8,9],10],[[106,7,105,8,9],8]]
  return wc_switch(text,train,held)
}

skill main() -> Any {
  if arg(1) == "switch" { return wc_order(read_file(arg(2))) }
  if arg(1) == "relation" { return wc_relation(read_file(arg(2))) }
  if arg(1) == "boundary" { return wc_boundary(read_file(arg(2))) }
  if arg(1) != null { return wc_transfer(read_file(arg(1))) }
  let text = "heed1 zells sum 2,1,5 1\nheed1 zells sum 2,9,5 9\nheed1 zells sum 5,1,2 1\nheed1 zells sum 5,2,1 2\n"
  do print("ambiguous exports: " ++ str(len(load_lessons(text))))
  do print(wc_transfer(text ++ "heed1 zells sum 8,7,6,5,4 6\n"))
  let switching = "heed1 brins sum 2,1,5 1\nheed1 brins sum 2,9,5 9\nheed1 brins sum 5,1,2 1\nheed1 brins sum 5,2,1 2\nheed1 brins sum 0,1,2,3,4 1\nheed1 glims sum 2,1,5 1\nheed1 glims sum 2,9,5 9\nheed1 glims sum 5,1,2 1\nheed1 glims sum 5,2,1 2\nheed1 glims sum 0,1,2,3,4 2\nheed1 zells sum 1,7,4,8,9 7\nheed1 zells sum 1,2,5,3,9 2\nheed1 zells sum 10,7,4,9 4\nheed1 zells sum 10,2,5,9 5\nheed1 zells sum 10,7,0,4,1,9 4\n"
  let observations = {}
  for line in split(trim(switching),"\n") { observations = hm_take(observations,line) }
  do print(wn_book_reply(observations,"zells",observations["zells"],"sum",[1,2],true))
  do print(wc_order(switching ++ "heed1 zells sum 0,1,2,0 2\nheed1 zells sum 0,1,2,4 1\n"))
  let prior = split(switching,"heed1 zells")[0]
  let boundary = prior ++ "heed1 zells sum 2,7,-1,8,9 7\nheed1 zells sum 2,7,1,8,9 9\nheed1 zells sum 2,7,1,6,9 9\n"
  let book = {}
  for line in split(trim(boundary),"\n") { book = hm_take(book,line) }
  do print(wn_book_reply(book,"zells",book["zells"],"sum",[2,7,1,6,9],true))
  do print(wc_boundary(boundary ++ "heed1 zells sum 2,7,0,8,9 9\n"))
  let relation = prior ++ "heed1 zells sum 3,7,5,8,9 9\nheed1 zells sum 6,7,5,8,9 7\nheed1 zells sum 3,7,2,11,9 7\n"
  let relations = {}
  for line in split(trim(relation),"\n") { relations = hm_take(relations,line) }
  do print(wn_book_reply(relations,"zells",relations["zells"],"sum",[3,7,2,11,9],true))
  do print(wc_relation(relation ++ "heed1 zells sum 5,7,5,8,9 9\n"))
  let rows = [["sum",[2,5],2],["sum",[5,2],11],["sum",[0,5],0]]
  do print(wn_reply(rows,"sum",[1,1],false))
  for r in [["sum",[5,0],15],["sum",[0-3,4],0-3],["sum",[4,0-3],18],["sum",[3,3],3]] {
    rows = append(rows,r)
  }
  let models = wn_fit(rows,"sum")
  if len(models) != 1 { return "failed to recover a unique knot" }
  do print(show(models[0]))
  let hits = 0
  for h in range(0-8,9) {
    for t in range(0-8,9) {
      if sev(models[0],null,[h,99,t],null,[]) == h+2*max(0,h-t) { hits = hits+1 }
    }
  }
  do print(str(hits) ++ "/289 new lists")
  do print("conflicting interiors: " ++ str(len(wn_fit(append(rows,["sum",[2,0,5],7]),"sum"))))
  do print("other reducer: " ++ str(len(wn_fit(rows,"count"))))
  do print("insufficient rank: " ++ str(len(wn_fit([["sum",[1,2],1],["sum",[2,4],2]],"sum"))))
  let shifted = []
  for ends in [[0,2],[3,1],[2,5],[6,1],[3,2],[8,0],[1,4]] {
    let h = ends[0]
    let t = ends[1]
    shifted = append(shifted,["sum",ends,t+3*max(0,h-t-2)])
  }
  do print(wn_reply(shifted,"sum",[11,77,3],true))
  do print(wn_reply(shifted,"sum",[11,77,3],false))
  let skipped = []
  for gap in [0-5,0-3,0-1,1,3,5,7] {
    let t = if gap % 4 == 1 { 3 } else { 0-2 }
    let h = t+gap
    skipped = append(skipped,["sum",[h,t],h+2*max(0,gap-2)])
  }
  do print(wn_reply(skipped,"sum",[9,1],true))
  do print(wn_reply(skipped,"sum",[9,1],false))
  let ambiguous = [["sum",[1,5],1],["sum",[2,4],2],["sum",[5,1],9]]
  do print(wn_reply(ambiguous,"sum",[7,1],false))
  do print(wn_reply(append(ambiguous,["sum",[4,1],6]),"sum",[7,1],false))
  let wide = [["sum",[1,500],1],["sum",[2,400],2],["sum",[500,1],999]]
  do print(wn_reply(wide,"sum",[700,1],false))
  do print(wn_reply(wide,"sum",[500,1],false))
  let interior = [["sum",[2,1,5],1],["sum",[2,9,5],9]]
  do print(wn_reply(interior,"sum",[2,9,5],true))
  do print(wn_reply(interior,"sum",[8,7,6,5,4],false))
  let center = append(interior,["sum",[8,7,6,5,4],6])
  do print(wn_reply(center,"sum",[9,3,0-8,2],false))
  let second = append(interior,["sum",[8,7,6,5,4],7])
  do print(wn_reply(second,"sum",[9,3,0-8,2],false))
  do print(wn_reply(second,"sum",[9],false))
  return wn_reply([["sum",[2,5],2],["sum",[5,2],5]],"sum",[9,99,1],false)
}
