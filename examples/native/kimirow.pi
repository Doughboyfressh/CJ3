# One row of Kimi K3.1 Pro, and it is not a word.
# model-00002, layer 1, expert 0, w2, row 0.
# Packed bytes at file offset 1,274,412,048 (1,536 bytes). Scales at 1,279,917,072 (96 bytes).
# Low nibble first, which is compressed-tensors unpack_fp4_from_uint8. The swapped order is
# checked too. The 1.56 TB checkpoint is not copied. This file holds the one row so the
# failure can be rerun. It is not a learned word, and it is not written to the SSD.
# The training half's most common code is 9, 164 times. It hits 162 of the 1,536 held-out
# positions. The two halves differ in 1,416 positions. Tiling the first 32 codes hits 112.
# All 16 codes occur. The 96 scales are only the adjacent bytes 120 and 121, 24 and 72,
# with no constant gap. A cold read of the verdict is one page, 1,024 cycles.
skill score(codes) -> Any {
  let hist = arr(16)
  for i in range(0, 1536) {
    let c = aget(codes, i)
    do aset(hist, c, aget(hist, c) + 1)
  }
  let maj = 0
  let best = 0
  for c in range(0, 16) {
    if aget(hist, c) > best {
      let best = aget(hist, c)
      let maj = c
    }
  }
  let heldm = 0
  let diffs = 0
  let tiled = 0
  for i in range(0, 1536) {
    if aget(codes, 1536 + i) == maj { let heldm = heldm + 1 }
    if aget(codes, i) != aget(codes, 1536 + i) { let diffs = diffs + 1 }
    if aget(codes, 1536 + i) == aget(codes, i % 32) { let tiled = tiled + 1 }
  }
  let seen = arr(16)
  for i in range(0, 3072) { do aset(seen, aget(codes, i), 1) }
  let kinds = 0
  for c in range(0, 16) {
    if aget(seen, c) == 1 { let kinds = kinds + 1 }
  }
  return [maj, best, heldm, diffs, tiled, kinds]
}

skill main() -> Any {
  let lines = split(trim(read_file("examples/native/kimi_w2.txt")), "\n")
  let pb = split(lines[0], " ")
  let sc = split(lines[1], " ")
  let low = arr(3072)
  let high = arr(3072)
  for i in range(0, 1536) {
    let b = num(pb[i])
    let lo = b % 16
    let hi = b // 16
    do aset(low, i * 2, lo)
    do aset(low, i * 2 + 1, hi)
    do aset(high, i * 2, hi)
    do aset(high, i * 2 + 1, lo)
  }
  let a = score(low)
  let b = score(high)
  let n120 = 0
  let n121 = 0
  for s in sc {
    if num(s) == 120 { let n120 = n120 + 1 }
    if num(s) == 121 { let n121 = n121 + 1 }
  }
  let w2 = 1536 + 96
  let bus = (w2 + 31) // 32
  let page = (w2 + 3) // 4
  let text = "w2 row0 not a word"
  let slot = rt_sw_ssd_alloc(64)
  let other = rt_sw_ssd_alloc(8)
  do rt_sw_ssd_puts(slot, text)
  do rt_sw_ssd_puts(other, "x")
  let p = rt_sw_pg()
  let got = rt_sw_ssd_gets(slot)
  let read = rt_sw_pg() - p
  let again = rt_sw_ssd_gets(slot)
  print(len(pb) == 1536)
  print(len(sc) == 96)
  print(a[0] == 9)
  print(a[1] == 164)
  print(a[2] == 162)
  print(a[3] == 1416)
  print(a[4] == 112)
  print(a[5] == 16)
  print(b[0] == a[0])
  print(b[1] == a[1])
  print(b[2] == a[2])
  print(b[3] == a[3])
  print(b[4] == a[4])
  print(b[5] == a[5])
  print(n120 == 24)
  print(n121 == 72)
  print(n120 + n121 == 96)
  print(w2 == 1632)
  print(bus == 51)
  print(page == 408)
  print(page == 8 * bus)
  print(read == 1024)
  print(again == got)
  print(got == text)
  return 0
}
