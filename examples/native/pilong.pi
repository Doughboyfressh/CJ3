# One branch may now be a longer program: an operation of an operation.
# 2,048 long programs, and 65,536 conditionals that use one long branch.
# Nothing is kept except the survivors. The sample 0, 1, 2, 3, 4 mapping to
# 0, 1, 2, 6, 12 fits no short conditional. Six long ones force 20, 30, 42,
# and they force -1 and -3 on inputs below the sample.
skill ev(e, x) -> Any {
  let k = e[0]
  if k == 0 { return e[1] }
  if k == 1 { return x }
  let L = ev(e[1], x)
  let R = ev(e[2], x)
  if L == 1000000000 { return 1000000000 }
  if R == 1000000000 { return 1000000000 }
  if k == 2 { return L + R }
  if k == 3 { return L - R }
  if k == 4 { return L * R }
  if R == 0 { return 1000000000 }
  if L % R != 0 { return 1000000000 }
  return L // R
}
skill branch(c, t, e, x) -> Any {
  if x < c { return ev(t, x) }
  return ev(e, x)
}
skill fit(c, t, e) -> Any {
  if branch(c, t, e, 0) != 0 { return 0 }
  if branch(c, t, e, 1) != 1 { return 0 }
  if branch(c, t, e, 2) != 2 { return 0 }
  if branch(c, t, e, 3) != 6 { return 0 }
  if branch(c, t, e, 4) != 12 { return 0 }
  return 1
}
skill use(s, atoms, deep, x) -> Any {
  let a = atoms[s[2]]
  let d = deep[s[3]]
  if s[0] == 0 { return branch(s[1], a, d, x) }
  return branch(s[1], d, a, x)
}
skill forced(ss, atoms, deep, x) -> Any {
  if len(ss) == 0 { return [0, 0] }
  let v = use(ss[0], atoms, deep, x)
  if v == 1000000000 { return [0, 0] }
  for s in ss {
    if use(s, atoms, deep, x) != v { return [0, 0] }
  }
  return [1, v]
}

skill main() -> Any {
  let atoms = [[0, 0], [0, 1], [0, 2], [1]]
  let ops = [2, 3, 4, 5]
  let mid = []
  for op in ops {
    for a in atoms {
      for b in atoms {
        let mid = append(mid, [op, a, b])
      }
    }
  }
  let deep = []
  for op in ops {
    for a in atoms {
      for b in mid {
        let deep = append(deep, [op, a, b])
        let deep = append(deep, [op, b, a])
      }
    }
  }
  let short_fit = 0
  let shorts = atoms
  for e in mid { let shorts = append(shorts, e) }
  for c in [0, 1, 2, 3] {
    for a in shorts {
      for b in shorts {
        if fit(c, a, b) == 1 { let short_fit = short_fit + 1 }
      }
    }
  }
  let ss = []
  let n = 0
  for c in [0, 1, 2, 3] {
    for ai in range(0, 4) {
      for di in range(0, len(deep)) {
        let n = n + 2
        if fit(c, atoms[ai], deep[di]) == 1 {
          let ss = append(ss, [0, c, ai, di])
        }
        if fit(c, deep[di], atoms[ai]) == 1 {
          let ss = append(ss, [1, c, ai, di])
        }
      }
    }
  }
  let text = "the long branch is forced\n"
  let slot = rt_sw_ssd_alloc(64)
  let other = rt_sw_ssd_alloc(8)
  do rt_sw_ssd_puts(slot, text)
  do rt_sw_ssd_puts(other, "x")
  let pg = rt_sw_pg()
  let got = rt_sw_ssd_gets(slot)
  let readp = rt_sw_pg() - pg
  print(len(deep) == 2048)
  print(n == 65536)
  print(short_fit == 0)
  print(len(ss) == 6)
  print(forced(ss, atoms, deep, 5) == [1, 20])
  print(forced(ss, atoms, deep, 6) == [1, 30])
  print(forced(ss, atoms, deep, 7) == [1, 42])
  print(forced(ss, atoms, deep, 0 - 1) == [1, 0 - 1])
  print(forced(ss, atoms, deep, 0 - 3) == [1, 0 - 3])
  print(readp == 1024)
  print(got == text)
  return 0
}
