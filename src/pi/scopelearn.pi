# A law is [operation, integer coefficient, scope]. Experiments are [reducer, samples].
# Each sample is one unit interval when the reducer is "impulse".
skill sl_adjust(law, x) -> Any {
  if law[0] == "scale" { return x * law[1] }
  return x + law[1]
}

skill sl_eval(law, experiment) -> Any {
  let product = experiment[0] == "product"
  let y = if product { 1 } else { 0 }
  for x in experiment[1] {
    let v = if law[2] == "before" { sl_adjust(law, x) } else { x }
    if product { y *= v } else { y += v }
  }
  return if law[2] == "after" { sl_adjust(law, y) } else { y }
}

skill sl_filter(laws, experiment, observed, error) -> Any {
  let keep = []
  for law in laws {
    let delta = sl_eval(law, experiment) - observed
    if delta >= 0 - error and delta <= error { keep = append(keep, law) }
  }
  return keep
}

# Worst number of surviving integer prediction intervals. A maximum occurs at a left endpoint.
skill sl_worst(laws, experiment, error) -> Any {
  let worst = 0
  for law in laws {
    let answer = sl_eval(law, experiment) - error
    let size = len(sl_filter(laws, experiment, answer, error))
    if size > worst { worst = size }
  }
  return worst
}

skill sl_session(domain, reply) -> Any {
  if domain != "words" and domain != "physics" { return "choose words or physics" }
  let laws = []
  for op in ["shift", "scale"] {
    for k in range(0 - 4, 5) {
      for side in ["before", "after"] { laws = append(laws, [op, k, side]) }
    }
  }
  let examples = [[["sum", [2,3]],10], [["sum", [1,2,3]],12]]
  let reducers = ["sum", "product"]
  let held = ["product", [3,5,7]]
  if domain == "physics" {
    examples = [[["impulse",[1]],3], [["impulse",[4]],6]]
    reducers = ["impulse"]
    held = ["impulse", [4,3,5]]
  }
  for ex in examples { laws = sl_filter(laws, ex[0], ex[1], 0) }
  do print("Explanations after the examples: " ++ str(laws))
  let best = null
  let worst = len(laws)
  # Prefer shorter experiments among equally informative questions.
  for n in range(1, 5) {
    let xs = range(2, 2 + n)
    for reducer in reducers {
      let experiment = [reducer, xs]
      let size = sl_worst(laws, experiment, 0)
      if size < worst { best = experiment; worst = size }
    }
  }
  if best == null { return "No distinguishing experiment in this search space." }
  do print("Chosen observation: " ++ str(best))
  for law in laws { do print(str(law) ++ " predicts " ++ str(sl_eval(law, best))) }
  if reply == null { return "Run again with the observed integer after the domain." }
  let value = int(reply)
  if str(value) != reply { return "Expected a canonical signed integer observation." }
  laws = sl_filter(laws, best, value, 0)
  if len(laws) == 0 { return "Observation contradicts every proposed law. Expand the hypothesis space." }
  if len(laws) > 1 { return "Still ambiguous: " ++ str(laws) }
  return "Retained " ++ str(laws[0]) ++ "; on new input " ++ str(held) ++ " predicts " ++ str(sl_eval(laws[0], held))
}
