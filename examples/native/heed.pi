# heed: Pi does what it is told, in English.
#
# Pi's mind (mindcore.pi) finds programs from examples: shown what "sum of squares" does to a few lists, it searches
# out sum(map(e -> e * e, x)). Every task it practises comes with a name. tonguelib.pi learns a language from pairs of
# utterance and meaning. Put together: the names are the utterances, the programs Pi found are the meanings, and
# what comes out is English that Pi can act on -- an instruction it was never given, read as a program and run.
#
# A meaning here is a chain of steps, outermost first: "sum of squares" is [sum(_)] [map(e -> e * e, _)], the _ being
# where the next step (and at last the input) goes. A program whose steps are not a chain (the input used twice,
# as in maxl(x) - minl(x)) is one step, whole. A word's meaning is then a piece of a chain, and to put words
# together is to join their pieces -- which is all tonguelib knows how to do.
#
#   PRACTICE  each named task solved by search, from examples (no words of its own yet, and no language); the names
#             and the programs found become Pi's English.
#   Then three rounds of instructions it never practised. In each round:
#   TOLD      the instruction alone, no examples. Pi reads it as a program; the program is run on inputs and compared
#             with what the instruction's author meant.
#   SHOWN     for each one it got wrong or could not read, examples -- and now Pi CHECKS ITS READING against them
#             before it trusts it, and mends the reading with what the examples say, cheapest mending first:
#               the reading fits                      -> kept (a guess the examples confirmed)
#               the words are right, the order is not -> the order of its steps that fits
#               one word is new                       -> the step Pi already knows that makes the sentence fit
#               a word means something else here      -> another known step for it, if every earlier sentence
#                                                        with that word still does what it did
#               none of these                         -> the search, as for a task with no name
#             A step that does nothing to the examples is no evidence for a word. What Pi settles on is heard as a
#             new sentence, and when the round is over the English is made again from everything heard.
#   A sentence kept whole whose words now read to a program that does the same thing gives way to the reading
#   (what a sentence means is what it does, not how the search happened to write it).
import "mindcore.pi"
import "tonguelib.pi"

# an instruction's words: lower case, a comma a word of its own
skill hd_words(text) -> Any { return split(join(split(lower(text), ","), " , ")) }

# does t use the input (outside an element function)?
skill hd_uses(t) -> Any {
  if t[0] == "v" { return isinput(t[1]) }
  if t[0] == "q" or t[0] == "p" { return false }
  for i in range(0, len(t[2])) {
    if is_fp(t, i) == false {
      if hd_uses(t[2][i]) { return true }
    }
  }
  return false
}

# the hole in a step (its own mark: ["p", 0] is already the running value inside a fold)
skill hd_hole() -> Any { return ["v", "_"] }

skill hd_holed(t) -> Any {
  if t[0] == "v" {
    if isinput(t[1]) { return hd_hole() }
    return t
  }
  if t[0] == "q" or t[0] == "p" { return t }
  let out = []
  for a in t[2] { let out = append(out, hd_holed(a)) }
  return [t[0], t[1], out]
}

skill hd_plug(t, v) -> Any {
  if t[0] == "v" {
    if t[1] == "_" { return v }
    return t
  }
  if t[0] == "q" or t[0] == "p" { return t }
  let out = []
  for a in t[2] { let out = append(out, hd_plug(a, v)) }
  return [t[0], t[1], out]
}

# a program as a chain of steps, outermost first; each step a tree with a hole where the rest goes
skill hd_chain(t) -> Any {
  let out = []
  let cur = t
  let going = true
  while going {
    if cur[0] == "v" { let going = false } else {
      let which = 0 - 1
      let count = 0
      if cur[0] == "op" or cur[0] == "w" {
        for i in range(0, len(cur[2])) {
          if is_fp(cur, i) == false {
            if hd_uses(cur[2][i]) {
              let which = i
              let count = count + 1
            }
          }
        }
      }
      if count == 1 {
        let args = []
        for i in range(0, len(cur[2])) {
          if i == which { let args = append(args, hd_hole()) } else { let args = append(args, cur[2][i]) }
        }
        let out = append(out, [cur[0], cur[1], args])
        let cur = cur[2][which]
      } else {
        # the input used twice, or not at all: what is left is one step, the input its hole
        let out = append(out, hd_holed(cur))
        let going = false
      }
    }
  }
  return out
}

# a step as one word of meaning, written as Pi writes programs, with _ for the hole
skill hd_token(step) -> Any { return "[" ++ show(step) ++ "]" }

# the chain as words of meaning; steps: every step met so far, by its word -> [words, steps]
skill hd_meaning(t, steps) -> Any {
  let toks = []
  for st in hd_chain(t) {
    let k = hd_token(st)
    let toks = append(toks, k)
    let steps = put(steps, k, st)
  }
  return [toks, steps]
}

# words of meaning back into a program: each step's hole takes what follows, the last takes the input
skill hd_program(toks, steps, xin) -> Any {
  let cur = xin
  let i = len(toks) - 1
  while i >= 0 {
    let st = steps[toks[i]]
    if st == null { return null }
    let cur = hd_plug(st, cur)
    let i = i - 1
  }
  return cur
}

skill hd_input(domain) -> Any {
  if domain == "grids" { return ["v", "g"] }
  return ["v", "x"]
}

# the kind of value a program gives (I a number, L a list, G a grid, C a truth), or null if its pieces do not
# fit one another -- a grid step given a list is not a program, and is never run
skill hd_kind(t, sigs) -> Any {
  let h = t[0]
  if h == "v" {
    if t[1] == "x" { return "L" }
    if t[1] == "g" { return "G" }
    return "I"
  }
  if h == "q" or h == "p" { return "I" }
  if h != "op" { return null }
  let sig = sigs[t[1]]
  if sig == null { return null }
  if len(sig[0]) != len(t[2]) { return null }
  for i in range(0, len(sig[0])) {
    let want = sig[0][i]
    if want != "F" and want != "P" and want != "F2" {
      if hd_kind(t[2][i], sigs) != want { return null }
    }
  }
  return sig[1]
}

skill hd_sigs() -> Any {
  let sigs = {}
  for o in optable() { let sigs = put(sigs, o[0], [o[1], o[2]]) }
  return sigs
}

skill hd_agrees(tree, f, inputs) -> Any {
  if tree == null { return false }
  if hd_kind(tree, hd_sigs()) == null { return false }
  for v in inputs {
    let y = sev(tree, null, v, null, [])
    if y == null { return false }
    if y != f(v) { return false }
  }
  return true
}

# the score: is this program what the task's author meant? run on every input, the held-out ones too
skill hd_right(tree, f, domain) -> Any { return hd_agrees(tree, f, train_inputs(domain) ++ held_inputs(domain)) }

# Pi's own check: does it fit the examples Pi was shown? (the held-out inputs are not Pi's to look at)
skill hd_fits(tree, f, domain) -> Any { return hd_agrees(tree, f, train_inputs(domain)) }

skill hd_tasks(domain, unseen) -> Any {
  if unseen {
    if domain == "lists" { return unseen_lists() }
    if domain == "text" { return unseen_text() }
    return unseen_grids()
  }
  if domain == "lists" { return list_tasks() }
  if domain == "text" { return text_tasks() }
  return grid_tasks()
}

# ---- new instructions, made of words Pi will by then have met (stage 5): never practised, never shown -----------
skill hd_new_lists() -> Any {
  return [
    ["sum of negatives", fn(xs) => sum(tfilter(xs, fn(v) => v < 0))],
    ["product of negatives", fn(xs) => t_prod(tfilter(xs, fn(v) => v < 0))],
    ["negatives sorted", fn(xs) => sort(tfilter(xs, fn(v) => v < 0))],
    ["squares of negatives", fn(xs) => tmap(tfilter(xs, fn(v) => v < 0), fn(v) => v * v)],
    ["count doubles", fn(xs) => len(tmap(xs, fn(v) => v * 2))],
    ["product of doubles", fn(xs) => t_prod(tmap(xs, fn(v) => v * 2))],
    ["largest square of positives", fn(xs) => tmax(tmap(tfilter(xs, fn(v) => v > 0), fn(v) => v * v))],
    ["sum of squares of evens", fn(xs) => sum(tmap(tfilter(xs, fn(v) => v % 2 == 0), fn(v) => v * v))],
    ["evens sorted", fn(xs) => sort(tfilter(xs, fn(v) => v % 2 == 0))],
    ["squares sorted, biggest first", fn(xs) => reverse(sort(tmap(xs, fn(v) => v * v)))],
    ["three smallest, biggest first", fn(xs) => reverse(ttake(3, sort(xs)))],
    ["count evens", fn(xs) => len(tfilter(xs, fn(v) => v % 2 == 0))]
  ]
}

skill hd_new_text() -> Any {
  return [
    ["count letters before n", fn(xs) => len(tfilter(xs, fn(v) => v < 110))],
    ["letters before n, reversed", fn(xs) => reverse(tfilter(xs, fn(v) => v < 110))],
    ["letters after m, sorted", fn(xs) => sort(tfilter(xs, fn(v) => v > 109))],
    ["uppercase, reversed, sorted", fn(xs) => sort(reverse(tmap(xs, fn(v) => v - 32)))]
  ]
}

skill hd_new_grids() -> Any {
  return [
    ["rotate left, recolour 1 to 5", fn(g) => t_rotl(t_recol(g, 1, 5))],
    ["transpose, then flip", fn(g) => reverse(transpose(g))],
    ["rotate right, then flip", fn(g) => reverse(t_rotr(g))],
    ["mirror, then flip", fn(g) => reverse(t_fliph(g))]
  ]
}

skill hd_new(domain) -> Any {
  if domain == "lists" { return hd_new_lists() }
  if domain == "text" { return hd_new_text() }
  return hd_new_grids()
}

# ---- a third set, for the words mended in the second round ---------------------------------------------------------
skill hd_third(domain) -> Any {
  if domain == "lists" {
    return [
      ["doubles sorted", fn(xs) => sort(tmap(xs, fn(v) => v * 2))],
      ["sum of doubles of positives", fn(xs) => sum(tmap(tfilter(xs, fn(v) => v > 0), fn(v) => v * 2))],
      ["sum of squares of negatives", fn(xs) => sum(tmap(tfilter(xs, fn(v) => v < 0), fn(v) => v * v))],
      ["negatives sorted, biggest first", fn(xs) => reverse(sort(tfilter(xs, fn(v) => v < 0)))],
      ["evens sorted, biggest first", fn(xs) => reverse(sort(tfilter(xs, fn(v) => v % 2 == 0)))],
      ["sum of three smallest", fn(xs) => sum(ttake(3, sort(xs)))],
      ["three smallest of positives", fn(xs) => ttake(3, sort(tfilter(xs, fn(v) => v > 0)))],
      ["product of doubles of evens", fn(xs) => t_prod(tmap(tfilter(xs, fn(v) => v % 2 == 0), fn(v) => v * 2))]
    ]
  }
  if domain == "text" {
    return [
      ["letters before n, sorted", fn(xs) => sort(tfilter(xs, fn(v) => v < 110))],
      ["uppercase, sorted, reversed", fn(xs) => reverse(sort(tmap(xs, fn(v) => v - 32)))],
      ["count letters after m, sorted", fn(xs) => len(sort(tfilter(xs, fn(v) => v > 109)))]
    ]
  }
  return [
    ["transpose, recolour 1 to 5", fn(g) => transpose(t_recol(g, 1, 5))],
    ["mirror left-right, then flip", fn(g) => reverse(t_fliph(g))],
    ["flip upside down, recolour 1 to 5", fn(g) => reverse(t_recol(g, 1, 5))],
    ["mirror, then flip", fn(g) => reverse(t_fliph(g))]
  ]
}

# ---- reading, and checking a reading ---------------------------------------------------------------------------
# an instruction read with no examples -> the words of meaning, or null
skill hd_read(rules, fam, text) -> Any { return tg_understand(rules, fam, hd_words(text)) }

# TOLD: [the program or null, how it went: "right", "wrong" or "cannot read"]
skill hd_told(rules, fam, steps, task, domain) -> Any {
  let toks = hd_read(rules, fam, task[0])
  if toks == null { return [null, "cannot read"] }
  let tree = hd_program(toks, steps, hd_input(domain))
  if hd_right(tree, task[1], domain) { return [tree, "right"] }
  return [tree, "wrong"]
}

# every order of a few steps
skill hd_orders(toks) -> Any {
  if len(toks) <= 1 { return [toks] }
  let out = []
  for i in range(0, len(toks)) {
    for rest in hd_orders(slice(toks, 0, i) ++ slice(toks, i + 1, len(toks))) { let out = append(out, [toks[i]] ++ rest) }
  }
  return out
}

# how many letters two words share from the start
skill hd_alike(a, b) -> Any {
  let n = 0
  while n < len(a) and n < len(b) and slice(a, n, n + 1) == slice(b, n, n + 1) { let n = n + 1 }
  return n
}

# the known steps, those named by a word that looks like w first (the more letters shared, the sooner)
skill hd_likely(rules, w, known) -> Any {
  let ks = []
  for k in known {
    let best = 0
    for r in rules {
      if len(r[0]) == 1 and r[1] == [k] {
        let a = hd_alike(w, r[0][0])
        if a >= 4 and a > best { let best = a }
      }
    }
    let ks = append(ks, tg_pad(100 - best) ++ " " ++ k)
  }
  let out = []
  for s in sort(ks) { let out = append(out, slice(s, 5, len(s))) }
  return out
}

# does every sentence heard that has the word w still do what it did, if w meant the step k?
skill hd_still(mem, rules, fam, steps, w, k) -> Any {
  let rules2 = [[[w], [k]]] ++ rules
  for mm in mem {
    if contains(mm[0], w) {
      let toks = tg_understand(rules2, fam, mm[0])
      if toks == null { return false }
      if hd_fits(hd_program(toks, steps, hd_input(mm[3])), mm[2], mm[3]) == false { return false }
    }
  }
  return true
}

# does the step k do nothing here? (the program fits as well without it: then these examples say nothing about a
# word that would mean k -- "keep the positives" changes no word of letters, and must not become what a comma means)
skill hd_idle(toks, k, steps, xin, f, domain) -> Any {
  for i in range(0, len(toks)) {
    if toks[i] == k and len(toks) > 1 {
      let without = slice(toks, 0, i) ++ slice(toks, i + 1, len(toks))
      if hd_fits(hd_program(without, steps, xin), f, domain) { return true }
    }
  }
  return false
}

# SHOWN: mend the reading of an instruction with its examples, cheapest mending first
# -> [the words of meaning, how it was mended], or null (then it is for the search)
skill hd_mend(mem, rules, fam, steps, task, domain) -> Any {
  let words = hd_words(task[0])
  let xin = hd_input(domain)
  let toks = tg_understand(rules, fam, words)
  if toks != null {
    if hd_fits(hd_program(toks, steps, xin), task[1], domain) { return [toks, "its reading fits the examples"] }
    if len(toks) <= 4 {
      for o in hd_orders(toks) {
        if hd_fits(hd_program(o, steps, xin), task[1], domain) { return [o, "the words were right, the order is mended"] }
      }
    }
  }
  let known = sort(keys(steps))
  # one new word: the step Pi already knows that makes the sentence fit. Several may fit one sentence ("sum of
  # doubles" is as well sum(x ++ x)); the step a look-alike word already names is tried first ("double")
  for w in tg_strangers(rules, words) {
    for k in hd_likely(rules, w, known) {
      let t2 = tg_understand([[[w], [k]]] ++ rules, fam, words)
      if t2 != null {
        if hd_fits(hd_program(t2, steps, xin), task[1], domain) {
          if hd_idle(t2, k, steps, xin, task[1], domain) == false { return [t2, "\"" ++ w ++ "\" is new: it must mean " ++ k] }
        }
      }
    }
  }
  # a word Pi knows means something else here -- allowed only if what it has heard with that word still holds
  for w in words {
    let was = tg_read(rules, [w])
    if was != null {
      for k in known {
        if [k] != was {
          let t3 = tg_understand([[[w], [k]]] ++ rules, fam, words)
          if t3 != null {
            if hd_fits(hd_program(t3, steps, xin), task[1], domain) {
              if hd_idle(t3, k, steps, xin, task[1], domain) == false {
                if hd_still(mem, rules, fam, steps, w, k) { return [t3, "\"" ++ w ++ "\" was mistaken: it means " ++ k] }
              }
            }
          }
        }
      }
    }
  }
  return null
}

# ---- what Pi has heard: memories [words, meaning, the task's function, its domain] -> the English ------------------
skill hd_pairs(mem) -> Any {
  let out = []
  for mm in mem { let out = append(out, [mm[0], mm[1]]) }
  return out
}

# a sentence kept whole, word for word, whose words now read (without that rule) to a program that fits its
# examples: the reading replaces what the search wrote. -> [memories, how many gave way]
skill hd_settle(mem, rules, fam, steps) -> Any {
  let out = []
  let changed = 0
  for mm in mem {
    let keep = mm
    if len(mm[0]) >= 2 {
      let others = []
      let whole = false
      for r in rules {
        if r[0] == mm[0] { let whole = true } else { let others = append(others, r) }
      }
      if whole {
        let toks = tg_understand(others, fam, mm[0])
        if toks != null {
          if toks != mm[1] {
            if hd_fits(hd_program(toks, steps, hd_input(mm[3])), mm[2], mm[3]) {
              let keep = [mm[0], toks, mm[2], mm[3]]
              let changed = changed + 1
            }
          }
        }
      }
    }
    let out = append(out, keep)
  }
  return [out, changed]
}

# the English of everything heard, settled: -> [rules, fam, memories]
skill hd_english(mem, steps) -> Any {
  let rules = tg_learn(hd_pairs(mem))
  let fam = tg_familiar(rules, hd_pairs(mem))
  let going = 3
  while going > 0 {
    let st = hd_settle(mem, rules, fam, steps)
    if st[1] == 0 { let going = 0 } else {
      let mem = st[0]
      let rules = tg_learn(hd_pairs(mem))
      let fam = tg_familiar(rules, hd_pairs(mem))
      let going = going - 1
    }
  }
  return [rules, fam, mem]
}

skill hd_set(round, domain) -> Any {
  if round == 1 { return hd_tasks(domain, true) }
  if round == 2 { return hd_new(domain) }
  return hd_third(domain)
}

skill main() -> Any {
  let domains = ["lists", "text", "grids"]
  let pl = pools()
  let pre = prelude()
  let g = default_genome()
  do print("PRACTICE -- each task solved by search, from examples:")
  let mem = []
  let steps = {}
  for d in domains {
    for t in hd_tasks(d, false) {
      let r = attempt_task_g(t, d, [], [], pl, pre, g)
      if r[0] == null { do print("  " ++ t[0] ++ ": not found") } else {
        let mn = hd_meaning(r[0], steps)
        let steps = mn[1]
        let mem = append(mem, [hd_words(t[0]), mn[0], t[1], d])
        do print("  " ++ t[0] ++ ": " ++ show(r[0]))
      }
    }
  }
  let en = hd_english(mem, steps)
  let rules = en[0]
  let fam = en[1]
  let mem = en[2]
  do print("")
  do print("the English Pi made of it: " ++ str(len(rules)) ++ " rules from " ++ str(len(mem)) ++ " names")
  do print(tg_show(rules))
  let summary = []
  for round in [1, 2, 3] {
    do print("ROUND " ++ str(round) ++ " -- TOLD (no examples):")
    let right = 0
    let total = 0
    let beyond = 0
    let again = 0
    let failed = []
    for d in domains {
      for t in hd_set(round, d) {
        let r = hd_told(rules, fam, steps, t, d)
        let total = total + 1
        let line = "  " ++ t[0] ++ ": " ++ r[1]
        if r[0] != null { let line = line ++ "   " ++ show(r[0]) }
        if r[1] == "right" {
          let right = right + 1
          # one it was shown the answer to in an earlier round is remembered, not worked out: said so, and counted apart
          for q in mem {
            if q[0] == hd_words(t[0]) and q[3] == d {
              let again = again + 1
              let line = line ++ "   (remembered: it was shown this one before)"
            }
          }
          if round == 1 {
            # could Pi have found this one from examples, by search, as it found the tasks it practised?
            let s = attempt_task_g(t, d, [], [], pl, pre, g)
            if s[0] == null {
              let beyond = beyond + 1
              let line = line ++ "   (beyond its search: shown examples and no words, it finds nothing)"
            }
          }
        } else { let failed = append(failed, [t, d]) }
        do print(line)
      }
    }
    let line = "  told: " ++ str(right) ++ " of " ++ str(total) ++ " done rightly"
    if round == 1 { let line = line ++ "; " ++ str(beyond) ++ " of those are beyond what its search finds from examples" }
    if again > 0 { let line = line ++ "; " ++ str(again) ++ " of those remembered from being shown, " ++ str(right - again) ++ " of " ++ str(total - again) ++ " new ones worked out" }
    do print(line)
    let sm = "round " ++ str(round) ++ ": " ++ str(right - again) ++ " of " ++ str(total - again)
    if again > 0 { let sm = sm ++ " new (and " ++ str(again) ++ " remembered)" }
    let summary = append(summary, sm)
    if len(failed) > 0 {
      do print("ROUND " ++ str(round) ++ " -- SHOWN (examples for the " ++ str(len(failed)) ++ " it did not get):")
      let searched = 0
      let mended = 0
      for ft in failed {
        let t = ft[0]
        let d = ft[1]
        let md = hd_mend(mem, rules, fam, steps, t, d)
        let toks = null
        if md != null {
          let toks = md[0]
          let mended = mended + 1
          do print("  " ++ t[0] ++ ": " ++ md[1] ++ "   " ++ show(hd_program(toks, steps, hd_input(d))))
        } else {
          let r = attempt_task_g(t, d, [], [], pl, pre, g)
          if r[0] == null { do print("  " ++ t[0] ++ ": not mended, and not found by search") } else {
            let mn = hd_meaning(r[0], steps)
            let steps = mn[1]
            let toks = mn[0]
            let searched = searched + 1
            do print("  " ++ t[0] ++ ": by search   " ++ show(r[0]))
          }
        }
        if toks != null { let mem = append(mem, [hd_words(t[0]), toks, t[1], d]) }
      }
      # the English is made again from everything heard
      let en = hd_english(mem, steps)
      let rules = en[0]
      let fam = en[1]
      let mem = en[2]
      do print("  mended from its own reading: " ++ str(mended) ++ "; left to the search: " ++ str(searched) ++ "; the English is now " ++ str(len(rules)) ++ " rules from " ++ str(len(mem)) ++ " sentences")
    }
    do print("")
  }
  do print("the English at the end:")
  do print(tg_show(rules))
  return "told, with no examples -- " ++ join(summary, "; ")
}
