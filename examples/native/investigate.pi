# Active program induction in the integer world shared with dream and curious.
import "dreamlib.pi"
import "chatprofile.pi"

# Prefer the probe with the smallest sum of squared outcome counts. Under
# a uniform prior on candidate programs, this minimizes expected survivors.
skill experiment(models, probes) -> Any {
  let best = null
  let cost = len(models)*len(models)
  for x in probes {
    let counts = {}
    let score = 0
    for model in models {
      let key = str(run(model,x))
      let n = counts[key]
      if n == null { let n = 0 }
      let score = score + 2*n + 1
      let counts = put(counts,key,n+1)
    }
    if score < cost {
      let best = x
      let cost = score
    }
  }
  return best
}

skill formula(model) -> Any {
  let expr = "x"
  for op in model {
    if op[0] == 0 { expr = "(" ++ expr ++ " + " ++ str(op[1]) ++ ")" }
    if op[0] == 1 { expr = "(" ++ expr ++ " * " ++ str(op[1]) ++ ")" }
    if op[0] == 2 { expr = "(" ++ expr ++ " * x)" }
    if op[0] == 3 { expr = "(" ++ expr ++ ")^2" }
  }
  return expr
}

# Search the learned program over the same bounded domain exposed by "use".
skill input_for(model,wanted) -> Any {
  for x in range(-8,9) {
    if run(model,x) == wanted {
      return "Input " ++ str(x) ++ " gives " ++ str(wanted) ++ " under the learned rule " ++ formula(model) ++ "."
    }
  }
  return "The learned rule " ++ formula(model) ++ " gives no input from -8 to 8 for output " ++ str(wanted) ++ "."
}

skill main() -> Any {
  let alpha = alphabet()
  let path = chat_data("investigations.txt")
  let log = read_file(path)
  let seed = 12345
  let last = null
  if log != null {
    for row in split(log,"\n") {
      let fields = split(trim(row)," ")
      if len(fields) != 3 { continue }
      let s = num(fields[0])
      let size = num(fields[1])
      let idx = num(fields[2])
      if s == null or size == null or idx == null { continue }
      if size < 1 or size > 3 or idx < 0 or idx >= power(len(alpha),int(size)) { continue }
      let seed = int(s)
      let last = nth_prog(alpha,int(size),int(idx))
    }
  }
  if arg(1) == "use" {
    if last == null { return "Run an investigation first." }
    let x = arg(2)
    if x != null {
      for n in range(-8,9) {
        if str(n) == trim(x) { return formula(last) ++ " at " ++ str(n) ++ " = " ++ str(run(last,n)) }
      }
    }
    return "Give an integer from -8 to 8."
  }
  let solving = arg(1) == "solve"
  let wanted = null
  if solving {
    let raw = arg(2)
    let wanted = if raw == null { null } else { num(raw) }
    if wanted == null or abs(wanted) > 100000000 or str(int(wanted)) != raw { return "Give a whole-number output between -100000000 and 100000000." }
    let wanted = int(wanted)
    if last != null { return input_for(last,wanted) }
  }
  let world = dream_target(seed,alpha,3)
  let models = []
  for size in range(1,4) {
    for i in range(0,power(len(alpha),size)) { models = append(models,nth_prog(alpha,size,i)) }
  }
  let notes = []
  while true {
    let probe = experiment(models,range(-5,6))
    if probe == null { break }
    let observed = run(world[0],probe)
    let kept = []
    for model in models { if run(model,probe) == observed { kept = append(kept,model) } }
    let notes = append(notes,"Tried " ++ str(probe) ++ ", observed " ++ str(observed) ++ ": " ++ str(len(models)) ++ " candidates -> " ++ str(len(kept)) ++ ".")
    let models = kept
  }
  let model = models[0]
  for x in [-8,-7,-6,6,7,8] {
    if run(model,x) != run(world[0],x) { return join(notes,"\n") ++ "\nRule failed a reserved input." }
  }
  let idx = 0
  for i in range(0,power(len(alpha),len(model))) {
    if nth_prog(alpha,len(model),i) == model {
      let idx = i
      break
    }
  }
  if not rt_append_file(path,str(world[1]) ++ " " ++ str(len(model)) ++ " " ++ str(idx) ++ "\n") { return "Could not save the discovery." }
  let result = join(notes,"\n") ++ "\nSaved " ++ formula(model) ++ " after checking six reserved inputs."
  if solving { return result ++ "\n" ++ input_for(model,wanted) }
  return result
}
