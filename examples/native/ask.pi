# Answer one question using the same facts as interactive chat.
import "conversation.pi"

skill main() -> Any {
  let words = []
  let i = 1
  while arg(i) != null {
    let words = append(words,arg(i))
    let i = i+1
  }
  if len(words) == 0 { return "Usage: ask QUESTION" }
  let reply = handle(load_facts("out/chat_facts.txt"),join(words," "))
  if reply[2] { return "Use chat to teach new facts." }
  return reply[0]
}
