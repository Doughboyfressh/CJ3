# Induction: Pi writes a program from examples. It searches expressions bottom-up, smallest first, over the
# inputs (x, y), the constants 0..3 and the operations + - * // % max min and negation. It keeps only ONE program
# per distinct behaviour on the examples (observational equivalence, deduplicated in a hash set), so the space
# stays small. The first program whose outputs equal the targets is then RUN by Pi's own evaluator (interp.pi)
# on held-out inputs it never saw; only if it holds there does it count. The smallest program found is the
# shortest description Pi has of the examples -- induction as compression. Deterministic -> golden.
import "interp.pi"

skill opnames() -> Any { return ["+", "-", "*", "//", "%", "max", "min"] }
skill commutes(c) -> Any { return c == 0 or c == 2 or c == 5 or c == 6 }

skill apply2(c, a, b) -> Any {
  if c == 0 { return a + b }
  if c == 1 { return a - b }
  if c == 2 { return a * b }
  if c == 3 { return a // b }
  if c == 4 { return a % b }
  if c == 5 {
    if a >= b { return a }
    return b
  }
  if a <= b { return a }
  return b
}

# two independent polynomial hashes of an output vector, folded into one integer key
skill mix1(h, v) -> Any { return (h * 1000003 + v % 1073741789 + 1) % 1073741789 }
skill mix2(h, v) -> Any { return (h * 999983 + v % 1073741783 + 7) % 1073741783 }

# a growable list built in chunks (appending to one big list would copy it every time)
skill gl_push(g, x) -> Any {
  let cur = append(g[1], x)
  if len(cur) >= 64 { return [append(g[0], cur), []] }
  return [g[0], cur]
}
skill gl_items(g) -> Any {
  let out = []
  for c in g[0] { let out = out ++ c }
  return out ++ g[1]
}

# readable Pi for an expression tree
skill show(e) -> Any {
  let h = e[0]
  if h == "v" { return e[1] }
  if h == "q" { return str(e[1]) }
  let a = e[2]
  if e[1] == "neg" { return "-" ++ show(a[0]) }
  if e[1] == "max" or e[1] == "min" { return e[1] ++ "(" ++ show(a[0]) ++ ", " ++ show(a[1]) ++ ")" }
  return "(" ++ show(a[0]) ++ " " ++ e[1] ++ " " ++ show(a[1]) ++ ")"
}

skill size_of(e) -> Any {
  if e[0] == "v" or e[0] == "q" { return 1 }
  let s = 1
  for a in e[2] { let s = s + size_of(a) }
  return s
}

# does the tree, run by Pi's own evaluator, give the right output on every held-out case?
skill verify(tree, vars, held) -> Any {
  for ex in held {
    let env = {}
    for i in range(0, len(vars)) { let env = put(env, vars[i], ex[0][i]) }
    let r = ev(tree, env, {}, 10000)
    if r[0] == 0 { return false }
    if r[1] != ex[1] { return false }
  }
  return true
}

# -> the smallest verified program as a tree, or null; examples are [[inputs], output]
skill induce(train, held, nvars, maxsize, cap) -> Any {
  let vars = slice(["x", "y"], 0, nvars)
  let n = len(train)
  let target = []
  for ex in train { let target = append(target, ex[1]) }
  let seen = hset(1048576)
  let levels = [[]]
  let total = 0
  # size 1: the inputs and the constants
  let l1 = [[], []]
  let leaves = []
  for i in range(0, nvars) { let leaves = append(leaves, [["v", vars[i]], i]) }
  for c in [0, 1, 2, 3] { let leaves = append(leaves, [["q", c], 0 - 1 - c]) }
  for lf in leaves {
    let vec = []
    for ex in train {
      if lf[1] >= 0 { let vec = append(vec, ex[0][lf[1]]) } else { let vec = append(vec, 0 - 1 - lf[1]) }
    }
    let h1 = 0
    let h2 = 0
    for v in vec {
      let h1 = mix1(h1, v)
      let h2 = mix2(h2, v)
    }
    if hset_add(seen, h1 * 1073741783 + h2) {
      if vec == target {
        if verify(lf[0], vars, held) { return lf[0] }
      }
      let l1 = gl_push(l1, [lf[0], vec])
      let total = total + 1
    }
  }
  let levels = append(levels, gl_items(l1))
  for s in range(2, maxsize + 1) {
    let cur = [[], []]
    # negation of size s-1
    for a in levels[s - 1] {
      if total < cap {
        let h1 = 0
        let h2 = 0
        let same = true
        for j in range(0, n) {
          let v = 0 - a[1][j]
          let h1 = mix1(h1, v)
          let h2 = mix2(h2, v)
          if v != target[j] { let same = false }
        }
        if hset_add(seen, h1 * 1073741783 + h2) {
          let vec = []
          for j in range(0, n) { let vec = append(vec, 0 - a[1][j]) }
          let tree = ["op", "neg", [a[0]]]
          if same {
            if verify(tree, vars, held) { return tree }
          }
          let cur = gl_push(cur, [tree, vec])
          let total = total + 1
        }
      }
    }
    # binary operations whose two sides sum to s-1
    for c in range(0, 7) {
      for sa in range(1, s - 1) {
        let sb = s - 1 - sa
        if commutes(c) == false or sa <= sb {
          let la = levels[sa]
          let lb = levels[sb]
          for ia in range(0, len(la)) {
            let a = la[ia]
            let start = 0
            if commutes(c) and sa == sb { let start = ia }
            for ib in range(start, len(lb)) {
              if total < cap {
                let b = lb[ib]
                let ok = true
                let h1 = 0
                let h2 = 0
                let same = true
                for j in range(0, n) {
                  if ok {
                    let bv = b[1][j]
                    if (c == 3 or c == 4) and bv == 0 {
                      let ok = false
                    } else {
                      let v = apply2(c, a[1][j], bv)
                      let h1 = mix1(h1, v)
                      let h2 = mix2(h2, v)
                      if v != target[j] { let same = false }
                    }
                  }
                }
                if ok {
                  if hset_add(seen, h1 * 1073741783 + h2) {
                    let vec = []
                    for j in range(0, n) { let vec = append(vec, apply2(c, a[1][j], b[1][j])) }
                    let tree = ["op", opnames()[c], [a[0], b[0]]]
                    if same {
                      if verify(tree, vars, held) { return tree }
                    }
                    let cur = gl_push(cur, [tree, vec])
                    let total = total + 1
                  }
                }
              }
            }
          }
        }
      }
    }
    let levels = append(levels, gl_items(cur))
  }
  return null
}

skill ex1(f, xs) -> Any {
  let out = []
  for x in xs { let out = append(out, [[x], f(x)]) }
  return out
}
skill ex2(f, xs, ys) -> Any {
  let out = []
  for x in xs {
    for y in ys { let out = append(out, [[x, y], f(x, y)]) }
  }
  return out
}

skill report(name, tree) -> Any {
  if tree == null { return name ++ ": not found within the size limit\n" }
  return name ++ ": " ++ show(tree) ++ "  (size " ++ str(size_of(tree)) ++ ", verified on unseen inputs)\n"
}

skill main() -> Any {
  let tx = [0 - 3, 0 - 2, 0 - 1, 0, 1, 2, 3, 4]
  let hx = [5, 6, 7, 9, 0 - 5]
  let out = ""
  let found = 0
  let cases = [
    ["x*x + 1", fn(x) => x * x + 1],
    ["(x+1)*(x-1)", fn(x) => (x + 1) * (x - 1)],
    ["3*x - 1", fn(x) => 3 * x - 1],
    ["x*x*x", fn(x) => x * x * x],
    ["x//2 + 1", fn(x) => x // 2 + 1],
    ["x % 3", fn(x) => x % 3],
    ["max(x, 2)", fn(x) => max(x, 2)],
    ["(x+2)*(x+2)", fn(x) => (x + 2) * (x + 2)],
    ["2x^2 + 3x + 1", fn(x) => 2 * x * x + 3 * x + 1]
  ]
  for cs in cases {
    let f = cs[1]
    let t = induce(ex1(f, tx), ex1(f, hx), 1, 9, 400000)
    if t != null { let found = found + 1 }
    let out = out ++ report(cs[0], t)
  }
  let txy = [1, 2, 3, 4]
  let ty = [1, 2, 3]
  let hxy = [5, 7]
  let hy = [4, 6]
  let cases2 = [
    ["x*y + 1", fn(x, y) => x * y + 1],
    ["(x+y)*(x-y)", fn(x, y) => (x + y) * (x - y)],
    ["|x - y|", fn(x, y) => max(x, y) - min(x, y)],
    ["x*x + y*y", fn(x, y) => x * x + y * y],
    ["x // y", fn(x, y) => x // y]
  ]
  for cs in cases2 {
    let f = cs[1]
    let t = induce(ex2(f, txy, ty), ex2(f, hxy, hy), 2, 9, 400000)
    if t != null { let found = found + 1 }
    let out = out ++ report(cs[0], t)
  }
  return out ++ "found " ++ str(found) ++ " of 14"
}
