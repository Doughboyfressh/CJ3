1. Pi practises (each task solved by search, from examples):
  sum: sum(x)   = [sum(_)]
  length: len(x)   = [len(_)]
  reverse: rev(x)   = [rev(_)]
  sort: sort(x)   = [sort(_)]
  double each: map(e -> (e + e), x)   = [map(e -> (e + e), _)]
  add one to each: map(e -> (e + 1), x)   = [map(e -> (e + 1), _)]
  square each: map(e -> (e * e), x)   = [map(e -> (e * e), _)]
  keep positives: filter(e -> (0 < e), x)   = [filter(e -> (0 < e), _)]
  keep evens: filter(e -> (0 == (e % 2)), x)   = [filter(e -> (0 == (e % 2)), _)]
  count positives: len(filter(e -> (0 < e), x))   = [len(_)] [filter(e -> (0 < e), _)]
  sum of squares: sum(map(e -> (e * e), x))   = [sum(_)] [map(e -> (e * e), _)]
  largest: maxl(x)   = [maxl(_)]
  spread: (maxl(x) - minl(x))   = [(maxl(_) - minl(_))]
  sort descending: rev(sort(x))   = [rev(_)] [sort(_)]
  sum of positives: sum(filter(e -> (0 < e), x))   = [sum(_)] [filter(e -> (0 < e), _)]
  squares sorted: sort(map(e -> (e * e), x))   = [sort(_)] [map(e -> (e * e), _)]
  two smallest: take(2, sort(x))   = [take(2, _)] [sort(_)]
  count evens: len(filter(e -> (0 == (e % 2)), x))   = [len(_)] [filter(e -> (0 == (e % 2)), _)]
  sum of evens: sum(filter(e -> (0 == (e % 2)), x))   = [sum(_)] [filter(e -> (0 == (e % 2)), _)]
  largest two, biggest first: take(2, rev(sort(x)))   = [take(2, _)] [rev(_)] [sort(_)]
  clamp negatives to zero: map(e -> if((e < 0), 0, e), x)   = [map(e -> if((e < 0), 0, e), _)]
  product: fold((acc, e) -> (acc * e), 1, x)   = [fold((acc, e) -> (acc * e), 1, _)]
  product of squares: fold((acc, e) -> (acc * e), 1, (x ++ x))   = [fold((acc, e) -> (acc * e), 1, _)] [(_ ++ _)]
  reverse the word: rev(x)   = [rev(_)]
  word length: len(x)   = [len(_)]
  first letter: head(x)   = [head(_)]
  uppercase: map(e -> (e + -32), x)   = [map(e -> (e + -32), _)]
  mirror: (x ++ rev(x))   = [(_ ++ rev(_))]
  next letter of each: map(e -> (e + 1), x)   = [map(e -> (e + 1), _)]
  letters after m: filter(e -> (109 < e), x)   = [filter(e -> (109 < e), _)]
  first letter as capital: (-32 + head(x))   = [(-32 + _)] [head(_)]
  uppercase, reversed: rev(map(e -> (e + -32), x))   = [rev(_)] [map(e -> (e + -32), _)]
  letters before n: filter(e -> (e < 110), x)   = [filter(e -> (e < 110), _)]
  flip upside down: gflipv(g)   = [gflipv(_)]
  mirror left-right: gfliph(g)   = [gfliph(_)]
  transpose: gtrans(g)   = [gtrans(_)]
  height: gh(g)   = [gh(_)]
  width: gw(g)   = [gw(_)]
  rotate 180: gflipv(gfliph(g))   = [gflipv(_)] [gfliph(_)]
  rotate right: gfliph(gtrans(g))   = [gfliph(_)] [gtrans(_)]
  rotate left: gflipv(gtrans(g))   = [gflipv(_)] [gtrans(_)]
  recolour 1 to 5: gmap(e -> recolour(e, 1->5), g)   = [gmap(e -> recolour(e, 1->5), _)]
  recolour 1 to 5, then flip: gflipv(gmap(e -> recolour(e, 1->5), g))   = [gflipv(_)] [gmap(e -> recolour(e, 1->5), _)]

2. the English Pi made of it: 45 rules from 43 names
