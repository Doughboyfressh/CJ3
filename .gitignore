# Generated / large runtime data -- never pushed.
# out/ holds the brain's weight-derived system snapshots (flash_sys*.snap), ~19 GB of Wikipedia data,
# indexes, logs, and all compiled .exe binaries. None of it belongs in source control.
out/

# tooling caches
.ruff_cache/
__pycache__/
*.pyc

# keep the bootstrap compilers (seed/pic.exe for Windows, seed/pic for Linux) -- they are required to build Pi
# and live outside out/
.pi-profile/
