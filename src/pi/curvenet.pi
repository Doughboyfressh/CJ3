import "chatprofile.pi"
# A scalar piecewise-linear network in breakpoint form. An interior point
# contributes one ReLU weighted by the change in slope. Collinear points
# are retained in the lesson file so that later corrections can expose them.
skill cn_int(s) -> Any {
  let n = hm_number(s)
  if n == null or n < 0-100000000 or n > 100000000 { return null }
  return n
}

skill cn_prefix(values,count) -> Any {
  if len(values) == count { return values }
  let kept = arr(count)
  for i in range(0,count) { aset(kept,i,aget(values,i)) }
  return kept
}

skill cn_fit(data) -> Any {
  let records = split(trim(data))
  let n = len(records)
  if n == 0 { return null }
  let order = arr(n)
  let values = arr(n)
  for i in range(0,n) {
    let region = mark()
    let pair = split(records[i],"=")
    if len(pair) != 2 { return null }
    let x = cn_int(pair[0])
    let y = cn_int(pair[1])
    if x == null or y == null { return null }
    aset(order,i,(x+100000000)*n+i)
    aset(values,i,y)
    do release(region,null)
  }
  let order = sort(order)
  let xs = arr(n)
  let ys = arr(n)
  let count = 0
  let samples = 0
  for i in range(0,n) {
    let key = order[i] // n
    if i+1 == n or order[i+1] // n != key {
      let x = key-100000000
      let y = aget(values,order[i] % n)
      if count >= 2 {
        let a = count-2
        let b = count-1
        if (aget(ys,b)-aget(ys,a))*(x-aget(xs,b)) == (y-aget(ys,b))*(aget(xs,b)-aget(xs,a)) {
          let count = count-1
        }
      }
      aset(xs,count,x)
      aset(ys,count,y)
      let count = count+1
      let samples = samples+1
    }
  }
  return [cn_prefix(xs,count),cn_prefix(ys,count),count,samples]
}

skill cn_predict(net,x) -> Any {
  let xs = net[0]
  let ys = net[1]
  let lo = 0
  let hi = net[2]-1
  if x < aget(xs,lo) or x > aget(xs,hi) { return "Outside the taught range." }
  while hi-lo > 1 {
    let mid = (lo+hi) // 2
    if x < aget(xs,mid) { let hi = mid } else { let lo = mid }
  }
  if x == aget(xs,lo) { return str(aget(ys,lo)) }
  let width = aget(xs,hi)-aget(xs,lo)
  let total = aget(ys,lo)*(aget(xs,hi)-x)+aget(ys,hi)*(x-aget(xs,lo))
  let a = abs(total)
  let b = width
  while b != 0 { let r = a % b; let a = b; let b = r }
  let den = width // a
  let num = total // a
  return if den == 1 { str(num) } else { str(num) ++ "/" ++ str(den) }
}

skill chat_curve(st,text) -> Any {
  if slice(text,0,6) != "curve " and slice(text,0,12) != "teach curve " { return null }
  let words = split(text)
  if len(words) < 2 { return null }
  let teach = words[0] == "teach" and words[1] == "curve"
  if not teach and words[0] != "curve" { return null }
  let i = if teach { 2 } else { 1 }
  if len(words) <= i+1 or not hm_word(words[i]) { return ["Use teach curve NAME X=Y ... or curve NAME at X or curve NAME neurons.",st,false] }
  let path = chat_data("chat_curve_" ++ words[i] ++ ".txt")
  let data = read_file(path)
  if data == null { let data = "" }
  let suffix = ""
  if teach { let suffix = join(slice(words,i+1,len(words))," ") ++ "\n" }
  if data != "" and not ends(data,"\n") { return ["Incomplete curve lesson file.",st,false] }
  let source = if teach { data ++ suffix } else { data }
  if source == "" { return ["Teach this curve first.",st,false] }
  let cached = st["curve_cache"]
  let net = null
  if cached != null and cached[0] == path and cached[1] == source { let net = cached[2] }
  if net == null {
    let m = mark()
    let net = release(m,cn_fit(source))
  }
  if net == null { return ["Use integer X=Y lessons between -100000000 and 100000000.",st,false] }
  let reply = str(net[3]) ++ " samples, " ++ str(max(0,net[2]-2)) ++ " hidden ReLU neurons."
  if teach {
    if not rt_append_file(path,suffix) { return ["Could not save curve lessons.",st,false] }
    let prior = st["neuron_curve_prediction"]
    if prior != null and prior[0] == path and prior[3] == data {
      for record in reverse(slice(words,i+1,len(words))) {
        let pair = split(record,"=")
        if prior[1] == pair[0] {
          let st = neuron_observe(st,if prior[2] == pair[1] { 0 } else { 1 })
          let st = put(st,"neuron_curve_prediction",null)
          break
        }
      }
    }
  } else {
    if words[i+1] != "neurons" or len(words) != i+2 {
      if len(words) != i+3 or words[i+1] != "at" or cn_int(words[i+2]) == null { return ["Use curve NAME neurons or curve NAME at X.",st,false] }
      let reply = cn_predict(net,cn_int(words[i+2]))
      if reply != "Outside the taught range." {
        let st = put(st,"neuron_curve_prediction",[path,words[i+2],reply,source])
        if neuron_gate(st) {
          let token = words[i+2] ++ "="
          let known = slice(source,0,len(token)) == token
          for sep in [" ","\n","\t","\r"] { if contains(source,sep ++ token) { let known = true } }
          if not known {
            let reply = reply ++ ". Can you check it? Teach curve " ++ words[i] ++ " " ++ token ++ "VALUE with the observed integer."
          }
        }
      }
    }
  }
  if cached == null or cached[0] != path or cached[1] != source { let st = put(st,"curve_cache",[path,source,net]) }
  return [reply,put(st,"program_result",reply),false]
}
